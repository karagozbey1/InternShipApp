@model WebUI.Models.ViewModels.Account.ResetPasswordViewModel
@{
    Layout = "_AccountLayout";
}

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="login-wrap p-4 p-md-5">
                    <h3 class="mb-4 text-center">Þifrenizi Sýfýrlayýn</h3>

                    @if (TempData["ResetSuccess"] != null)
                    {
                        <div class="alert alert-success text-center">
                            @TempData["ResetSuccess"]
                        </div>

                        <script>
                            setTimeout(function () {
                                window.location.href = '@Url.Action("Login", "Account")';
                            }, 3300);
                        </script>
                    }
                    else
                    {
                        <form asp-action="ResetPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <input asp-for="Token" type="hidden" />
                            <input asp-for="Email" type="hidden" />

                            <div class="form-group mb-3">
                                <input asp-for="NewPassword" class="form-control" placeholder="Yeni Þifre" type="password" />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni Þifre Tekrar" type="password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="d-flex justify-content-center">
                                <button type="submit" class="btn btn-warning w-100">Þifreyi Sýfýrla</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</section>