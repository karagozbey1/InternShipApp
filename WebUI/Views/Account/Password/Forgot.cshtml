@model ForgotPasswordViewModel

@{
    ViewBag.Title = "Þifremi Unuttum";
    Layout = "_AccountLayout";
}

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center mb-5">
                <h2 class="heading-section">Þifre Sýfýrlama</h2>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-wrap p-0 forgot-password-card">
                    <h3 class="mb-3 text-center fw-bold">E?posta adresinizi girin</h3>
                    <p class="text-center mb-4 helper-text">Size güvenli bir þifre sýfýrlama baðlantýsý göndereceðiz.</p>

                    <!-- Dynamic Alerts -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-4">
                            Lütfen geçerli bir e?posta adresi giriniz.
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success py-2 px-3 mb-4">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <!-- Modern Form -->
                    <form asp-action="ForgotPassword" method="post" novalidate class="forgot-form">
                        @Html.AntiForgeryToken()
                        <div class="mb-4 position-relative">
                            <label asp-for="Email" class="form-label text-white small fw-semibold">E?posta Adresiniz</label>
                            <div class="position-relative">
                                <span class="input-icon-left"><i class="fa fa-envelope"></i></span>
                                <input asp-for="Email" 
                                       type="email" 
                                       autocomplete="email" 
                                       required 
                                       class="form-control forgot-input" 
                                       placeholder="ornek@universite.edu.tr" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 forgot-submit-btn">
                            <i class="fa fa-paper-plane me-2"></i>Gönder
                        </button>
                    </form>

                    <!-- Return to Login Link -->
                    <div class="text-center mt-4 small">
                        <a asp-controller="Account" asp-action="Login" class="return-login-link">
                            <i class="fa fa-arrow-right-to-bracket me-1"></i> Giriþ Yap
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}