@model CompanyRegisterViewModel
@{
    Layout = "_AccountLayout";
}

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center mb-5">
                <h2 class="heading-section">Firma Kayıt</h2>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="login-wrap p-0">
                    <h3 class="mb-4 text-center">Firma Bilgilerinizi Girin</h3>
                    <form asp-action="CompanyRegister" asp-controller="Account" method="post" class="signin-form">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input asp-for="CompanyName" class="form-control" placeholder="Firma Adı" required />
                                <span asp-validation-for="CompanyName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="CompanyUserFullName" class="form-control" placeholder="Firma Yetkilisi Adı" required />
                                <span asp-validation-for="CompanyUserFullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="TaxNumber" class="form-control" placeholder="Vergi Numarası" required />
                                <span asp-validation-for="TaxNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="EmailUser" class="form-control" placeholder="Firma Yetkili E-posta" required />
                                <span asp-validation-for="EmailUser" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <select asp-for="Sector" class="form-control" required>
                                    <option value="">Sektör Seçiniz</option>
                                    <option value="Teknoloji">Teknoloji</option>
                                    <option value="Finans">Finans</option>
                                    <option value="Sağlık">Sağlık</option>
                                    <option value="Eğitim">Eğitim</option>
                                    <option value="İmalat">İmalat</option>
                                    <option value="Hizmet">Hizmet</option>
                                    <option value="Perakende">Perakende</option>
                                    <option value="İnşaat">İnşaat</option>
                                    <option value="Turizm">Turizm</option>
                                    <option value="Diğer">Diğer</option>
                                </select>
                                <span asp-validation-for="Sector" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="RoleInCompany" class="form-control" placeholder="Firmadaki Pozisyonunuz" required />
                                <span asp-validation-for="RoleInCompany" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="Phone" class="form-control" placeholder="Telefon Numarası" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="Address" class="form-control" placeholder="Firma Adresi (isteğe bağlı)" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="Password" type="password" id="password-field-company" class="form-control" placeholder="Şifre" required />
                                <span toggle="#password-field-company" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="ConfirmPassword" type="password" id="confirm-password-field-company" class="form-control" placeholder="Şifre Tekrar" required />
                                <span toggle="#confirm-password-field-company" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="form-control btn btn-primary submit px-3">Kayıt Ol</button>
                        </div>
                        
                        <div class="form-group">
                            <a href="@Url.Action("RegisterOptions", "Account")" class="btn btn-secondary w-100">Geri Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
