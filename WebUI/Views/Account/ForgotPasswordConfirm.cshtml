@{
    ViewBag.Title = "Şifre Sıfırlama Gönderildi";   
	Layout = "_AccountLayout";

}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="alert alert-success">
            <h4 class="alert-heading">Talebiniz alındı!</h4>
            <p>@ViewBag.Message</p>
            <hr />
            <p class="mb-0">
                Giriş sayfasına dönmek için <a asp-controller="Account" asp-action="Login">buraya tıklayın</a>.
            </p>
        </div>
    </div>
</div>
