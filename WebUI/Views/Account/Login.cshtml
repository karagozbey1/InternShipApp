@model LoginViewModel
@{
    Layout = "_AccountLayout";
}

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center mb-5">
                <h2 class="heading-section">Giriş Yap</h2>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="login-wrap p-0">
                    <h3 class="mb-4 text-center">Hesabınıza giriş yapın</h3>
                    
                    @if (TempData["ActivationSuccess"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["ActivationSuccess"]
                        </div>
                    }

                    @if (TempData["ResetEmailSent"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["ResetEmailSent"]
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post" class="signin-form">
                        @Html.AntiForgeryToken()
                        
                        <div class="form-group">
                            <input asp-for="Email" type="email" class="form-control" placeholder="E-posta Adresiniz" required>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group position-relative">
                            <input asp-for="Password" id="password-field" type="password" class="form-control" placeholder="Şifreniz" required>
                            <span toggle="#password-field" class="fa fa-fw fa-eye field-icon toggle-password" style="position:absolute; top:50%; right:15px; cursor:pointer;"></span>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group d-flex justify-content-between align-items-center">
                            <div class="w-50">
                                <label class="checkbox-wrap checkbox-primary">
                                    <input asp-for="RememberMe" type="checkbox"> Beni Hatırla
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                            <div class="w-50 text-end">
                                <a asp-controller="Account" asp-action="ForgotPassword">Şifremi Unuttum</a>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="form-control btn btn-primary submit px-3">Giriş Yap</button>
                        </div>
                        
                        <div class="form-group">
                            <a asp-action="RegisterOptions" class="btn btn-outline-primary w-100">Kayıt Ol</a>
                        </div>
                        
                        <div class="form-group text-center">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-link">Ana Sayfaya Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}