@{
    Layout = "_AccountLayout";
}

<section class="modern-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-sm-9">
                <div class="modern-card">
                    <!-- Header with Animated Icon -->
                    <div class="card-header">
                        <div class="icon-wrapper">
                            <div class="pulse-ring"></div>
                            <div class="pulse-ring delay-1"></div>
                            <div class="pulse-ring delay-2"></div>
                            <div class="animated-icon">
                                <i class="fas fa-user-plus"></i>
                            </div>
                        </div>
                        <h1 class="card-title">Kayıt Ol</h1>
                        <p class="card-subtitle">
                            Lütfen kayıt olmak istediğiniz rolü seçin
                        </p>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body">
                        <!-- Role Selection Buttons -->
                        <div class="role-selection">
                            <!-- Student Button -->
                            <div class="role-option">
                                <a asp-action="StudentRegister" class="modern-role-btn">
                                    <div class="role-icon student-icon">
                                        <i class="fas fa-user-graduate"></i>
                                    </div>
                                    <div class="role-content">
                                        <h3>Öğrenci</h3>
                                        <p>Staj başvurusu yapın ve sürecinizi takip edin</p>
                                    </div>
                                    <div class="role-arrow">
                                        <i class="fas fa-chevron-right"></i>
                                    </div>
                                </a>
                            </div>

                            <!-- Advisor Button -->
                            <div class="role-option">
                                <a asp-action="AdvisorRegister" class="modern-role-btn">
                                    <div class="role-icon advisor-icon">
                                        <i class="fas fa-chalkboard-teacher"></i>
                                    </div>
                                    <div class="role-content">
                                        <h3>Danışman</h3>
                                        <p>Öğrenci stajlarını yönetin ve onaylayın</p>
                                    </div>
                                    <div class="role-arrow">
                                        <i class="fas fa-chevron-right"></i>
                                    </div>
                                </a>
                            </div>

                            <!-- Company Button -->
                            <div class="role-option">
                                <a asp-action="CompanyRegister" class="modern-role-btn">
                                    <div class="role-icon company-icon">
                                        <i class="fas fa-building"></i>
                                    </div>
                                    <div class="role-content">
                                        <h3>Firma</h3>
                                        <p>Staj ilanları verin ve başvuruları değerlendirin</p>
                                    </div>
                                    <div class="role-arrow">
                                        <i class="fas fa-chevron-right"></i>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Card Footer -->
                    <div class="card-footer">
                        <div class="footer-content">
                            <p>Zaten hesabınız var mı?</p>
                            <a asp-controller="Account" asp-action="Login" class="login-link">
                                <span>Giriş Yap</span>
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>