@{
	Layout = "_AccountLayout";
}
<!doctype html>
<html lang="tr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="~/css/style.css">
</head>
<body>
	<section class="ftco-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-md-6 text-center mb-5">
					<h2 class="heading-section">Kayıt Ol</h2>
				</div>
			</div>
			<div class="row justify-content-center">
				<div class="col-md-6 col-lg-4">
					<div class="login-wrap p-0">
						<h3 class="mb-4 text-center">Lütfen rolünüzü seçin</h3>
						<div class="form-group">
							<a asp-action="StudentRegister" class="form-control btn btn-primary submit px-3">Öğrenci</a>
						</div>
						<div class="form-group">
							<a asp-action="AdvisorRegister" class="form-control btn btn-success submit px-3">Danışman</a>
						</div>
						<div class="form-group">
							<a asp-action="CompanyRegister" class="form-control btn btn-info submit px-3">Firma</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</body>
</html>