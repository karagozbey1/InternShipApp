@model AdvisorRegisterViewModel
@{
	Layout = "_AccountLayout";
}
<!doctype html>
<html lang="tr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="~/css/style.css">
</head>
<body >
	<section class="ftco-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-md-6 text-center mb-5">
					<h2 class="heading-section">Danışman Kayıt</h2>
				</div>
			</div>
			<div class="row justify-content-center">
				<div class="col-md-6 col-lg-4">
					<div class="login-wrap p-0">
						<h3 class="mb-4 text-center">Bilgilerinizi girin</h3>
						<form asp-action="AdvisorRegister" asp-controller="Account" method="post" class="signin-form">
							<div asp-validation-summary="All" class="text-danger"></div>
							<div class="form-group">
								<input asp-for="FullName" class="form-control" placeholder="Adınız" required>
								<span asp-validation-for="FullName" class="text-danger"></span>
							</div>
							
							<div class="form-group">
								<input asp-for="Email" class="form-control" placeholder="Üniversite E-posta Adresi" required>
								<span asp-validation-for="Email" class="text-danger"></span>
							</div>
							<div class="form-group">
								<input asp-for="Password" id="password-field-advisor" type="password" class="form-control" placeholder="Şifre" required>
								<span toggle="#password-field-advisor" class="fa fa-fw fa-eye field-icon toggle-password"></span>
								<span asp-validation-for="Password" class="text-danger"></span>
							</div>
							<div class="form-group">
								<input asp-for="ConfirmPassword" id="confirm-password-field-advisor" type="password" class="form-control" placeholder="Şifre Tekrar" required>
								<span toggle="#confirm-password-field-advisor" class="fa fa-fw fa-eye field-icon toggle-password"></span>
								<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
							</div>
							<div class="form-group">
								<button type="submit" class="form-control btn btn-primary submit px-3">Kayıt Ol</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>
</body>
</html>