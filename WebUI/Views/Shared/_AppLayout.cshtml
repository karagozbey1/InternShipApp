@{
    Layout = null;
    var title = ViewData["Title"] ?? "Panel";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <title>@title - Staj Takip Sistemi</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- jQuery - Önce yüklenmeli -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Özel CSS -->
    <link rel="stylesheet" href="~/css/StudentCss/dashboard.css" />
    <link rel="stylesheet" href="~/css/StudentCss/app-theme.css" />
    <link rel="stylesheet" href="~/css/AdvisorCss/advisor-theme.css" />
    <link rel="stylesheet" href="~/css/company/company-styles.css" />
    <link rel="stylesheet" href="~/css/overrides.css" />

    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-full bg-gray-50 dark:bg-gray-900">
    <div class="min-h-screen dark:bg-gray-900">
        <div class="flex h-screen">
            @if (userRole == "Advisor")
            {
                <partial name="~/Views/Shared/PartialsViewApp/_AdvisorSidebar.cshtml" />
            }
            else if (userRole == "Company")
            {
                <partial name="~/Views/Shared/PartialsViewApp/_CompanySidebar.cshtml" />
            }
            else
            {
                <partial name="~/Views/Shared/PartialsViewApp/_Sidebar.cshtml" />
            }

            <div class="flex-1 flex flex-col overflow-hidden">
                <partial name="~/Views/Shared/PartialsViewApp/_Header.cshtml" model='@(ViewData["Title"]?.ToString() ?? "Ana Sayfa")' />

                <main class="flex-1 overflow-y-auto bg-gray-50 dark:bg-gray-900 p-6">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- Dashboard Scriptleri -->
    <script src="~/js/StudentScript/dashboard.js"></script>
    <script src="~/js/AdvisorScript/advisor.js"></script>
    <script src="~/js/company/company-dashboard.js"></script>
 
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
