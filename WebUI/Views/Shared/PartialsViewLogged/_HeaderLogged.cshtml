@using Microsoft.AspNetCore.Identity
@using System.Text.RegularExpressions
@using System.Security.Claims
@inject Business.Interfaces.UserRepose.IIUserService UserService

<header class="bg-white shadow">
    <div class="container d-flex justify-content-between align-items-center p-3">
        <div class="d-flex align-items-center">
            <img src="~/images/logo.png" alt="Üniversite Logosu" class="h-8 mr-2" />
            <span class="font-weight-bold text-lg text-gray-800">Staj Takip Sistemi</span>
        </div>

        <div class="d-flex align-items-center">
            @{ 
                var userIdClaim = Context.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                int.TryParse(userIdClaim, out var userId);
                var user = userId > 0 ? await UserService.GetUserWithUniversityAsync(userId) : null;
                var rawName = user?.FullName ?? Context.User?.Identity?.Name ?? "Kullanıcı";
                var cleaned = Regex.Replace(rawName, @"[^\p{L}\p{N}\s.\-']+", "");
                cleaned = Regex.Replace(cleaned, @"\s+", " ").Trim();
                var displayName = string.IsNullOrWhiteSpace(cleaned) ? rawName : cleaned;
                var university = user?.University?.Name ?? string.Empty;
                var department = user?.Department ?? string.Empty;
            }

            <div class="header-welcome-mini me-3 text-end">
                <div class="fw-semibold text-gray-800">Hoş Geldiniz, @displayName</div>
                @if (!string.IsNullOrWhiteSpace(university) || !string.IsNullOrWhiteSpace(department))
                {
                    <div class="text-xs text-primary">@(!string.IsNullOrWhiteSpace(university) ? university.ToUpperInvariant() : "")@(!string.IsNullOrWhiteSpace(university) && !string.IsNullOrWhiteSpace(department) ? " - " : "")@department</div>
                }
            </div>

            <div class="dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <img src="~/images/user-avatar.png" alt="Profil Resmi" class="rounded-circle h-8 w-8" />
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    <div class="px-3 py-2">
                        <div class="fw-semibold">@displayName</div>
                        @if (!string.IsNullOrWhiteSpace(university)) { <div class="text-xs text-muted">@university</div> }
                        @if (!string.IsNullOrWhiteSpace(department)) { <div class="text-xs text-muted">@department</div> }
                    </div>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#">Profilim</a>
                    <div class="dropdown-divider"></div>
                    <form asp-action="Logout" asp-controller="Account" method="post" id="logoutForm">
                        <button type="submit" class="dropdown-item">Çıkış Yap</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>