<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - Staj Takip Sistemi</title>

    <!-- Modern Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome 5.15.4 (Integrity kaldırıldı; SRI hash uyuşmazlığı blokluyordu) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- Eğer yine yüklenmezse tarayıcı eklentilerini devre dışı bırakıp Ctrl+F5 yapın. Gerekirse local kopya eklenebilir. -->

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-modern.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="modern-account-layout">
    <!-- Dynamic Floating Shapes will be added by JavaScript -->
    
    <main role="main" class="container">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/popper.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/account-modern.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
