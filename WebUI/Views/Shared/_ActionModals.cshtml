<!-- Approve Modal -->
<div id="approveModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-md w-full p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-200">
                <i class="fas fa-check-circle mr-2 text-green-500"></i>Baþvuruyu Onayla
            </h3>
            <button onclick="closeApproveModal()" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        
        <div class="mb-4">
            <p class="text-gray-600 dark:text-gray-400 mb-2">
                <strong id="approveStudentName"></strong> adlý öðrencinin 
                <strong id="approveCompanyName"></strong> þirketindeki staj baþvurusunu onaylamak istediðinizden emin misiniz?
            </p>
        </div>
        
        <form id="approveForm" onsubmit="submitApproval(event)">
            <input type="hidden" id="approveApplicationId" name="id" />
            @Html.AntiForgeryToken()
            
            <div class="mb-4">
                <label for="approveNote" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Danýþman Notu (Ýsteðe Baðlý)
                </label>
                <textarea id="approveNote" name="advisorNote" rows="3"
                          class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200"
                          placeholder="Onay ile ilgili notlarýnýzý buraya yazabilirsiniz..."></textarea>
            </div>
            
            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeApproveModal()" 
                        class="px-4 py-2 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 transition-colors">
                    Ýptal
                </button>
                <button type="submit" 
                        class="bg-green-500 hover:bg-green-600 text-white px-6 py-2 rounded-lg transition-colors font-medium">
                    <i class="fas fa-check mr-1"></i>Onayla
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-md w-full p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-200">
                <i class="fas fa-times-circle mr-2 text-red-500"></i>Baþvuruyu Reddet
            </h3>
            <button onclick="closeRejectModal()" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        
        <div class="mb-4">
            <p class="text-gray-600 dark:text-gray-400 mb-2">
                <strong id="rejectStudentName"></strong> adlý öðrencinin 
                <strong id="rejectCompanyName"></strong> þirketindeki staj baþvurusunu reddetmek istediðinizden emin misiniz?
            </p>
        </div>
        
        <form id="rejectForm" onsubmit="submitRejection(event)">
            <input type="hidden" id="rejectApplicationId" name="id" />
            @Html.AntiForgeryToken()
            
            <div class="mb-4">
                <label for="rejectReason" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Red Nedeni <span class="text-red-500">*</span>
                </label>
                <textarea id="rejectReason" name="rejectionReason" rows="4" required
                          class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200"
                          placeholder="Red nedeninizi açýklayýnýz..."></textarea>
                <small class="text-gray-500 text-xs mt-1">Red nedeni öðrenciye bildirilecektir.</small>
            </div>
            
            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeRejectModal()" 
                        class="px-4 py-2 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 transition-colors">
                    Ýptal
                </button>
                <button type="submit" 
                        class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg transition-colors font-medium">
                    <i class="fas fa-times mr-1"></i>Reddet
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Revision Modal -->
<div id="revisionModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-md w-full p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-200">
                <i class="fas fa-undo mr-2 text-yellow-500"></i>Revizyona Gönder
            </h3>
            <button onclick="closeRevisionModal()" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        
        <div class="mb-4">
            <p class="text-gray-600 dark:text-gray-400 mb-2">
                <strong id="revisionStudentName"></strong> adlý öðrencinin 
                <strong id="revisionCompanyName"></strong> þirketindeki staj baþvurusunu revizyona göndermek istediðinizden emin misiniz?
            </p>
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 rounded-lg p-3 mt-3">
                <p class="text-yellow-800 dark:text-yellow-200 text-sm">
                    <i class="fas fa-info-circle mr-1"></i>
                    Baþvuru beklemede durumunda kalacak ve öðrenci düzeltme yapabilecek.
                </p>
            </div>
        </div>
        
        <form id="revisionForm" onsubmit="submitRevision(event)">
            <input type="hidden" id="revisionApplicationId" name="id" />
            @Html.AntiForgeryToken()
            
            <div class="mb-4">
                <label for="revisionNote" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Geri Dönüþ Notu <span class="text-red-500">*</span>
                </label>
                <textarea id="revisionNote" name="revisionNote" rows="4" required
                          class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200"
                          placeholder="Düzeltilmesi gereken noktalarý belirtiniz..."></textarea>
                <small class="text-gray-500 text-xs mt-1">Bu not öðrenciye gönderilecektir.</small>
            </div>
            
            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeRevisionModal()" 
                        class="px-4 py-2 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200 transition-colors">
                    Ýptal
                </button>
                <button type="submit" 
                        class="bg-yellow-500 hover:bg-yellow-600 text-white px-6 py-2 rounded-lg transition-colors font-medium">
                    <i class="fas fa-undo mr-1"></i>Geri Gönder
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Modal functions
    function showApproveModal(id, studentName, companyName) {
        document.getElementById('approveApplicationId').value = id;
        document.getElementById('approveStudentName').textContent = studentName;
        document.getElementById('approveCompanyName').textContent = companyName;
        document.getElementById('approveNote').value = '';
        document.getElementById('approveModal').classList.remove('hidden');
    }
    
    function closeApproveModal() {
        document.getElementById('approveModal').classList.add('hidden');
    }
    
    function showRejectModal(id, studentName, companyName) {
        document.getElementById('rejectApplicationId').value = id;
        document.getElementById('rejectStudentName').textContent = studentName;
        document.getElementById('rejectCompanyName').textContent = companyName;
        document.getElementById('rejectReason').value = '';
        document.getElementById('rejectModal').classList.remove('hidden');
    }
    
    function closeRejectModal() {
        document.getElementById('rejectModal').classList.add('hidden');
    }
    
    function showRevisionModal(id, studentName, companyName) {
        document.getElementById('revisionApplicationId').value = id;
        document.getElementById('revisionStudentName').textContent = studentName;
        document.getElementById('revisionCompanyName').textContent = companyName;
        document.getElementById('revisionNote').value = '';
        document.getElementById('revisionModal').classList.remove('hidden');
    }
    
    function closeRevisionModal() {
        document.getElementById('revisionModal').classList.add('hidden');
    }
    
    // Form submissions
    async function submitApproval(event) {
        event.preventDefault();
        
        const formData = new FormData(event.target);
        
        try {
            const response = await fetch('/AdvisorApplication/ApproveApplication', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success) {
                showNotification(result.message, 'success');
                closeApproveModal();
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showNotification(result.message, 'error');
            }
        } catch (error) {
            showNotification('Ýþlem sýrasýnda hata oluþtu.', 'error');
        }
    }
    
    async function submitRejection(event) {
        event.preventDefault();
        
        const formData = new FormData(event.target);
        
        try {
            const response = await fetch('/AdvisorApplication/RejectApplication', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success) {
                showNotification(result.message, 'success');
                closeRejectModal();
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showNotification(result.message, 'error');
            }
        } catch (error) {
            showNotification('Ýþlem sýrasýnda hata oluþtu.', 'error');
        }
    }
    
    async function submitRevision(event) {
        event.preventDefault();
        
        const formData = new FormData(event.target);
        
        try {
            const response = await fetch('/AdvisorApplication/ReturnForRevision', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success) {
                showNotification(result.message, 'success');
                closeRevisionModal();
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showNotification(result.message, 'error');
            }
        } catch (error) {
            showNotification('Ýþlem sýrasýnda hata oluþtu.', 'error');
        }
    }
    
    // Close modals with escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeApproveModal();
            closeRejectModal();
            closeRevisionModal();
        }
    });
    
    // Close modals when clicking outside
    ['approveModal', 'rejectModal', 'revisionModal'].forEach(modalId => {
        document.getElementById(modalId).addEventListener('click', function(e) {
            if (e.target === this) {
                if (modalId === 'approveModal') closeApproveModal();
                else if (modalId === 'rejectModal') closeRejectModal();
                else if (modalId === 'revisionModal') closeRevisionModal();
            }
        });
    });
</script>