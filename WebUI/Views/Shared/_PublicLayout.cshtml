@* Güncellenmiş layout - About ve Contact linkleri kaldırıldı *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staj Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        :root { --primary-start:#6d28d9; --primary-mid:#5631d8; --primary-end:#2563eb; --gradient-main:linear-gradient(90deg,var(--primary-start),var(--primary-mid) 40%,var(--primary-end)); }
        .top-gradient-bar {height:4px;background:var(--gradient-main);}        
        .nav-solutions-btn, .nav-gradient-btn {border:0;transition:.25s;background:var(--gradient-main);color:#fff;border-radius:24px;padding:.45rem 1.15rem;font-size:.85rem;font-weight:600;position:relative;overflow:hidden;}
        .nav-solutions-btn:hover, .nav-gradient-btn:hover {filter:brightness(1.1);color:#fff;}
        .nav-auth-outline{border:1px solid var(--primary-start);color:var(--primary-start);border-radius:24px;padding:.45rem 1.15rem;font-size:.85rem;font-weight:600;}
        .nav-auth-outline:hover{background:var(--gradient-main);border-color:transparent;color:#fff;}
        .scroll-link {cursor:pointer;}
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <div class="top-gradient-bar"></div>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm" style="min-height:60px;">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-layer-group me-2 text-gradient"></i>
                    <span>StajTakip</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto small fw-semibold align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Solutions">Çözüm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Announcements">Duyurular</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            if(userRole=="Student"){
                                <li class="nav-item"><a class="nav-link nav-auth-outline" asp-controller="Dashboard" asp-action="Index">Panel</a></li>
                            } else if(userRole=="Advisor"){
                                <li class="nav-item"><a class="nav-link nav-auth-outline" asp-controller="AdvisorDashboard" asp-action="Index">Panel</a></li>
                            } else if(userRole=="Company"){
                                <li class="nav-item"><a class="nav-link nav-auth-outline" asp-controller="Company" asp-action="Index">Panel</a></li>
                            }
                       
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link btn btn-link p-0 m-0" style="text-decoration:none;">Çıkış</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- Yeni istek: Giriş butonu gradient ve sayfa içindeki rol kartlarına kaydırma -->
                            <li class="nav-item">
                                <a class="nav-link nav-gradient-btn scroll-link" data-target="#role-cards">Giriş</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-solutions-btn" asp-controller="Account" asp-action="RegisterOptions">Kayıt Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>StajTakip</h5>
                    <p class="small">Öğrenciler, akademisyenler ve şirketler için uçtan uca staj başvuru & takip platformu.</p>
                </div>
                <div class="col-md-4">
                    <h5>Hızlı Linkler</h5>
                    <ul class="list-unstyled">
                        <li><a class="text-light text-decoration-none small" asp-controller="Home" asp-action="Solutions">Çözüm</a></li>
                        <li><a class="text-light text-decoration-none small" asp-controller="Home" asp-action="Announcements">Duyurular</a></li>
                        <li><a asp-action="Privacy" class="text-light text-decoration-none small">Gizlilik</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>İletişim</h5>
                    <p class="small mb-1"><i class="fas fa-envelope me-2"></i>staj@universite.edu.tr</p>
                    <p class="small mb-1"><i class="fas fa-phone me-2"></i>0212 555 01 23</p>
                    <p class="small mb-1"><i class="fas fa-map-marker-alt me-2"></i>Üniversite Kampüsü</p>
                </div>
            </div>
            <hr class="my-3">
            <div class="row">
                <div class="col-12 text-center">
                    <p class="small mb-0">&copy; 2025 - StajTakip</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('click', function(e){
            const link = e.target.closest('.scroll-link');
            if(!link) return;            
            const targetSel = link.getAttribute('data-target');
            const el = document.querySelector(targetSel);
            if(el){
                if(window.location.pathname !== '/' && !window.location.pathname.toLowerCase().endsWith('/home/index')){
                    window.location = '/#' + targetSel.replace('#','');
                    return;
                }
                e.preventDefault();
                window.scrollTo({top: el.getBoundingClientRect().top + window.scrollY - 70, behavior:'smooth'});
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>