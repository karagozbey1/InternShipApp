<aside class="company-sidebar bg-gradient-to-br from-indigo-800 via-purple-700 to-indigo-900 shadow-xl rounded-xl p-6 w-72 min-h-screen flex flex-col gap-4">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #6D28D9 0%, #7C3AED 100%);">
                <i class="fas fa-building text-white text-lg"></i>
            </div>
            <div>
                <h2 class="text-lg font-bold" style="color: #ede9fe;">Firma Paneli</h2>
                <p class="text-sm" style="color: #c7d2fe;">Staj Takip Sistemi</p>
            </div>
        </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="mt-6">
        <ul class="space-y-2">
            <!-- Ana Sayfa -->
            <li>
                <a asp-controller="Company" asp-action="Index" 
                   class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200 hover:bg-gradient-to-r hover:from-purple-700 hover:to-indigo-800 hover:text-white"
                   style="color: #ede9fe;">
                    <i class="fas fa-home w-5 h-5 mr-3 text-indigo-200"></i>
                    <span class="font-medium">Ana Sayfa</span>
                </a>
            </li>
            <!-- Bildirimler -->
            <li>
                <a asp-controller="Company" asp-action="Notifications" 
                   class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200 hover:bg-gradient-to-r hover:from-purple-700 hover:to-indigo-800 hover:text-white"
                   style="color: #ede9fe;">
                    <i class="fas fa-bell w-5 h-5 mr-3 text-indigo-200"></i>
                    <span class="font-medium">Bildirimler</span>
                    <span id="notificationBadge" class="ml-auto bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-full hidden">0</span>
                </a>
            </li>
            <!-- Profil -->
            <li>
                <a asp-controller="CompanyProfile" asp-action="Index" 
                   class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200 hover:bg-gradient-to-r hover:from-purple-700 hover:to-indigo-800 hover:text-white"
                   style="color: #ede9fe;">
                    <i class="fas fa-user w-5 h-5 mr-3 text-indigo-200"></i>
                    <span class="font-medium">Profil</span>
                </a>
            </li>
            <!-- Ýlanlarým -->
            <li>
                <a asp-controller="CompanyJobPostings" asp-action="List" 
                   class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200 hover:bg-gradient-to-r hover:from-purple-700 hover:to-indigo-800 hover:text-white"
                   style="color: #ede9fe;">
                    <i class="fas fa-briefcase w-5 h-5 mr-3 text-indigo-200"></i>
                    <span class="font-medium">Ýlanlarým</span>
                </a>
            </li>
            <!-- Baþvurular -->
            <li>
                <a asp-controller="CompanyApplications" asp-action="List" 
                   class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200 hover:bg-gradient-to-r hover:from-purple-700 hover:to-indigo-800 hover:text-white"
                   style="color: #ede9fe;">
                    <i class="fas fa-file-alt w-5 h-5 mr-3 text-indigo-200"></i>
                    <span class="font-medium">Baþvurular</span>
                </a>
            </li>
            <!-- Aktif Stajyerler -->
            <li>
                <a asp-controller="CompanyInterns" asp-action="List" 
                   class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200 hover:bg-gradient-to-r hover:from-purple-700 hover:to-indigo-800 hover:text-white"
                   style="color: #ede9fe;">
                    <i class="fas fa-users w-5 h-5 mr-3 text-indigo-200"></i>
                    <span class="font-medium">Aktif Stajyerler</span>
                </a>
            </li>
            <!-- Raporlar -->
            <li>
                <a asp-controller="CompanyInterns" asp-action="Reports" 
                   class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200 hover:bg-gradient-to-r hover:from-purple-700 hover:to-indigo-800 hover:text-white"
                   style="color: #ede9fe;">
                    <i class="fas fa-chart-bar w-5 h-5 mr-3 text-indigo-200"></i>
                    <span class="font-medium">Raporlar</span>
                </a>
            </li>
        </ul>
        <div class="mx-4 my-6" style="border-top: 1px solid #6D28D9;"></div>
        <ul class="space-y-2">
            <!-- LOGOUT BUTTON -->
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="company-nav-link flex items-center px-4 py-3 rounded-lg transition-all duration-200" style="color: #fca5a5; background:none; border:none; width:100%; text-align:left;">
                        <i class="fas fa-sign-out-alt w-5 h-5 mr-3" style="color: #fca5a5;"></i>
                        <span class="font-medium">Çýkýþ Yap</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>
</aside>

<script>
    // Dinamik bildirim sayýsýný güncelle
    document.addEventListener('DOMContentLoaded', function() {
        fetch('/Company/Notification/UnreadCount')
            .then(response => response.json())
            .then(data => {
                const badge = document.getElementById('notificationBadge');
                if (data.unreadCount > 0) {
                    badge.textContent = data.unreadCount;
                    badge.classList.remove('hidden');
                }
            })
            .catch(error => console.error('Error fetching notification count:', error));
    });
</script>