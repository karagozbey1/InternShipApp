@model string

<header class="h-16 border-b bg-white/80 backdrop-blur-md border-gray-200 dark:bg-gray-800/90 dark:border-gray-700 flex items-center justify-between px-6">
    <div>
        <h1 class="text-xl font-bold text-gray-800 dark:text-gray-200">@Model</h1>
    </div>

    <div class="flex items-center gap-4">
        <!-- Theme Toggle -->
        <button id="themeToggle" class="p-2 rounded-xl bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-yellow-400 dark:hover:bg-gray-600 transition-all duration-200">
            <i class="fas fa-moon dark:hidden"></i>
            <i class="fas fa-sun hidden dark:inline"></i>
        </button>

        <!-- Notifications Button -->
        <div class="relative">
            <button id="notificationBtn" onclick="toggleNotifications()" class="relative p-2 rounded-xl bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 transition-all duration-200">
                <i class="fas fa-bell text-lg"></i>
                <span id="notificationBadge" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold hidden">
                    0
                </span>
            </button>
            
            <!-- Notification Dropdown -->
            <div id="notificationDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 z-50 overflow-hidden">
                <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-purple-500 to-indigo-600">
                    <div class="flex items-center justify-between">
                        <h3 class="font-bold text-white">Bildirimler</h3>
                        <button onclick="markAllAsRead()" class="text-xs text-white/80 hover:text-white transition-colors">
                            Tümünü Okundu İşaretle
                        </button>
                    </div>
                </div>
                <div id="notificationList" class="max-h-96 overflow-y-auto">
                    <div class="p-4 text-center text-gray-500 dark:text-gray-400">
                        <i class="fas fa-bell-slash text-2xl mb-2"></i>
                        <p class="text-sm">Yeni bildirim yok</p>
                    </div>
                </div>
                <div class="p-3 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
                    <a href="/Notification" class="block text-center text-sm text-purple-600 dark:text-purple-400 hover:text-purple-800 dark:hover:text-purple-300 font-medium">
                        Tüm Bildirimleri Gör
                    </a>
                </div>
            </div>
        </div>

        <!-- Messages Button -->
        <button id="messengerBtn" onclick="openChat()" class="flex items-center gap-2 bg-gradient-to-r from-blue-500 to-purple-600 text-white px-4 py-2 rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105">
            <i class="fas fa-comments"></i>
            <span class="font-medium">Mesajlar</span>
            <span id="unreadMessagesCount" class="bg-white text-blue-600 text-xs rounded-full px-2 py-1 font-bold hidden">
                0
            </span>
        </button>
    </div>
</header>

<!-- Chat Modal Container -->
<div id="chatModalContainer"></div>

<script>
    // Theme toggle
    document.getElementById('themeToggle')?.addEventListener('click', function() {
        document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    });

    // Load saved theme
    if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
    }

    // ==================== NOTIFICATIONS ====================
    let notificationsOpen = false;

    function toggleNotifications() {
        const dropdown = document.getElementById('notificationDropdown');
        notificationsOpen = !notificationsOpen;
        
        if (notificationsOpen) {
            dropdown.classList.remove('hidden');
            loadNotifications();
        } else {
            dropdown.classList.add('hidden');
        }
    }

    function loadNotifications() {
        fetch('/Notification/GetUnreadNotifications')
            .then(response => response.json())
            .then(data => {
                const listElement = document.getElementById('notificationList');
                
                if (data.notifications && data.notifications.length > 0) {
                    listElement.innerHTML = data.notifications.map(notification => `
                        <div class="notification-item p-4 border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer ${notification.isRead ? 'opacity-60' : ''}" 
                             onclick="goToNotification(${notification.id}, '${notification.link || ''}')">
                            <div class="flex items-start gap-3">
                                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-gradient-to-br ${getNotificationColor(notification.type)} flex items-center justify-center">
                                    <i class="fas ${getNotificationIcon(notification.type)} text-white text-sm"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate">${notification.title}</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">${notification.message}</p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                                        <i class="fas fa-clock mr-1"></i>${notification.timeAgo}
                                    </p>
                                </div>
                                ${!notification.isRead ? '<div class="w-2 h-2 bg-blue-500 rounded-full flex-shrink-0"></div>' : ''}
                            </div>
                        </div>
                    `).join('');
                } else {
                    listElement.innerHTML = `
                        <div class="p-8 text-center text-gray-500 dark:text-gray-400">
                            <i class="fas fa-bell-slash text-3xl mb-3 opacity-50"></i>
                            <p class="text-sm">Yeni bildirim yok</p>
                        </div>
                    `;
                }
            })
            .catch(error => {
                console.error('Bildirimler yüklenemedi:', error);
                document.getElementById('notificationList').innerHTML = `
                    <div class="p-4 text-center text-red-500">
                        <i class="fas fa-exclamation-circle mr-2"></i>Bildirimler yüklenemedi
                    </div>
                `;
            });
    }

    function getNotificationIcon(type) {
        const icons = {
            'ApplicationApproved': 'fa-check-circle',
            'ApplicationRejected': 'fa-times-circle',
            'RevisionRequested': 'fa-edit',
            'NewMessage': 'fa-envelope',
            'DiaryApproved': 'fa-book-check',
            'DiaryRejected': 'fa-book-dead',
            'NewApplication': 'fa-file-alt',
            'default': 'fa-bell'
        };
        return icons[type] || icons['default'];
    }

    function getNotificationColor(type) {
        const colors = {
            'ApplicationApproved': 'from-green-400 to-green-600',
            'ApplicationRejected': 'from-red-400 to-red-600',
            'RevisionRequested': 'from-yellow-400 to-orange-500',
            'NewMessage': 'from-blue-400 to-blue-600',
            'DiaryApproved': 'from-emerald-400 to-emerald-600',
            'DiaryRejected': 'from-rose-400 to-rose-600',
            'NewApplication': 'from-purple-400 to-purple-600',
            'default': 'from-gray-400 to-gray-600'
        };
        return colors[type] || colors['default'];
    }

    function goToNotification(id, link) {
        // Mark as read
        fetch(`/Notification/MarkAsRead/${id}`, { method: 'POST' })
            .then(() => {
                updateNotificationCount();
                if (link) {
                    window.location.href = link;
                }
            })
            .catch(err => console.error('Bildirim işaretlenemedi:', err));
    }

    function markAllAsRead() {
        fetch('/Notification/MarkAllAsRead', { method: 'POST' })
            .then(() => {
                updateNotificationCount();
                loadNotifications();
            })
            .catch(err => console.error('Bildirimler işaretlenemedi:', err));
    }

    function updateNotificationCount() {
        fetch('/Notification/GetUnreadCount')
            .then(response => response.json())
            .then(data => {
                const badge = document.getElementById('notificationBadge');
                if (badge) {
                    if (data.count > 0) {
                        badge.textContent = data.count > 99 ? '99+' : data.count;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }
            })
            .catch(error => console.error('Bildirim sayısı alınamadı:', error));
    }

    // Close notification dropdown when clicking outside
    document.addEventListener('click', function(e) {
        const dropdown = document.getElementById('notificationDropdown');
        const btn = document.getElementById('notificationBtn');
        if (dropdown && btn && !dropdown.contains(e.target) && !btn.contains(e.target)) {
            dropdown.classList.add('hidden');
            notificationsOpen = false;
        }
    });

    // ==================== MESSAGES ====================
    function updateUnreadMessageCount() {
        fetch('/Chat/GetUnreadCount')
            .then(response => response.json())
            .then(data => {
                const countElement = document.getElementById('unreadMessagesCount');
                if (countElement) {
                    if (data.unreadCount > 0) {
                        countElement.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                        countElement.classList.remove('hidden');
                    } else {
                        countElement.classList.add('hidden');
                    }
                }
            })
            .catch(error => console.error('Mesaj sayısı alınamadı:', error));
    }

    // Load counts on page load
    document.addEventListener('DOMContentLoaded', function() {
        updateUnreadMessageCount();
        updateNotificationCount();
        
        // Update counts every 30 seconds
        setInterval(() => {
            updateUnreadMessageCount();
            updateNotificationCount();
        }, 30000);
    });

    // Chat functionality
    function openChat() {
        const modalContainer = document.getElementById('chatModalContainer');
        
        const iframe = document.createElement('iframe');
        iframe.src = '/Chat';
        iframe.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
            z-index: 10000;
            background: rgba(0, 0, 0, 0.5);
        `;
        iframe.id = 'chatIframe';
        
        modalContainer.appendChild(iframe);
        
        window.addEventListener('message', function(event) {
            if (event.data === 'closeChat') {
                closeChat();
            }
        });
        
        document.body.style.overflow = 'hidden';
    }

    function closeChat() {
        const chatIframe = document.getElementById('chatIframe');
        if (chatIframe) {
            chatIframe.remove();
        }
        
        document.body.style.overflow = 'auto';
        updateUnreadMessageCount();
    }

    // Close chat with Escape key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeChat();
        }
    });
</script>