@model WebUI.Models.ViewModels.Advisor.AdvisorNotificationViewModel
@{
    ViewData["Title"] = "Bildirimler";
    Layout = "_AppLayout"; 
}
<div class="container mt-6">
    <div class="w-full mb-8 flex items-center justify-center">
        <div class="rounded-2xl bg-[#f3f7ff] border border-[#dbeafe] shadow-sm px-8 py-6 flex items-center gap-4 w-full">
            <i class="fas fa-bell text-3xl text-blue-700"></i>
            <div>
                <h1 class="text-2xl font-bold text-blue-700 mb-1">Bildirimler</h1>
                <p class="text-blue-600">Danýþman bildirimlerinizi yönetin.</p>
            </div>
            <div class="ml-auto flex gap-2">
                <button class="btn btn-secondary" onclick="refreshNow()"><i class="fas fa-rotate"></i> Yenile</button>
                <button class="btn btn-secondary" onclick="markAllAsRead()"><i class="fas fa-check-double"></i> Tümünü Okundu Yap</button>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <p class="text-sm font-medium text-gray-600">Okunmayan</p>
            <p id="unreadCount" class="stat-number text-3xl font-bold text-gray-900">@Model.Statistics?.UnreadCount</p>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <p class="text-sm font-medium text-gray-600">Bugün</p>
            <p id="todayCount" class="stat-number text-3xl font-bold text-gray-900">@Model.Statistics?.TodayCount</p>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <p class="text-sm font-medium text-gray-600">Bu Hafta</p>
            <p id="weekCount" class="stat-number text-3xl font-bold text-gray-900">@Model.Statistics?.ThisWeekCount</p>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <p class="text-sm font-medium text-gray-600">Toplam</p>
            <p id="totalCount" class="stat-number text-3xl font-bold text-gray-900">@Model.Statistics?.TotalCount</p>
        </div>
    </div>

    <div class="mb-4 flex flex-wrap gap-4 items-center">
        <div class="flex gap-4 flex-wrap">
            <button class="btn btn-primary" onclick="applyFilter('all')">Tümü</button>
            <button class="btn btn-secondary" onclick="applyFilter('unread')">Okunmayanlar</button>
            <button class="btn btn-secondary" onclick="applyFilter('application')">Baþvurular</button>
            <button class="btn btn-secondary" onclick="applyFilter('diary')">Staj Defteri</button>
            <button class="btn btn-secondary" onclick="applyFilter('system')">Sistem</button>
        </div>
    </div>

    <div id="notification-list"></div>
</div>

<style>
    .icon-circle { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; }
    .unread-dot { width:8px; height:8px; background:#2563eb; border-radius:50%; display:inline-block; }
    .notification-card { position:relative; }
    .action-btn { width:40px; height:40px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; border:none; cursor:pointer; background:transparent; transition:all .15s; }
    .action-btn.approve { color:#10b981; }
    .action-btn.delete { color:#ef4444; }
    .action-btn.open { color:#3b82f6; text-decoration:none; }
</style>

@section Scripts {
<script>
           let currentFilter = 'all';
        let autoRefreshTimer = null;

      
        async function fetchNotifications(filter) {
            const res = await fetch(`/Advisor/AdvisorNotification/Filter?type=${filter}`);
            return await res.json();
        }

        function renderItem(n) {
            const div = document.createElement('div');
            div.className = 'notification-card flex items-start gap-4 p-4 bg-white rounded-xl shadow-sm border mb-3';
            div.dataset.id = n.id;

            div.innerHTML = `
                <div class="flex-shrink-0 mt-1">
                    <div class="icon-circle bg-blue-100">
                        <i class="fas fa-bell icon-lg"></i>
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <h5 class="text-lg font-semibold text-gray-900 mb-1">${n.title}</h5>
                                ${n.isRead ? '' : '<span class="unread-dot" title="Okunmadý"></span>'}
                            </div>
                            <p class="text-gray-600 mb-2">${n.message}</p>
                            <div class="flex items-center gap-3 text-sm text-gray-500">
                                <span>
                                    <i class="fas fa-clock mr-1"></i>
                                    ${new Date(n.createdAt).toLocaleString()}
                                </span>
                                <span class="px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-800">
                                    ${n.type}
                                </span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-2">
                            ${n.isRead ? '' : `
                                <button class="action-btn approve" onclick="markAsRead(${n.id})">
                                    <i class="fas fa-check-circle"></i>
                                </button>`}
                            <button class="action-btn delete" onclick="deleteNotification(${n.id})">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                            ${n.actionUrl ? `
                                <a class="action-btn open" href="${n.actionUrl}">
                                    <i class="fas fa-external-link-alt"></i>
                                </a>` : ''}
                        </div>
                    </div>
                </div>
            `;
            return div;
        }

        
        async function applyFilter(f) {
            currentFilter = f;
            await loadList();
        }

        async function loadList() {
            const data = await fetchNotifications(currentFilter);
            const list = document.getElementById('notification-list');

            list.innerHTML = '';

            if (Array.isArray(data) && data.length) {
                data.forEach(n => list.appendChild(renderItem(n)));
            } else {
                list.innerHTML = `
                    <div class="bg-white border rounded-xl shadow-sm p-10 text-center text-gray-500">
                        <i class="fas fa-bell-slash text-5xl mb-4"></i>
                        <p>Bildirim bulunamadý</p>
                    </div>`;
            }

            updateCounters(data);
        }

     
        function startAutoRefresh() {
            if (autoRefreshTimer) clearInterval(autoRefreshTimer);
            autoRefreshTimer = setInterval(() => loadList(), 30000);
        }

        function refreshNow() {
            loadList();
        }

     
        async function markAsRead(id) {
            const res = await fetch(`/Advisor/AdvisorNotification/MarkAsRead/${id}`, { method: 'POST' });

            if (res.ok) {
                const card = document.querySelector(`[data-id='${id}']`);
                card?.querySelector('.unread-dot')?.remove();
                card?.querySelector('.action-btn.approve')?.remove();
                refreshUnread();
            }
        }

        async function markAllAsRead() {
            if (!confirm('Tüm bildirimler okundu iþaretlensin mi?')) return;

            const res = await fetch('/Advisor/AdvisorNotification/MarkAllAsRead', { method: 'POST' });

            if (res.ok) {
                loadList();
                refreshUnread();
            }
        }

        async function deleteNotification(id) {
            if (!confirm('Silinsin mi?')) return;

            const res = await fetch(`/Advisor/AdvisorNotification/Delete/${id}`, { method: 'POST' });

            if (res.ok) {
                document.querySelector(`[data-id='${id}']`)?.remove();
                refreshUnread();
            }
        }

       
        async function refreshUnread() {
            const res = await fetch('/Advisor/AdvisorNotification/GetUnreadCount');
            const d = await res.json();

            document.getElementById('unreadCount').textContent = d.unreadCount;

            const badge = document.getElementById('sidebarNotificationBadge');
            if (badge) {
                if (d.unreadCount > 0) {
                    badge.textContent = d.unreadCount;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
        }

        function updateCounters(data) {
            const today = new Date();
            const todayStr = today.toDateString();

            const weekAgo = new Date();
            weekAgo.setDate(weekAgo.getDate() - 7);

            let todayCnt = 0, weekCnt = 0;

            data.forEach(n => {
                const d = new Date(n.createdAt);
                if (d.toDateString() === todayStr) todayCnt++;
                if (d >= weekAgo) weekCnt++;
            });

            document.getElementById('todayCount').textContent = todayCnt;
            document.getElementById('weekCount').textContent = weekCnt;
            document.getElementById('totalCount').textContent = data.length;
        }

      
        document.addEventListener('DOMContentLoaded', () => {
            loadList();
            refreshUnread();
            startAutoRefresh();
        });

</script>
}
