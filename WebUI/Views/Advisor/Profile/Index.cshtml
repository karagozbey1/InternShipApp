@using WebUI.Models.ViewModels.Advisor
@model AdvisorProfileViewModel
@{
    ViewData["Title"] = "Profil";
    Layout = "_AppLayout";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-lg dark:from-blue-900/20 dark:to-indigo-900/20 dark:border-blue-700 flex items-start justify-between">
        <div>
            <h1 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-2">
                <i class="fas fa-user-tie me-3"></i>Danýþman Profili
            </h1>
            <p class="text-blue-600 dark:text-blue-300">Bilgilerinizi görüntüleyin ve düzenleyin</p>
        </div>
        <div>
            <button id="btnEditToggle" class="px-4 py-2 rounded-xl text-white shadow-sm hover:shadow transition-all duration-150" style="background:linear-gradient(135deg,#7C3AED,#6D28D9);">
                <i class="fas fa-pen me-2"></i>Düzenle
            </button>
        </div>
    </div>

    <!-- DISPLAY SECTION -->
    <div id="displaySection" class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
        <!-- TempData Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
        <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
        <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        </div>
        }

        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-6">
            <!-- Centered name -->
            <div class="text-center mb-6">
                <h2 class="text-2xl font-extrabold text-gray-900 dark:text-gray-100">@Model.FullName</h2>
                <div class="text-gray-500 dark:text-gray-400">@Model.Title - @Model.Department</div>
                <div class="text-sm text-gray-400 dark:text-gray-500">@Model.UniversityName</div>
            </div>

            <!-- Info grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="space-y-3">
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-envelope text-rose-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">E-posta</div>
                            <div class="font-medium">@Model.Email</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-award text-indigo-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">Unvan</div>
                            <div class="font-medium">@Model.Title</div>
                        </div>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-graduation-cap text-fuchsia-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">Bölüm</div>
                            <div class="font-medium">@Model.Department</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-university text-purple-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">Üniversite</div>
                            <div class="font-medium">@Model.UniversityName</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- EDIT SECTION -->
    <div id="editSection" class="hidden space-y-6">
        <!-- Profile Information -->
        <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-6">
                <i class="fas fa-user me-2"></i>Profil Bilgileri
            </h3>

            <form asp-action="UpdateProfile" method="post" class="profile-form">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="FullName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-user me-1"></i>Ad Soyad
                        </label>
                        <input asp-for="FullName" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Adýnýzý ve soyadýnýzý girin" 
                               required />
                        <span asp-validation-for="FullName" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-envelope me-1"></i>E-posta
                        </label>
                        <input asp-for="Email" 
                               type="email"
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="E-posta adresinizi girin" 
                               readonly />
                        <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-award me-1"></i>Unvan
                        </label>
                        <input asp-for="Title" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Akademik unvanýnýz" 
                               required />
                        <span asp-validation-for="Title" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Department" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-graduation-cap me-1"></i>Bölüm
                        </label>
                        <input asp-for="Department" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark(text-gray-200" 
                               placeholder="Bölümünüz" 
                               required />
                        <span asp-validation-for="Department" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <button type="submit" class="mt-6 bg-gradient-to-r from-blue-500 to-purple-600 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105 font-medium">
                    <i class="fas fa-save me-2"></i>Bilgileri Güncelle
                </button>
                <button type="button" id="btnCancelEdit" class="ml-3 px-4 py-3 rounded-xl border">Ýptal</button>
            </form>
        </div>

        <!-- Change Password -->
        <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-6">
                <i class="fas fa-lock me-2"></i>Þifre Deðiþtir
            </h3>

            <form asp-action="ChangePassword" method="post" class="change-password-form">
                @Html.AntiForgeryToken()
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-key me-1"></i>Mevcut Þifre
                        </label>
                        <input type="password" 
                               name="CurrentPassword" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Mevcut þifrenizi girin" 
                               required />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-lock me-1"></i>Yeni Þifre
                        </label>
                        <input type="password" name="NewPassword" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" placeholder="Yeni þifrenizi girin (en az 6 karakter)" minlength="6" required />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-check-circle me-1"></i>Yeni Þifre Tekrar
                        </label>
                        <input type="password" name="ConfirmPassword" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" placeholder="Yeni þifrenizi tekrar girin" required />
                    </div>
                </div>

                <button type="submit" class="mt-6 bg-gradient-to-r from-green-500 to-green-600 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105 font-medium">
                    <i class="fas fa-shield-alt me-2"></i>Þifreyi Güncelle
                </button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/advisor/profile.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/advisor/profile.js" asp-append-version="true"></script>
}
