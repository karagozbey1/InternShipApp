@using Core.Entity
@model WebUI.Models.ViewModels.Advisor.AdvisorApplicationListViewModel
@{
    ViewData["Title"] = "Staj Baþvurularý";
    Layout = "_AppLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdvisorCss/advisor-theme.css" asp-append-version="true" />
}

<div class="space-y-6">
    <!-- Premium Hero Header -->
    <div class="advisor-hero-header animate-fade-in-up">
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur flex items-center justify-center">
                        <i class="fas fa-clipboard-list text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl lg:text-3xl font-bold text-white">Staj Baþvurularý</h1>
                        <p class="text-white/70 text-sm">Öðrenci staj onay formlarýný yönetin</p>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <div class="px-4 py-2 rounded-xl bg-white/10 backdrop-blur border border-white/20">
                    <span class="text-white/70 text-sm">Bugün</span>
                    <p class="text-white font-semibold">@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                </div>
                <button onclick="refreshPage()" class="btn-premium btn-premium-glass">
                    <i class="fas fa-sync-alt"></i>
                    <span class="hidden sm:inline">Yenile</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Premium Ýstatistik Kartlarý -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="advisor-stat-card-premium animate-fade-in-up stagger-1">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Toplam</p>
                    <p class="advisor-stat-value">@Model.TotalCount</p>
                </div>
                <div class="advisor-stat-icon" style="background: var(--gradient-info);">
                    <i class="fas fa-clipboard-list"></i>
                </div>
            </div>
            <div class="mt-3 flex items-center text-xs text-gray-500">
                <i class="fas fa-chart-line mr-1"></i>
                <span>Tüm baþvurular</span>
            </div>
        </div>

        <div class="advisor-stat-card-premium animate-fade-in-up stagger-2">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Beklemede</p>
                    <p class="advisor-stat-value" style="background: linear-gradient(135deg, #f59e0b, #d97706); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@Model.PendingCount</p>
                </div>
                <div class="advisor-stat-icon" style="background: var(--gradient-warning);">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
            <div class="mt-3 flex items-center text-xs text-yellow-600">
                <i class="fas fa-exclamation-circle mr-1"></i>
                <span>Ýnceleme bekliyor</span>
            </div>
        </div>

        <div class="advisor-stat-card-premium animate-fade-in-up stagger-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Onaylý</p>
                    <p class="advisor-stat-value" style="background: linear-gradient(135deg, #10b981, #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@Model.ApprovedCount</p>
                </div>
                <div class="advisor-stat-icon" style="background: var(--gradient-success);">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <div class="mt-3 flex items-center text-xs text-green-600">
                <i class="fas fa-thumbs-up mr-1"></i>
                <span>Baþarýyla onaylandý</span>
            </div>
        </div>

        <div class="advisor-stat-card-premium animate-fade-in-up stagger-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Revizyon</p>
                    <p class="advisor-stat-value" style="background: linear-gradient(135deg, #f97316, #ea580c); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@Model.RevisionCount</p>
                </div>
                <div class="advisor-stat-icon" style="background: linear-gradient(135deg, #f97316, #ea580c);">
                    <i class="fas fa-edit"></i>
                </div>
            </div>
            <div class="mt-3 flex items-center text-xs text-orange-600">
                <i class="fas fa-redo mr-1"></i>
                <span>Düzeltme bekliyor</span>
            </div>
        </div>

        <div class="advisor-stat-card-premium animate-fade-in-up stagger-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Reddedilen</p>
                    <p class="advisor-stat-value" style="background: linear-gradient(135deg, #ef4444, #dc2626); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@Model.RejectedCount</p>
                </div>
                <div class="advisor-stat-icon" style="background: var(--gradient-danger);">
                    <i class="fas fa-times-circle"></i>
                </div>
            </div>
            <div class="mt-3 flex items-center text-xs text-red-600">
                <i class="fas fa-ban mr-1"></i>
                <span>Uygun bulunmadý</span>
            </div>
        </div>
    </div>

    <!-- Premium Filtre Alaný -->
    <div class="filter-section-premium animate-fade-in-up">
        <form asp-action="Index" method="get" class="space-y-4">
            <div class="flex flex-col lg:flex-row gap-4">
                <div class="flex-1">
                    <div class="relative">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" 
                               class="filter-input-premium pl-11"
                               placeholder="Öðrenci adý, þirket adý veya numara ara...">
                    </div>
                </div>
                
                <div class="flex flex-wrap gap-3">
                    <select name="statusFilter" class="filter-input-premium w-full sm:w-48">
                        <option value="">Tüm Durumlar</option>
                        <option value="@InternshipApprovalStatus.Pending" selected="@(Model.StatusFilter == InternshipApprovalStatus.Pending)">? Beklemede</option>
                        <option value="@InternshipApprovalStatus.Approved" selected="@(Model.StatusFilter == InternshipApprovalStatus.Approved)">? Onaylý</option>
                        <option value="@InternshipApprovalStatus.Revision" selected="@(Model.StatusFilter == InternshipApprovalStatus.Revision)">?? Revizyon</option>
                        <option value="@InternshipApprovalStatus.Rejected" selected="@(Model.StatusFilter == InternshipApprovalStatus.Rejected)">? Reddedildi</option>
                    </select>
                    
                    <button type="submit" class="btn-premium btn-premium-primary">
                        <i class="fas fa-filter"></i>
                        Filtrele
                    </button>
                    
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue)
                    {
                        <a asp-action="Index" class="btn-premium btn-premium-outline">
                            <i class="fas fa-times"></i>
                            Temizle
                        </a>
                    }
                </div>
            </div>
            
            <!-- Hýzlý Filtre Butonlarý -->
            <div class="flex flex-wrap gap-2 pt-2 border-t border-gray-100 dark:border-gray-700">
                <span class="text-sm text-gray-500 mr-2 py-1">Hýzlý Filtre:</span>
                <a href="@Url.Action("Index")" class="px-3 py-1 rounded-full text-sm font-medium transition-all @(Model.StatusFilter == null ? "bg-indigo-100 text-indigo-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                    Tümü (@Model.TotalCount)
                </a>
                <a href="@Url.Action("Index", new { statusFilter = InternshipApprovalStatus.Pending })" class="px-3 py-1 rounded-full text-sm font-medium transition-all @(Model.StatusFilter == InternshipApprovalStatus.Pending ? "bg-yellow-100 text-yellow-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                    <i class="fas fa-clock mr-1"></i>Beklemede (@Model.PendingCount)
                </a>
                <a href="@Url.Action("Index", new { statusFilter = InternshipApprovalStatus.Revision })" class="px-3 py-1 rounded-full text-sm font-medium transition-all @(Model.StatusFilter == InternshipApprovalStatus.Revision ? "bg-orange-100 text-orange-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                    <i class="fas fa-edit mr-1"></i>Revizyon (@Model.RevisionCount)
                </a>
            </div>
        </form>
    </div>

    <!-- Baþvuru Kartlarý -->
    <div class="space-y-4" id="applicationsContainer">
        @if (Model.Applications.Any())
        {
            @foreach (var application in Model.Applications)
            {
                var initials = string.Join("", application.StudentName.Split(' ').Where(n => !string.IsNullOrEmpty(n)).Select(n => n[0]).Take(2)).ToUpper();
                
                <a href="@Url.Action("ApplicationDetail", "AdvisorApplication", new { id = application.Id })" 
                   class="application-card-premium status-@application.Status.ToString().ToLower() block animate-fade-in-up">
                    <div class="flex flex-col lg:flex-row lg:items-center gap-4">
                        <!-- Öðrenci Bilgileri -->
                        <div class="flex items-center gap-4 flex-1 min-w-0">
                            <div class="application-avatar">@initials</div>
                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2 mb-1">
                                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white truncate">@application.StudentName</h3>
                                    <span class="badge-premium badge-@application.Status.ToString().ToLower()">
                                        <i class="@application.StatusIcon"></i>
                                        @application.StatusText
                                    </span>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
                                    <span><i class="fas fa-id-card mr-1"></i>@application.StudentNumber</span>
                                    <span><i class="fas fa-envelope mr-1"></i>@application.StudentEmail</span>
                                    @if (!string.IsNullOrEmpty(application.StudentDepartment))
                                    {
                                        <span><i class="fas fa-graduation-cap mr-1"></i>@application.StudentDepartment</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Þirket ve Staj Bilgileri -->
                        <div class="flex-1 lg:border-l lg:border-gray-200 lg:dark:border-gray-700 lg:pl-4">
                            <div class="flex items-start gap-3">
                                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center text-white flex-shrink-0">
                                    <i class="fas fa-building"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-semibold text-gray-800 dark:text-gray-200 truncate">@application.CompanyName</h4>
                                    <p class="text-sm text-gray-500 dark:text-gray-400 truncate">@application.Position</p>
                                    <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-gray-500">
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-calendar-alt"></i>
                                            @application.StartDate.ToString("dd MMM") - @application.EndDate.ToString("dd MMM yyyy")
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-clock"></i>
                                            @application.WeeklyWorkHours sa/hafta
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <i class="fas fa-hourglass-half"></i>
                                            @application.DurationDays gün
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tarih ve Aksiyonlar -->
                        <div class="flex items-center justify-between lg:flex-col lg:items-end gap-3">
                            <div class="text-right">
                                <p class="text-xs text-gray-400">@application.DaysFromSubmission gün önce</p>
                                <p class="text-sm font-medium text-gray-600 dark:text-gray-300">@application.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                            
                            @if (application.Status == InternshipApprovalStatus.Pending)
                            {
                                <div class="flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation();">
                                    <button onclick="showApproveModal(@application.Id, '@application.StudentName', '@application.CompanyName')"
                                            class="application-action-btn approve" title="Onayla">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button onclick="showRevisionModal(@application.Id, '@application.StudentName', '@application.CompanyName')"
                                            class="application-action-btn revision" title="Revizyon Ýste">
                                        <i class="fas fa-undo"></i>
                                    </button>
                                    <button onclick="showRejectModal(@application.Id, '@application.StudentName', '@application.CompanyName')"
                                            class="application-action-btn reject" title="Reddet">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="text-right">
                                    @if (application.Status == InternshipApprovalStatus.Approved && application.ApprovedAt.HasValue)
                                    {
                                        <span class="text-sm text-green-600 font-medium">
                                            <i class="fas fa-check-circle mr-1"></i>@application.ApprovedAt.Value.ToString("dd.MM.yyyy")
                                        </span>
                                    }
                                    else if (application.Status == InternshipApprovalStatus.Rejected && application.RejectedAt.HasValue)
                                    {
                                        <span class="text-sm text-red-600 font-medium">
                                            <i class="fas fa-times-circle mr-1"></i>@application.RejectedAt.Value.ToString("dd.MM.yyyy")
                                        </span>
                                    }
                                    else if (application.Status == InternshipApprovalStatus.Revision && application.RevisedAt.HasValue)
                                    {
                                        <span class="text-sm text-orange-600 font-medium">
                                            <i class="fas fa-edit mr-1"></i>@application.RevisedAt.Value.ToString("dd.MM.yyyy")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    
                    @if (application.Status == InternshipApprovalStatus.Revision && !string.IsNullOrEmpty(application.RevisionNote))
                    {
                        <div class="mt-4 p-3 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl">
                            <p class="text-xs font-semibold text-orange-700 dark:text-orange-300 mb-1">
                                <i class="fas fa-info-circle mr-1"></i>Revizyon Notu:
                            </p>
                            <p class="text-sm text-orange-800 dark:text-orange-200">@application.RevisionNote</p>
                        </div>
                    }
                </a>
            }
        }
        else
        {
            <div class="empty-state-premium animate-fade-in-up">
                <div class="empty-state-icon">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <h3 class="empty-state-title">Baþvuru Bulunamadý</h3>
                <p class="empty-state-description">
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue)
                    {
                        <span>Arama kriterlerinize uygun baþvuru bulunamadý. Filtreleri deðiþtirerek tekrar deneyin.</span>
                    }
                    else
                    {
                        <span>Henüz öðrencilerinizden staj onay formu gönderilmemiþ.</span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue)
                {
                    <a asp-action="Index" class="btn-premium btn-premium-primary mt-4">
                        <i class="fas fa-undo mr-2"></i>Filtreleri Temizle
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- Onay/Revizyon/Red Modalleri -->
@await Html.PartialAsync("_ActionModals")

@section Scripts {
    <script>
        // Sayfa yenileme
        function refreshPage() {
            location.reload();
        }
        
        // 60 saniyede bir otomatik yenileme (modal açýk deðilse)
        setInterval(function() {
            if (!document.querySelector('.modal-premium-overlay.active')) {
                // Silent refresh - sadece verileri güncelle
                console.log('Veriler kontrol ediliyor...');
            }
        }, 60000);
        
        // Animasyonlarý tetikle
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.animate-fade-in-up').forEach((el, index) => {
                el.style.opacity = '1';
            });
        });
    </script>
}
