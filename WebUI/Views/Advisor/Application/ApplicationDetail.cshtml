@model WebUI.Models.ViewModels.Advisor.AdvisorApplicationCardViewModel
@{
    ViewData["Title"] = "Basvuru Detayi";
    Layout = "_AppLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdvisorCss/advisor-theme.css" asp-append-version="true" />
    <style>
        .application-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            border-radius: 24px;
            padding: 2.5rem 2rem;
            position: relative;
            overflow: hidden;
        }
        .application-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        }
        .status-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
        .status-card:hover {
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.1);
        }
        .status-card-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
        }
        .action-btn-approve {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            border: none;
            padding: 1rem 1.5rem;
            border-radius: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .action-btn-approve:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
        }
        .action-btn-revision {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            border: none;
            padding: 1rem 1.5rem;
            border-radius: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .action-btn-revision:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(245, 158, 11, 0.4);
        }
        .action-btn-reject {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            border: none;
            padding: 1rem 1.5rem;
            border-radius: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .action-btn-reject:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(239, 68, 68, 0.4);
        }
        .info-block {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }
        .info-block-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        .info-block-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .revision-alert {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(217, 119, 6, 0.1) 100%);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            padding: 1.5rem;
        }
        .rejection-alert {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
            border: 2px solid #ef4444;
            border-radius: 16px;
            padding: 1.5rem;
        }
        .dark .status-card {
            background: rgba(30, 41, 59, 0.95);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .dark .info-block {
            background: rgba(30, 41, 59, 0.9);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .timeline-vertical {
            position: relative;
            padding-left: 2rem;
        }
        .timeline-vertical::before {
            content: '';
            position: absolute;
            left: 0.5rem;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(180deg, #6366f1 0%, #a855f7 100%);
        }
        .timeline-item {
            position: relative;
            padding-bottom: 1.5rem;
        }
        .timeline-item::after {
            content: '';
            position: absolute;
            left: -1.5rem;
            top: 0;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #6366f1;
            border: 3px solid white;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }
    </style>
}

<div class="space-y-6">
    <!-- Geri Butonu -->
    <div class="flex items-center justify-between animate-fade-in-up">
        <a asp-action="Index" class="btn-premium btn-premium-outline">
            <i class="fas fa-arrow-left"></i>
            Basvurulara Don
        </a>
        <div class="flex gap-3">
            <a asp-controller="Chat" asp-action="Index" class="btn-premium btn-premium-success">
                <i class="fas fa-comments"></i>
                Mesaj Gonder
            </a>
        </div>
    </div>

    <!-- Hero Section -->
    <div class="application-hero animate-fade-in-up">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-6">
            <div class="w-20 h-20 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center">
                <i class="fas fa-file-alt text-white text-3xl"></i>
            </div>
            <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-2">
                    <h1 class="text-2xl md:text-3xl font-bold text-white">@Model.StudentName</h1>
                    @{
                        var statusClass = Model.Status switch
                        {
                            Core.Entity.InternshipApprovalStatus.Approved => "bg-green-500",
                            Core.Entity.InternshipApprovalStatus.Rejected => "bg-red-500",
                            Core.Entity.InternshipApprovalStatus.Revision => "bg-orange-500",
                            _ => "bg-yellow-500"
                        };
                    }
                    <span class="px-4 py-1.5 rounded-full text-sm font-semibold text-white @statusClass">
                        <i class="@Model.StatusIcon mr-1"></i>@Model.StatusText
                    </span>
                </div>
                <p class="text-white/80 text-lg mb-3">@Model.CompanyName - @Model.Position</p>
                <div class="flex flex-wrap gap-3">
                    @if (!string.IsNullOrEmpty(Model.StudentUniversity))
                    {
                        <span class="px-3 py-1.5 rounded-full bg-white/20 text-white text-sm backdrop-blur">
                            <i class="fas fa-university mr-1"></i>@Model.StudentUniversity
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.StudentDepartment))
                    {
                        <span class="px-3 py-1.5 rounded-full bg-white/20 text-white text-sm backdrop-blur">
                            <i class="fas fa-graduation-cap mr-1"></i>@Model.StudentDepartment
                        </span>
                    }
                    <span class="px-3 py-1.5 rounded-full bg-white/20 text-white text-sm backdrop-blur">
                        <i class="fas fa-calendar mr-1"></i>@Model.CreatedAt.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>
            
            <!-- Hizli Istatistikler -->
            <div class="grid grid-cols-2 gap-3">
                <div class="px-4 py-3 rounded-xl bg-white/10 backdrop-blur border border-white/20 text-center">
                    <p class="text-2xl font-bold text-white">@Model.DurationDays</p>
                    <span class="text-white/70 text-xs">Gun</span>
                </div>
                <div class="px-4 py-3 rounded-xl bg-white/10 backdrop-blur border border-white/20 text-center">
                    <p class="text-2xl font-bold text-white">@Model.WeeklyWorkHours</p>
                    <span class="text-white/70 text-xs">Saat/Hafta</span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Sol Kolon - Ana Icerik -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Ogrenci Bilgileri -->
            <div class="info-block animate-fade-in-up">
                <div class="info-block-header">
                    <div class="info-block-icon bg-indigo-100 dark:bg-indigo-900/50">
                        <i class="fas fa-user-graduate text-indigo-600"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Ogrenci Bilgileri</h3>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Ogrenci No</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@Model.StudentNumber</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Universite</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@(Model.StudentUniversity ?? "-")</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Bolum</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@(Model.StudentDepartment ?? "-")</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Sinif</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@(Model.StudentGrade.HasValue ? Model.StudentGrade + ". Sinif" : "-")</p>
                    </div>
                </div>
            </div>

            <!-- Staj Bilgileri -->
            <div class="info-block animate-fade-in-up">
                <div class="info-block-header">
                    <div class="info-block-icon bg-purple-100 dark:bg-purple-900/50">
                        <i class="fas fa-briefcase text-purple-600"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Staj Bilgileri</h3>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Sirket</p>
                        <p class="font-semibold text-gray-900 dark:text-white text-lg">@Model.CompanyName</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Pozisyon</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@Model.Position</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Haftalik Saat</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@Model.WeeklyWorkHours saat</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Baslangic</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@Model.StartDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Bitis</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@Model.EndDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Toplam Sure</p>
                        <p class="font-semibold text-gray-900 dark:text-white">@Model.DurationDays gun</p>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.WorkplaceAddress))
                {
                    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                        <p class="text-xs text-gray-500 mb-1">Is Yeri Adresi</p>
                        <p class="text-gray-900 dark:text-white">@Model.WorkplaceAddress</p>
                    </div>
                }
            </div>

            <!-- Koordinator Bilgileri -->
            @if (!string.IsNullOrEmpty(Model.InternshipCoordinator))
            {
                <div class="info-block animate-fade-in-up">
                    <div class="info-block-header">
                        <div class="info-block-icon bg-green-100 dark:bg-green-900/50">
                            <i class="fas fa-user-tie text-green-600"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Staj Koordinatoru</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <p class="text-xs text-gray-500 mb-1">Ad Soyad</p>
                            <p class="font-semibold text-gray-900 dark:text-white">@Model.InternshipCoordinator</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.CoordinatorEmail))
                        {
                            <div>
                                <p class="text-xs text-gray-500 mb-1">E-posta</p>
                                <a href="mailto:@Model.CoordinatorEmail" class="font-semibold text-indigo-600 hover:text-indigo-800">@Model.CoordinatorEmail</a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.CoordinatorPhone))
                        {
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Telefon</p>
                                <a href="tel:@Model.CoordinatorPhone" class="font-semibold text-indigo-600 hover:text-indigo-800">@Model.CoordinatorPhone</a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Ogrenci Notu -->
            @if (!string.IsNullOrEmpty(Model.StudentNote))
            {
                <div class="info-block animate-fade-in-up">
                    <div class="info-block-header">
                        <div class="info-block-icon bg-blue-100 dark:bg-blue-900/50">
                            <i class="fas fa-sticky-note text-blue-600"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Ogrenci Notu</h3>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 border-l-4 border-blue-500">
                        <p class="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line">@Model.StudentNote</p>
                    </div>
                </div>
            }

            <!-- Danisman Notu -->
            @if (!string.IsNullOrEmpty(Model.AdvisorNote))
            {
                <div class="info-block animate-fade-in-up">
                    <div class="info-block-header">
                        <div class="info-block-icon bg-purple-100 dark:bg-purple-900/50">
                            <i class="fas fa-comment-dots text-purple-600"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Danisman Notu</h3>
                    </div>
                    <div class="bg-purple-50 dark:bg-purple-900/20 rounded-xl p-4 border-l-4 border-purple-500">
                        <p class="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line">@Model.AdvisorNote</p>
                    </div>
                </div>
            }

            <!-- Revizyon Notu -->
            @if (!string.IsNullOrEmpty(Model.RevisionNote))
            {
                <div class="revision-alert animate-fade-in-up">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-edit text-orange-600 text-xl"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-bold text-orange-800 dark:text-orange-200 mb-2">Revizyon Notu</h4>
                            <p class="text-orange-700 dark:text-orange-300 leading-relaxed whitespace-pre-line">@Model.RevisionNote</p>
                            @if (Model.RevisedAt.HasValue)
                            {
                                <p class="text-orange-600 text-sm mt-3">
                                    <i class="fas fa-clock mr-1"></i>@Model.RevisedAt.Value.ToString("dd.MM.yyyy HH:mm")
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Red Nedeni -->
            @if (!string.IsNullOrEmpty(Model.RejectionReason) && Model.Status == Core.Entity.InternshipApprovalStatus.Rejected)
            {
                <div class="rejection-alert animate-fade-in-up">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-times-circle text-red-600 text-xl"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-bold text-red-800 dark:text-red-200 mb-2">Red Nedeni</h4>
                            <p class="text-red-700 dark:text-red-300 leading-relaxed whitespace-pre-line">@Model.RejectionReason</p>
                            @if (Model.RejectedAt.HasValue)
                            {
                                <p class="text-red-600 text-sm mt-3">
                                    <i class="fas fa-clock mr-1"></i>@Model.RejectedAt.Value.ToString("dd.MM.yyyy HH:mm")
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sag Kolon -->
        <div class="space-y-6">
            <!-- Durum Yonetimi -->
            <div class="status-card animate-fade-in-up">
                <div class="status-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-tasks mr-2 text-indigo-500"></i>
                        Durum Yonetimi
                    </h3>
                </div>
                <div class="p-6 space-y-4">
                    @if (Model.Status == Core.Entity.InternshipApprovalStatus.Pending)
                    {
                        <button onclick="showApproveModal(@Model.Id, '@Model.StudentName', '@Model.CompanyName')" class="action-btn-approve">
                            <i class="fas fa-check-circle text-lg"></i>
                            <span>Onayla</span>
                        </button>
                        <button onclick="showRevisionModal(@Model.Id, '@Model.StudentName', '@Model.CompanyName')" class="action-btn-revision">
                            <i class="fas fa-undo text-lg"></i>
                            <span>Revizyon Iste</span>
                        </button>
                        <button onclick="showRejectModal(@Model.Id, '@Model.StudentName', '@Model.CompanyName')" class="action-btn-reject">
                            <i class="fas fa-times-circle text-lg"></i>
                            <span>Reddet</span>
                        </button>
                    }
                    else if (Model.Status == Core.Entity.InternshipApprovalStatus.Approved)
                    {
                        <div class="p-4 rounded-xl bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/30 dark:to-emerald-900/30 border border-green-200 dark:border-green-700">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center">
                                    <i class="fas fa-check-circle text-green-600 text-lg"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-green-800 dark:text-green-200">Onaylandi</p>
                                    @if (Model.ApprovedAt.HasValue)
                                    {
                                        <p class="text-green-600 text-sm">@Model.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.Status == Core.Entity.InternshipApprovalStatus.Revision)
                    {
                        <div class="p-4 rounded-xl bg-gradient-to-r from-orange-50 to-amber-50 dark:from-orange-900/30 dark:to-amber-900/30 border border-orange-200 dark:border-orange-700">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/50 flex items-center justify-center">
                                    <i class="fas fa-edit text-orange-600 text-lg"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-orange-800 dark:text-orange-200">Revizyon Bekleniyor</p>
                                    <p class="text-orange-600 text-sm">Ogrenci duzeltme yapabilir</p>
                                </div>
                            </div>
                        </div>
                        <button onclick="showApproveModal(@Model.Id, '@Model.StudentName', '@Model.CompanyName')" class="action-btn-approve">
                            <i class="fas fa-check-circle text-lg"></i>
                            <span>Simdi Onayla</span>
                        </button>
                    }
                    else if (Model.Status == Core.Entity.InternshipApprovalStatus.Rejected)
                    {
                        <div class="p-4 rounded-xl bg-gradient-to-r from-red-50 to-pink-50 dark:from-red-900/30 dark:to-pink-900/30 border border-red-200 dark:border-red-700">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 rounded-full bg-red-100 dark:bg-red-900/50 flex items-center justify-center">
                                    <i class="fas fa-times-circle text-red-600 text-lg"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-red-800 dark:text-red-200">Reddedildi</p>
                                    @if (Model.RejectedAt.HasValue)
                                    {
                                        <p class="text-red-600 text-sm">@Model.RejectedAt.Value.ToString("dd.MM.yyyy HH:mm")</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Iletisim -->
            <div class="status-card animate-fade-in-up">
                <div class="status-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-envelope mr-2 text-indigo-500"></i>
                        Iletisim
                    </h3>
                </div>
                <div class="p-6 space-y-3">
                    <a href="mailto:@Model.StudentEmail" class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors group">
                        <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center group-hover:bg-indigo-200">
                            <i class="fas fa-envelope text-indigo-600"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-gray-500">E-posta</p>
                            <p class="font-medium text-indigo-600 truncate">@Model.StudentEmail</p>
                        </div>
                    </a>
                    <a asp-controller="Chat" asp-action="Index" class="w-full btn-premium btn-premium-primary py-3">
                        <i class="fas fa-comments"></i>
                        Mesaj Gonder
                    </a>
                </div>
            </div>

            <!-- Belgeler -->
            <div class="status-card animate-fade-in-up">
                <div class="status-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-paperclip mr-2 text-indigo-500"></i>
                        Basvuru Belgeleri
                    </h3>
                </div>
                <div id="approvalDocuments" class="p-6">
                    <div class="text-center py-4">
                        <i class="fas fa-spinner fa-spin text-indigo-500 text-xl mb-2"></i>
                        <p class="text-gray-500 text-sm">Belgeler yukleniyor...</p>
                    </div>
                </div>
            </div>

            <!-- Zaman Cizelgesi -->
            <div class="status-card animate-fade-in-up">
                <div class="status-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-history mr-2 text-indigo-500"></i>
                        Zaman Cizelgesi
                    </h3>
                </div>
                <div class="p-6">
                    <div class="timeline-vertical">
                        <div class="timeline-item">
                            <p class="text-sm font-semibold text-gray-900 dark:text-white">Basvuru Olusturuldu</p>
                            <p class="text-xs text-gray-500">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                        @if (Model.RevisedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <p class="text-sm font-semibold text-orange-600">Revizyon Istendi</p>
                                <p class="text-xs text-gray-500">@Model.RevisedAt.Value.ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                        }
                        @if (Model.ApprovedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <p class="text-sm font-semibold text-green-600">Onaylandi</p>
                                <p class="text-xs text-gray-500">@Model.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                        }
                        @if (Model.RejectedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <p class="text-sm font-semibold text-red-600">Reddedildi</p>
                                <p class="text-xs text-gray-500">@Model.RejectedAt.Value.ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ActionModals")

@section Scripts {
    <script>
        async function loadApprovalDocuments() {
            try {
                const response = await fetch('/Document/GetStudentDocuments?approvalId=@Model.Id');
                if (!response.ok) throw new Error('Belge istegi basarisiz');
                const docs = await response.json();
                const container = document.getElementById('approvalDocuments');
                if (!docs || docs.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-4">
                            <i class="fas fa-folder-open text-3xl text-gray-300 dark:text-gray-600 mb-2"></i>
                            <p class="text-gray-500 text-sm">Belge bulunamadi</p>
                        </div>`;
                    return;
                }
                container.innerHTML = docs.map(d => `
                    <div class="flex items-center justify-between p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-colors mb-2">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center">
                                <i class="fas fa-file-pdf text-indigo-600"></i>
                            </div>
                            <div>
                                <p class="font-medium text-gray-900 dark:text-white text-sm">${d.title || d.fileName}</p>
                                <p class="text-xs text-gray-500">${d.documentType || 'Belge'}</p>
                            </div>
                        </div>
                        <a href="${d.filePath}" target="_blank" class="w-8 h-8 rounded-lg bg-indigo-100 hover:bg-indigo-200 flex items-center justify-center transition-colors">
                            <i class="fas fa-download text-indigo-600 text-sm"></i>
                        </a>
                    </div>`).join('');
            } catch (e) {
                document.getElementById('approvalDocuments').innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-exclamation-circle text-3xl text-red-400 mb-2"></i>
                        <p class="text-red-500 text-sm">Belgeler yuklenirken hata olustu</p>
                    </div>`;
            }
        }
        document.addEventListener('DOMContentLoaded', loadApprovalDocuments);
    </script>
}
