@model WebUI.Models.ViewModels.Advisor.AdvisorStudentListViewModel
@{
    ViewData["Title"] = "Öðrencilerim";
    Layout = "_AppLayout";
}
<div class="space-y-6" x-data="advisorStudents()">
    <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-lg dark:from-blue-900/20 dark:to-indigo-900/20 dark:border-blue-700">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-1">
                    <i class="fas fa-users mr-2"></i>Öðrencilerim
                </h1>
                <p class="text-blue-600 dark:text-blue-300 text-sm">Üniversite ve bölüm bazlý danýþmanlýk kapsamýndaki öðrenciler</p>
            </div>
            <div class="flex flex-wrap gap-3 text-sm">
                <div class="px-3 py-2 bg-white dark:bg-gray-800 rounded-xl shadow flex items-center gap-2"><span class="text-gray-500">Toplam</span><span class="font-semibold text-blue-600">@Model.TotalItems</span></div>
                <div class="px-3 py-2 bg-white dark:bg-gray-800 rounded-xl shadow flex items-center gap-2"><span class="text-gray-500">Aktif</span><span class="font-semibold text-green-600">@Model.ActiveCount</span></div>
                <div class="px-3 py-2 bg-white dark:bg-gray-800 rounded-xl shadow flex items-center gap-2"><span class="text-gray-500">Pasif</span><span class="font-semibold text-red-600">@Model.PassiveCount</span></div>
                <div class="px-3 py-2 bg-white dark:bg-gray-800 rounded-xl shadow flex items-center gap-2"><span class="text-gray-500">Staj (Onaylý)</span><span class="font-semibold text-indigo-600">@Model.WithApprovedInternship</span></div>
                <div class="px-3 py-2 bg-white dark:bg-gray-800 rounded-xl shadow flex items-center gap-2"><span class="text-gray-500">Bekleyen Baþvuru</span><span class="font-semibold text-yellow-600">@Model.WithPendingApplications</span></div>
            </div>
        </div>
    </div>

    <form method="get" class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/60 dark:border-gray-700 flex flex-col gap-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Ara</label>
                <input name="Filters.Search" value="@Model.Filters.Search" placeholder="Ad / e-posta" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Bölüm</label>
                <input name="Filters.Department" value="@Model.Filters.Department" placeholder="Bölüm" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Sýnýf</label>
                <input name="Filters.Grade" value="@(Model.Filters.Grade?.ToString() ?? "")" type="number" min="1" max="8" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Durum</label>
                <select name="Filters.Status" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm">
                    <option value="">Tümü</option>
                    <option value="active" selected="@(Model.Filters.Status=="active")">Aktif</option>
                    <option value="passive" selected="@(Model.Filters.Status=="passive")">Pasif</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Sýrala</label>
                <select name="Filters.Sort" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm">
                    <option value="lastActivity" selected="@(Model.Filters.Sort=="lastActivity")">Son Aktivite</option>
                    <option value="name" selected="@(Model.Filters.Sort=="name")">Ad</option>
                    <option value="applications" selected="@(Model.Filters.Sort=="applications")">Baþvuru</option>
                    <option value="diaries" selected="@(Model.Filters.Sort=="diaries")">Defter Girdisi</option>
                </select>
            </div>
        </div>
        <div class="flex items-center flex-wrap gap-3 justify-between">
            <div class="flex items-center gap-2 text-xs">
                <label class="flex items-center gap-1 cursor-pointer select-none">
                    <span>Artan</span>
                    <input type="radio" name="Filters.Order" value="asc" @(Model.Filters.Order=="asc"?"checked":null) />
                </label>
                <label class="flex items-center gap-1 cursor-pointer select-none">
                    <span>Azalan</span>
                    <input type="radio" name="Filters.Order" value="desc" @(Model.Filters.Order!="asc"?"checked":null) />
                </label>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg text-sm font-medium shadow">
                    <i class="fas fa-search mr-2"></i>Uygula
                </button>
                <a asp-action="Index" class="px-6 py-3 bg-gray-500 hover:bg-gray-600 text-white rounded-lg text-sm font-medium shadow">
                    <i class="fas fa-undo mr-2"></i>Temizle
                </a>
            </div>
        </div>
    </form>

    <div class="space-y-6">
        @if (Model.Students.Any())
        {
            <div class="flex justify-between items-center">
                <div class="text-sm text-gray-500" id="listInfo"></div>
                <div class="flex gap-2" id="bulkActions" style="display:none;">
                    <button type="button" onclick="openBulkNotify()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium">
                        <i class="fas fa-paper-plane mr-1"></i>Toplu Bildirim
                    </button>
                    <span class="text-xs text-gray-500" x-text="selectedIds.size + ' seçili'"></span>
                </div>
            </div>
            <div id="ajaxStudentGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-6">
                @if (Model.Students.Any())
                {
                    foreach (var s in Model.Students)
                    {
                        <div class="ss-card relative p-5 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm hover:shadow-lg transition-all duration-300" data-id="@s.Id">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center text-white font-bold text-sm">@((s.FullName??"?").Split(' ').Take(2).Aggregate("",(acc,p)=>acc + (string.IsNullOrEmpty(p)?"":p[0].ToString())).ToUpper())</div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-semibold text-gray-900 dark:text-white text-sm">@s.FullName</h3>
                                    <p class="text-xs text-indigo-600 dark:text-indigo-300 font-medium">@(s.StudentNumber ?? "-")</p>
                                    <div class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-[11px] text-gray-600 dark:text-gray-300">
                                        <div><span class="text-gray-400">Üniversite:</span><br/><span class="font-medium">@(s.UniversityName ?? "-")</span></div>
                                        <div><span class="text-gray-400">Bölüm:</span><br/><span class="font-medium">@(s.Department ?? "-")</span></div>
                                        <div><span class="text-gray-400">Sýnýf:</span><br/><span class="font-medium">@(s.Grade?.ToString() ?? "-")</span></div>
                                        <div><span class="text-gray-400">Durum:</span><br/><span class="font-medium @(s.IsActive?"text-green-600":"text-red-600")">@(s.IsActive?"Aktif":"Pasif")</span></div>
                                    </div>
                                </div>
                                <div class="text-right text-[10px] text-gray-400 whitespace-nowrap">@((s.LastActivity?.ToString("yyyy-MM-dd")) ?? "-")</div>
                            </div>
                            <div class="mt-4 flex gap-3">
                                <a asp-controller="Chat" asp-action="Index" asp-route-studentId="@s.Id" class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 rounded-lg border border-emerald-500 text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 text-xs font-medium">
                                    <i class="fas fa-envelope"></i><span>Ýletiþim</span>
                                </a>
                                <div class="flex items-center pl-2">
                                    <input type='checkbox' class='student-select w-4 h-4' data-id='@s.Id' />
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div id="loadingSpinner" class="text-center py-6 hidden">
                <i class="fas fa-spinner fa-spin text-blue-500 text-2xl"></i>
            </div>
            <div id="endMessage" class="text-center text-xs text-gray-400 py-4 hidden">Tüm kayýtlar yüklendi</div>
        }
        else
        {
            <div class="p-8 text-center bg-white/70 dark:bg-gray-800/60 rounded-2xl border border-dashed border-gray-300 dark:border-gray-600">
                <i class="fas fa-user-graduate text-gray-400 text-5xl mb-4"></i>
                <h3 class="text-lg font-semibold text-gray-600 dark:text-gray-400 mb-2">Öðrenci bulunamadý</h3>
                <p class="text-sm text-gray-500 dark:text-gray-500">Filtreleri deðiþtirerek tekrar deneyin.</p>
            </div>
        }
    </div>
</div>

<!-- Öðrenci Detay Modal -->
<div id="studentDetailModal" class="fixed inset-0 bg-black bg-opacity-40 hidden z-50 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-lg p-6 relative">
    <button class="absolute top-3 right-3 text-gray-400 hover:text-gray-600" onclick="closeStudentDetail()"><i class="fas fa-times"></i></button>
    <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200"><i class="fas fa-user-graduate text-blue-500 mr-2"></i>Öðrenci Detayý</h3>
    <div id="studentDetailContent" class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
      <div class="text-center py-8"><i class="fas fa-spinner fa-spin text-blue-500 text-2xl"></i></div>
    </div>
  </div>
</div>

<!-- Toplu Bildirim Modal -->
<div id="bulkNotifyModal" class="fixed inset-0 bg-black bg-opacity-40 hidden z-50 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-md p-6 relative">
    <button class="absolute top-3 right-3 text-gray-400 hover:text-gray-600" onclick="closeBulkNotify()"><i class="fas fa-times"></i></button>
    <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200"><i class="fas fa-paper-plane text-indigo-500 mr-2"></i>Toplu Bildirim</h3>
    <form id="bulkNotifyForm" onsubmit="sendBulkNotification(event)">
      @Html.AntiForgeryToken()
      <div class="mb-3">
        <label class="block text-xs font-medium mb-1">Baþlýk</label>
        <input name="title" required maxlength="150" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm" />
      </div>
      <div class="mb-4">
        <label class="block text-xs font-medium mb-1">Mesaj</label>
        <textarea name="message" required rows="4" maxlength="1000" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm"></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" class="px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg text-sm" onclick="closeBulkNotify()">Vazgeç</button>
        <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium"><i class="fas fa-paper-plane mr-1"></i>Gönder</button>
      </div>
    </form>
  </div>
</div>

@section Scripts{
<script>
const tokens = document.querySelector('input[name="__RequestVerificationToken"]');
function advisorStudents(){return {}};
let page=1, loading=false, totalPages=1, searchTimer=null; const pageSize=12; const selectedIds=new Set();
const grid=document.getElementById('ajaxStudentGrid');
const spinner=document.getElementById('loadingSpinner');
const endMsg=document.getElementById('endMessage');
const bulkActions=document.getElementById('bulkActions');
const listInfo=document.getElementById('listInfo');
function buildQuery(){const params=new URLSearchParams(new FormData(document.querySelector('form')));params.set('page',page);params.set('pageSize',pageSize);return '/AdvisorStudent/List?'+params.toString();"}
function cardHtml(s){return `<div class='ss-card relative p-5 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm hover:shadow-lg transition-all duration-300' data-id='${s.id}'><div class='flex items-start gap-4'><div class='w-12 h-12 rounded-full bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center text-white font-bold text-sm'>${(s.fullName||'?').split(' ').slice(0,2).map(x=>x?x[0]:'').join('').toUpperCase()}</div><div class='flex-1 min-w-0'><h3 class='font-semibold text-gray-900 dark:text-white text-sm'>${s.fullName}</h3><p class='text-xs text-indigo-600 dark:text-indigo-300 font-medium'>${s.studentNumber||'-'}</p><div class='mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-[11px] text-gray-600 dark:text-gray-300'><div><span class='text-gray-400'>Üniversite:</span><br/><span class='font-medium'>${s.universityName||'-'}</span></div><div><span class='text-gray-400'>Bölüm:</span><br/><span class='font-medium'>${s.department||'-'}</span></div><div><span class='text-gray-400'>Sýnýf:</span><br/><span class='font-medium'>${s.grade||'-'}</span></div><div><span class='text-gray-400'>Durum:</span><br/><span class='font-medium ${s.isActive?"text-green-600":"text-red-600"}'>${s.isActive?"Aktif":"Pasif"}</span></div></div></div><div class='text-right text-[10px] text-gray-400 whitespace-nowrap'>${s.lastActivity||'-'}</div></div><div class='mt-4 flex gap-3'><a href='/Chat/Index?studentId=${s.id}' class='flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 rounded-lg border border-emerald-500 text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 text-xs font-medium transition'><i class='fas fa-envelope'></i><span>Ýletiþim</span></a><div class='flex items-center pl-2'><input type='checkbox' class='student-select w-4 h-4' data-id='${s.id}' /></div></div></div>`;}
async function loadStudents(initial=false){ if(loading|| (page>totalPages && !initial)) return; loading=true; spinner.classList.remove('hidden'); try{ const res=await fetch(buildQuery()); const data=await res.json(); if(!data.success) return; totalPages=data.totalPages; if(initial && page===2) { listInfo.textContent=`Sayfa 1/${data.totalPages} - Toplam ${data.total}`; } else { listInfo.textContent=`Sayfa ${data.page}/${data.totalPages} - Toplam ${data.total}`; data.students.forEach(s=>{ if(document.querySelector(`.ss-card[data-id='${s.id}']`)) return; grid.insertAdjacentHTML('beforeend', cardHtml(s)); }); attachSelectionHandlers(); } if(page>=totalPages){endMsg.classList.remove('hidden');} page++; } finally {loading=false; spinner.classList.add('hidden'); }}
// Initial load: server rendered first page already, so just load remaining pages lazily
page = 2; // because first page rendered
// Fetch metadata silently to get total pages if only 1 item
loadStudents(true);
</script>
}
