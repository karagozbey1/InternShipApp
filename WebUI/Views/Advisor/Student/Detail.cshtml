@model WebUI.Models.ViewModels.Advisor.AdvisorStudentDetailViewModel
@{
    ViewData["Title"] = "Ogrenci Detayi - " + Model.Student.FullName;
    Layout = "_AppLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdvisorCss/advisor-theme.css" asp-append-version="true" />
    <style>
        .student-profile-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            border-radius: 24px;
            padding: 3rem 2rem;
            position: relative;
            overflow: hidden;
        }
        .student-profile-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        }
        .student-avatar-xl {
            width: 130px;
            height: 130px;
            border-radius: 32px;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 3.5rem;
            border: 6px solid white;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
            transition: all 0.4s ease;
        }
        .student-avatar-xl:hover {
            transform: scale(1.05) rotate(-3deg);
        }
        .detail-tab-item {
            padding: 1rem 1.5rem;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            font-weight: 600;
            color: #6b7280;
            transition: all 0.3s ease;
        }
        .detail-tab-item:hover {
            color: #6366f1;
        }
        .detail-tab-item.active {
            color: #6366f1;
            border-bottom-color: #6366f1;
        }
        .detail-tab-content {
            display: none;
        }
        .detail-tab-content.active {
            display: block;
        }
        .application-timeline {
            position: relative;
            padding-left: 2rem;
        }
        .application-timeline::before {
            content: '';
            position: absolute;
            left: 0.5rem;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(180deg, #6366f1 0%, #a855f7 100%);
        }
        .timeline-node {
            position: relative;
            padding-bottom: 1.5rem;
        }
        .timeline-node::after {
            content: '';
            position: absolute;
            left: -1.5rem;
            top: 0.25rem;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #6366f1;
            border: 3px solid white;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }
        .timeline-node:last-child::before {
            display: none;
        }
        .diary-entry-card {
            background: white;
            border-radius: 16px;
            border: 1px solid rgba(0, 0, 0, 0.05);
            padding: 1.5rem;
            transition: all 0.3s ease;
        }
        .diary-entry-card:hover {
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.1);
            transform: translateY(-2px);
        }
        .dark .diary-entry-card {
            background: rgba(30, 41, 59, 0.9);
            border-color: rgba(71, 85, 105, 0.3);
        }
    </style>
}

<div class="space-y-6">
    <!-- Geri Butonu -->
    <div class="flex items-center justify-between animate-fade-in-up">
        <a asp-action="Index" class="btn-premium btn-premium-outline">
            <i class="fas fa-arrow-left"></i>
            Ogrencilere Don
        </a>
        <div class="flex gap-3">
            <a asp-controller="Chat" asp-action="Index" asp-route-studentId="@Model.Student.Id" class="btn-premium btn-premium-success">
                <i class="fas fa-comments"></i>
                Mesaj Gonder
            </a>
            <button onclick="sendNotification()" class="btn-premium btn-premium-primary">
                <i class="fas fa-bell"></i>
                Bildirim Gonder
            </button>
        </div>
    </div>

    <!-- Profil Hero -->
    <div class="student-profile-hero animate-fade-in-up">
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-8">
            <div class="student-avatar-xl">
                @{
                    var initials = string.Join("", (Model.Student.FullName ?? "?").Split(' ').Where(p => !string.IsNullOrEmpty(p)).Select(p => p[0]).Take(2)).ToUpper();
                }
                @initials
            </div>
            <div class="text-center md:text-left flex-1">
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">@Model.Student.FullName</h1>
                <p class="text-white/80 text-xl mb-4">@(Model.Student.StudentNumber ?? "Ogrenci Numarasi Yok")</p>
                <div class="flex flex-wrap justify-center md:justify-start gap-3">
                    @if (!string.IsNullOrEmpty(Model.Student.UniversityName))
                    {
                        <span class="px-4 py-2 rounded-full bg-white/20 text-white text-sm font-medium backdrop-blur">
                            <i class="fas fa-university mr-2"></i>@Model.Student.UniversityName
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Student.Department))
                    {
                        <span class="px-4 py-2 rounded-full bg-white/20 text-white text-sm font-medium backdrop-blur">
                            <i class="fas fa-graduation-cap mr-2"></i>@Model.Student.Department
                        </span>
                    }
                    @if (Model.Student.Grade.HasValue)
                    {
                        <span class="px-4 py-2 rounded-full bg-white/20 text-white text-sm font-medium backdrop-blur">
                            <i class="fas fa-layer-group mr-2"></i>@Model.Student.Grade. Sinif
                        </span>
                    }
                    <span class="px-4 py-2 rounded-full @(Model.Student.IsActive ? "bg-green-500/80" : "bg-gray-500/80") text-white text-sm font-medium">
                        <i class="fas fa-@(Model.Student.IsActive ? "check-circle" : "pause-circle") mr-2"></i>@(Model.Student.IsActive ? "Aktif" : "Pasif")
                    </span>
                </div>
            </div>
            
            <!-- Hizli Istatistikler -->
            <div class="grid grid-cols-2 gap-3">
                <div class="px-4 py-3 rounded-xl bg-white/10 backdrop-blur border border-white/20 text-center">
                    <p class="text-2xl font-bold text-white">@Model.TotalApplications</p>
                    <span class="text-white/70 text-xs">Basvuru</span>
                </div>
                <div class="px-4 py-3 rounded-xl bg-green-500/30 backdrop-blur border border-green-400/30 text-center">
                    <p class="text-2xl font-bold text-white">@Model.ApprovedApplications</p>
                    <span class="text-green-200 text-xs">Onayli</span>
                </div>
                <div class="px-4 py-3 rounded-xl bg-yellow-500/30 backdrop-blur border border-yellow-400/30 text-center">
                    <p class="text-2xl font-bold text-white">@Model.PendingApplications</p>
                    <span class="text-yellow-200 text-xs">Bekleyen</span>
                </div>
                <div class="px-4 py-3 rounded-xl bg-purple-500/30 backdrop-blur border border-purple-400/30 text-center">
                    <p class="text-2xl font-bold text-white">@Model.TotalDiaryEntries</p>
                    <span class="text-purple-200 text-xs">Defter</span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Sol Kolon - Ana Icerik -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Tab Navigation -->
            <div class="advisor-card-premium animate-fade-in-up">
                <div class="flex overflow-x-auto border-b border-gray-200 dark:border-gray-700">
                    <button class="detail-tab-item active" data-tab="overview">
                        <i class="fas fa-chart-pie mr-2"></i>Genel Bakis
                    </button>
                    <button class="detail-tab-item" data-tab="applications">
                        <i class="fas fa-file-alt mr-2"></i>Basvurular
                    </button>
                    <button class="detail-tab-item" data-tab="diaries">
                        <i class="fas fa-book mr-2"></i>Staj Defteri
                    </button>
                    <button class="detail-tab-item" data-tab="documents">
                        <i class="fas fa-folder-open mr-2"></i>Belgeler
                    </button>
                </div>
                
                <!-- Genel Bakis Tab -->
                <div id="tab-overview" class="detail-tab-content active p-6">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                        <div class="text-center p-4 rounded-xl bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/30 dark:to-indigo-900/30">
                            <div class="text-3xl font-bold text-blue-600 mb-1">@Model.TotalApplications</div>
                            <div class="text-xs text-gray-600 dark:text-gray-400">Toplam Basvuru</div>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/30 dark:to-emerald-900/30">
                            <div class="text-3xl font-bold text-green-600 mb-1">@Model.ApprovedApplications</div>
                            <div class="text-xs text-gray-600 dark:text-gray-400">Onayli</div>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/30 dark:to-orange-900/30">
                            <div class="text-3xl font-bold text-yellow-600 mb-1">@Model.PendingApplications</div>
                            <div class="text-xs text-gray-600 dark:text-gray-400">Bekleyen</div>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-gradient-to-br from-red-50 to-pink-50 dark:from-red-900/30 dark:to-pink-900/30">
                            <div class="text-3xl font-bold text-red-600 mb-1">@Model.RejectedApplications</div>
                            <div class="text-xs text-gray-600 dark:text-gray-400">Reddedilen</div>
                        </div>
                    </div>
                    
                    <!-- Staj Durumu -->
                    <div class="p-5 rounded-xl bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 mb-6">
                        <div class="flex items-center justify-between">
                            <div>
                                <h4 class="font-semibold text-gray-900 dark:text-white mb-1">Staj Durumu</h4>
                                <p class="text-sm text-gray-600 dark:text-gray-400">Ogrencinin guncel staj durumu</p>
                            </div>
                            <span class="badge-premium @(Model.InternshipStatus == "Devam" ? "badge-approved" : Model.InternshipStatus == "Bekliyor" ? "badge-pending" : "badge-info")">
                                @Model.InternshipStatus
                            </span>
                        </div>
                    </div>
                    
                    <!-- Defter Istatistikleri -->
                    <div class="grid grid-cols-3 gap-4">
                        <div class="text-center p-4 rounded-xl border border-gray-100 dark:border-gray-700">
                            <div class="text-2xl font-bold text-purple-600 mb-1">@Model.TotalDiaryEntries</div>
                            <div class="text-xs text-gray-500">Toplam Girdi</div>
                        </div>
                        <div class="text-center p-4 rounded-xl border border-gray-100 dark:border-gray-700">
                            <div class="text-2xl font-bold text-green-600 mb-1">@Model.ApprovedDiaryEntries</div>
                            <div class="text-xs text-gray-500">Onayli</div>
                        </div>
                        <div class="text-center p-4 rounded-xl border border-gray-100 dark:border-gray-700">
                            <div class="text-2xl font-bold text-yellow-600 mb-1">@Model.PendingDiaryEntries</div>
                            <div class="text-xs text-gray-500">Bekleyen</div>
                        </div>
                    </div>
                </div>
                
                <!-- Basvurular Tab -->
                <div id="tab-applications" class="detail-tab-content p-6">
                    @if (Model.Applications.Any())
                    {
                        <div class="application-timeline">
                            @foreach (var app in Model.Applications.OrderByDescending(a => a.CreatedAt))
                            {
                                <div class="timeline-node">
                                    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 p-4 ml-4">
                                        <div class="flex items-start justify-between mb-3">
                                            <div>
                                                <h5 class="font-semibold text-gray-900 dark:text-white">@app.CompanyName</h5>
                                                <p class="text-sm text-gray-500">@app.Position</p>
                                            </div>
                                            <span class="badge-premium @(app.Status == Core.Entity.InternshipApprovalStatus.Approved ? "badge-approved" : app.Status == Core.Entity.InternshipApprovalStatus.Pending ? "badge-pending" : app.Status == Core.Entity.InternshipApprovalStatus.Revision ? "badge-revision" : "badge-rejected")">
                                                @(app.Status == Core.Entity.InternshipApprovalStatus.Approved ? "Onayli" : app.Status == Core.Entity.InternshipApprovalStatus.Pending ? "Bekliyor" : app.Status == Core.Entity.InternshipApprovalStatus.Revision ? "Revizyon" : "Reddedildi")
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-4 text-xs text-gray-500">
                                            <span><i class="fas fa-calendar mr-1"></i>@app.StartDate.ToString("dd.MM.yyyy") - @app.EndDate.ToString("dd.MM.yyyy")</span>
                                            <span><i class="fas fa-clock mr-1"></i>@app.WeeklyWorkHours saat/hafta</span>
                                        </div>
                                        <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700">
                                            <a asp-controller="AdvisorApplication" asp-action="Detail" asp-route-id="@app.Id" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                                <i class="fas fa-eye mr-1"></i>Detayi Gor
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <i class="fas fa-file-alt text-4xl text-gray-300 dark:text-gray-600 mb-3"></i>
                            <p class="text-gray-500">Henuz basvuru bulunmuyor</p>
                        </div>
                    }
                </div>
                
                <!-- Defterler Tab -->
                <div id="tab-diaries" class="detail-tab-content p-6">
                    @if (Model.DiaryEntries.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var entry in Model.DiaryEntries.OrderByDescending(d => d.Date).Take(10))
                            {
                                <div class="diary-entry-card">
                                    <div class="flex items-start justify-between mb-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center">
                                                <i class="fas fa-book-open text-indigo-600"></i>
                                            </div>
                                            <div>
                                                <p class="font-semibold text-gray-900 dark:text-white">@entry.Date.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                                                <p class="text-xs text-gray-500">@entry.Date.DayOfWeek</p>
                                            </div>
                                        </div>
                                        <span class="badge-premium @(entry.IsApproved ? "badge-approved" : "badge-pending")">
                                            @(entry.IsApproved ? "Onayli" : "Bekliyor")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(entry.Content))
                                    {
                                        <p class="text-gray-700 dark:text-gray-300 text-sm line-clamp-3">@entry.Content</p>
                                    }
                                </div>
                            }
                        </div>
                        
                        @if (Model.DiaryEntries.Count > 10)
                        {
                            <div class="text-center mt-6">
                                <a asp-controller="AdvisorDiary" asp-action="Index" asp-route-studentId="@Model.Student.Id" class="btn-premium btn-premium-outline">
                                    <i class="fas fa-list"></i>
                                    Tum Girdileri Gor (@Model.DiaryEntries.Count)
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <i class="fas fa-book text-4xl text-gray-300 dark:text-gray-600 mb-3"></i>
                            <p class="text-gray-500">Henuz defter girdisi bulunmuyor</p>
                        </div>
                    }
                </div>
                
                <!-- Belgeler Tab -->
                <div id="tab-documents" class="detail-tab-content p-6">
                    @if (Model.Documents.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="flex items-center justify-between p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-colors">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center">
                                            <i class="fas fa-file-pdf text-indigo-600 text-lg"></i>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-900 dark:text-white">@doc.Title</p>
                                            <div class="flex items-center gap-3 text-xs text-gray-500">
                                                <span>@doc.DocumentType</span>
                                                <span>@doc.UploadedAt.ToString("dd.MM.yyyy")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <a href="@doc.FilePath" target="_blank" class="btn-premium btn-premium-outline text-sm py-2">
                                        <i class="fas fa-download"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <i class="fas fa-folder-open text-4xl text-gray-300 dark:text-gray-600 mb-3"></i>
                            <p class="text-gray-500">Henuz belge bulunmuyor</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sag Kolon -->
        <div class="space-y-6">
            <!-- Iletisim Bilgileri -->
            <div class="advisor-card-premium animate-fade-in-up">
                <div class="advisor-card-header">
                    <h3 class="advisor-card-title">
                        <i class="fas fa-address-card text-indigo-500"></i>
                        Iletisim Bilgileri
                    </h3>
                </div>
                <div class="p-6 space-y-4">
                    <a href="mailto:@Model.Student.Email" class="flex items-center gap-4 p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors group">
                        <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center group-hover:bg-indigo-200">
                            <i class="fas fa-envelope text-indigo-600"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-gray-500 mb-0.5">E-posta</p>
                            <p class="font-medium text-indigo-600 truncate">@Model.Student.Email</p>
                        </div>
                    </a>
                    
                    @if (!string.IsNullOrEmpty(Model.Student.Phone))
                    {
                        <a href="tel:@Model.Student.Phone" class="flex items-center gap-4 p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-green-50 dark:hover:bg-green-900/30 transition-colors group">
                            <div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/50 flex items-center justify-center group-hover:bg-green-200">
                                <i class="fas fa-phone text-green-600"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-gray-500 mb-0.5">Telefon</p>
                                <p class="font-medium text-green-600">@Model.Student.Phone</p>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Hizli Islemler -->
            <div class="advisor-card-premium animate-fade-in-up">
                <div class="advisor-card-header">
                    <h3 class="advisor-card-title">
                        <i class="fas fa-bolt text-indigo-500"></i>
                        Hizli Islemler
                    </h3>
                </div>
                <div class="p-6 space-y-3">
                    <a asp-controller="Chat" asp-action="Index" asp-route-studentId="@Model.Student.Id" class="w-full btn-premium btn-premium-primary py-3">
                        <i class="fas fa-comments"></i>
                        Mesaj Gonder
                    </a>
                    <button onclick="sendNotification()" class="w-full btn-premium btn-premium-outline py-3">
                        <i class="fas fa-bell"></i>
                        Bildirim Gonder
                    </button>
                    @if (Model.PendingApplications > 0)
                    {
                        <a asp-controller="AdvisorApplication" asp-action="Index" asp-route-studentId="@Model.Student.Id" class="w-full btn-premium btn-premium-warning py-3">
                            <i class="fas fa-file-alt"></i>
                            Bekleyen Basvurular (@Model.PendingApplications)
                        </a>
                    }
                    @if (Model.PendingDiaryEntries > 0)
                    {
                        <a asp-controller="AdvisorDiary" asp-action="Index" asp-route-studentId="@Model.Student.Id" class="w-full btn-premium btn-premium-info py-3">
                            <i class="fas fa-book"></i>
                            Bekleyen Defterler (@Model.PendingDiaryEntries)
                        </a>
                    }
                </div>
            </div>

            <!-- Son Aktivite -->
            <div class="advisor-card-premium animate-fade-in-up">
                <div class="advisor-card-header">
                    <h3 class="advisor-card-title">
                        <i class="fas fa-clock text-indigo-500"></i>
                        Zaman Bilgisi
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between py-2 border-b border-gray-100 dark:border-gray-700">
                            <span class="text-gray-500">Kayit Tarihi</span>
                            <span class="font-medium text-gray-900 dark:text-white">@Model.Student.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                        @if (Model.LastActivity.HasValue)
                        {
                            <div class="flex justify-between py-2">
                                <span class="text-gray-500">Son Aktivite</span>
                                <span class="font-medium text-gray-900 dark:text-white">@Model.LastActivity.Value.ToString("dd.MM.yyyy")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bildirim Modal -->
<div id="notificationModal" class="modal-premium-overlay">
    <div class="modal-premium max-w-md">
        <div class="modal-premium-header">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
                        <i class="fas fa-bell text-white"></i>
                    </div>
                    <h2 class="text-xl font-bold text-white">Bildirim Gonder</h2>
                </div>
                <button onclick="closeNotificationModal()" class="w-10 h-10 rounded-xl bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-white"></i>
                </button>
            </div>
        </div>
        <form id="notificationForm" onsubmit="submitNotification(event)" class="modal-premium-body">
            @Html.AntiForgeryToken()
            <input type="hidden" name="studentId" value="@Model.Student.Id" />
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Baslik</label>
                    <input name="title" required maxlength="150" class="filter-input-premium" placeholder="Bildirim basligi..." />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Mesaj</label>
                    <textarea name="message" required rows="4" maxlength="1000" class="filter-input-premium" placeholder="Mesajinizi yazin..."></textarea>
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button type="button" onclick="closeNotificationModal()" class="btn-premium btn-premium-outline">Iptal</button>
                <button type="submit" class="btn-premium btn-premium-primary">
                    <i class="fas fa-paper-plane"></i>
                    Gonder
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Tab Navigation
        document.querySelectorAll('.detail-tab-item').forEach(tab => {
            tab.addEventListener('click', function() {
                const tabId = this.dataset.tab;
                
                document.querySelectorAll('.detail-tab-item').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.detail-tab-content').forEach(c => c.classList.remove('active'));
                
                this.classList.add('active');
                document.getElementById('tab-' + tabId).classList.add('active');
            });
        });
        
        // Notification Modal
        function sendNotification() {
            document.getElementById('notificationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        
        function closeNotificationModal() {
            document.getElementById('notificationModal').classList.remove('active');
            document.body.style.overflow = 'auto';
        }
        
        async function submitNotification(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            
            try {
                const res = await fetch('/AdvisorStudent/SendNotification', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                
                if (data.success) {
                    alert('Bildirim basariyla gonderildi!');
                    closeNotificationModal();
                    form.reset();
                } else {
                    alert('Hata: ' + data.message);
                }
            } catch (err) {
                alert('Hata: ' + err.message);
            }
        }
        
        // Modal disi tiklama
        document.querySelectorAll('.modal-premium-overlay').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('active');
                    document.body.style.overflow = 'auto';
                }
            });
        });
        
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-premium-overlay.active').forEach(m => {
                    m.classList.remove('active');
                });
                document.body.style.overflow = 'auto';
            }
        });
    </script>
}
