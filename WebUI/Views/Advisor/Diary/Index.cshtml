@model WebUI.Models.ViewModels.Advisor.AdvisorDiaryViewModel
@{
    ViewData["Title"] = "Staj Defterleri";
    Layout = "_AppLayout";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-lg dark:from-blue-900/20 dark:to-indigo-900/20 dark:border-blue-700">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-2">
                    <i class="fas fa-book-open me-3"></i>Öðrenci Staj Defterleri
                </h1>
                <p class="text-blue-600 dark:text-blue-300">
                    <i class="fas fa-university mr-2"></i>@Model.AdvisorInfo.UniversityName - @Model.AdvisorInfo.Department Bölümü
                </p>
                <p class="text-sm text-blue-500 dark:text-blue-400">
                    Bölümünüzde @Model.AdvisorInfo.TotalStudentsInDepartment öðrenci var, @Model.AdvisorInfo.StudentsWithDiaries öðrencinin staj defteri bulunuyor.
                </p>
            </div>
            <div class="flex gap-3">
                <button onclick="exportAllDiaries()" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition-colors">
                    <i class="fas fa-file-excel mr-2"></i>Excel Ýndir
                </button>
                <a asp-controller="AdvisorDashboard" asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
        <form method="get" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Öðrenci Adý</label>
                <input type="text" name="Filters.StudentName" value="@Model.Filters.StudentName" 
                       class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 dark:text-gray-200"
                       placeholder="Öðrenci adý ara..." />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Durum</label>
                <select name="Filters.Status" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 dark:text-gray-200">
                    <option value="">Tümü</option>
                    <option value="pending" selected="@(Model.Filters.Status == "pending")">Bekleyen</option>
                    <option value="approved" selected="@(Model.Filters.Status == "approved")">Onaylanan</option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Baþlangýç Tarihi</label>
                <input type="date" name="Filters.StartDate" value="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" 
                       class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 dark:text-gray-200" />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Bitiþ Tarihi</label>
                <input type="date" name="Filters.EndDate" value="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" 
                       class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 dark:text-gray-200" />
            </div>
            
            <div class="md:col-span-2 lg:col-span-4 flex gap-3">
                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg transition-colors">
                    <i class="fas fa-search mr-2"></i>Filtrele
                </button>
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition-colors">
                    <i class="fas fa-undo mr-2"></i>Temizle
                </a>
            </div>
        </form>
    </div>

    <!-- Student Diaries List -->
    @if (Model.StudentDiaries.Any())
    {
        <!-- Öðrenci Kartlarý -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var studentGroup in Model.StudentDiaries)
            {
                <div class="student-card bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                    <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-xl font-bold">
                                @{ var nameParts = studentGroup.Student.FullName.Split(' '); var initials = ""; if (nameParts.Length >= 1 && !string.IsNullOrEmpty(nameParts[0])) initials += nameParts[0][0]; if (nameParts.Length >= 2 && !string.IsNullOrEmpty(nameParts[1])) initials += nameParts[1][0]; }
                                @initials.ToUpper()
                            </div>
                            <div class="flex-1">
                                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">@studentGroup.Student.FullName</h3>
                                <p class="text-sm text-gray-600 dark:text-gray-400"><i class="fas fa-envelope mr-1"></i>@studentGroup.Student.Email</p>
                                <p class="text-sm text-gray-500 dark:text-gray-500"><i class="fas fa-graduation-cap mr-1"></i>@(studentGroup.Student.Department ?? "Bölüm Belirtilmemiþ")</p>
                                <div class="mt-2 flex flex-wrap gap-2 text-xs">
                                    @if (studentGroup.DiaryId.HasValue)
                                    {<span class="px-2 py-1 bg-indigo-100 text-indigo-700 rounded">Defter ID: @studentGroup.DiaryId</span>}
                                    @if (!string.IsNullOrWhiteSpace(studentGroup.DiaryTitle))
                                    {<span class="px-2 py-1 bg-blue-100 text-blue-700 rounded">@studentGroup.DiaryTitle</span>}
                                    <span class="px-2 py-1 @(studentGroup.IsRequired ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700") rounded">@(studentGroup.IsRequired ? "Zorunlu" : "Gönüllü")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="p-4 bg-gray-50 dark:bg-gray-700/50">
                        <div class="grid grid-cols-1 gap-2 text-sm">
                            <div class="flex items-center justify-between"><span class="text-gray-600 dark:text-gray-400"><i class="fas fa-building mr-1"></i>Staj Firmasý:</span><span class="text-gray-800 dark:text-gray-200 font-medium">@(studentGroup.InternshipCompany.Length > 20 ? studentGroup.InternshipCompany.Substring(0, 20) + "..." : studentGroup.InternshipCompany)</span></div>
                            @if (studentGroup.InternshipStartDate.HasValue && studentGroup.InternshipEndDate.HasValue)
                            {<div class="flex items-center justify-between"><span class="text-gray-600 dark:text-gray-400"><i class="fas fa-calendar mr-1"></i>Staj Dönemi:</span><span class="text-gray-800 dark:text-gray-200 font-medium">@studentGroup.InternshipStartDate.Value.ToString("dd.MM") - @studentGroup.InternshipEndDate.Value.ToString("dd.MM")</span></div>}
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="text-center p-3 bg-blue-50 dark:bg-blue-900/30 rounded-lg"><div class="text-xl font-bold text-blue-600 dark:text-blue-400">@studentGroup.TotalEntries</div><div class="text-xs text-blue-500 dark:text-blue-300">Toplam Girdi</div></div>
                            <div class="text-center p-3 bg-yellow-50 dark:bg-yellow-900/30 rounded-lg"><div class="text-xl font-bold text-yellow-600 dark:text-yellow-400">@studentGroup.PendingEntries</div><div class="text-xs text-yellow-500 dark:text-yellow-300">Bekleyen</div></div>
                        </div>
                        <div class="grid grid-cols-2 gap-3 mt-3">
                            <div class="text-center p-3 bg-green-50 dark:bg-green-900/30 rounded-lg"><div class="text-xl font-bold text-green-600 dark:text-green-400">@studentGroup.ApprovedEntries</div><div class="text-xs text-green-500 dark:text-green-300">Onaylanan</div></div>
                            <div class="text-center p-3 bg-purple-50 dark:bg-purple-900/30 rounded-lg"><div class="text-xl font-bold text-purple-600 dark:text-purple-400">@(studentGroup.LastEntryDate?.ToString("dd.MM") ?? "-")</div><div class="text-xs text-purple-500 dark:text-purple-300">Son Girdi</div></div>
                        </div>
                    </div>
                    <div class="p-4 border-t border-gray-200 dark:border-gray-700">
                        <button onclick="openStudentDiaryModal(@studentGroup.Student.Id, '@studentGroup.Student.FullName', @studentGroup.DiaryId)" class="w-full bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white py-3 px-4 rounded-lg transition-all duration-300 transform hover:scale-105 font-medium">
                            <i class="fas fa-eye mr-2"></i>Defteri Aç
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalItems > Model.PageSize)
        {
            <div class="flex justify-center mt-8">
                <nav class="flex space-x-2">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" 
                           class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">Önceki</a>
                    }
                    
                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <a asp-action="Index" asp-route-page="@i" 
                           class="px-4 py-2 @(i == Model.CurrentPage ? "bg-blue-500 text-white" : "bg-white text-gray-700 hover:bg-gray-50") border border-gray-300 rounded-lg transition-colors">@i</a>
                    }
                    
                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" 
                           class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">Sonraki</a>
                    }
                </nav>
            </div>
        }
    }
    else
    {
        <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <div class="text-center py-12">
                <i class="fas fa-book-open text-gray-400 text-6xl mb-4"></i>
                <h3 class="text-lg font-semibold text-gray-600 dark:text-gray-400 mb-2">Staj Defteri Bulunamadý</h3>
                <p class="text-gray-500 dark:text-gray-500 mb-4">
                    @if (!string.IsNullOrEmpty(Model.Filters.StudentName) || !string.IsNullOrEmpty(Model.Filters.Status))
                    {
                        <span>Arama kriterlerinize uygun staj defteri bulunamadý. Filtreleri temizleyerek tekrar deneyin.</span>
                    }
                    else
                    {
                        <span>Bölümünüzden henüz staj defteri tutan öðrenci bulunmamaktadýr.</span>
                    }
                </p>
                <a asp-action="Index" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-xl transition-colors duration-200">
                    <i class="fas fa-undo mr-2"></i>Filtreleri Temizle
                </a>
            </div>
        </div>
    }
</div>

@Html.AntiForgeryToken()

<!-- Öðrenci Staj Defteri Modal -->
<div id="studentDiaryModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-5xl w-full max-h-[90vh] overflow-y-auto">
            <div class="p-6">
                <div class="flex justify-between items-start mb-6">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white" id="studentName">
                        <i class="fas fa-book-open text-blue-500 mr-2"></i>Öðrenci Staj Defteri
                    </h2>
                    <button onclick="closeStudentDiaryModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 text-xl p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <!-- Loading -->
                <div id="diaryLoading" class="text-center py-8">
                    <i class="fas fa-spinner fa-spin text-blue-500 text-3xl mb-4"></i>
                    <p class="text-gray-600 dark:text-gray-400">Staj defteri yükleniyor...</p>
                </div>
                
                <!-- Diary Entries Content -->
                <div id="diaryEntriesContent" class="hidden">
                    <!-- Dynamic content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStudentId = null;
        let currentDiaryId = null;
        let currentStudentEntries = [];
        
        function exportAllDiaries() {
            alert('Excel export özelliði yakýnda eklenecek.');
        }
        
        // Öðrenci staj defteri modal'ýný aç
        function openStudentDiaryModal(studentId, studentName, diaryId) {
            currentStudentId = studentId;
            currentDiaryId = diaryId || null;
            document.getElementById('studentName').innerHTML = `<i class="fas fa-book-open text-blue-500 mr-2"></i>${studentName} - Staj Defteri ${currentDiaryId ? '(ID: '+currentDiaryId+')' : ''}`;
            document.getElementById('studentDiaryModal').classList.remove('hidden');
            document.getElementById('diaryLoading').classList.remove('hidden');
            document.getElementById('diaryEntriesContent').classList.add('hidden');
            document.body.style.overflow = 'hidden';
            const url = `/Advisor/AdvisorDiary/GetStudentDiaryEntries/${studentId}?diaryId=${currentDiaryId || ''}`;
            fetch(url).then(r=>r.json()).then(data=>{ if(data.success){ currentStudentEntries=data.entries; renderDiaryEntries(data.entries);} else {alert(data.message||'Hata'); closeStudentDiaryModal();}}).catch(err=>{alert('Hata: '+err.message); closeStudentDiaryModal();}).finally(()=>{document.getElementById('diaryLoading').classList.add('hidden'); document.getElementById('diaryEntriesContent').classList.remove('hidden');});
        }
        function closeStudentDiaryModal(){ document.getElementById('studentDiaryModal').classList.add('hidden'); document.body.style.overflow='auto'; currentStudentId=null; currentDiaryId=null; currentStudentEntries=[]; }
        
        // Staj defteri girdilerini render et
        function renderDiaryEntries(entries) {
            if (!entries || entries.length === 0) {
                document.getElementById('diaryEntriesContent').innerHTML = `
                    <div class="text-center py-12">
                        <i class="fas fa-book text-gray-400 text-6xl mb-4"></i>
                        <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">Henüz girdi yok</h3>
                        <p class="text-gray-500 dark:text-gray-500">Bu öðrenci henüz staj defteri girdisi yapmamýþ.</p>
                    </div>
                `;
                return;
            }
            
            // Girdileri tarihe göre grupla
            const groupedEntries = groupEntriesByDate(entries);
            
            let html = `
                <div class="mb-4 flex justify-between items-center">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200">
                        <i class="fas fa-calendar-alt mr-2"></i>Staj Defteri Girdileri (${entries.length} girdi)
                    </h3>
                    <div class="flex gap-2">
                        <button onclick="filterEntries('all')" class="px-3 py-1 bg-blue-100 text-blue-800 rounded-lg text-sm hover:bg-blue-200 transition-colors entry-filter active" data-filter="all">
                            Tümü
                        </button>
                        <button onclick="filterEntries('pending')" class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-lg text-sm hover:bg-yellow-200 transition-colors entry-filter" data-filter="pending">
                            Bekleyen
                        </button>
                        <button onclick="filterEntries('approved')" class="px-3 py-1 bg-green-100 text-green-800 rounded-lg text-sm hover:bg-green-200 transition-colors entry-filter" data-filter="approved">
                            Onaylanan
                        </button>
                    </div>
                </div>
                
                <div class="space-y-4" id="entriesList">
            `;
            
            // Her gün için girdileri göster
            for (const dateGroup of groupedEntries) {
                html += `
                    <div class="date-group border border-gray-200 dark:border-gray-600 rounded-lg overflow-hidden">
                        <div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 border-b border-gray-200 dark:border-gray-600">
                            <h4 class="font-semibold text-gray-800 dark:text-gray-200">
                                <i class="fas fa-calendar mr-2"></i>${dateGroup.date}
                                <span class="text-sm text-gray-500 dark:text-gray-400 ml-2">(${dateGroup.entries.length} girdi)</span>
                            </h4>
                        </div>
                        <div class="p-4 space-y-3">
                `;
                
                // O gün için tüm girdiler
                for (const entry of dateGroup.entries) {
                    const statusClass = entry.isApproved ? 'green' : 'yellow';
                    const statusText = entry.isApproved ? 'Onaylandý' : 'Beklemede';
                    const statusIcon = entry.isApproved ? 'check' : 'clock';
                    
                    html += `
                        <div class="entry-item bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg p-4 hover:shadow-md transition-all duration-300" data-status="${entry.isApproved ? 'approved' : 'pending'}">
                            <div class="flex justify-between items-start mb-3">
                                <div class="flex-1">
                                    <h5 class="font-semibold text-gray-900 dark:text-white mb-2">${entry.title}</h5>
                                    <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400 mb-2">
                                        <span><i class="fas fa-clock mr-1"></i>${entry.workingHours} saat</span>
                                        <span class="px-2 py-1 rounded-full text-xs font-medium bg-${statusClass}-100 text-${statusClass}-800 dark:bg-${statusClass}-900 dark:text-${statusClass}-200">
                                            <i class="fas fa-${statusIcon} mr-1"></i>${statusText}
                                        </span>
                                    </div>
                                </div>
                                ${!entry.isApproved ? `
                                <div class="flex gap-2">
                                    <button onclick="approveEntry(${entry.id}, '${entry.title}')" class="text-green-600 hover:text-green-700 px-2 py-1 rounded hover:bg-green-50 dark:hover:bg-green-900 transition-colors" title="Onayla">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button onclick="rejectEntry(${entry.id}, '${entry.title}')" class="text-red-600 hover:text-red-700 px-2 py-1 rounded hover:bg-red-50 dark:hover:bg-red-900 transition-colors" title="Reddet">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                ` : ''}}
                            </div>
                            
                            <div class="mb-3">
                                <h6 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ýçerik:</h6>
                                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">${entry.content}</p>
                            </div>
                            
                            ${entry.learnedTopics ? `
                            <div class="mb-3">
                                <h6 class="text-sm font-medium text-yellow-700 dark:text-yellow-300 mb-1">
                                    <i class="fas fa-lightbulb mr-1"></i>Öðrenilenler:
                                </h6>
                                <p class="text-yellow-600 dark:text-yellow-400 text-sm bg-yellow-50 dark:bg-yellow-900/30 p-2 rounded">${entry.learnedTopics}</p>
                            </div>
                            ` : ''}
                            
                            ${entry.challenges ? `
                            <div class="mb-3">
                                <h6 class="text-sm font-medium text-orange-700 dark:text-orange-300 mb-1">
                                    <i class="fas fa-exclamation-triangle mr-1"></i>Zorluklar:
                                </h6>
                                <p class="text-orange-600 dark:text-orange-400 text-sm bg-orange-50 dark:bg-orange-900/30 p-2 rounded">${entry.challenges}</p>
                            </div>
                            ` : ''}
                            
                            <div class="border-t border-gray-200 dark:border-gray-600 pt-3 mt-3">
                                <h6 class="text-sm font-medium text-purple-700 dark:text-purple-300 mb-2">
                                    <i class="fas fa-comment mr-1"></i>Danýþman Yorumu:
                                </h6>
                                ${entry.advisorFeedback ? `
                                    <p class="text-purple-600 dark:text-purple-400 text-sm bg-purple-50 dark:bg-purple-900/30 p-2 rounded">${entry.advisorFeedback}</p>
                                ` : `
                                    <div class="space-y-2">
                                        <p class="text-gray-500 dark:text-gray-400 text-sm italic">Henüz yorum yapýlmamýþ.</p>
                                        <div class="flex gap-2">
                                            <textarea id="comment_${entry.id}" class="flex-1 p-2 border border-gray-300 dark:border-gray-600 rounded text-sm focus:ring-2 focus:ring-purple-500 bg-white dark:bg-gray-700 dark:text-gray-200" rows="2" placeholder="Yorumunuzu yazýn..."></textarea>
                                            <button onclick="submitComment(${entry.id})" class="px-3 py-2 bg-purple-500 hover:bg-purple-600 text-white rounded text-sm transition-colors">
                                                <i class="fas fa-paper-plane"></i>
                                            </button>
                                        </div>
                                    </div>
                                `}
                            </div>
                        </div>
                    `;
                }
                
                html += `
                        </div>
                    </div>
                `;
            }
            
            html += '</div>';
            
            document.getElementById('diaryEntriesContent').innerHTML = html;
        }
        
        // Girdileri tarihe göre grupla
        function groupEntriesByDate(entries) {
            const groups = {};
            
            entries.forEach(entry => {
                const date = new Date(entry.date).toLocaleDateString('tr-TR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    weekday: 'long'
                });
                
                if (!groups[date]) {
                    groups[date] = [];
                }
                groups[date].push(entry);
            });
            
            // Tarihe göre sýrala
            return Object.keys(groups)
                .sort((a, b) => new Date(groups[b][0].date) - new Date(groups[a][0].date))
                .map(date => ({
                    date: date,
                    entries: groups[date].sort((a, b) => new Date(b.date) - new Date(a.date))
                }));
        }
        
        // Girdi filtreleme
        function filterEntries(filter) {
            // Filter butonlarýný güncelle
            document.querySelectorAll('.entry-filter').forEach(btn => {
                btn.classList.remove('active', 'bg-blue-500', 'text-white');
                btn.classList.add('bg-blue-100', 'text-blue-800');
            });
            
            const activeBtn = document.querySelector(`[data-filter="${filter}"]`);
            activeBtn.classList.remove('bg-blue-100', 'text-blue-800');
            activeBtn.classList.add('active', 'bg-blue-500', 'text-white');
            
            // Girdileri filtrele
            const entries = document.querySelectorAll('.entry-item');
            entries.forEach(entry => {
                const status = entry.dataset.status;
                let show = false;
                
                switch(filter) {
                    case 'all':
                        show = true;
                        break;
                    case 'pending':
                        show = status === 'pending';
                        break;
                    case 'approved':
                        show = status === 'approved';
                        break;
                }
                
                if (show) {
                    entry.style.display = 'block';
                    entry.style.opacity = '1';
                } else {
                    entry.style.display = 'none';
                    entry.style.opacity = '0';
                }
            });
            
            // Boþ grup gizle
            document.querySelectorAll('.date-group').forEach(group => {
                const visibleEntries = group.querySelectorAll('.entry-item:not([style*="display: none"])');
                if (visibleEntries.length === 0) {
                    group.style.display = 'none';
                } else {
                    group.style.display = 'block';
                }
            });
        }
        
        // Yorum gönder
        function submitComment(entryId) {
            const comment = document.getElementById(`comment_${entryId}`).value.trim();
            if (!comment) {
                alert('Lütfen bir yorum yazýn.');
                return;
            }
            
            // Create a form and submit
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Advisor/AdvisorDiary/ApproveEntry';
            
            // Add anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token.value;
                form.appendChild(tokenInput);
            }
            
            // Add entry ID
            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'entryId';
            idInput.value = entryId;
            form.appendChild(idInput);
            
            // Add feedback
            const feedbackInput = document.createElement('input');
            feedbackInput.type = 'hidden';
            feedbackInput.name = 'feedback';
            feedbackInput.value = comment;
            form.appendChild(feedbackInput);
            
            document.body.appendChild(form);
            form.submit();
        }
        
        // Girdi onayla
        function approveEntry(entryId, title) {
            if (confirm(`"${title}" adlý girdiyi onaylamak istediðinizden emin misiniz?`)) {
                // Create a form and submit
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Advisor/AdvisorDiary/ApproveEntry';
                
                // Add anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }
                
                // Add entry ID
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'entryId';
                idInput.value = entryId;
                form.appendChild(idInput);
                
                // Add feedback (empty for approve)
                const feedbackInput = document.createElement('input');
                feedbackInput.type = 'hidden';
                feedbackInput.name = 'feedback';
                feedbackInput.value = '';
                form.appendChild(feedbackInput);
                
                document.body.appendChild(form);
                form.submit();
            }
        }
        
        // Girdi reddet
        function rejectEntry(entryId, title) {
            const reason = prompt(`"${title}" adlý girdiyi neden reddediyorsunuz?`);
            if (reason && reason.trim()) {
                // Create a form and submit
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Advisor/AdvisorDiary/RejectEntry';
                
                // Add anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }
                
                // Add entry ID
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'DiaryEntryId';
                idInput.value = entryId;
                form.appendChild(idInput);
                
                // Add feedback
                const feedbackInput = document.createElement('input');
                feedbackInput.type = 'hidden';
                feedbackInput.name = 'Feedback';
                feedbackInput.value = reason.trim();
                form.appendChild(feedbackInput);
                
                document.body.appendChild(form);
                form.submit();
            }
        }
        
        // Modal kontrolleri
        document.getElementById('studentDiaryModal').addEventListener('click', function(e) {
            if (e.target === this) closeStudentDiaryModal();
        });
        
        // ESC tuþu ile modal kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeStudentDiaryModal();
            }
        });
    </script>
}
