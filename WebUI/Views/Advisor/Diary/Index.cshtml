@model WebUI.Models.ViewModels.Advisor.AdvisorDiaryViewModel
@{
    ViewData["Title"] = "Staj Defterleri";
    Layout = "_AppLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdvisorCss/advisor-theme.css" asp-append-version="true" />
}

<div class="space-y-6">
    <!-- Premium Hero Header -->
    <div class="advisor-hero-header animate-fade-in-up">
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur flex items-center justify-center">
                        <i class="fas fa-book-open text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl lg:text-3xl font-bold text-white">Öðrenci Staj Defterleri</h1>
                        <p class="text-white/70 text-sm">
                            <i class="fas fa-university mr-1"></i>@Model.AdvisorInfo.UniversityName - @Model.AdvisorInfo.Department
                        </p>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <div class="px-4 py-2 rounded-xl bg-white/10 backdrop-blur border border-white/20">
                    <span class="text-white/70 text-xs">Öðrenci</span>
                    <p class="text-white font-bold text-lg">@Model.AdvisorInfo.TotalStudentsInDepartment</p>
                </div>
                <div class="px-4 py-2 rounded-xl bg-white/10 backdrop-blur border border-white/20">
                    <span class="text-white/70 text-xs">Defter Var</span>
                    <p class="text-white font-bold text-lg">@Model.AdvisorInfo.StudentsWithDiaries</p>
                </div>
                <a asp-controller="AdvisorDashboard" asp-action="Index" class="btn-premium btn-premium-glass">
                    <i class="fas fa-arrow-left"></i>
                    <span class="hidden sm:inline">Dashboard</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Premium Filtre Alaný -->
    <div class="filter-section-premium animate-fade-in-up">
        <form method="get" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2 uppercase tracking-wide">
                        <i class="fas fa-user mr-1"></i>Öðrenci
                    </label>
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" name="Filters.StudentName" value="@Model.Filters.StudentName" 
                               class="filter-input-premium pl-10"
                               placeholder="Öðrenci adý ara..." />
                    </div>
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2 uppercase tracking-wide">
                        <i class="fas fa-filter mr-1"></i>Durum
                    </label>
                    <select name="Filters.Status" class="filter-input-premium">
                        <option value="">Tüm Durumlar</option>
                        <option value="pending" selected="@(Model.Filters.Status == "pending")">? Bekleyen Girdiler</option>
                        <option value="approved" selected="@(Model.Filters.Status == "approved")">? Onaylanan Girdiler</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2 uppercase tracking-wide">
                        <i class="fas fa-calendar mr-1"></i>Baþlangýç
                    </label>
                    <input type="date" name="Filters.StartDate" value="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" 
                           class="filter-input-premium" />
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-2 uppercase tracking-wide">
                        <i class="fas fa-calendar-check mr-1"></i>Bitiþ
                    </label>
                    <input type="date" name="Filters.EndDate" value="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" 
                           class="filter-input-premium" />
                </div>
            </div>
            
            <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-gray-100 dark:border-gray-700">
                <div class="text-sm text-gray-500">
                    <i class="fas fa-info-circle mr-1"></i>
                    Toplam <strong>@Model.TotalItems</strong> öðrenci defteri bulundu
                </div>
                <div class="flex gap-3">
                    <button type="submit" class="btn-premium btn-premium-primary">
                        <i class="fas fa-search"></i>
                        Filtrele
                    </button>
                    <a asp-action="Index" class="btn-premium btn-premium-outline">
                        <i class="fas fa-undo"></i>
                        Temizle
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Öðrenci Defter Kartlarý -->
    @if (Model.StudentDiaries.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var studentGroup in Model.StudentDiaries)
            {
                var nameParts = studentGroup.Student.FullName.Split(' ');
                var initials = "";
                if (nameParts.Length >= 1 && !string.IsNullOrEmpty(nameParts[0])) initials += nameParts[0][0];
                if (nameParts.Length >= 2 && !string.IsNullOrEmpty(nameParts[1])) initials += nameParts[1][0];
                
                <div class="diary-card-premium animate-fade-in-up">
                    <!-- Kart Üst Dekoratif Alan -->
                    <div class="h-20 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 relative overflow-hidden">
                        <div class="absolute inset-0 bg-black/10"></div>
                        <div class="absolute top-2 right-2 flex gap-1">
                            @if (studentGroup.IsRequired)
                            {
                                <span class="px-2 py-1 rounded-full text-xs font-semibold bg-green-500 text-white">Zorunlu</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 rounded-full text-xs font-semibold bg-yellow-500 text-white">Gönüllü</span>
                            }
                        </div>
                    </div>
                    
                    <!-- Avatar ve Bilgiler -->
                    <div class="px-6 pb-4 -mt-10 relative">
                        <div class="diary-student-avatar mx-auto mb-3 border-4 border-white dark:border-gray-800">
                            @initials.ToUpper()
                        </div>
                        
                        <div class="text-center mb-4">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white">@studentGroup.Student.FullName</h3>
                            <p class="text-sm text-gray-500 dark:text-gray-400">
                                <i class="fas fa-envelope mr-1"></i>@studentGroup.Student.Email
                            </p>
                            @if (!string.IsNullOrEmpty(studentGroup.Student.Department))
                            {
                                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                                    <i class="fas fa-graduation-cap mr-1"></i>@studentGroup.Student.Department
                                </p>
                            }
                        </div>
                        
                        <!-- Staj Bilgileri -->
                        <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-3 mb-4">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center">
                                    <i class="fas fa-building text-blue-600 dark:text-blue-400 text-sm"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs text-gray-500 dark:text-gray-400">Staj Firmasý</p>
                                    <p class="text-sm font-semibold text-gray-900 dark:text-white truncate">
                                        @(studentGroup.InternshipCompany.Length > 25 ? studentGroup.InternshipCompany.Substring(0, 25) + "..." : studentGroup.InternshipCompany)
                                    </p>
                                </div>
                            </div>
                            @if (studentGroup.InternshipStartDate.HasValue && studentGroup.InternshipEndDate.HasValue)
                            {
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center">
                                        <i class="fas fa-calendar-alt text-purple-600 dark:text-purple-400 text-sm"></i>
                                    </div>
                                    <div class="flex-1">
                                        <p class="text-xs text-gray-500 dark:text-gray-400">Staj Dönemi</p>
                                        <p class="text-sm font-semibold text-gray-900 dark:text-white">
                                            @studentGroup.InternshipStartDate.Value.ToString("dd MMM") - @studentGroup.InternshipEndDate.Value.ToString("dd MMM yyyy")
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- Ýstatistikler -->
                    <div class="diary-stats-grid">
                        <div class="diary-stat-box total">
                            <div class="diary-stat-number">@studentGroup.TotalEntries</div>
                            <div class="diary-stat-label">Toplam Girdi</div>
                        </div>
                        <div class="diary-stat-box pending">
                            <div class="diary-stat-number">@studentGroup.PendingEntries</div>
                            <div class="diary-stat-label">Bekleyen</div>
                        </div>
                        <div class="diary-stat-box approved">
                            <div class="diary-stat-number">@studentGroup.ApprovedEntries</div>
                            <div class="diary-stat-label">Onaylanan</div>
                        </div>
                        <div class="diary-stat-box last">
                            <div class="diary-stat-number">@(studentGroup.LastEntryDate?.ToString("dd.MM") ?? "-")</div>
                            <div class="diary-stat-label">Son Girdi</div>
                        </div>
                    </div>
                    
                    <!-- Ýlerleme Çubuðu -->
                    @{
                        var progress = studentGroup.TotalEntries > 0 
                            ? (int)((double)studentGroup.ApprovedEntries / studentGroup.TotalEntries * 100) 
                            : 0;
                    }
                    <div class="px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                        <div class="flex justify-between text-xs text-gray-500 mb-2">
                            <span>Onay Ýlerlemesi</span>
                            <span class="font-semibold">%@progress</span>
                        </div>
                        <div class="progress-premium">
                            <div class="progress-premium-bar" style="width: @progress%"></div>
                        </div>
                    </div>
                    
                    <!-- Aksiyon Butonu -->
                    <div class="p-4 border-t border-gray-100 dark:border-gray-700">
                        <button onclick="openStudentDiaryModal(@studentGroup.Student.Id, '@studentGroup.Student.FullName', @(studentGroup.DiaryId.HasValue ? studentGroup.DiaryId.Value.ToString() : "null"))" 
                                class="w-full btn-premium btn-premium-primary">
                            <i class="fas fa-eye"></i>
                            <span>Defteri Ýncele</span>
                            @if (studentGroup.PendingEntries > 0)
                            {
                                <span class="ml-2 px-2 py-0.5 rounded-full bg-white/20 text-xs">@studentGroup.PendingEntries yeni</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Sayfalama -->
        @if (Model.TotalItems > Model.PageSize)
        {
            <div class="flex justify-center mt-8">
                <nav class="flex items-center gap-2">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" 
                           class="btn-premium btn-premium-outline">
                            <i class="fas fa-chevron-left"></i>
                            Önceki
                        </a>
                    }
                    
                    <div class="flex gap-1">
                        @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                        {
                            <a asp-action="Index" asp-route-page="@i" 
                               class="w-10 h-10 rounded-xl flex items-center justify-center font-semibold transition-all @(i == Model.CurrentPage ? "bg-indigo-600 text-white shadow-lg" : "bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700")">
                                @i
                            </a>
                        }
                    </div>
                    
                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" 
                           class="btn-premium btn-premium-outline">
                            Sonraki
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                </nav>
            </div>
        }
    }
    else
    {
        <div class="empty-state-premium animate-fade-in-up">
            <div class="empty-state-icon">
                <i class="fas fa-book-open"></i>
            </div>
            <h3 class="empty-state-title">Staj Defteri Bulunamadý</h3>
            <p class="empty-state-description">
                @if (!string.IsNullOrEmpty(Model.Filters.StudentName) || !string.IsNullOrEmpty(Model.Filters.Status))
                {
                    <span>Arama kriterlerinize uygun staj defteri bulunamadý.</span>
                }
                else
                {
                    <span>Bölümünüzden henüz staj defteri tutan öðrenci bulunmamaktadýr.</span>
                }
            </p>
            <a asp-action="Index" class="btn-premium btn-premium-primary mt-4">
                <i class="fas fa-undo mr-2"></i>Filtreleri Temizle
            </a>
        </div>
    }
</div>

@Html.AntiForgeryToken()

<!-- Öðrenci Staj Defteri Modal -->
<div id="studentDiaryModal" class="modal-premium-overlay">
    <div class="modal-premium max-w-5xl">
        <div class="modal-premium-header">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
                        <i class="fas fa-book-open text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold" id="studentName">Öðrenci Staj Defteri</h2>
                        <p class="text-white/70 text-sm">Günlük girdileri inceleyin</p>
                    </div>
                </div>
                <button onclick="closeStudentDiaryModal()" class="w-10 h-10 rounded-xl bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-white"></i>
                </button>
            </div>
        </div>
        
        <div class="modal-premium-body">
            <!-- Loading -->
            <div id="diaryLoading" class="text-center py-12">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-indigo-100 flex items-center justify-center">
                    <i class="fas fa-spinner fa-spin text-indigo-600 text-2xl"></i>
                </div>
                <p class="text-gray-500">Staj defteri yükleniyor...</p>
            </div>
            
            <!-- Diary Entries Content -->
            <div id="diaryEntriesContent" class="hidden"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStudentId = null;
        let currentDiaryId = null;
        let currentStudentEntries = [];
        
        // Modal açma/kapama
        function openStudentDiaryModal(studentId, studentName, diaryId) {
            currentStudentId = studentId;
            currentDiaryId = diaryId || null;
            
            document.getElementById('studentName').textContent = studentName + ' - Staj Defteri';
            document.getElementById('studentDiaryModal').classList.add('active');
            document.getElementById('diaryLoading').classList.remove('hidden');
            document.getElementById('diaryEntriesContent').classList.add('hidden');
            document.body.style.overflow = 'hidden';
            
            const url = `/Advisor/AdvisorDiary/GetStudentDiaryEntries/${studentId}?diaryId=${currentDiaryId || ''}`;
            fetch(url)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        currentStudentEntries = data.entries;
                        renderDiaryEntries(data.entries);
                    } else {
                        alert(data.message || 'Hata oluþtu');
                        closeStudentDiaryModal();
                    }
                })
                .catch(err => {
                    alert('Hata: ' + err.message);
                    closeStudentDiaryModal();
                })
                .finally(() => {
                    document.getElementById('diaryLoading').classList.add('hidden');
                    document.getElementById('diaryEntriesContent').classList.remove('hidden');
                });
        }
        
        function closeStudentDiaryModal() {
            document.getElementById('studentDiaryModal').classList.remove('active');
            document.body.style.overflow = 'auto';
            currentStudentId = null;
            currentDiaryId = null;
            currentStudentEntries = [];
        }
        
        // Defter girdilerini render et
        function renderDiaryEntries(entries) {
            const content = document.getElementById('diaryEntriesContent');
            
            if (!entries || entries.length === 0) {
                content.innerHTML = `
                    <div class="empty-state-premium">
                        <div class="empty-state-icon">
                            <i class="fas fa-book"></i>
                        </div>
                        <h3 class="empty-state-title">Henüz Girdi Yok</h3>
                        <p class="empty-state-description">Bu öðrenci henüz staj defteri girdisi yapmamýþ.</p>
                    </div>
                `;
                return;
            }
            
            const groupedEntries = groupEntriesByDate(entries);
            
            let html = `
                <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                    <div class="flex items-center gap-2">
                        <span class="text-lg font-bold text-gray-900 dark:text-white">
                            <i class="fas fa-calendar-alt mr-2 text-indigo-500"></i>Toplam ${entries.length} Girdi
                        </span>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="filterEntries('all')" class="px-4 py-2 rounded-xl text-sm font-medium transition-all bg-indigo-100 text-indigo-700 entry-filter active" data-filter="all">
                            Tümü
                        </button>
                        <button onclick="filterEntries('pending')" class="px-4 py-2 rounded-xl text-sm font-medium transition-all bg-gray-100 text-gray-600 hover:bg-yellow-100 hover:text-yellow-700 entry-filter" data-filter="pending">
                            <i class="fas fa-clock mr-1"></i>Bekleyen
                        </button>
                        <button onclick="filterEntries('approved')" class="px-4 py-2 rounded-xl text-sm font-medium transition-all bg-gray-100 text-gray-600 hover:bg-green-100 hover:text-green-700 entry-filter" data-filter="approved">
                            <i class="fas fa-check mr-1"></i>Onaylý
                        </button>
                    </div>
                </div>
                <div class="space-y-6" id="entriesList">
            `;
            
            for (const dateGroup of groupedEntries) {
                html += `
                    <div class="date-group">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center">
                                <i class="fas fa-calendar text-indigo-600 dark:text-indigo-400"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-900 dark:text-white">${dateGroup.date}</h4>
                                <p class="text-xs text-gray-500">${dateGroup.entries.length} girdi</p>
                            </div>
                        </div>
                        <div class="space-y-3 pl-6 border-l-2 border-indigo-200 dark:border-indigo-800">
                `;
                
                for (const entry of dateGroup.entries) {
                    const statusClass = entry.isApproved ? 'approved' : 'pending';
                    const statusText = entry.isApproved ? 'Onaylandý' : 'Beklemede';
                    const statusBadgeClass = entry.isApproved ? 'badge-approved' : 'badge-pending';
                    
                    html += `
                        <div class="diary-entry-card ${statusClass}" data-status="${statusClass}">
                            <div class="flex items-start justify-between gap-4 mb-3">
                                <div class="flex-1">
                                    <h5 class="font-semibold text-gray-900 dark:text-white mb-2">${entry.title}</h5>
                                    <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
                                        <span><i class="fas fa-clock mr-1"></i>${entry.workingHours} saat</span>
                                        <span class="badge-premium ${statusBadgeClass}">
                                            <i class="fas fa-${entry.isApproved ? 'check' : 'clock'}"></i>
                                            ${statusText}
                                        </span>
                                    </div>
                                </div>
                                ${!entry.isApproved ? `
                                <div class="flex gap-2">
                                    <button onclick="approveEntry(${entry.id}, '${entry.title}')" class="application-action-btn approve" title="Onayla">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button onclick="rejectEntry(${entry.id}, '${entry.title}')" class="application-action-btn reject" title="Reddet">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                ` : ''}
                            </div>
                            
                            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-3 mb-3">
                                <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">${entry.content}</p>
                            </div>
                            
                            ${entry.learnedTopics ? `
                            <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-xl p-3 mb-3">
                                <p class="text-xs font-semibold text-yellow-700 dark:text-yellow-300 mb-1">
                                    <i class="fas fa-lightbulb mr-1"></i>Öðrenilenler
                                </p>
                                <p class="text-sm text-yellow-800 dark:text-yellow-200">${entry.learnedTopics}</p>
                            </div>
                            ` : ''}
                            
                            ${entry.challenges ? `
                            <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl p-3 mb-3">
                                <p class="text-xs font-semibold text-orange-700 dark:text-orange-300 mb-1">
                                    <i class="fas fa-exclamation-triangle mr-1"></i>Karþýlaþýlan Zorluklar
                                </p>
                                <p class="text-sm text-orange-800 dark:text-orange-200">${entry.challenges}</p>
                            </div>
                            ` : ''}
                            
                            <div class="border-t border-gray-100 dark:border-gray-700 pt-3">
                                <p class="text-xs font-semibold text-purple-700 dark:text-purple-300 mb-2">
                                    <i class="fas fa-comment mr-1"></i>Danýþman Yorumu
                                </p>
                                ${entry.advisorFeedback ? `
                                    <div class="bg-purple-50 dark:bg-purple-900/20 rounded-xl p-3">
                                        <p class="text-sm text-purple-800 dark:text-purple-200">${entry.advisorFeedback}</p>
                                    </div>
                                ` : `
                                    <div class="flex gap-2">
                                        <textarea id="comment_${entry.id}" class="flex-1 filter-input-premium text-sm" rows="2" placeholder="Yorumunuzu yazýn..."></textarea>
                                        <button onclick="submitComment(${entry.id})" class="btn-premium btn-premium-primary h-fit">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </div>
                                `}
                            </div>
                        </div>
                    `;
                }
                
                html += `</div></div>`;
            }
            
            html += '</div>';
            content.innerHTML = html;
        }
        
        function groupEntriesByDate(entries) {
            const groups = {};
            entries.forEach(entry => {
                const date = new Date(entry.date).toLocaleDateString('tr-TR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    weekday: 'long'
                });
                if (!groups[date]) groups[date] = [];
                groups[date].push(entry);
            });
            return Object.keys(groups)
                .sort((a, b) => new Date(groups[b][0].date) - new Date(groups[a][0].date))
                .map(date => ({ date, entries: groups[date] }));
        }
        
        function filterEntries(filter) {
            document.querySelectorAll('.entry-filter').forEach(btn => {
                btn.classList.remove('bg-indigo-100', 'text-indigo-700');
                btn.classList.add('bg-gray-100', 'text-gray-600');
            });
            document.querySelector(`[data-filter="${filter}"]`).classList.remove('bg-gray-100', 'text-gray-600');
            document.querySelector(`[data-filter="${filter}"]`).classList.add('bg-indigo-100', 'text-indigo-700');
            
            document.querySelectorAll('.diary-entry-card').forEach(entry => {
                const status = entry.dataset.status;
                entry.style.display = (filter === 'all' || status === filter) ? 'block' : 'none';
            });
            
            document.querySelectorAll('.date-group').forEach(group => {
                const visible = group.querySelectorAll('.diary-entry-card:not([style*="display: none"])');
                group.style.display = visible.length ? 'block' : 'none';
            });
        }
        
        function submitComment(entryId) {
            const comment = document.getElementById(`comment_${entryId}`).value.trim();
            if (!comment) { alert('Lütfen bir yorum yazýn.'); return; }
            
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Advisor/AdvisorDiary/ApproveEntry';
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = '__RequestVerificationToken';
                input.value = token.value;
                form.appendChild(input);
            }
            
            ['entryId', 'feedback'].forEach((name, i) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = i === 0 ? entryId : comment;
                form.appendChild(input);
            });
            
            document.body.appendChild(form);
            form.submit();
        }
        
        function approveEntry(entryId, title) {
            if (confirm(`"${title}" girdisini onaylamak istiyor musunuz?`)) {
                submitComment(entryId);
            }
        }
        
        function rejectEntry(entryId, title) {
            const reason = prompt(`"${title}" girdisini neden reddediyorsunuz?`);
            if (reason && reason.trim()) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Advisor/AdvisorDiary/RejectEntry';
                
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = '__RequestVerificationToken';
                    input.value = token.value;
                    form.appendChild(input);
                }
                
                [['DiaryEntryId', entryId], ['Feedback', reason.trim()]].forEach(([name, value]) => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = value;
                    form.appendChild(input);
                });
                
                document.body.appendChild(form);
                form.submit();
            }
        }
        
        // Modal dýþýna týklama
        document.getElementById('studentDiaryModal').addEventListener('click', function(e) {
            if (e.target === this) closeStudentDiaryModal();
        });
        
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeStudentDiaryModal();
        });
    </script>
}
