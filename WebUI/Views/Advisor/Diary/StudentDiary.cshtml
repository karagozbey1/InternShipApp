@model WebUI.Models.ViewModels.Advisor.AdvisorDiaryDetailViewModel
@{
    ViewData["Title"] = "Öðrenci Staj Defteri";
    Layout = "_AppLayout";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-lg dark:from-blue-900/20 dark:to-indigo-900/20 dark:border-blue-700">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-2">
                    <i class="fas fa-book mr-3"></i>@Model.StudentName - Staj Defteri
                </h1>
                <p class="text-blue-600 dark:text-blue-300">
                    <i class="fas fa-building mr-2"></i>@Model.CompanyName - @Model.InternshipStartDate?.ToString("dd MMMM yyyy") - @Model.InternshipEndDate?.ToString("dd MMMM yyyy")
                </p>
            </div>
            <div class="flex gap-3">
                <button onclick="exportDiaryPdf()" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition-colors">
                    <i class="fas fa-file-pdf mr-2"></i>PDF Ýndir
                </button>
                <a asp-controller="AdvisorDiary" asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Ýstatistikler -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center">
                <div class="p-3 bg-blue-100 dark:bg-blue-900 rounded-full">
                    <i class="fas fa-calendar-check text-blue-500 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Toplam Girdi</p>
                    <p class="text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.TotalEntries</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center">
                <div class="p-3 bg-green-100 dark:bg-green-900 rounded-full">
                    <i class="fas fa-check-circle text-green-500 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Onaylanan</p>
                    <p class="text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.ApprovedEntries</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center">
                <div class="p-3 bg-yellow-100 dark:bg-yellow-900 rounded-full">
                    <i class="fas fa-clock text-yellow-500 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Bekleyen</p>
                    <p class="text-2xl font-bold text-gray-900 dark:text-gray-100">@Model.PendingEntries</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center">
                <div class="p-3 bg-purple-100 dark:bg-purple-900 rounded-full">
                    <i class="fas fa-chart-line text-purple-500 text-xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Toplam Saat</p>
                    <p class="text-2xl font-bold text-gray-900 dark:text-gray-100">@(Model.DiaryEntries?.Sum(x => x.Entry.WorkingHours) ?? 0)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtreler -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
                <i class="fas fa-filter mr-2 text-blue-500"></i>Defter Girdileri
            </h2>
            <div class="flex gap-2">
                <button onclick="filterEntries('all')" class="px-3 py-1 bg-blue-500 text-white rounded-lg text-sm hover:bg-blue-600 transition-colors entry-filter active" data-filter="all">
                    Tümü
                </button>
                <button onclick="filterEntries('pending')" class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors entry-filter" data-filter="pending">
                    Bekleyen
                </button>
                <button onclick="filterEntries('approved')" class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg text-sm hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors entry-filter" data-filter="approved">
                    Onaylanan
                </button>
            </div>
        </div>

        @if (Model.DiaryEntries?.Any() == true)
        {
            <div class="space-y-4" id="diary-entries-container">
                @foreach (var entryWithStatus in Model.DiaryEntries.OrderByDescending(x => x.Entry.Date))
                {
                    <div class="diary-entry-card bg-gradient-to-r from-gray-50 to-white dark:from-gray-700 dark:to-gray-800 rounded-lg border border-gray-200 dark:border-gray-600 p-6 shadow-sm hover:shadow-md transition-all duration-300" 
                         data-status="@(entryWithStatus.Entry.IsApproved ? "approved" : "pending")">
                        
                        <!-- Entry Header -->
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center gap-4">
                                <div class="p-3 bg-blue-100 dark:bg-blue-900 rounded-lg">
                                    <i class="fas fa-book-open text-blue-500 text-lg"></i>
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">@entryWithStatus.Entry.Title</h3>
                                    <div class="flex items-center gap-4 mt-1">
                                        <span class="text-sm text-gray-600 dark:text-gray-400">
                                            <i class="fas fa-calendar mr-1"></i>@entryWithStatus.Entry.Date.ToString("dd MMMM yyyy")
                                        </span>
                                        <span class="text-sm text-gray-600 dark:text-gray-400">
                                            <i class="fas fa-clock mr-1"></i>@entryWithStatus.Entry.WorkingHours saat
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="bg-@(entryWithStatus.Entry.IsApproved ? "green" : "yellow")-100 text-@(entryWithStatus.Entry.IsApproved ? "green" : "yellow")-800 dark:bg-@(entryWithStatus.Entry.IsApproved ? "green" : "yellow")-900 dark:text-@(entryWithStatus.Entry.IsApproved ? "green" : "yellow")-200 px-3 py-1 rounded-full text-sm">
                                    <i class="fas fa-@(entryWithStatus.Entry.IsApproved ? "check" : "clock") mr-1"></i>@entryWithStatus.StatusText
                                </span>
                                @if (!entryWithStatus.Entry.IsApproved)
                                {
                                    <button onclick="showApprovalModal(@entryWithStatus.Entry.Id, '@entryWithStatus.Entry.Title')" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded-lg text-sm transition-colors">
                                        <i class="fas fa-check mr-1"></i>Onayla
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Entry Content -->
                        <div class="mb-4">
                            <h4 class="font-medium text-gray-800 dark:text-gray-200 mb-2">Ýçerik:</h4>
                            <p class="text-gray-700 dark:text-gray-300 leading-relaxed">@entryWithStatus.Entry.Content</p>
                        </div>

                        <!-- Additional Details -->
                        @if (!string.IsNullOrEmpty(entryWithStatus.Entry.LearnedTopics) || !string.IsNullOrEmpty(entryWithStatus.Entry.Challenges))
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                @if (!string.IsNullOrEmpty(entryWithStatus.Entry.LearnedTopics))
                                {
                                    <div class="bg-yellow-50 dark:bg-yellow-900 rounded-lg p-3">
                                        <h5 class="font-medium text-yellow-800 dark:text-yellow-200 mb-1">
                                            <i class="fas fa-lightbulb mr-1"></i>Öðrenilenler
                                        </h5>
                                        <p class="text-yellow-700 dark:text-yellow-300 text-sm">@entryWithStatus.Entry.LearnedTopics</p>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(entryWithStatus.Entry.Challenges))
                                {
                                    <div class="bg-orange-50 dark:bg-orange-900 rounded-lg p-3">
                                        <h5 class="font-medium text-orange-800 dark:text-orange-200 mb-1">
                                            <i class="fas fa-exclamation-triangle mr-1"></i>Zorluklar
                                        </h5>
                                        <p class="text-orange-700 dark:text-orange-300 text-sm">@entryWithStatus.Entry.Challenges</p>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Advisor Feedback -->
                        @if (!string.IsNullOrEmpty(entryWithStatus.Entry.AdvisorFeedback))
                        {
                            <div class="bg-blue-50 dark:bg-blue-900 rounded-lg p-4 border-l-4 border-blue-500">
                                <h5 class="font-medium text-blue-800 dark:text-blue-200 mb-2">
                                    <i class="fas fa-comment mr-1"></i>Verilen Geri Bildirim
                                </h5>
                                <p class="text-blue-700 dark:text-blue-300">@entryWithStatus.Entry.AdvisorFeedback</p>
                                @if (entryWithStatus.Entry.ApprovedAt.HasValue)
                                {
                                    <p class="text-xs text-blue-600 dark:text-blue-400 mt-2">
                                        <i class="fas fa-clock mr-1"></i>@entryWithStatus.Entry.ApprovedAt.Value.ToString("dd MMMM yyyy HH:mm")
                                    </p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <i class="fas fa-book text-6xl text-gray-400 mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">Henüz staj defteri girdisi yok</h3>
                <p class="text-gray-500 dark:text-gray-500">Öðrenci henüz staj defteri oluþturmamýþ.</p>
            </div>
        }
    </div>
</div>

<!-- Onay Modal -->
<div id="approvalModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-md w-full">
            <div class="p-6">
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Staj Defteri Onayý</h2>
                    <button onclick="closeApprovalModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                
                <form id="approvalForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="entryIdInput" name="entryId" />
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Geri Bildirim (Ýsteðe baðlý)
                        </label>
                        <textarea name="feedback" rows="4" 
                                  class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200"
                                  placeholder="Öðrenciye verilecek geri bildirim..."></textarea>
                    </div>
                    
                    <div class="flex gap-3">
                        <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition-colors">
                            <i class="fas fa-check mr-2"></i>Onayla
                        </button>
                        <button type="button" onclick="closeApprovalModal()" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                            <i class="fas fa-times mr-2"></i>Ýptal
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterEntries(filter) {
            const entries = document.querySelectorAll('.diary-entry-card');
            const buttons = document.querySelectorAll('.entry-filter');
            
            // Update button styles
            buttons.forEach(btn => {
                btn.classList.remove('active', 'bg-blue-500', 'text-white');
                btn.classList.add('bg-gray-100', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            });
            
            const activeButton = document.querySelector(`[data-filter="${filter}"]`);
            activeButton.classList.add('active', 'bg-blue-500', 'text-white');
            activeButton.classList.remove('bg-gray-100', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
            
            // Filter entries
            entries.forEach(entry => {
                const status = entry.dataset.status;
                let shouldShow = false;
                
                switch(filter) {
                    case 'all':
                        shouldShow = true;
                        break;
                    case 'pending':
                        shouldShow = status === 'pending';
                        break;
                    case 'approved':
                        shouldShow = status === 'approved';
                        break;
                }
                
                if (shouldShow) {
                    entry.style.display = 'block';
                    setTimeout(() => {
                        entry.style.opacity = '1';
                        entry.style.transform = 'translateY(0)';
                    }, 10);
                } else {
                    entry.style.opacity = '0';
                    entry.style.transform = 'translateY(20px)';
                    setTimeout(() => {
                        entry.style.display = 'none';
                    }, 300);
                }
            });
        }

        function showApprovalModal(entryId, entryTitle) {
            document.getElementById('entryIdInput').value = entryId;
            document.getElementById('approvalForm').action = `/Advisor/AdvisorDiary/ApproveEntry`;
            document.getElementById('approvalModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeApprovalModal() {
            document.getElementById('approvalModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function exportDiaryPdf() {
            // PDF export fonksiyonu
            alert('PDF export özelliði yakýnda eklenecek.');
        }

        // Modal dýþýna týklanýnca kapat
        document.getElementById('approvalModal').addEventListener('click', function(e) {
            if (e.target === this) closeApprovalModal();
        });

        // ESC tuþu ile modal kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeApprovalModal();
            }
        });
    </script>
}
