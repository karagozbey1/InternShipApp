@model WebUI.Models.ViewModels.Advisor.AdvisorReportViewModel
@{
    ViewData["Title"] = "Raporlar";
    Layout = "_AppLayout";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-indigo-50 to-cyan-50 border border-indigo-200 shadow-lg dark:from-indigo-900/20 dark:to-cyan-900/20 dark:border-indigo-700">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-indigo-800 dark:text-indigo-200 mb-2">
                    <i class="fas fa-chart-line me-3"></i>Raporlar ve Analizler
                </h1>
                <p class="text-indigo-600 dark:text-indigo-300">
                    <i class="fas fa-university mr-2"></i>@Model.AdvisorInfo.UniversityName - @Model.AdvisorInfo.Department Bölümü
                </p>
                <p class="text-sm text-indigo-500 dark:text-indigo-400">
                    Öðrenci aktiviteleri ve performans analizleri
                </p>
            </div>
            <div class="flex gap-3">
                <button onclick="exportReport('excel')" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition-colors">
                    <i class="fas fa-download mr-2"></i>Excel Ýndir
                </button>
                <a asp-controller="AdvisorDashboard" asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Period Filter -->
        <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4">
                <i class="fas fa-calendar mr-2"></i>Dönem Seçimi
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <a asp-action="Index" asp-route-period="today" asp-route-reportType="@Model.CurrentReportType" 
                   class="period-btn @(Model.CurrentPeriod == "today" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Bugün
                </a>
                <a asp-action="Index" asp-route-period="thisWeek" asp-route-reportType="@Model.CurrentReportType"
                   class="period-btn @(Model.CurrentPeriod == "thisWeek" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Bu Hafta
                </a>
                <a asp-action="Index" asp-route-period="thisMonth" asp-route-reportType="@Model.CurrentReportType"
                   class="period-btn @(Model.CurrentPeriod == "thisMonth" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Bu Ay
                </a>
                <a asp-action="Index" asp-route-period="thisYear" asp-route-reportType="@Model.CurrentReportType"
                   class="period-btn @(Model.CurrentPeriod == "thisYear" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Bu Yýl
                </a>
            </div>
        </div>

        <!-- Report Type Filter -->
        <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4">
                <i class="fas fa-chart-bar mr-2"></i>Rapor Türü
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <a asp-action="Index" asp-route-reportType="overview" asp-route-period="@Model.CurrentPeriod"
                   class="report-type-btn @(Model.CurrentReportType == "overview" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Genel
                </a>
                <a asp-action="Index" asp-route-reportType="applications" asp-route-period="@Model.CurrentPeriod"
                   class="report-type-btn @(Model.CurrentReportType == "applications" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Baþvurular
                </a>
                <a asp-action="Index" asp-route-reportType="diaries" asp-route-period="@Model.CurrentPeriod"
                   class="report-type-btn @(Model.CurrentReportType == "diaries" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Staj Defterleri
                </a>
                <a asp-action="Index" asp-route-reportType="students" asp-route-period="@Model.CurrentPeriod"
                   class="report-type-btn @(Model.CurrentReportType == "students" ? "active" : "") px-3 py-2 rounded-lg text-sm font-medium transition-colors text-center">
                    Öðrenciler
                </a>
            </div>
        </div>
    </div>

    @if (Model.CurrentReportType == "overview" && Model.Summary != null)
    {
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
            <div class="summary-card bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-100 text-sm">Toplam Öðrenci</p>
                        <p class="text-3xl font-bold">@Model.Summary.TotalStudents</p>
                    </div>
                    <i class="fas fa-users text-2xl opacity-80"></i>
                </div>
            </div>
            <div class="summary-card bg-gradient-to-br from-green-500 to-green-600 text-white rounded-xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-100 text-sm">Aktif Öðrenci</p>
                        <p class="text-3xl font-bold">@Model.Summary.ActiveStudents</p>
                    </div>
                    <i class="fas fa-user-check text-2xl opacity-80"></i>
                </div>
            </div>
            <div class="summary-card bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-purple-100 text-sm">Toplam Baþvuru</p>
                        <p class="text-3xl font-bold">@Model.Summary.TotalApplications</p>
                    </div>
                    <i class="fas fa-file-alt text-2xl opacity-80"></i>
                </div>
            </div>
            <div class="summary-card bg-gradient-to-br from-yellow-500 to-yellow-600 text-white rounded-xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-100 text-sm">Defteri Girdileri</p>
                        <p class="text-3xl font-bold">@Model.Summary.TotalDiaryEntries</p>
                    </div>
                    <i class="fas fa-book text-2xl opacity-80"></i>
                </div>
            </div>
            <div class="summary-card bg-gradient-to-br from-red-500 to-red-600 text-white rounded-xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-red-100 text-sm">Toplam Saat</p>
                        <p class="text-3xl font-bold">@Model.Summary.TotalWorkingHours.ToString("F0")</p>
                    </div>
                    <i class="fas fa-clock text-2xl opacity-80"></i>
                </div>
            </div>
        </div>

        <!-- Activity Chart -->
        @if (Model.ActivityData.Any())
        {
            <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4">
                    <i class="fas fa-chart-line mr-2"></i>Günlük Aktivite Grafiði
                </h3>
                <canvas id="activityChart" width="400" height="200"></canvas>
            </div>
        }
    }

    @if (Model.CurrentReportType == "applications")
    {
        @if (Model.ApplicationStatistics.Any())
        {
            <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4">
                    <i class="fas fa-file-alt mr-2"></i>Baþvuru Ýstatistikleri
                </h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                            <tr>
                                <th class="px-6 py-3">Öðrenci</th>
                                <th class="px-6 py-3">Toplam</th>
                                <th class="px-6 py-3">Onaylanan</th>
                                <th class="px-6 py-3">Bekleyen</th>
                                <th class="px-6 py-3">Reddedilen</th>
                                <th class="px-6 py-3">Baþarý Oraný</th>
                                <th class="px-6 py-3">Son Baþvuru</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in Model.ApplicationStatistics)
                            {
                                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                                    <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                                        @stat.StudentName
                                        <div class="text-xs text-gray-500">@stat.StudentEmail</div>
                                    </td>
                                    <td class="px-6 py-4">@stat.TotalApplications</td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs">
                                            @stat.ApprovedApplications
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs">
                                            @stat.PendingApplications
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 bg-red-100 text-red-800 rounded-full text-xs">
                                            @stat.RejectedApplications
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                                            <div class="bg-blue-600 h-2.5 rounded-full" style="width: @(stat.SuccessRate)%"></div>
                                        </div>
                                        <span class="text-xs text-gray-600">@stat.SuccessRate.ToString("F1")%</span>
                                    </td>
                                    <td class="px-6 py-4 text-xs">
                                        @(stat.LastApplicationDate?.ToString("dd.MM.yyyy") ?? "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-12 bg-white dark:bg-gray-800 rounded-xl shadow-lg">
                <i class="fas fa-file-alt text-gray-400 text-6xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">Baþvuru Verisi Bulunamadý</h3>
                <p class="text-gray-500 dark:text-gray-500">Seçilen dönemde baþvuru bulunmamaktadýr.</p>
            </div>
        }
    }

    @if (Model.CurrentReportType == "diaries")
    {
        @if (Model.DiaryStatistics.Any())
        {
            <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4">
                    <i class="fas fa-book mr-2"></i>Staj Defteri Ýstatistikleri
                </h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                            <tr>
                                <th class="px-6 py-3">Öðrenci</th>
                                <th class="px-6 py-3">Toplam Girdi</th>
                                <th class="px-6 py-3">Onaylanan</th>
                                <th class="px-6 py-3">Bekleyen</th>
                                <th class="px-6 py-3">Toplam Saat</th>
                                <th class="px-6 py-3">Ortalama Saat</th>
                                <th class="px-6 py-3">Onay Oraný</th>
                                <th class="px-6 py-3">Son Girdi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in Model.DiaryStatistics)
                            {
                                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                                    <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                                        @stat.StudentName
                                        <div class="text-xs text-gray-500">@stat.StudentEmail</div>
                                    </td>
                                    <td class="px-6 py-4">@stat.TotalEntries</td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs">
                                            @stat.ApprovedEntries
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs">
                                            @stat.PendingEntries
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">@stat.TotalHours.ToString("F1")</td>
                                    <td class="px-6 py-4">@stat.AverageHoursPerEntry.ToString("F1")</td>
                                    <td class="px-6 py-4">
                                        <div class="w-full bg-gray-200 rounded-full h-2.5">
                                            <div class="bg-green-600 h-2.5 rounded-full" style="width: @(stat.ApprovalRate)%"></div>
                                        </div>
                                        <span class="text-xs text-gray-600">@stat.ApprovalRate.ToString("F1")%</span>
                                    </td>
                                    <td class="px-6 py-4 text-xs">
                                        @(stat.LastEntryDate?.ToString("dd.MM.yyyy") ?? "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-12 bg-white dark:bg-gray-800 rounded-xl shadow-lg">
                <i class="fas fa-book text-gray-400 text-6xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">Staj Defteri Verisi Bulunamadý</h3>
                <p class="text-gray-500 dark:text-gray-500">Seçilen dönemde staj defteri girdisi bulunmamaktadýr.</p>
            </div>
        }
    }

    @if (Model.CurrentReportType == "students")
    {
        @if (Model.StudentReports.Any())
        {
            <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-4">
                    <i class="fas fa-users mr-2"></i>Öðrenci Aktivite Raporu
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var student in Model.StudentReports)
                    {
                        <div class="student-report-card bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg border border-gray-200 dark:border-gray-700">
                            <div class="flex items-center justify-between mb-4">
                                <h4 class="text-lg font-semibold text-gray-900 dark:text-white">@student.StudentName</h4>
                                <span class="px-2 py-1 rounded-full text-xs font-medium @(student.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                    @student.ActivityStatus
                                </span>
                            </div>
                            
                            <div class="space-y-3">
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600 dark:text-gray-400">Baþvurular:</span>
                                    <span class="font-medium">@student.TotalApplications</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600 dark:text-gray-400">Defteri Girdileri:</span>
                                    <span class="font-medium">@student.TotalDiaryEntries</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600 dark:text-gray-400">Çalýþma Saati:</span>
                                    <span class="font-medium">@student.TotalWorkingHours.ToString("F1")</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-600 dark:text-gray-400">Son Aktivite:</span>
                                    <span class="font-medium text-xs">
                                        @(student.LastActivity?.ToString("dd.MM.yyyy") ?? "Yok")
                                    </span>
                                </div>
                            </div>
                            
                            <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-600">
                                <p class="text-xs text-gray-500 dark:text-gray-400">@student.StudentEmail</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400">@student.Department</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-12 bg-white dark:bg-gray-800 rounded-xl shadow-lg">
                <i class="fas fa-users text-gray-400 text-6xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">Öðrenci Verisi Bulunamadý</h3>
                <p class="text-gray-500 dark:text-gray-500">Seçilen dönemde aktif öðrenci bulunmamaktadýr.</p>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (Model.ActivityData.Any())
        {
            <text>
            const ctx = document.getElementById('activityChart').getContext('2d');
            const activityChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.ActivityData.Select(d => $"'{d.Date}'")))],
                    datasets: [
                        {
                            label: 'Baþvurular',
                            data: [@Html.Raw(string.Join(",", Model.ActivityData.Select(d => d.Applications)))],
                            borderColor: 'rgb(59, 130, 246)',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            tension: 0.4
                        },
                        {
                            label: 'Staj Defteri Girdileri',
                            data: [@Html.Raw(string.Join(",", Model.ActivityData.Select(d => d.DiaryEntries)))],
                            borderColor: 'rgb(16, 185, 129)',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                }
            });
            </text>
        }

        function exportReport(format) {
            const currentParams = new URLSearchParams(window.location.search);
            const period = currentParams.get('period') || '@Model.CurrentPeriod';
            const reportType = currentParams.get('reportType') || '@Model.CurrentReportType';
            
            window.location.href = `/Advisor/AdvisorReport/Export/${reportType}?period=${period}&format=${format}`;
        }
    </script>
}

@section Styles {
    <style>
        .period-btn, .report-type-btn {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #6b7280;
        }
        
        .period-btn.active, .report-type-btn.active {
            background: #6366f1;
            color: white;
            border-color: #6366f1;
        }
        
        .period-btn:hover:not(.active), .report-type-btn:hover:not(.active) {
            background: rgba(255, 255, 255, 0.9);
            color: #374151;
        }

        .summary-card {
            transition: all 0.3s ease;
        }

        .summary-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .student-report-card {
            transition: all 0.3s ease;
        }

        .student-report-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        #activityChart {
            height: 300px !important;
        }
    </style>
}
