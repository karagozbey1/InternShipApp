@model WebUI.Models.ViewModels.Home.AnnouncementOffersViewModel
@{
    ViewData["Title"] = "Duyurular / Aktif Ýlanlar";
    Layout = "_PublicLayout";
    var isStudent = User.IsInRole("Student");
    bool isAuth = User.Identity?.IsAuthenticated == true;
}
<link rel="stylesheet" href="~/css/announcements.css" />
<div class="container-fluid px-4 py-4" id="offersRoot" data-page-size="@Model.PageSize" data-initial-page="@Model.Page">
    <form method="get" id="filterForm" class="offer-filters row gy-2 gx-2 align-items-end mb-4" onsubmit="return false;">
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label fw-semibold mb-1">Arama</label>
            <div class="position-relative">
                <i class="fas fa-search position-absolute filter-icon"></i>
                <input type="text" name="q" value="@Model.Query" class="form-control ps-4" placeholder="Baþlýk, þirket, þehir.." />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold mb-1">Þehir</label>
            <select name="city" class="form-select">
                <option value="">Hepsi</option>
                @foreach (var c in Model.DistinctCities){<option value="@c" selected="@(Model.City==c)">@c</option>}
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold mb-1">Alan</label>
            <select name="field" class="form-select">
                <option value="">Hepsi</option>
                @foreach (var f in Model.DistinctFields){<option value="@f" selected="@(Model.Field==f)">@f</option>}
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold mb-1">Sýrala</label>
            <select name="sort" class="form-select">
                <option value="new" selected="@(Model.Sort=="new")">En Yeni</option>
                <option value="old" selected="@(Model.Sort=="old")">En Eski</option>
                <option value="title" selected="@(Model.Sort=="title")">Baþlýða Göre</option>
            </select>
        </div>
        <div class="col-6 col-md-1 d-flex">
            <button class="btn btn-primary w-100 gradient-btn mt-auto" id="applyFilters" type="button"><i class="fas fa-filter me-1"></i>Uygula</button>
        </div>
    </form>
    <div class="row g-0 offers-layout">
        <div class="col-12 col-lg-4 border-end d-flex flex-column list-column">
            <div class="list-meta small text-muted d-flex justify-content-between align-items-center px-2">
                <span id="resultSummary">Toplam @Model.TotalCount kayýt</span>
                <span id="pageSummary">Sayfa @Model.Page/@Model.TotalPages</span>
            </div>
            <div id="announcementList" class="offer-list flex-grow-1 overflow-auto">
                @foreach (var item in Model.Offers.Where(o=>o.IsActive))
                {
                    var workTypeDisplay = (item.WorkType?.Equals("Internship", StringComparison.OrdinalIgnoreCase) ?? false) ? "Staj" : item.WorkType;
                    var deadline = item.ApplicationDeadline;
                    var showDateText = deadline.HasValue ? deadline.Value.ToString("dd.MM.yyyy") : item.PublishDate.ToString("dd.MM.yyyy");
                    var jsonObj = new {
                        id = item.Id,
                        title = item.Title,
                        companyName = item.CompanyName,
                        publishDate = item.PublishDate,
                        applicationDeadline = item.ApplicationDeadline,
                        city = item.City,
                        field = item.Field,
                        position = item.Position,
                        salary = item.Salary,
                        workType = workTypeDisplay,
                        quota = item.Quota,
                        isFavorite = item.IsFavorite,
                        description = item.Description,
                        requirements = item.Requirements,
                        phone = item.Phone,
                        address = item.Address,
                        website = item.Website,
                        isActive = item.IsActive,
                        companyDescription = item.CompanyDescription,
                        employeeCount = item.EmployeeCount,
                        establishedDate = item.EstablishedDate
                    };
                    <div class="offer-tile offer-tile-enhanced" tabindex="0" onclick="annSelect(this)" data-json='@System.Text.Json.JsonSerializer.Serialize(jsonObj)'>
                        <h6 class="mb-1 offer-title text-truncate fw-bold" title="@item.Title">@item.Title</h6>
                        <div class="small text-muted mb-1 d-flex align-items-center gap-1"><i class="far fa-calendar"></i><span>Son Baþvuru: @showDateText</span></div>
                        <div class="small text-muted mb-2 text-truncate"><i class="fas fa-building me-1 text-primary"></i>@item.CompanyName</div>
                        <div class="small mb-2"><i class="fas fa-location-dot me-1 text-secondary"></i><span class="text-muted">@item.City</span></div>
                        <div class="offer-details mt-2 pt-2 border-top">
                            <div class="row g-1 small">
                                <div class="col-4 text-center"><div class="detail-box bg-light rounded p-1"><div class="text-primary fw-bold small">@(item.Position ?? item.Field ?? "-")</div><div class="text-xs text-muted">Pozisyon</div></div></div>
                                <div class="col-4 text-center"><div class="detail-box bg-light rounded p-1"><div class="text-success fw-bold small">@(workTypeDisplay ?? "-")</div><div class="text-xs text-muted">Tür</div></div></div>
                                <div class="col-4 text-center"><div class="detail-box bg-light rounded p-1"><div class="text-info fw-bold small">@(item.Salary ?? "-")</div><div class="text-xs text-muted">Maaþ</div></div></div>
                            </div>
                        </div>
                        <button type="button" class="favorite-btn" title="Favori" onclick="event.stopPropagation();annToggleFav(@item.Id,this)"><i class="@(item.IsFavorite?"fas text-warning fa-star":"far fa-star text-secondary")"></i></button>
                    </div>
                }
            </div>
            <nav class="mt-2 small" id="paginationBar">
                @if (Model.TotalPages > 1){
                    <ul class="pagination pagination-sm flex-wrap mb-0 justify-content-center">
                        <li class="page-item @(Model.Page==1?"disabled":"")"><a class="page-link" href="#" onclick="annLoad(@(Model.Page-1));return false;">Önceki</a></li>
                        @for (int i=1;i<=Model.TotalPages;i++){<li class="page-item @(Model.Page==i?"active":"")"><a class="page-link" href="#" onclick="annLoad(@i);return false;">@i</a></li>}
                        <li class="page-item @(Model.Page==Model.TotalPages?"disabled":"")"><a class="page-link" href="#" onclick="annLoad(@(Model.Page+1));return false;">Sonraki</a></li>
                    </ul>
                }
            </nav>
        </div>
        <div class="col-12 col-lg-8 detail-column">
            <div id="detailWrapper" class="p-3 h-100 d-flex flex-column">
                <div id="detailHero" class="rounded-2xl p-4 mb-4" style="background: linear-gradient(120deg,#6d28d9 0%,#5631d8 45%,#2563eb 90%); display: none;">
                    <div class="text-white">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                            <div class="flex-grow-1 pe-lg-4">
                                <h2 id="detailTitle" class="text-2xl font-bold mb-1">Ýlan Baþlýðý</h2>
                                <div id="detailMeta" class="text-sm opacity-90">Firma • Þehir • Tarih</div>
                            </div>
                            <div class="d-flex gap-2 align-self-start">
                                <button id="applyBtn" class="btn btn-success btn-lg d-none" onclick="annApply()"><i class="fas fa-paper-plane me-2"></i>Baþvuru Yap</button>
                                <button id="saveBtn" class="btn btn-light"><i class="fas fa-bookmark me-1"></i>Kaydet</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="mainContent" class="row g-4 align-items-start" style="display:none;">
                    <div class="col-lg-7" id="contentColumn">
                        <div class="card mb-4">
                            <div class="card-header bg-light"><h6 class="mb-0 text-dark"><i class="fas fa-align-left me-2"></i>Genel Açýklama</h6></div>
                            <div class="card-body"><div id="descContent" class="text-muted">Açýklama burada görünecek</div></div></div>
                        <div class="card mb-4">
                            <div class="card-header bg-light"><h6 class="mb-0 text-dark"><i class="fas fa-list me-2"></i>Gereksinimler</h6></div>
                            <div class="card-body"><div id="requirementsContent" class="text-muted">Gereksinimler burada görünecek</div></div></div>
                    </div>
                    <div class="col-lg-5" id="companyColumn">
                        <div class="card h-100">
                            <div class="card-header bg-light"><h6 class="mb-0 text-dark"><i class="fas fa-building me-2"></i>Firma Bilgileri</h6></div>
                            <div class="card-body d-flex flex-column">
                                <div class="text-center mb-4">
                                    <div id="companyLogo" class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle text-white fw-bold d-none" style="width:80px;height:80px;font-size:2rem;background:linear-gradient(45deg,#3b82f6,#9333ea);"></div>
                                    <h5 id="companyName" class="fw-bold mb-1">Firma Adý</h5>
                                    <p id="companyLocation" class="text-muted small mb-1"><i class="fas fa-map-marker-alt me-1"></i>Konum</p>
                                    <div id="companyWebsite" class="small mb-2"></div>
                                </div>
                                <div class="mb-3">
                                    <h6 class="fw-bold text-primary mb-2"><i class="fas fa-phone me-2"></i>Ýletiþim</h6>
                                    <div id="companyContent" class="small"></div>
                                </div>
                                <div class="mb-3">
                                    <h6 class="fw-bold text-primary mb-2"><i class="fas fa-info-circle me-2"></i>Hakkýnda</h6>
                                    <div id="companyAbout" class="small text-muted"></div>
                                </div>
                                <div class="mt-auto border-top pt-3 small text-center" id="companyExtra"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="defaultState" class="flex-1 d-flex align-items-center justify-content-center" style="display:flex;">
                    <div class="text-center"><i class="fas fa-mouse-pointer text-muted mb-3" style="font-size:3rem;"></i><h4 class="text-muted">Bir Ýlan Seçin</h4><p class="text-muted">Detaylarý görüntülemek için sol taraftaki listeden bir ilan seçin</p></div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>window.__isAuthenticated=@(isAuth.ToString().ToLower());window.__isStudent=@(isStudent.ToString().ToLower());</script>
    <script id="initialOffersData" type="application/json">@System.Text.Json.JsonSerializer.Serialize(new { items = Model.Offers.Where(o=>o.IsActive).Select(o => new { id=o.Id,title=o.Title,companyName=o.CompanyName,publishDate=o.PublishDate,applicationDeadline=o.ApplicationDeadline,city=o.City,field=o.Field,position=o.Position,salary=o.Salary,workType=((o.WorkType?.Equals("Internship",StringComparison.OrdinalIgnoreCase)??false)?"Staj":o.WorkType),quota=o.Quota,isFavorite=o.IsFavorite,description=o.Description,requirements=o.Requirements,phone=o.Phone,address=o.Address,website=o.Website,isActive=o.IsActive,companyDescription=o.CompanyDescription,employeeCount=o.EmployeeCount,establishedDate=o.EstablishedDate }), totalCount=Model.TotalCount,page=Model.Page,totalPages=Model.TotalPages })</script>
    <script src="~/js/announcements.js"></script>
    <style>
        .offer-tile-enhanced{padding:1rem;margin-bottom:.75rem;border:1px solid #e9ecef;border-radius:8px;transition:.2s;cursor:pointer;position:relative;background:#fff}
        .offer-tile-enhanced:hover{border-color:#007bff;box-shadow:0 2px 8px rgba(0,123,255,.15);transform:translateY(-1px)}
        .offer-tile-enhanced.active{border-color:#007bff;background:#f0f8ff;box-shadow:0 4px 12px rgba(0,123,255,.2)}
        .detail-box{min-height:48px;display:flex;flex-direction:column;justify-content:center;border:1px solid #e9ecef}
        .favorite-btn{position:absolute;top:8px;right:8px;background:none;border:0;padding:4px;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center}
        .favorite-btn:hover{background:rgba(0,0,0,.05)}
    </style>
}