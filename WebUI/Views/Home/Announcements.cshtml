@model WebUI.Models.ViewModels.Home.AnnouncementOffersViewModel
@{
    ViewData["Title"] = "Duyurular / Aktif Ilanlar";
    Layout = "_PublicLayout";
    var isStudent = User.IsInRole("Student");
    bool isAuth = User.Identity?.IsAuthenticated == true;
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
}

<style>
    .announcements-hero {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        padding: 3rem 0;
        position: relative;
        overflow: hidden;
    }
    .announcements-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 80%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    }
    
    .main-content-section {
        background: #f8fafc;
        padding: 2rem 0 4rem;
        min-height: calc(100vh - 200px);
    }
    
    .filter-section {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        margin-top: -2rem;
        position: relative;
        z-index: 10;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    .filter-input-premium {
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        transition: all 0.3s ease;
        font-size: 14px;
        width: 100%;
    }
    .filter-input-premium:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        background: white;
        outline: none;
    }
    .filter-btn-premium {
        padding: 12px 24px;
        border-radius: 12px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .filter-btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }
    
    .offers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 1.5rem;
    }
    
    .offer-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .offer-card:hover {
        border-color: #6366f1;
        box-shadow: 0 10px 40px rgba(99, 102, 241, 0.15);
        transform: translateY(-4px);
    }
    .offer-card.active {
        border-color: #6366f1;
        box-shadow: 0 10px 40px rgba(99, 102, 241, 0.2);
    }
    .offer-card-header {
        padding: 1.25rem;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(139, 92, 246, 0.05));
        border-bottom: 1px solid #f1f5f9;
    }
    .offer-card-title {
        font-weight: 700;
        color: #1e293b;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        line-height: 1.4;
    }
    .offer-card-company {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #64748b;
        margin-bottom: 0.5rem;
    }
    .offer-card-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #94a3b8;
    }
    .offer-card-body {
        padding: 1.25rem;
        flex: 1;
    }
    .offer-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 1rem;
    }
    .offer-tag {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }
    .offer-tag.position { background: rgba(99, 102, 241, 0.1); color: #6366f1; }
    .offer-tag.type { background: rgba(16, 185, 129, 0.1); color: #059669; }
    .offer-tag.salary { background: rgba(14, 165, 233, 0.1); color: #0284c7; }
    
    .offer-card-description {
        font-size: 14px;
        color: #64748b;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .offer-card-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fafbfc;
    }
    .offer-card-date {
        font-size: 12px;
        color: #94a3b8;
    }
    .btn-detail {
        padding: 8px 16px;
        border-radius: 10px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-detail:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
        color: white;
    }
    
    .pagination-premium {
        display: flex;
        justify-content: center;
        gap: 6px;
        padding: 2rem 0;
    }
    .pagination-premium .page-link {
        padding: 10px 16px;
        border-radius: 10px;
        border: none;
        background: white;
        color: #475569;
        font-weight: 500;
        font-size: 14px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .pagination-premium .page-link:hover {
        background: #f1f5f9;
    }
    .pagination-premium .page-item.active .page-link {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
    }
    .pagination-premium .page-item.disabled .page-link {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .empty-state-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1));
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .empty-state-icon i {
        font-size: 2rem;
        color: #6366f1;
    }
    
    .summary-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding: 0 0.5rem;
    }
    .summary-text {
        font-size: 14px;
        color: #64748b;
        font-weight: 500;
    }
    
    @@media (max-width: 768px) {
        .offers-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Hero Section -->
<div class="announcements-hero">
    <div class="container position-relative" style="z-index: 1;">
        <div class="text-center">
            <h1 class="display-5 fw-bold text-white mb-3">
                <i class="fas fa-bullhorn me-3"></i>Staj Ilanlari
            </h1>
            <p class="lead text-white-50 mb-0" style="max-width: 600px; margin: 0 auto;">
                Turkiye'nin oncu sirketlerinden staj firsatlarini kesfedin ve kariyerinize ilk adiminizi atin.
            </p>
        </div>
    </div>
</div>

<div class="main-content-section">
    <div class="container" id="offersRoot" data-page-size="@Model.PageSize" data-initial-page="@Model.Page">
        <!-- Filter Section -->
        <div class="filter-section">
            <form method="get" id="filterForm" class="row g-3 align-items-end" onsubmit="return false;">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold small mb-2">Arama</label>
                    <div class="position-relative">
                        <i class="fas fa-search position-absolute" style="left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
                        <input type="text" name="q" value="@Model.Query" class="filter-input-premium ps-5" placeholder="Baslik, sirket, sehir.." />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fw-semibold small mb-2">Sehir</label>
                    <select name="city" class="filter-input-premium">
                        <option value="">Hepsi</option>
                        @foreach (var c in Model.DistinctCities){<option value="@c" selected="@(Model.City==c)">@c</option>}
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fw-semibold small mb-2">Alan</label>
                    <select name="field" class="filter-input-premium">
                        <option value="">Hepsi</option>
                        @foreach (var f in Model.DistinctFields){<option value="@f" selected="@(Model.Field==f)">@f</option>}
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fw-semibold small mb-2">Sirala</label>
                    <select name="sort" class="filter-input-premium">
                        <option value="new" selected="@(Model.Sort=="new")">En Yeni</option>
                        <option value="old" selected="@(Model.Sort=="old")">En Eski</option>
                        <option value="title" selected="@(Model.Sort=="title")">Basliga Gore</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <button class="filter-btn-premium w-100" id="applyFilters" type="button">
                        <i class="fas fa-filter me-2"></i>Uygula
                    </button>
                </div>
            </form>
        </div>

        <!-- Summary Bar -->
        <div class="summary-bar">
            <span class="summary-text" id="resultSummary">Toplam @Model.TotalCount kayit</span>
            <span class="summary-text" id="pageSummary">Sayfa @Model.Page/@Model.TotalPages</span>
        </div>

        <!-- Offers Grid -->
        <div class="offers-grid" id="announcementList">
            @foreach (var item in Model.Offers.Where(o=>o.IsActive))
            {
                var workTypeDisplay = (item.WorkType?.Equals("Internship", StringComparison.OrdinalIgnoreCase) ?? false) ? "Staj" : item.WorkType;
                var deadline = item.ApplicationDeadline;
                var showDateText = deadline.HasValue ? deadline.Value.ToString("dd.MM.yyyy") : item.PublishDate.ToString("dd.MM.yyyy");
                
                <div class="offer-card">
                    <div class="offer-card-header">
                        <h3 class="offer-card-title">@item.Title</h3>
                        <div class="offer-card-company">
                            <i class="fas fa-building text-primary"></i>
                            <span>@item.CompanyName</span>
                        </div>
                        <div class="offer-card-meta">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>@item.City</span>
                            <span class="mx-2">•</span>
                            <i class="far fa-calendar"></i>
                            <span>Son: @showDateText</span>
                        </div>
                    </div>
                    <div class="offer-card-body">
                        <div class="offer-card-tags">
                            <span class="offer-tag position">@(item.Position ?? item.Field ?? "-")</span>
                            <span class="offer-tag type">@(workTypeDisplay ?? "-")</span>
                            @if (!string.IsNullOrEmpty(item.Salary))
                            {
                                <span class="offer-tag salary">@item.Salary</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="offer-card-description">@item.Description</p>
                        }
                    </div>
                    <div class="offer-card-footer">
                        <span class="offer-card-date">
                            <i class="far fa-clock me-1"></i>Ilan: @item.PublishDate.ToString("dd.MM.yyyy")
                        </span>
                        <a href="/Student/Application/OfferDetails/@item.Id?source=home" class="btn-detail">
                            <i class="fas fa-eye"></i>Detay
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Offers.Any(o => o.IsActive))
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h4 class="fw-bold text-gray-700 mb-2">Ilan Bulunamadi</h4>
                <p class="text-muted">Su anda aktif staj ilani bulunmamaktadir.</p>
            </div>
        }

        <!-- Pagination -->
        <nav class="pagination-premium" id="paginationBar">
            @if (Model.TotalPages > 1){
                <ul class="pagination pagination-sm flex-wrap mb-0 justify-content-center">
                    <li class="page-item @(Model.Page==1?"disabled":"")"><a class="page-link" href="#" onclick="annLoad(@(Model.Page-1));return false;">Onceki</a></li>
                    @for (int i=1;i<=Model.TotalPages;i++){<li class="page-item @(Model.Page==i?"active":"")"><a class="page-link" href="#" onclick="annLoad(@i);return false;">@i</a></li>}
                    <li class="page-item @(Model.Page==Model.TotalPages?"disabled":"")"><a class="page-link" href="#" onclick="annLoad(@(Model.Page+1));return false;">Sonraki</a></li>
                </ul>
            }
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        window.__isAuthenticated=@(isAuth.ToString().ToLower());
        window.__isStudent=@(isStudent.ToString().ToLower());
        document.body.setAttribute('data-user-id', '@userId');
        document.body.setAttribute('data-auth', '@isAuth.ToString().ToLower()');
        document.body.setAttribute('data-student', '@isStudent.ToString().ToLower()');
    </script>
    <script id="initialOffersData" type="application/json">@System.Text.Json.JsonSerializer.Serialize(new { items = Model.Offers.Where(o=>o.IsActive).Select(o => new { id=o.Id,title=o.Title,companyName=o.CompanyName,publishDate=o.PublishDate,applicationDeadline=o.ApplicationDeadline,city=o.City,field=o.Field,position=o.Position,salary=o.Salary,workType=((o.WorkType?.Equals("Internship",StringComparison.OrdinalIgnoreCase)??false)?"Staj":o.WorkType),quota=o.Quota,isFavorite=o.IsFavorite,description=o.Description,requirements=o.Requirements,phone=o.Phone,address=o.Address,website=o.Website,isActive=o.IsActive,companyDescription=o.CompanyDescription,employeeCount=o.EmployeeCount,establishedDate=o.EstablishedDate }), totalCount=Model.TotalCount,page=Model.Page,totalPages=Model.TotalPages })</script>
    <script src="~/js/announcements.js"></script>
}