@model WebUI.Models.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "_PublicLayout";
}

<!-- Hero Section with Dynamic Slider -->
@if (Model.SliderItems.Any())
{
    <div id="heroCarousel" class="carousel slide hero-section" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < Model.SliderItems.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" 
                        class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" 
                        aria-label="Slide @(i + 1)"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < Model.SliderItems.Count; i++)
            {
                var slider = Model.SliderItems[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="container">
                        <div class="row align-items-center min-vh-50">
                            <div class="col-lg-8 mx-auto text-center text-white">
                                <h1 class="display-4 fw-bold mb-4">@slider.Title</h1>
                                @if (!string.IsNullOrEmpty(slider.Description))
                                {
                                    <p class="lead mb-4">@slider.Description</p>
                                }
                                
                                <div class="d-flex gap-3 justify-content-center flex-wrap">
                                    @if (User.Identity?.IsAuthenticated != true)
                                    {
                                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                                            <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                                        </a>
                                        <a asp-controller="Account" asp-action="RegisterOptions" class="btn btn-outline-light btn-lg">
                                            <i class="fas fa-user-plus me-2"></i>Kayıt Ol
                                        </a>
                                    }
                                    else
                                    {
                                        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                                        @if (userRole == "Student")
                                        {
                                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg">
                                                <i class="fas fa-tachometer-alt me-2"></i>Öğrenci Paneli
                                            </a>
                                        }
                                        else if (userRole == "Advisor")
                                        {
                                            <a asp-controller="AdvisorDashboard" asp-action="Index" class="btn btn-primary btn-lg">
                                                <i class="fas fa-chalkboard-teacher me-2"></i>Danışman Paneli
                                            </a>
                                        }
                                        else if (userRole == "Company")
                                        {
                                            <a asp-controller="Company" asp-action="Index" class="btn btn-primary btn-lg">
                                                <i class="fas fa-building me-2"></i>Firma Paneli
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.SliderItems.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        }
    </div>
}
else
{
    <!-- Fallback Hero Section -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center min-vh-50">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="display-4 fw-bold text-white mb-4">
                        Üniversite Staj Takip Sistemi
                    </h1>
                    <p class="lead text-white mb-4">
                        Staj sürecinizi dijital ortamda takip edin, başvurularınızı yönetin ve 
                        staj deneyiminizi en verimli şekilde geçirin.
                    </p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                            </a>
                            <a asp-controller="Account" asp-action="RegisterOptions" class="btn btn-outline-light btn-lg">
                                <i class="fas fa-user-plus me-2"></i>Kayıt Ol
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Content Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <!-- Dynamic Announcements -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-bullhorn me-2"></i>Son Duyurular</h4>
                        <a asp-controller="Home" asp-action="Announcements" class="btn btn-sm btn-light">Tümü</a>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @if (Model.Announcements.Any())
                            {
                                @foreach (var announcement in Model.Announcements)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="announcement-item p-3 border rounded h-100 d-flex flex-column">
                                            <h6 class="fw-bold text-primary">@announcement.Title</h6>
                                            <p class="small text-muted mb-2">
                                                <i class="fas fa-calendar me-1"></i>@announcement.PublishDate.ToString("dd MMM yyyy")
                                            </p>
                                            <p class="mb-0 flex-grow-1">
                                                @((announcement.Content?.Length ?? 0) > 110 ? 
                                                  Html.Raw(announcement.Content!.Substring(0,107) + "...") : 
                                                  Html.Raw(announcement.Content))
                                            </p>
                                            <a asp-controller="Home" asp-action="Announcements" class="btn btn-sm btn-outline-primary mt-2">
                                                <i class="fas fa-arrow-right me-1"></i>Devamını Oku
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted py-4">
                                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                                    <p>Henüz duyuru bulunmamaktadır.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Dynamic News -->
                <div class="card">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-newspaper me-2"></i>Haberler</h4>
                        <a asp-controller="Home" asp-action="News" class="btn btn-sm btn-light">Tümü</a>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @if (Model.News.Any())
                            {
                                @foreach (var news in Model.News)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="news-item h-100">
                                            <h6 class="fw-bold">@news.Title</h6>
                                            <p class="small text-muted mb-2">
                                                <i class="fas fa-calendar me-1"></i>@news.PublishDate.ToString("dd MMM yyyy")
                                            </p>
                                            <p class="small">
                                                @((news.Content?.Length ?? 0) > 110 ? 
                                                  Html.Raw(news.Content!.Substring(0,107) + "...") : 
                                                  Html.Raw(news.Content))
                                            </p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted py-4">
                                    <i class="fas fa-newspaper fa-2x mb-2"></i>
                                    <p>Henüz haber bulunmamaktadır.</p>
                                </div>
                            }
                        </div>
                        @if (Model.News.Any())
                        {
                            <div class="text-center mt-3">
                                <a asp-controller="Home" asp-action="News" class="btn btn-success">
                                    <i class="fas fa-newspaper me-2"></i>Tüm Haberleri Görüntüle
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Dynamic Sidebar -->
            <div class="col-lg-4">
                <!-- Hızlı Erişim -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-link me-2"></i>Hızlı Erişim</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                                @if (userRole == "Student")
                                {
                                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary">
                                        <i class="fas fa-tachometer-alt me-2"></i>Öğrenci Paneli
                                    </a>
                                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="fas fa-user me-2"></i>Profil
                                    </a>
                                    <a asp-controller="Application" asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="fas fa-file-text me-2"></i>Başvurularım
                                    </a>
                                    <a asp-controller="Diary" asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="fas fa-book-open me-2"></i>Staj Defteri
                                    </a>
                                }
                                else if (userRole == "Advisor")
                                {
                                    <a asp-controller="AdvisorDashboard" asp-action="Index" class="btn btn-outline-primary">
                                        <i class="fas fa-chalkboard-teacher me-2"></i>Danışman Paneli
                                    </a>
                                }
                                else if (userRole == "Company")
                                {
                                    <a asp-controller="Company" asp-action="Index" class="btn btn-outline-primary">
                                        <i class="fas fa-building me-2"></i>Firma Paneli
                                    </a>
                                }
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
                                    <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                                </a>
                                <a asp-controller="Account" asp-action="RegisterOptions" class="btn btn-outline-success">
                                    <i class="fas fa-user-plus me-2"></i>Kayıt Ol
                                </a>
                            }
                            <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary">
                                <i class="fas fa-phone me-2"></i>İletişim
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Dynamic Contact Information -->
                <div class="card mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Staj Koordinatörlüğü</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>Staj Koordinatörü</strong><br>
                            Öğr. Üyesi Dr. Ali Veli
                        </p>
                        <p class="mb-1">
                            <i class="fas fa-envelope me-2 text-primary"></i>
                            <a href="mailto:@Model.ContactInfo.Email">@Model.ContactInfo.Email</a>
                        </p>
                        <p class="mb-1">
                            <i class="fas fa-phone me-2 text-primary"></i>
                            <a href="tel:@Model.ContactInfo.Phone">@Model.ContactInfo.Phone</a>
                        </p>
                        <p class="mb-1">
                            <i class="fas fa-clock me-2 text-primary"></i>@Model.ContactInfo.WorkingHours
                        </p>
                    </div>
                </div>

                <!-- Dynamic Important Dates -->
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Önemli Tarihler</h5>
                    </div>
                    <div class="card-body">
                        <div class="timeline">
                            @foreach (var date in Model.ImportantDates.OrderBy(d => d.Date))
                            {
                                <div class="timeline-item mb-3">
                                    <div class="fw-bold text-primary">@date.Date.ToString("dd MMMM yyyy")</div>
                                    <div class="small">@date.Description</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.hero-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    min-height: 60vh;
}

.hero-section h1 {
    color: white !important;
}

.carousel-item {
    min-height: 60vh;
    display: flex;
    align-items: center;
}

.announcement-item, .news-item {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.announcement-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.timeline-item {
    border-left: 2px solid #dee2e6;
    padding-left: 15px;
    position: relative;
}

.timeline-item:before {
    content: '';
    width: 8px;
    height: 8px;
    background: #007bff;
    border-radius: 50%;
    position: absolute;
    left: -5px;
    top: 5px;
}

.carousel-control-prev,
.carousel-control-next {
    width: 5%;
}

.carousel-control-prev-icon,
.carousel-control-next-icon {
    width: 2rem;
    height: 2rem;
}
</style>
