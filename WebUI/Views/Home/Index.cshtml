@model WebUI.Models.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "_PublicLayout";
}

<!-- Gradient Hero -->
<section class="position-relative overflow-hidden" style="background:linear-gradient(120deg,#6d28d9 0%,#5631d8 45%,#2563eb 90%);min-height:480px;">
    <div class="container position-relative py-5" style="z-index:2;">
        <div class="row justify-content-center text-center">
            <div class="col-xl-8 col-lg-9">
                <h1 class="display-5 fw-bold text-white mb-3">Staj Sürecinizi Dijitalleştirin</h1>
                <p class="lead text-white-50 mb-4">Öğrenciler, akademisyenler ve şirketler için uçtan uca başvuru, takip ve yönetim platformu.</p>
                <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
                    <a asp-controller="Account" asp-action="RegisterOptions" class="btn btn-light px-4 py-2"><i class="fas fa-paper-plane me-2"></i>Bize Katıl</a>
                </div>
                <div class="d-flex flex-wrap justify-content-center gap-4 small fw-semibold text-white-50 mt-2">
                    <span><i class="fas fa-user-graduate me-1"></i>1+ Aktif Öğrenci</span>
                    <span><i class="fas fa-building me-1"></i>1+ Firma</span>
                    <span><i class="fas fa-user-tie me-1"></i>1+ Akademisyen</span>
                    <span><i class="fas fa-check-circle me-1"></i>2+ Tamamlanan Staj</span>
                </div>
            </div>
        </div>
    </div>
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background:radial-gradient(circle at 50% 30%,rgba(255,255,255,.15),transparent 60%);"></div>
</section>

<!-- Why Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Neden <span class="text-primary">StajTakip</span>?</h2>
            <p class="text-muted">Modern teknoloji ile staj sürecinizi daha verimli hale getirin</p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-6 col-md-3">
                <div class="feature-card border rounded-4 h-100 p-4 text-center">
                    <div class="text-primary fs-3 mb-2"><i class="fas fa-file-signature"></i></div>
                    <h6 class="fw-bold mb-1">Dijital Başvuru</h6>
                    <p class="small text-muted mb-0">Kolay ve hızlı başlangıç</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card border rounded-4 h-100 p-4 text-center">
                    <div class="text-primary fs-3 mb-2"><i class="fas fa-bolt"></i></div>
                    <h6 class="fw-bold mb-1">Anlık Takip</h6>
                    <p class="small text-muted mb-0">Gerçek zamanlı süreç</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card border rounded-4 h-100 p-4 text-center">
                    <div class="text-primary fs-3 mb-2"><i class="fas fa-shield-alt"></i></div>
                    <h6 class="fw-bold mb-1">Veri Güvenliği</h6>
                    <p class="small text-muted mb-0">Verileriniz güvende</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card border rounded-4 h-100 p-4 text-center">
                    <div class="text-primary fs-3 mb-2"><i class="fas fa-gauge-high"></i></div>
                    <h6 class="fw-bold mb-1">Güçlü Performans</h6>
                    <p class="small text-muted mb-0">Hızlı ve stabil</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Role Cards Section -->
<section class="pb-5" id="role-cards">
    <div class="container">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Herkes İçin Çözüm</h3>
            <p class="text-muted">Staj sürecinin tüm tarafları için özel tasarlanmış özellikler</p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="solution-card card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="mb-3 text-primary fs-2"><i class="fas fa-user-graduate"></i></div>
                        <h5 class="fw-bold">Öğrenciler</h5>
                        <ul class="small text-muted mb-4 ps-3">
                            <li>Dijital başvuru ve takip</li>
                            <li>Belge yönetimi</li>
                            <li>Staj defteri takibi</li>
                            <li>Revizyon bildirimleri</li>
                            <li>Raporlama & analiz</li>
                        </ul>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-auto">Öğrenci Giriş</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="solution-card card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="mb-3 text-primary fs-2"><i class="fas fa-chalkboard-teacher"></i></div>
                        <h5 class="fw-bold">Akademisyenler</h5>
                        <ul class="small text-muted mb-4 ps-3">
                            <li>Öğrencileri yönetin</li>
                            <li>Başvuruları onaylayın</li>
                            <li>Defter ve rapor değerlendirme</li>
                            <li>Revizyon bildirimleri</li>
                            <li>İstatistiksel analiz</li>
                        </ul>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-auto">Akademisyen Giriş</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="solution-card card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="mb-3 text-primary fs-2"><i class="fas fa-building"></i></div>
                        <h5 class="fw-bold">Şirketler</h5>
                        <ul class="small text-muted mb-4 ps-3">
                            <li>İlan yönetimi</li>
                            <li>Aday değerlendirme</li>
                            <li>Süreç raporları</li>
                            <li>Güvenli depolama</li>
                            <li>Performans analizi</li>
                        </ul>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-auto">Şirket Giriş</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.feature-card,.solution-card{transition:.3s;}
.feature-card:hover,.solution-card:hover{box-shadow:0 10px 25px -5px rgba(0,0,0,.1),0 8px 10px -6px rgba(0,0,0,.1);transform:translateY(-4px);} 
</style>
