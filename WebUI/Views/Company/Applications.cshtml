@model WebUI.Models.Company.ApplicationListViewModel
@{
    ViewData["Title"] = "Baþvurular";
    Layout = "_AppLayout";
}
<div class="company-dashboard">
    <!-- Sayfa Baþlýðý Kartý -->
    <div class="w-full mb-8 flex items-center justify-center">
        <div class="rounded-2xl bg-blue-50 dark:bg-gray-800 border border-blue-200 dark:border-gray-600 shadow-sm px-8 py-6 flex items-center gap-4 w-full">
            <i class="fas fa-file-alt text-3xl text-blue-600 dark:text-blue-400"></i>
            <div>
                <h1 class="text-2xl font-bold text-blue-700 dark:text-blue-300 mb-1">Baþvurular</h1>
                <p class="text-blue-600 dark:text-blue-400">Ýlanlarýnýza gelen baþvurularý inceleyin ve deðerlendirin.</p>
            </div>
        </div>
    </div>
    <!-- Filters -->
    <div class="search-filters mb-6">
        <form method="get" class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-64">
                <label for="searchTerm" class="block text-sm font-medium text-blue-700 dark:text-blue-300 mb-2">
                    <i class="fas fa-search mr-1"></i>Arama
                </label>
                <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm"
                       class="w-full px-4 py-2 border border-blue-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-700 focus:border-blue-700 bg-white dark:bg-gray-700 dark:text-white shadow-sm"
                       placeholder="Öðrenci adý, email, üniversite ara..." />
            </div>
            <div class="min-w-48">
                <label for="statusFilter" class="block text-sm font-medium text-blue-700 dark:text-blue-300 mb-2">
                    <i class="fas fa-filter mr-1"></i>Durum
                </label>
                <select name="statusFilter" id="statusFilter"
                        class="w-full px-4 py-2 border border-blue-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-700 focus:border-blue-700 bg-white dark:bg-gray-700 dark:text-white shadow-sm">
                    <option value="">Tüm Durumlar</option>
                    @foreach (var status in Enum.GetValues<WebUI.Models.Company.ApplicationStatus>())
                    {
                        <option value="@status" selected="@(Model.StatusFilter == status)">@status.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div class="min-w-64">
                <label for="jobPostingIdFilter" class="block text-sm font-medium text-blue-700 dark:text-blue-300 mb-2">
                    <i class="fas fa-briefcase mr-1"></i>Ýlan
                </label>
                <select name="jobPostingIdFilter" id="jobPostingIdFilter"
                        class="w-full px-4 py-2 border border-blue-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-700 focus:border-blue-700 bg-white dark:bg-gray-700 dark:text-white shadow-sm">
                    <option value="">Tüm Ýlanlar</option>
                    @foreach (var job in Model.AvailableJobPostings)
                    {
                        <option value="@job.Id" selected="@(Model.JobPostingIdFilter == job.Id)">@job.Title</option>
                    }
                </select>
            </div>
            <div>
                <button type="submit" class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-6 py-2 rounded-lg transition-all duration-200">
                    <i class="fas fa-search mr-2"></i>Filtrele
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.JobPostingIdFilter.HasValue)
            {
                <div>
                    <a asp-controller="CompanyApplications" asp-action="List" class="px-4 py-2 border border-blue-300 dark:border-gray-600 rounded-lg text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-gray-700 transition-colors duration-200">
                        <i class="fas fa-times mr-2"></i>Temizle
                    </a>
                </div>
            }
        </form>
    </div>
    <!-- Results Summary -->
    <div class="mb-6">
        <p class="text-blue-600 dark:text-blue-400">
            <i class="fas fa-info-circle mr-1"></i>
            Toplam @Model.Applications.Count baþvuru bulundu
        </p>
    </div>
    <!-- Applications List -->
    @if (Model.Applications.Any())
    {
        <div class="space-y-4">
            @foreach (var application in Model.Applications)
            {
                <div class="company-card p-6 hover:shadow-lg transition-shadow cursor-pointer bg-white dark:bg-gray-800 border border-blue-100 dark:border-gray-600 rounded-xl" onclick="viewApplicationDetail(@application.Id)">
                    <div class="flex items-start justify-between">
                        <div class="flex items-start space-x-4 flex-1">
                            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-graduate text-blue-600 dark:text-blue-400 text-lg"></i>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center space-x-3 mb-2">
                                    <h3 class="text-lg font-semibold text-blue-900 dark:text-blue-200">
                                        @application.StudentName
                                    </h3>
                                    <span class="status-badge status-@application.Status.ToString().ToLower() bg-white dark:bg-gray-700 text-blue-700 dark:text-blue-300 px-3 py-1 rounded-full border border-blue-100 dark:border-gray-600">
                                        @application.Status.GetDisplayName()
                                    </span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-blue-700 dark:text-blue-300 mb-3">
                                    <div class="flex items-center">
                                        <i class="fas fa-envelope mr-2 text-blue-500 dark:text-blue-400"></i>
                                        <span>@application.StudentEmail</span>
                                    </div>
                                    <div class="flex items-center">
                                        <i class="fas fa-university mr-2 text-blue-500 dark:text-blue-400"></i>
                                        <span>@application.University</span>
                                    </div>
                                    <div class="flex items-center">
                                        <i class="fas fa-graduation-cap mr-2 text-blue-500 dark:text-blue-400"></i>
                                        <span>@application.Department</span>
                                    </div>
                                    <div class="flex items-center">
                                        <i class="fas fa-calendar mr-2 text-blue-500 dark:text-blue-400"></i>
                                        <span>@application.ApplicationDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <p class="font-medium text-blue-900 dark:text-blue-200 mb-1">
                                        <i class="fas fa-briefcase mr-2 text-green-600 dark:text-green-400"></i>
                                        @application.JobTitle
                                    </p>
                                </div>
                                @if (!string.IsNullOrEmpty(application.CoverLetter))
                                {
                                    <div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-lg">
                                        <p class="text-sm text-blue-700 dark:text-blue-300">
                                            <i class="fas fa-quote-left mr-1"></i>
                                            @(application.CoverLetter.Length > 150 
                                                ? application.CoverLetter.Substring(0, 150) + "..." 
                                                : application.CoverLetter)
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="flex flex-col space-y-2 ml-6">
                            <a asp-action="ApplicationDetail" asp-route-id="@application.Id" 
                               class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-4 py-2 rounded text-center text-sm shadow-md transition-all duration-200"
                               onclick="event.stopPropagation();">
                                <i class="fas fa-eye mr-1"></i>Detay
                            </a>
                            @if (!string.IsNullOrEmpty(application.CvPath))
                            {
                                <a href="@application.CvPath" target="_blank" 
                                   class="px-4 py-2 border border-blue-300 dark:border-gray-600 rounded text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-gray-700 text-sm text-center transition-colors duration-200"
                                   onclick="event.stopPropagation();">
                                    <i class="fas fa-file-pdf mr-1"></i>CV Ýndir
                                </a>
                            }
                            @if (application.Status == WebUI.Models.Company.ApplicationStatus.Pending)
                            {
                                <div class="flex space-x-1">
                                    <button onclick="updateApplicationStatus(@application.Id, '@WebUI.Models.Company.ApplicationStatus.Approved'); event.stopPropagation();" 
                                            class="flex-1 px-2 py-2 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded hover:bg-green-200 dark:hover:bg-green-900/50 text-xs transition-colors duration-200">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button onclick="updateApplicationStatus(@application.Id, '@WebUI.Models.Company.ApplicationStatus.Rejected'); event.stopPropagation();" 
                                            class="flex-1 px-2 py-2 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 rounded hover:bg-red-200 dark:hover:bg-red-900/50 text-xs transition-colors duration-200">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="company-card bg-blue-50 dark:bg-gray-800 border border-blue-100 dark:border-gray-600">
            <div class="p-12 text-center">
                <i class="fas fa-file-alt text-6xl text-blue-300 dark:text-blue-500 mb-4"></i>
                <h3 class="text-xl font-semibold text-blue-900 dark:text-blue-200 mb-2">
                    Baþvuru bulunmuyor
                </h3>
                <p class="text-blue-600 dark:text-blue-400 mb-6">
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.JobPostingIdFilter.HasValue)
                    {
                        <span>Arama kriterlerinize uygun baþvuru bulunamadý. Filtreleri deðiþtirmeyi deneyin.</span>
                    }
                    else
                    {
                        <span>Henüz hiç baþvuru almamýþsýnýz. Ýlanlarýnýzý paylaþarak öðrencilerin dikkatini çekin.</span>
                    }
                </p>
                <div class="space-x-4">
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.JobPostingIdFilter.HasValue)
                    {
                        <a asp-controller="CompanyApplications" asp-action="List" class="btn-outline-primary-company px-6 py-3 rounded-lg border border-blue-300 dark:border-gray-600 text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-gray-700 transition-colors duration-200">
                            <i class="fas fa-times mr-2"></i>Filtreleri Temizle
                        </a>
                    }
                    <a asp-controller="CompanyJobPostings" asp-action="Create" class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-6 py-3 rounded-lg transition-all duration-200">
                        <i class="fas fa-plus mr-2"></i>Yeni Ýlan Oluþtur
                    </a>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts {
    <script>
        const applicationDetailUrlPattern = '@Url.Action("Detail","CompanyApplications", new { id = 0 })'; // ends with /0
        const applicationDetailBase = applicationDetailUrlPattern.endsWith('/0') ? applicationDetailUrlPattern.slice(0, -2) : applicationDetailUrlPattern;
        const updateStatusUrl = '@Url.Action("UpdateApplicationStatus","CompanyApplications")';

        function viewApplicationDetail(applicationId) {
            window.location.href = applicationDetailBase + '/' + applicationId;
        }
        function updateApplicationStatus(applicationId, status) {
            var statusText = status === 'Approved' ? 'onaylamak' : 'reddetmek';
            if (confirm('Bu baþvuruyu ' + statusText + ' istediðinizden emin misiniz?')) {
                $.post(updateStatusUrl, {
                    id: applicationId,
                    status: status,
                    __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val()
                })
                    .done(function () { location.reload(); })
                    .fail(function () { alert('Ýþlem sýrasýnda bir hata oluþtu.'); });
            }
        }
        $(document).keydown(function (e) {
            if (e.ctrlKey && e.keyCode === 70) {
                e.preventDefault();
                $('#searchTerm').focus();
            }
        });
        setInterval(function() {
            console.log('Checking for new applications...');
        }, 60000);
    </script>
}