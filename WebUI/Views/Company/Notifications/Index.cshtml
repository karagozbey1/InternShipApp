@model List<Core.Entity.Notification>
@{
    ViewData["Title"] = "Bildirimler";
    Layout = "_AppLayout";
}

<div class="container mt-5">
    <!-- Sayfa Baþlýðý Kartý -->
    <div class="w-full mb-8 flex items-center justify-center">
        <div class="rounded-2xl bg-[#f3f7ff] border border-[#dbeafe] shadow-sm px-8 py-6 flex items-center gap-4 w-full">
            <i class="fas fa-bell text-3xl text-blue-700"></i>
            <div>
                <h1 class="text-2xl font-bold text-blue-700 mb-1">Bildirimler</h1>
                <p class="text-blue-600">Firma paneli bildirimlerinizi görüntüleyin ve yönetin.</p>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Okunmayan</p>
                    <p id="unreadCount" class="stat-number text-3xl font-bold text-gray-900">@Model.Count(n => !n.IsRead)</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl">
                    <i class="fas fa-envelope text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Bugün</p>
                    <p class="stat-number text-3xl font-bold text-gray-900">@Model.Count(n => n.CreatedAt.Date == DateTime.Today)</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-green-500 to-emerald-500 rounded-xl">
                    <i class="fas fa-calendar-day text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Bu Hafta</p>
                    <p class="stat-number text-3xl font-bold text-gray-900">@Model.Count(n => n.CreatedAt.Date >= DateTime.Today.AddDays(-7))</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-yellow-400 to-orange-400 rounded-xl">
                    <i class="fas fa-calendar-week text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white border shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Toplam</p>
                    <p class="stat-number text-3xl font-bold text-gray-900">@Model.Count</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl">
                    <i class="fas fa-bell text-white text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="mb-4">
        <div class="flex gap-4">
            <button class="btn btn-primary" onclick="filterNotifications('all')">Tümü</button>
            <button class="btn btn-secondary" onclick="filterNotifications('unread')">Okunmayanlar</button>
            <button class="btn btn-secondary" onclick="filterNotifications('application')">Baþvurular</button>
            <button class="btn btn-secondary" onclick="filterNotifications('diary')">Staj Defterleri</button>
            <button class="btn btn-secondary" onclick="filterNotifications('system')">Sistem</button>
        </div>
    </div>

    <!-- List -->
    <div id="notification-list">
        @if (Model.Any())
        {
            <div class="space-y-4">
                @foreach (var notification in Model)
                {
                    <div class="notification-card flex items-start gap-4 p-4 bg-white rounded-xl shadow-sm border transition-transform hover:shadow-lg" data-id="@notification.Id">
                        <div class="flex-shrink-0 mt-1">
                            <div class="icon-circle @(GetNotificationStyle(notification.Type))">
                                <i class="@(GetNotificationIcon(notification.Type)) icon-lg"></i>
                            </div>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2">
                                        <h5 class="text-lg font-semibold text-gray-900 mb-1">@notification.Title</h5>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="unread-dot" title="Okunmadý"></span>
                                        }
                                    </div>

                                    <p class="text-gray-600 mb-2">@notification.Message</p>

                                    <div class="flex items-center gap-3 text-sm text-gray-500">
                                        <span><i class="fas fa-clock mr-1"></i> @notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                        <span class="px-2 py-1 rounded-full text-xs font-medium @(GetTypeStyle(notification.Type))">@(GetTypeText(notification.Type))</span>
                                        @if (notification.Priority > 2)
                                        {
                                            <span class="px-2 py-1 bg-red-50 text-red-600 rounded-full text-xs font-medium"><i class="fas fa-exclamation-triangle mr-1"></i>Önemli</span>
                                        }
                                    </div>
                                </div>

                                <div class="flex flex-col items-end gap-2">
                                    @if (!notification.IsRead)
                                    {
                                        <button class="action-btn approve" title="Okundu olarak iþaretle" onclick="markAsRead(@notification.Id)">
                                            <i class="fas fa-check-circle"></i>
                                        </button>
                                    }
                                    <button class="action-btn delete" title="Sil" onclick="deleteNotification(@notification.Id)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                    @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                    {
                                        <a href="@notification.ActionUrl" class="action-btn open" title="Aç">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="stat-card dynamic-card bg-white border shadow-lg rounded-xl text-center py-12">
                <i class="fas fa-bell-slash text-gray-400 text-6xl mb-4"></i>
                <h3 class="text-lg font-semibold text-gray-600 mb-2">Bildirim Bulunamadý</h3>
                <p class="text-gray-500">Henüz hiç bildiriminiz yok.</p>
            </div>
        }
    </div>
</div>

<style>
    .icon-circle { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; }
    .icon-lg { font-size:20px; }
    .bg-blue-100 { background:#ebf8ff; color:#0369a1; }
    .bg-green-100 { background:#ecfdf5; color:#065f46; }
    .bg-gray-100 { background:#f3f4f6; color:#374151; }
    .bg-yellow-100 { background:#fffbeb; color:#92400e; }
    .bg-red-100 { background:#fff1f2; color:#9f1239; }
    .bg-purple-100 { background:#f3e8ff; color:#6b21a8; }

    .notification-card { position:relative; }
    .notification-card .unread-dot { width:8px; height:8px; background:#2563eb; border-radius:50%; display:inline-block; }

    .action-btn { width:40px; height:40px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; border:none; cursor:pointer; color:#374151; background:transparent; transition:all .15s ease; }
    .action-btn:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(15,23,42,0.06); }
    .action-btn.approve { color:#10b981; }
    .action-btn.delete { color:#ef4444; }
    .action-btn.open { color:#3b82f6; text-decoration:none; }

    /* hover for whole card */
    .notification-card:hover { transform:translateY(-4px); }

    /* responsive tweaks */
    @@media (max-width:768px) {
        .notification-card { flex-direction:column; }
        .action-btn { width:36px; height:36px; }
    }
</style>

@section Scripts {
    <script>
        let currentFilter = 'all';
        let autoRefreshTimer = null;

        function renderNotificationItem(notification) {
            const container = document.createElement('div');
            container.className = 'notification-card flex items-start gap-4 p-4 bg-white rounded-xl shadow-sm border mb-3 transition-transform hover:shadow-lg';
            container.setAttribute('data-id', notification.id);

            const iconWrap = document.createElement('div');
            iconWrap.className = 'flex-shrink-0 mt-1';
            const iconCircle = document.createElement('div');
            iconCircle.className = 'icon-circle bg-blue-100';
            const icon = document.createElement('i');
            icon.className = 'fas fa-bell icon-lg';
            iconCircle.appendChild(icon);
            iconWrap.appendChild(iconCircle);

            const content = document.createElement('div');
            content.className = 'flex-1 min-w-0';
            content.innerHTML = `<div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            <h5 class="text-lg font-semibold text-gray-900 mb-1">${notification.title}</h5>
                            ${notification.isRead ? '' : '<span class="unread-dot" title="Okunmadý"></span>'}
                        </div>
                        <p class="text-gray-600 mb-2">${notification.message}</p>
                        <div class="flex items-center gap-3 text-sm text-gray-500">
                            <span><i class="fas fa-clock mr-1"></i> ${new Date(notification.createdAt).toLocaleString()}</span>
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-800">${notification.type}</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-2">
                        ${notification.isRead ? '' : `<button class="action-btn approve" title="Okundu olarak iþaretle" onclick="markAsRead(${notification.id})"><i class="fas fa-check-circle"></i></button>`}
                        <button class="action-btn delete" title="Sil" onclick="deleteNotification(${notification.id})"><i class="fas fa-trash-alt"></i></button>
                        ${notification.actionUrl ? `<a href="${notification.actionUrl}" class="action-btn open" title="Aç"><i class="fas fa-external-link-alt"></i></a>` : ''}
                    </div>
                </div>`;

            container.appendChild(iconWrap);
            container.appendChild(content);
            return container;
        }

        function filterNotifications(filterType, silent=false) {
            currentFilter = filterType || 'all';
            fetch(`/Company/Notifications/Filter?type=${currentFilter}`)
                .then(response => response.json())
                .then(data => {
                    const notificationList = document.getElementById('notification-list');
                    if(!notificationList) return;
                    notificationList.innerHTML = '';
                    if (data.length > 0) {
                        const wrapper = document.createElement('div');
                        wrapper.className = 'space-y-4';
                        data.forEach(notification => {
                            const item = renderNotificationItem(notification);
                            wrapper.appendChild(item);
                        });
                        notificationList.appendChild(wrapper);
                    } else {
                        notificationList.innerHTML = '<div class="stat-card dynamic-card bg-white border shadow-lg rounded-xl text-center py-12">'+
                            '<i class="fas fa-bell-slash text-gray-400 text-6xl mb-4"></i>'+
                            '<h3 class="text-lg font-semibold text-gray-600 mb-2">Bildirim Bulunamadý</h3>' +
                            '<p class="text-gray-500">Henüz hiç bildiriminiz yok.</p>' +
                            '</div>';
                    }
                    updateUnreadCount();
                    if(!silent){ console.debug('Notifications refreshed ('+ currentFilter +')'); }
                })
                .catch(e=> console.warn('Filter fetch failed', e));
        }

        function startAutoRefresh(){
            if(autoRefreshTimer) clearInterval(autoRefreshTimer);
            autoRefreshTimer = setInterval(()=> filterNotifications(currentFilter, true), 30000);
        }

        function markAsRead(notificationId) {
            fetch(`/Company/Notifications/MarkAsRead/${notificationId}`, {
                method: 'POST'
            })
            .then(response => {
                if (response.ok) {
                    const el = document.querySelector(`[data-id='${notificationId}']`);
                    if (el) {
                        // remove unread dot
                        const dot = el.querySelector('.unread-dot');
                        if (dot) dot.remove();
                        // remove approve button
                        const btn = el.querySelector('.action-btn.approve');
                        if (btn) btn.remove();
                        el.classList.remove('bg-white');
                    }
                    updateUnreadCount();
                } else {
                    alert('Bildirim okundu olarak iþaretlenirken hata oluþtu.');
                }
            })
            .catch(() => alert('Ýþlem sýrasýnda hata oluþtu.'));
        }

        function deleteNotification(notificationId) {
            if (!confirm('Bu bildirimi silmek istediðinizden emin misiniz?')) return;

            fetch(`/Company/Notifications/Delete/${notificationId}`, {
                method: 'POST'
            })
            .then(response => {
                if (response.ok) {
                    const el = document.querySelector(`[data-id='${notificationId}']`);
                    if (el) {
                        el.style.transition = 'all 0.35s ease';
                        el.style.opacity = '0';
                        el.style.transform = 'translateX(20px)';
                        setTimeout(() => el.remove(), 350);
                    }
                    updateUnreadCount();
                } else {
                    alert('Bildirim silinirken hata oluþtu.');
                }
            })
            .catch(() => alert('Ýþlem sýrasýnda hata oluþtu.'));
        }

        function updateUnreadCount() {
            fetch('/Company/Notifications/UnreadCount')
                .then(r => r.json())
                .then(d => {
                    const badge = document.getElementById('unreadCount');
                    if (badge) badge.textContent = d.unreadCount;

                    const sidebarBadge = document.getElementById('notificationBadge');
                    if (sidebarBadge) {
                        if (d.unreadCount > 0) {
                            sidebarBadge.textContent = d.unreadCount;
                            sidebarBadge.classList.remove('hidden');
                        } else {
                            sidebarBadge.classList.add('hidden');
                        }
                    }
                });
        }

        // initial unread count sync
        document.addEventListener('DOMContentLoaded', function() {
            updateUnreadCount();
            startAutoRefresh();
        });
    </script>
}

@functions {
    private string GetNotificationIcon(string type)
    {
        return type?.ToLower() switch
        {
            "application" => "fas fa-file-alt",
            "diary" => "fas fa-book",
            "system" => "fas fa-cog",
            "warning" => "fas fa-exclamation-triangle",
            "error" => "fas fa-times-circle",
            "success" => "fas fa-check-circle",
            _ => "fas fa-bell"
        };
    }

    private string GetNotificationStyle(string type)
    {
        return type?.ToLower() switch
        {
            "application" => "bg-blue-100 text-blue-600",
            "diary" => "bg-green-100 text-green-600",
            "system" => "bg-gray-100 text-gray-600",
            "warning" => "bg-yellow-100 text-yellow-600",
            "error" => "bg-red-100 text-red-600",
            "success" => "bg-green-100 text-green-600",
            _ => "bg-purple-100 text-purple-600"
        };
    }

    private string GetTypeStyle(string type)
    {
        return type?.ToLower() switch
        {
            "application" => "bg-blue-50 text-blue-800",
            "diary" => "bg-green-50 text-green-800",
            "system" => "bg-gray-50 text-gray-800",
            "warning" => "bg-yellow-50 text-yellow-800",
            "error" => "bg-red-50 text-red-800",
            "success" => "bg-green-50 text-green-800",
            _ => "bg-purple-50 text-purple-800"
        };
    }

    private string GetTypeText(string type)
    {
        return type?.ToLower() switch
        {
            "application" => "Baþvuru",
            "diary" => "Staj Defteri",
            "system" => "Sistem",
            "warning" => "Uyarý",
            "error" => "Hata",
            "success" => "Baþarý",
            _ => "Bilgi"
        };
    }
}