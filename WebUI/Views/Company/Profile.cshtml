@model WebUI.Models.Company.CompanyProfileViewModel
@{
    ViewData["Title"] = "Firma Profili";
    Layout = "_AppLayout";
}

@if (TempData["SuccessMessage"] != null)
{
<div class="mb-6 p-4 bg-green-100 dark:bg-green-900/30 border border-green-400 dark:border-green-600 text-green-700 dark:text-green-300 rounded-lg">
    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
</div>
}
@if (TempData["PasswordMessage"] != null)
{
<div class="mb-6 p-4 bg-blue-100 dark:bg-blue-900/30 border border-blue-400 dark:border-blue-600 text-blue-700 dark:text-blue-300 rounded-lg">
    <i class="fas fa-key me-2"></i>@TempData["PasswordMessage"]
</div>
}
@if (TempData["ErrorMessage"] != null)
{
<div class="mb-6 p-4 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-300 rounded-lg">
    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
</div>
}

<div class="space-y-6">
    <!-- Header -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 border border-blue-200 dark:border-gray-600 shadow-lg mb-6">
        <h1 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-2">
            <i class="fas fa-building me-3"></i>Firma Profili
        </h1>
        <p class="text-blue-600 dark:text-blue-300">Firma profil bilgilerinizi düzenleyebilirsiniz</p>
    </div>

    <!-- Profile Information -->
    <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 shadow-lg mb-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-6">
            <i class="fas fa-user me-2"></i>Firma Bilgileri
        </h3>
        <form asp-action="Profile" method="post" class="space-y-6" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CompanyId" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="CompanyName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-building me-1"></i>Firma Adý
                    </label>
                    <input asp-for="CompanyName" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Firma adýnýzý girin" />
                </div>
                <div>
                    <label asp-for="Sector" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-industry me-1"></i>Sektör
                    </label>
                    <input asp-for="Sector" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Sektörünüzü girin" />
                </div>
                <div>
                    <label asp-for="Phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-phone me-1"></i>Telefon
                    </label>
                    <input asp-for="Phone" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Telefon numaranýz" />
                </div>
                <div>
                    <label asp-for="TaxNumber" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-file-invoice me-1"></i>Vergi No
                    </label>
                    <input asp-for="TaxNumber" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Vergi numaranýz" />
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-envelope me-1"></i>E-posta
                    </label>
                    <input asp-for="Email" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="E-posta adresiniz" />
                </div>
                <div>
                    <label asp-for="Website" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-globe me-1"></i>Web Sitesi
                    </label>
                    <input asp-for="Website" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Web sitesi adresiniz" />
                </div>
                <div>
                    <label asp-for="EmployeeCount" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-users me-1"></i>Çalýþan Sayýsý
                    </label>
                    <input asp-for="EmployeeCount" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Çalýþan sayýsý" />
                </div>
                <div>
                    <label asp-for="Address" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-map-marker-alt me-1"></i>Adres
                    </label>
                    <input asp-for="Address" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Adres" />
                </div>
                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-align-left me-1"></i>Firma Açýklamasý
                    </label>
                    <textarea asp-for="Description" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Firma açýklamasý"></textarea>
                </div>
                <div>
                    <label asp-for="EstablishedDate" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-calendar-alt me-1"></i>Kuruluþ Tarihi
                    </label>
                    <input asp-for="EstablishedDate" type="date" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
                <div>
                    <label asp-for="UserFullName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-user me-1"></i>Kullanýcý Adý Soyadý
                    </label>
                    <input asp-for="UserFullName" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Kullanýcý adý soyadý" />
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-envelope me-1"></i>Kullanýcý E-posta
                    </label>
                    <input asp-for="Email" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Kullanýcý e-posta" />
                </div>
            </div>
            <button type="submit" class="bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105 font-medium mt-6">
                <i class="fas fa-save mr-2"></i>Firma Bilgilerini Güncelle
            </button>
        </form>
    </div>

    <!-- Change Password -->
    <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 shadow-lg">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-6">
            <i class="fas fa-lock me-2"></i>Þifre Deðiþtir
        </h3>
        <form method="post" asp-action="ChangePassword" class="change-password-form">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-key me-1"></i>Mevcut Þifre
                    </label>
                    <input type="password" name="CurrentPassword" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Mevcut þifrenizi girin" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-lock me-1"></i>Yeni Þifre
                    </label>
                    <input type="password" name="NewPassword" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Yeni þifrenizi girin (en az 6 karakter)" minlength="6" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        <i class="fas fa-check-circle me-1"></i>Yeni Þifre Tekrar
                    </label>
                    <input type="password" name="ConfirmNewPassword" class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-white" placeholder="Yeni þifrenizi tekrar girin" />
                </div>
            </div>
            <button type="submit" class="mt-6 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105 font-medium">
                <i class="fas fa-shield-alt me-2"></i>Þifreyi Güncelle
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Password confirmation validation
        document.addEventListener('DOMContentLoaded', function() {
            const passwordForm = document.querySelector('.change-password-form');
            if (!passwordForm) return;
            const newPassword = passwordForm.querySelector('input[name="NewPassword"]');
            const confirmPassword = passwordForm.querySelector('input[name="ConfirmNewPassword"]');
            function validatePasswords() {
                if (newPassword.value !== confirmPassword.value) {
                    confirmPassword.setCustomValidity('Þifreler eþleþmiyor');
                } else {
                    confirmPassword.setCustomValidity('');
                }
            }
            newPassword.addEventListener('input', validatePasswords);
            confirmPassword.addEventListener('input', validatePasswords);
            passwordForm.addEventListener('submit', function(e) {
                if (newPassword.value !== confirmPassword.value) {
                    e.preventDefault();
                    alert('Þifreler eþleþmiyor. Lütfen kontrol edin.');
                }
            });
        });
    </script>
}