@model List<WebUI.Models.Company.ActiveInternViewModel>
@{
    ViewData["Title"] = "Aktif Stajyerler";
    Layout = "_AppLayout";
}

@section Styles {
    <style>
        .intern-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
        .dark .intern-card {
            background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
            border: 1px solid #4b5563;
        }
        .intern-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.1);
        }
        .progress-container {
            background: #f1f5f9;
            border-radius: 12px;
            overflow: hidden;
            height: 8px;
        }
        .dark .progress-container {
            background: #374151;
        }
        .progress-fill {
            background: linear-gradient(90deg, #3b82f6, #1d4ed8);
            height: 100%;
            border-radius: 12px;
            transition: width 1s ease-in-out;
        }
        .btn-chat {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-chat:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
            color: white;
        }
        .btn-detail {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-detail:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
            color: white;
        }
        .btn-export {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-export:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
            color: white;
        }
    </style>
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
                <i class="fas fa-users mr-3 text-blue-600 dark:text-blue-400"></i>Aktif Stajyerler
            </h1>
            <p class="text-gray-600 dark:text-gray-400">Þu anda þirketinizde staj yapan öðrencileri görüntüleyin ve takip edin.</p>
        </div>
        <div class="flex space-x-4">
            <a asp-action="Reports" class="btn-export">
                <i class="fas fa-chart-bar mr-2"></i>Raporlar
            </a>
            <a asp-action="ExportToExcel" class="btn-export">
                <i class="fas fa-download mr-2"></i>Listeyi Dýþa Aktar
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-600 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Toplam Aktif Stajyer</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.Count</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl">
                    <i class="fas fa-users text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-600 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Bu Hafta Baþlayan</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.Count(m => m.StartDate >= DateTime.Now.AddDays(-7))</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-green-500 to-green-600 rounded-xl">
                    <i class="fas fa-calendar-check text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-600 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Bu Ay Bitecek</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.Count(m => m.EndDate <= DateTime.Now.AddDays(30))</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-orange-500 to-orange-600 rounded-xl">
                    <i class="fas fa-calendar-times text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-600 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Ortalama Ýlerleme</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white">@(Model.Any() ? Model.Average(m => m.ProgressPercentage).ToString("F1") : "0")%</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl">
                    <i class="fas fa-chart-line text-white text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Active Interns List -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            @foreach (var intern in Model.OrderBy(m => m.EndDate))
            {
                <div class="intern-card">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full flex items-center justify-center">
                                <span class="text-white font-bold text-lg">@intern.StudentName.Substring(0, 1).ToUpper()</span>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">@intern.StudentName</h3>
                                <p class="text-sm text-gray-600 dark:text-gray-400">@intern.Position</p>
                            </div>
                        </div>
                        <div class="flex space-x-2">
                            <a asp-action="StartChat" asp-route-studentId="@intern.StudentId" class="btn-chat" title="Ýletiþim">
                                <i class="fas fa-comments"></i>
                            </a>
                            <a asp-action="Detail" asp-route-id="@intern.Id" class="btn-detail" title="Detay">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-gray-600 dark:text-gray-400">
                                <i class="fas fa-calendar mr-2"></i>
                                @intern.StartDate.ToString("dd MMM yyyy") - @intern.EndDate.ToString("dd MMM yyyy")
                            </span>
                            <span class="font-medium text-gray-900 dark:text-white">
                                @{
                                    var remaining = intern.EndDate.Date - DateTime.Now.Date;
                                    var totalDays = (int)remaining.TotalDays;
                                    var months = totalDays / 30;
                                    var days = totalDays % 30;
                                    
                                    string remainingText;
                                    if (totalDays <= 0)
                                        remainingText = "Tamamlandý";
                                    else if (months > 0)
                                        remainingText = $"{months} ay {days} gün";
                                    else
                                        remainingText = $"{days} gün";
                                }
                                @remainingText kaldý
                            </span>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-sm text-gray-600 dark:text-gray-400">Ýlerleme</span>
                                <span class="text-sm font-medium text-gray-900 dark:text-white">@intern.ProgressPercentage.ToString("F1")%</span>
                            </div>
                            <div class="progress-container">
                                <div class="progress-fill" style="width: @intern.ProgressPercentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>

                        <div class="flex justify-between text-sm text-gray-600 dark:text-gray-400">
                            <span>Tamamlanan: @intern.CompletedDays gün</span>
                            <span>Toplam: @intern.TotalDays gün</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 shadow-lg rounded-xl">
            <div class="p-12 text-center">
                <i class="fas fa-users text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
                    Aktif stajyer bulunmuyor
                </h3>
                <p class="text-gray-600 dark:text-gray-400 mb-6">
                    Þu anda þirketinizde aktif staj yapan öðrenci bulunmuyor. 
                    Yeni ilanlar oluþturarak öðrencilere fýrsat sunabilirsiniz.
                </p>
                <div class="space-x-4">
                    <a asp-controller="CompanyJobPostings" asp-action="Create" class="btn-detail px-6 py-3 rounded-lg">
                        <i class="fas fa-plus mr-2"></i>Yeni Ýlan Oluþtur
                    </a>
                    <a asp-controller="CompanyApplications" asp-action="List" class="btn-chat px-6 py-3 rounded-lg">
                        <i class="fas fa-file-alt mr-2"></i>Baþvurularý Ýncele
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Animate progress bars on load
            $('.progress-fill').each(function() {
                var width = $(this).css('width');
                $(this).css('width', '0%').animate({
                    width: width
                }, 1000);
            });

            // Auto-refresh every 5 minutes
            setInterval(function() {
                console.log('Refreshing intern data...');
                // Could implement AJAX refresh here
            }, 300000);
        });

        // Success messages for actions
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            setTimeout(function() {
                alert('@TempData["SuccessMessage"]');
            }, 100);
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            setTimeout(function() {
                alert('@TempData["ErrorMessage"]');
            }, 100);
            </text>
        }
    </script>
}