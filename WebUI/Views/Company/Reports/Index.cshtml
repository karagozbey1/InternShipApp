@model WebUI.Models.Company.CompanyReportsViewModel
@{
    ViewData["Title"] = "Raporlar";
    Layout = "_AppLayout";
}

@section Styles {
    <style>
        .reports-sidebar {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            height: fit-content;
            position: sticky;
            top: 20px;
        }
        .dark .reports-sidebar {
            background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
            border: 1px solid #4b5563;
        }
        .report-menu-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            margin-bottom: 8px;
            border-radius: 12px;
            color: #6b7280;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .dark .report-menu-item {
            color: #9ca3af;
        }
        .report-menu-item:hover {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            color: #3b82f6;
            transform: translateX(4px);
        }
        .dark .report-menu-item:hover {
            background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);
            color: #93c5fd;
        }
        .report-menu-item.active {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
        }
        .report-content {
            display: none;
        }
        .report-content.active {
            display: block;
        }
        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
        .dark .stat-card {
            background: #1f2937;
            border: 1px solid #4b5563;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.1);
        }
        .chart-container {
            background: white;
            border-radius: 12px;
            padding: 24px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }
        .dark .chart-container {
            background: #1f2937;
            border: 1px solid #4b5563;
        }
        .department-bar {
            background: linear-gradient(90deg, #3b82f6, #1d4ed8);
            height: 20px;
            border-radius: 10px;
            transition: width 1s ease-in-out;
        }
        .status-bar {
            height: 16px;
            border-radius: 8px;
            transition: width 1s ease-in-out;
        }
        .status-approved { background: linear-gradient(90deg, #10b981, #059669); }
        .status-pending { background: linear-gradient(90deg, #f59e0b, #d97706); }
        .status-rejected { background: linear-gradient(90deg, #ef4444, #dc2626); }
        .export-btn {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .export-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
            color: white;
        }
        .performance-metric {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .dark .performance-metric {
            border-bottom: 1px solid #374151;
        }
        .performance-metric:last-child {
            border-bottom: none;
        }
    </style>
}

<div class="grid grid-cols-12 gap-6">
    <!-- Sol Menü -->
    <div class="col-span-3">
        <div class="reports-sidebar">
            <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">
                <i class="fas fa-chart-bar mr-2 text-blue-600 dark:text-blue-400"></i>Rapor Menüsü
            </h2>
            
            <nav class="space-y-2">
                <a href="#overview" class="report-menu-item active" data-tab="overview">
                    <i class="fas fa-tachometer-alt w-5 h-5 mr-3"></i>
                    <span>Genel Bakýþ</span>
                </a>
                <a href="#applications" class="report-menu-item" data-tab="applications">
                    <i class="fas fa-file-alt w-5 h-5 mr-3"></i>
                    <span>Baþvuru Analizi</span>
                </a>
                <a href="#departments" class="report-menu-item" data-tab="departments">
                    <i class="fas fa-university w-5 h-5 mr-3"></i>
                    <span>Bölüm Daðýlýmý</span>
                </a>
                <a href="#timeline" class="report-menu-item" data-tab="timeline">
                    <i class="fas fa-chart-line w-5 h-5 mr-3"></i>
                    <span>Zaman Analizi</span>
                </a>
                <a href="#performance" class="report-menu-item" data-tab="performance">
                    <i class="fas fa-award w-5 h-5 mr-3"></i>
                    <span>Performans</span>
                </a>
                <a href="#recommendations" class="report-menu-item" data-tab="recommendations">
                    <i class="fas fa-lightbulb w-5 h-5 mr-3"></i>
                    <span>Öneriler</span>
                </a>
            </nav>
        </div>
    </div>

    <!-- Sað Ýçerik -->
    <div class="col-span-9">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                    <span id="page-title">Genel Bakýþ</span>
                </h1>
                <p class="text-gray-600 dark:text-gray-400" id="page-description">Þirket staj süreçleri ile ilgili özet bilgiler.</p>
            </div>
            <div class="flex space-x-4">
                <button onclick="exportToExcel()" class="export-btn">
                    <i class="fas fa-file-excel mr-2"></i>Excel Ýndir
                </button>
            </div>
        </div>

        <!-- Genel Bakýþ -->
        <div id="overview" class="report-content active">
            <!-- Summary Statistics -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Toplam Baþvuru</p>
                            <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.TotalApplications</p>
                            <p class="text-sm text-green-600 dark:text-green-400 mt-1">
                                <i class="fas fa-arrow-up mr-1"></i>Bu ay: @Model.ThisMonthApplications
                            </p>
                        </div>
                        <div class="p-3 bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl">
                            <i class="fas fa-file-alt text-white text-xl"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Onaylanma Oraný</p>
                            <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.ApprovalRate.ToString("F1")%</p>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                                @Model.ApprovedApplications / @Model.TotalApplications baþvuru
                            </p>
                        </div>
                        <div class="p-3 bg-gradient-to-r from-green-500 to-green-600 rounded-xl">
                            <i class="fas fa-check-circle text-white text-xl"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Aktif Stajyer</p>
                            <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.ActiveInterns</p>
                            <p class="text-sm text-blue-600 dark:text-blue-400 mt-1">
                                Þu anda aktif
                            </p>
                        </div>
                        <div class="p-3 bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl">
                            <i class="fas fa-users text-white text-xl"></i>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Tamamlanan Staj</p>
                            <p class="text-3xl font-bold text-gray-900 dark:text-white">@Model.CompletedInterns</p>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                                Baþarýyla tamamlandý
                            </p>
                        </div>
                        <div class="p-3 bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-xl">
                            <i class="fas fa-graduation-cap text-white text-xl"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Charts -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="chart-container">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-pie-chart mr-2 text-blue-600 dark:text-blue-400"></i>Baþvuru Durumlarý
                    </h3>
                    <div class="space-y-4">
                        @foreach (var statusData in Model.StatusData)
                        {
                            <div class="flex items-center justify-between">
                                <div class="flex items-center">
                                    <div class="w-4 h-4 rounded-full mr-3 @(statusData.Status == "Onaylandý" ? "bg-green-500" : statusData.Status == "Beklemede" ? "bg-yellow-500" : "bg-red-500")"></div>
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@statusData.Status</span>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-bold text-gray-900 dark:text-white">@statusData.Count</div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400">@(Model.TotalApplications > 0 ? ((decimal)statusData.Count / Model.TotalApplications * 100).ToString("F1") : "0")%</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="chart-container">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                        <i class="fas fa-chart-bar mr-2 text-blue-600 dark:text-blue-400"></i>Son 3 Aylýk Trend
                    </h3>
                    <div class="space-y-4">
                        @foreach (var monthData in Model.MonthlyData.TakeLast(3))
                        {
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@monthData.Month</span>
                                    <span class="text-sm text-gray-600 dark:text-gray-400">@monthData.Applications baþvuru</span>
                                </div>
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-3">
                                    <div class="department-bar h-3 rounded-full" style="width: @(Model.MonthlyData.Any() ? (decimal)monthData.Applications / Model.MonthlyData.Max(m => m.Applications) * 100 : 0)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Baþvuru Analizi -->
        <div id="applications" class="report-content">
            <div class="chart-container">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-6">
                    <i class="fas fa-pie-chart mr-2 text-blue-600 dark:text-blue-400"></i>Baþvuru Durum Daðýlýmý
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @foreach (var statusData in Model.StatusData)
                    {
                        <div class="text-center">
                            <div class="relative w-24 h-24 mx-auto mb-4">
                                <div class="w-24 h-24 rounded-full @(statusData.Status == "Onaylandý" ? "bg-green-100 dark:bg-green-900/30" : statusData.Status == "Beklemede" ? "bg-yellow-100 dark:bg-yellow-900/30" : "bg-red-100 dark:bg-red-900/30") flex items-center justify-center">
                                    <div class="text-2xl font-bold @(statusData.Status == "Onaylandý" ? "text-green-600 dark:text-green-400" : statusData.Status == "Beklemede" ? "text-yellow-600 dark:text-yellow-400" : "text-red-600 dark:text-red-400")">
                                        @statusData.Count
                                    </div>
                                </div>
                            </div>
                            <div class="font-medium text-gray-900 dark:text-gray-100">@statusData.Status</div>
                            <div class="text-sm text-gray-600 dark:text-gray-400">
                                @(Model.TotalApplications > 0 ? ((decimal)statusData.Count / Model.TotalApplications * 100).ToString("F1") : "0")%
                            </div>
                            <div class="mt-2">
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                                    <div class="status-bar h-2 rounded-full @(statusData.Status == "Onaylandý" ? "status-approved" : statusData.Status == "Beklemede" ? "status-pending" : "status-rejected")" 
                                         style="width: @(Model.TotalApplications > 0 ? (decimal)statusData.Count / Model.TotalApplications * 100 : 0)%"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bölüm Daðýlýmý -->
        <div id="departments" class="report-content">
            <div class="chart-container">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                    <i class="fas fa-university mr-2 text-blue-600 dark:text-blue-400"></i>Bölüm Daðýlýmý
                </h3>
                <div class="space-y-4">
                    @foreach (var deptData in Model.DepartmentData.Take(10))
                    {
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@deptData.Department</span>
                                <span class="text-sm text-gray-600 dark:text-gray-400">@deptData.Count baþvuru</span>
                            </div>
                            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-4">
                                <div class="department-bar h-4 rounded-full" style="width: @(Model.DepartmentData.Any() ? (decimal)deptData.Count / Model.DepartmentData.Max(d => d.Count) * 100 : 0)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Zaman Analizi -->
        <div id="timeline" class="report-content">
            <div class="chart-container">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                    <i class="fas fa-chart-line mr-2 text-blue-600 dark:text-blue-400"></i>Aylýk Baþvuru Trendi
                </h3>
                <div class="space-y-4">
                    @foreach (var monthData in Model.MonthlyData)
                    {
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@monthData.Month</span>
                                <span class="text-sm text-gray-600 dark:text-gray-400">@monthData.Applications baþvuru, @monthData.Approvals onay</span>
                            </div>
                            <div class="relative">
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-4">
                                    <div class="department-bar h-4 rounded-full" style="width: @(Model.MonthlyData.Any() ? (decimal)monthData.Applications / Model.MonthlyData.Max(m => m.Applications) * 100 : 0)%"></div>
                                </div>
                                <div class="absolute top-0 left-0 w-full bg-green-400 rounded-full h-4 opacity-60" style="width: @(monthData.Applications > 0 ? (decimal)monthData.Approvals / monthData.Applications * 100 : 0)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Performans -->
        <div id="performance" class="report-content">
            <div class="chart-container">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                    <i class="fas fa-award mr-2 text-blue-600 dark:text-blue-400"></i>Performans Göstergeleri
                </h3>
                <div class="space-y-0">
                    <div class="performance-metric">
                        <span class="text-gray-600 dark:text-gray-400">Ortalama baþvuru süresi</span>
                        <span class="font-medium text-gray-900 dark:text-white">2.3 gün</span>
                    </div>
                    <div class="performance-metric">
                        <span class="text-gray-600 dark:text-gray-400">En popüler pozisyon</span>
                        <span class="font-medium text-gray-900 dark:text-white">@(Model.DepartmentData.FirstOrDefault()?.Department ?? "Bilinmiyor")</span>
                    </div>
                    <div class="performance-metric">
                        <span class="text-gray-600 dark:text-gray-400">Ortalama staj süresi</span>
                        <span class="font-medium text-gray-900 dark:text-white">45 gün</span>
                    </div>
                    <div class="performance-metric">
                        <span class="text-gray-600 dark:text-gray-400">Baþarý oraný</span>
                        <span class="font-medium text-green-600 dark:text-green-400">@Model.ApprovalRate.ToString("F1")%</span>
                    </div>
                    <div class="performance-metric">
                        <span class="text-gray-600 dark:text-gray-400">Bu ay baþvuru artýþý</span>
                        <span class="font-medium text-blue-600 dark:text-blue-400">+@(Model.TotalApplications > 0 ? (Model.ThisMonthApplications * 100 / Math.Max(Model.TotalApplications, 1)).ToString("F0") : "0")%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Öneriler -->
        <div id="recommendations" class="report-content">
            <div class="chart-container">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">
                    <i class="fas fa-lightbulb mr-2 text-blue-600 dark:text-blue-400"></i>Akýllý Öneriler
                </h3>
                <div class="space-y-4">
                    @if (Model.ApprovalRate < 50)
                    {
                        <div class="flex items-start p-4 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-lg">
                            <i class="fas fa-exclamation-triangle text-orange-500 dark:text-orange-400 mr-3 mt-1"></i>
                            <div>
                                <h4 class="font-medium text-orange-800 dark:text-orange-300">Onaylanma Oraný Düþük</h4>
                                <p class="text-sm text-orange-700 dark:text-orange-400 mt-1">Onaylanma oranýnýz %@Model.ApprovalRate.ToString("F1") seviyesinde. Ýlan kriterlerinizi gözden geçirmeyi ve daha açýk job tanýmlarý yazmayý düþünün.</p>
                            </div>
                        </div>
                    }
                    @if (Model.ActiveInterns < 5)
                    {
                        <div class="flex items-start p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
                            <i class="fas fa-info-circle text-blue-500 dark:text-blue-400 mr-3 mt-1"></i>
                            <div>
                                <h4 class="font-medium text-blue-800 dark:text-blue-300">Kapasite Artýrýmý</h4>
                                <p class="text-sm text-blue-700 dark:text-blue-400 mt-1">Þu anda @Model.ActiveInterns stajyer ile çalýþýyorsunuz. Daha fazla stajyer alarak þirket kapasitesini artýrabilir ve yetenekli öðrencilerle tanýþabilirsiniz.</p>
                            </div>
                        </div>
                    }
                    @if (Model.ThisMonthApplications > Model.TotalApplications / 6)
                    {
                        <div class="flex items-start p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
                            <i class="fas fa-check-circle text-green-500 dark:text-green-400 mr-3 mt-1"></i>
                            <div>
                                <h4 class="font-medium text-green-800 dark:text-green-300">Baþarýlý Performans</h4>
                                <p class="text-sm text-green-700 dark:text-green-400 mt-1">Bu ay baþvuru sayýnýz ortalamanýn üzerinde! Bu momentum'u korumak için sosyal medya paylaþýmlarýnýzý artýrabilirsiniz.</p>
                            </div>
                        </div>
                    }
                    <div class="flex items-start p-4 bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-lg">
                        <i class="fas fa-chart-line text-purple-500 dark:text-purple-400 mr-3 mt-1"></i>
                        <div>
                            <h4 class="font-medium text-purple-800 dark:text-purple-300">Geliþim Önerisi</h4>
                            <p class="text-sm text-purple-700 dark:text-purple-400 mt-1">En çok baþvuru alan bölüm "@(Model.DepartmentData.FirstOrDefault()?.Department ?? "Bilinmiyor")". Bu bölümlerden daha fazla stajyer almayý düþünebilirsiniz.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Menu navigation
            $('.report-menu-item').click(function(e) {
                e.preventDefault();
                
                // Remove active class from all menu items and content
                $('.report-menu-item').removeClass('active');
                $('.report-content').removeClass('active');
                
                // Add active class to clicked item
                $(this).addClass('active');
                
                // Show corresponding content
                var tabId = $(this).data('tab');
                $('#' + tabId).addClass('active');
                
                // Update page title and description
                updatePageInfo(tabId);
                
                // Animate progress bars for the active tab
                setTimeout(function() {
                    $('#' + tabId + ' .department-bar, #' + tabId + ' .status-bar').each(function() {
                        var width = $(this).attr('style').match(/width:\s*([^;%]+)%/);
                        if (width) {
                            $(this).css('width', '0%').animate({
                                width: width[1] + '%'
                            }, 1000);
                        }
                    });
                }, 100);
            });

            // Initial animation
            animateCurrentTabBars();
        });

        function updatePageInfo(tabId) {
            var titles = {
                'overview': 'Genel Bakýþ',
                'applications': 'Baþvuru Analizi',
                'departments': 'Bölüm Daðýlýmý',
                'timeline': 'Zaman Analizi',
                'performance': 'Performans',
                'recommendations': 'Öneriler'
            };
            
            var descriptions = {
                'overview': 'Þirket staj süreçleri ile ilgili özet bilgiler.',
                'applications': 'Baþvuru durumlarý ve onay oranlarý analizi.',
                'departments': 'Üniversite bölümlerine göre baþvuru daðýlýmý.',
                'timeline': 'Aylýk baþvuru trendleri ve zaman analizi.',
                'performance': 'Detaylý performans göstergeleri ve metrikler.',
                'recommendations': 'Sisteminizi geliþtirmek için akýllý öneriler.'
            };
            
            $('#page-title').text(titles[tabId] || 'Raporlar');
            $('#page-description').text(descriptions[tabId] || 'Rapor detaylarý.');
        }

        function animateCurrentTabBars() {
            $('.report-content.active .department-bar, .report-content.active .status-bar').each(function() {
                var width = $(this).attr('style');
                if (width && width.includes('width:')) {
                    var widthValue = width.match(/width:\s*([^;%]+)%/);
                    if (widthValue) {
                        $(this).css('width', '0%').animate({
                            width: widthValue[1] + '%'
                        }, 1500);
                    }
                }
            });
        }

        function exportToExcel() {
            // Excel export için actual implementation
            fetch('@Url.Action("ExportToExcel", "CompanyInterns")', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => {
                if (response.ok) {
                    return response.blob();
                }
                throw new Error('Excel export failed');
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = `Stajyer_Raporu_${new Date().toISOString().slice(0,10)}.csv`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                showNotification('Excel dosyasý baþarýyla indirildi!', 'success');
            })
            .catch(error => {
                console.error('Excel export error:', error);
                showNotification('Excel export hatasý: ' + error.message, 'error');
            });
        }

        // Auto refresh data every 2 minutes
        setInterval(function() {
            console.log('Refreshing report data...');
        }, 120000);

        // Success/Error messages
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            setTimeout(function() {
                showNotification('@TempData["SuccessMessage"]', 'success');
            }, 100);
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            setTimeout(function() {
                showNotification('@TempData["ErrorMessage"]', 'error');
            }, 100);
            </text>
        }

        function showNotification(message, type) {
            // Simple notification system
            var notification = $('<div class="fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ' + 
                (type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white') + '">' + 
                message + '</div>');
            
            $('body').append(notification);
            
            setTimeout(function() {
                notification.fadeOut(function() {
                    notification.remove();
                });
            }, 3000);
        }
    </script>
}