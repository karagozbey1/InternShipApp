@* Þirket raporlarý ana sayfasý *@
@model WebUI.Models.ViewModels.Company.CompanyReportViewModel

@{
    ViewData["Title"] = "Raporlar";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@* Ana container *@
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        @* Sayfa baþlýðý *@
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
                <i class="fas fa-chart-bar text-blue-600 dark:text-blue-400 mr-3"></i>
                Þirket Raporlarý
            </h1>
            <p class="mt-2 text-gray-600 dark:text-gray-300">
                Stajyerleriniz ve baþvuru süreçleriniz hakkýnda detaylý analiz ve raporlar
            </p>
        </div>

        @* Ýstatistik kartlarý *@
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            @* Toplam baþvuru sayýsý *@
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Toplam Baþvuru</p>
                        <p class="text-3xl font-bold text-blue-600 dark:text-blue-400">@Model.TotalApplications</p>
                    </div>
                    <div class="p-3 bg-blue-100 dark:bg-blue-900 rounded-full">
                        <i class="fas fa-file-alt text-blue-600 dark:text-blue-400 text-xl"></i>
                    </div>
                </div>
            </div>

            @* Bu ayki baþvuru sayýsý *@
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Bu Ay</p>
                        <p class="text-3xl font-bold text-green-600 dark:text-green-400">@Model.ThisMonthApplications</p>
                    </div>
                    <div class="p-3 bg-green-100 dark:bg-green-900 rounded-full">
                        <i class="fas fa-calendar text-green-600 dark:text-green-400 text-xl"></i>
                    </div>
                </div>
            </div>

            @* Aktif stajyer sayýsý *@
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Aktif Stajyerler</p>
                        <p class="text-3xl font-bold text-purple-600 dark:text-purple-400">@Model.ActiveInterns</p>
                    </div>
                    <div class="p-3 bg-purple-100 dark:bg-purple-900 rounded-full">
                        <i class="fas fa-users text-purple-600 dark:text-purple-400 text-xl"></i>
                    </div>
                </div>
            </div>

            @* Onaylanma oraný *@
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 dark:text-gray-300">Onaylanma Oraný</p>
                        <p class="text-3xl font-bold text-orange-600 dark:text-orange-400">%@Model.ApprovalRate.ToString("F1")</p>
                    </div>
                    <div class="p-3 bg-orange-100 dark:bg-orange-900 rounded-full">
                        <i class="fas fa-percentage text-orange-600 dark:text-orange-400 text-xl"></i>
                    </div>
                </div>
            </div>
        </div>

        @* Ana içerik alaný - iki kolon *@
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            @* Sol kolon - grafikler *@
            <div class="lg:col-span-2 space-y-6">
                @* Aylýk baþvuru trendi grafiði *@
                <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
                        <i class="fas fa-chart-line text-blue-600 dark:text-blue-400 mr-2"></i>
                        Aylýk Baþvuru Trendi
                    </h3>
                    <canvas id="monthlyApplicationsChart" width="400" height="200"></canvas>
                </div>

                @* Baþvuru durumlarý pasta grafiði *@
                <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
                        <i class="fas fa-chart-pie text-green-600 dark:text-green-400 mr-2"></i>
                        Baþvuru Durumlarý
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <canvas id="applicationStatusChart" width="200" height="200"></canvas>
                        <div class="space-y-2">
                            @* Durum legendasý *@
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-yellow-500 rounded mr-2"></div>
                                <span class="text-sm text-gray-600 dark:text-gray-300">Beklemede: @Model.PendingApplications</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-green-500 rounded mr-2"></div>
                                <span class="text-sm text-gray-600 dark:text-gray-300">Onaylý: @Model.ApprovedApplications</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-4 h-4 bg-red-500 rounded mr-2"></div>
                                <span class="text-sm text-gray-600 dark:text-gray-300">Reddedilen: @Model.RejectedApplications</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Sað kolon - eylemler ve öneriler *@
            <div class="space-y-6">
                @* Hýzlý eylemler kartý *@
                <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
                        <i class="fas fa-bolt text-yellow-600 dark:text-yellow-400 mr-2"></i>
                        Hýzlý Eylemler
                    </h3>
                    <div class="space-y-3">
                        @* Excel export butonu *@
                        <button onclick="exportToExcel()" class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition-colors">
                            <i class="fas fa-file-excel mr-2"></i>
                            Excel'e Aktar
                        </button>
                        
                        @* PDF rapor butonu *@
                        <button onclick="generatePDFReport()" class="w-full bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded-lg transition-colors">
                            <i class="fas fa-file-pdf mr-2"></i>
                            PDF Rapor
                        </button>
                        
                        @* E-posta raporu butonu *@
                        <button onclick="emailReport()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors">
                            <i class="fas fa-envelope mr-2"></i>
                            E-posta Gönder
                        </button>
                    </div>
                </div>

                @* Öneriler ve uyarýlar *@
                <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
                        <i class="fas fa-lightbulb text-yellow-600 dark:text-yellow-400 mr-2"></i>
                        Öneriler
                    </h3>
                    <div class="space-y-4">
                        @* Düþük onaylanma oraný uyarýsý *@
                        @if (Model.ApprovalRate < 50)
                        {
                            <div class="flex items-start p-4 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-lg">
                                <i class="fas fa-exclamation-triangle text-orange-500 dark:text-orange-400 mr-3 mt-1"></i>
                                <div>
                                    <h4 class="font-medium text-orange-800 dark:text-orange-300">Onaylanma Oraný Düþük</h4>
                                    <p class="text-sm text-orange-700 dark:text-orange-400 mt-1">Onaylanma oranýnýz %@Model.ApprovalRate.ToString("F1") seviyesinde. Ýlan kriterlerinizi gözden geçirmeyi ve daha açýk job tanýmlarý yazmayý düþünün.</p>
                                </div>
                            </div>
                        }
                        
                        @* Kapasite artýrým önerisi *@
                        @if (Model.ActiveInterns < 5)
                        {
                            <div class="flex items-start p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
                                <i class="fas fa-info-circle text-blue-500 dark:text-blue-400 mr-3 mt-1"></i>
                                <div>
                                    <h4 class="font-medium text-blue-800 dark:text-blue-300">Kapasite Artýrýmý</h4>
                                    <p class="text-sm text-blue-700 dark:text-blue-400 mt-1">Þu anda @Model.ActiveInterns stajyer ile çalýþýyorsunuz. Daha fazla stajyer alarak þirket kapasitesini artýrabilir ve yetenekli öðrencilerle tanýþabilirsiniz.</p>
                                </div>
                            </div>
                        }
                        
                        @* Baþarýlý performans tebriði *@
                        @if (Model.ThisMonthApplications > Model.TotalApplications / 6)
                        {
                            <div class="flex items-start p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
                                <i class="fas fa-check-circle text-green-500 dark:text-green-400 mr-3 mt-1"></i>
                                <div>
                                    <h4 class="font-medium text-green-800 dark:text-green-300">Baþarýlý Performans</h4>
                                    <p class="text-sm text-green-700 dark:text-green-400 mt-1">Bu ay baþvuru sayýnýz ortalamanýn üzerinde! Bu momentum'u korumak için sosyal medya paylaþýmlarýnýzý artýrabilirsiniz.</p>
                                </div>
                            </div>
                        }
                        
                        @* Genel geliþim önerisi *@
                        <div class="flex items-start p-4 bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-lg">
                            <i class="fas fa-chart-line text-purple-500 dark:text-purple-400 mr-3 mt-1"></i>
                            <div>
                                <h4 class="font-medium text-purple-800 dark:text-purple-300">Geliþim Önerisi</h4>
                                <p class="text-sm text-purple-700 dark:text-purple-400 mt-1">Stajyer memnuniyetini artýrmak için düzenli feedback toplantýlarý düzenlemeyi ve mentorluk programlarý geliþtirmeyi göz önünde bulundurun.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/company-reports.css" asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/company/reports.js" asp-append-version="true"></script>
}