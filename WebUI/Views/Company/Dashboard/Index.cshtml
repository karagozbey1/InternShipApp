@model WebUI.Models.Company.CompanyDashboardViewModel
@{
    ViewData["Title"] = "Firma Paneli";
    Layout = "_AppLayout";
}

<div class="space-y-6">
    <!-- Welcome Card -->
    <div class="dynamic-card p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 border border-blue-200 dark:border-gray-600 shadow-lg mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-2">
                    <i class="fas fa-building me-3"></i>Hoþ Geldiniz, @Model.CompanyName
                </h1>
                <p class="text-blue-600 dark:text-blue-300">@Model.Sector</p>
            </div>
            <div class="text-right">
                <div class="text-blue-800 dark:text-blue-200 text-sm">@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</div>
                <div class="text-blue-600 dark:text-blue-300 text-sm">@DateTime.Now.ToString("dddd", new System.Globalization.CultureInfo("tr-TR"))</div>
            </div>
        </div>
    </div>

    <!-- Main Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Toplam Ýlan</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.TotalJobPostings</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-yellow-500 to-orange-500 rounded-xl">
                    <i class="fas fa-briefcase text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Toplam Baþvuru</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.TotalApplications</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl">
                    <i class="fas fa-file-alt text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Aktif Stajyer</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.ActiveInterns</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-green-500 to-emerald-500 rounded-xl">
                    <i class="fas fa-users text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Toplam Stajyer</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.TotalInterns</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl">
                    <i class="fas fa-graduation-cap text-white text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities Section -->
    <div class="dynamic-card p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg mb-6">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-gray-800 dark:text-gray-200">
                <i class="fas fa-activity mr-2"></i>Son Aktiviteler
            </h2>
            <button onclick="refreshActivities()" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-sm">
                <i class="fas fa-sync-alt mr-1"></i>Yenile
            </button>
        </div>
        
        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
        {
            <div class="space-y-4">
                @foreach (var activity in Model.RecentActivities)
                {
                    <div class="activity-item flex items-start space-x-4 p-4 bg-gray-50 dark:bg-gray-700 border border-gray-100 dark:border-gray-600 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 hover:shadow-md transition-all duration-200">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-gradient-to-r from-@(activity.Color)-500 to-@(activity.Color)-600 rounded-full flex items-center justify-center">
                                <i class="@activity.Icon text-white text-sm"></i>
                            </div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-medium text-gray-900 dark:text-white text-sm">@activity.Title</h4>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">@activity.Description</p>
                            <div class="flex items-center justify-between mt-2">
                                <p class="text-xs text-gray-500 dark:text-gray-500">@activity.TimeAgo</p>
                                @if (activity.ActivityType == "NewApplication" && activity.RelatedId.HasValue)
                                {
                                    <a asp-controller="CompanyApplications" asp-action="Detail" asp-route-id="@activity.RelatedId"
                                       class="text-xs text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium">
                                        Görüntüle <i class="fas fa-arrow-right ml-1"></i>
                                    </a>
                                }
                                else if (activity.ActivityType == "NewJobPosting" && activity.RelatedId.HasValue)
                                {
                                    <a asp-controller="CompanyJobPostings" asp-action="Detail" asp-route-id="@activity.RelatedId"
                                       class="text-xs text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium">
                                        Ýlaný Görüntüle <i class="fas fa-arrow-right ml-1"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <i class="fas fa-history text-gray-400 dark:text-gray-500 text-6xl mb-4"></i>
                <h3 class="text-lg font-semibold text-gray-600 dark:text-gray-400 mb-2">Henüz aktivite bulunmamaktadýr</h3>
                <p class="text-gray-500 dark:text-gray-500">Firma aktiviteleri burada görünecektir.</p>
                <div class="mt-4">
                    <a asp-controller="CompanyJobPostings" asp-action="Create" class="bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-6 py-3 rounded-lg transition-all duration-200">
                        <i class="fas fa-plus mr-2"></i>Ýlk Ýlanýnýzý Oluþturun
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Recent Applications Section -->
    <div class="dynamic-card p-6 rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-lg">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-gray-800 dark:text-gray-200">
                <i class="fas fa-file-alt mr-2"></i>Son Baþvurular
            </h2>
            <a asp-action="Applications" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-sm">
                Tümünü Gör
            </a>
        </div>
        <div class="space-y-4">
            @if (Model.RecentApplications != null && Model.RecentApplications.Any())
            {
                @foreach (var application in Model.RecentApplications)
                {
                    <div class="note-card p-4 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-400 dark:border-blue-500 rounded-lg shadow-sm">
                        <span class="text-xs text-blue-600 dark:text-blue-400 font-medium">@application.StudentName</span>
                        <h4 class="font-medium text-gray-800 dark:text-gray-200 text-sm mb-1">@application.JobTitle</h4>
                        <p class="text-xs text-gray-600 dark:text-gray-400 mb-2">@application.ApplicationDate.ToString("dd MMM yyyy")</p>
                        <span class="text-xs text-gray-500 dark:text-gray-500">@application.Status.GetDisplayName()</span>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8">
                    <i class="fas fa-file-alt text-4xl text-gray-300 dark:text-gray-600 mb-4"></i>
                    <p class="text-gray-500 dark:text-gray-500 mb-3">Henüz baþvuru bulunmuyor</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize dashboard
            initializeDashboard();
            
            // Auto-refresh every 2 minutes
            setInterval(refreshActivities, 120000);
        });

        function initializeDashboard() {
            // Animate stat numbers
            $('.stat-number').each(function() {
                const finalValue = parseInt($(this).text());
                $(this).text('0');
                animateNumber($(this), finalValue, 1500);
            });

            // Initialize activity hover effects
            $('.activity-item').hover(
                function() {
                    $(this).addClass('shadow-lg');
                },
                function() {
                    $(this).removeClass('shadow-lg');
                }
            );
        }

        function animateNumber(element, targetValue, duration) {
            const startValue = 0;
            const increment = targetValue / (duration / 50);
            let current = startValue;

            const timer = setInterval(() => {
                current += increment;
                if (current >= targetValue) {
                    current = targetValue;
                    clearInterval(timer);
                }
                element.text(Math.floor(current));
            }, 50);
        }

        function refreshActivities() {
            // Show loading indicator
            const refreshBtn = $('.fa-sync-alt');
            refreshBtn.addClass('fa-spin');

            // Reload the page to get fresh data
            // In a real implementation, this would be an AJAX call
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        }

        // Show notification for new activities
        function showActivityNotification(message) {
            const notification = $(`
                <div class="fixed top-4 right-4 bg-blue-500 text-white p-4 rounded-lg shadow-lg z-50 notification-popup">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-bell"></i>
                        <span>${message}</span>
                    </div>
                </div>
            `);
            
            $('body').append(notification);
            
            setTimeout(() => {
                notification.fadeOut(() => notification.remove());
            }, 5000);
        }

        // Success/Error messages
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            setTimeout(function() {
                showActivityNotification('@TempData["SuccessMessage"]');
            }, 100);
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            setTimeout(function() {
                const notification = $(`
                    <div class="fixed top-4 right-4 bg-red-500 text-white p-4 rounded-lg shadow-lg z-50">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>@TempData["ErrorMessage"]</span>
                        </div>
                    </div>
                `);
                $('body').append(notification);
                setTimeout(() => notification.fadeOut(() => notification.remove()), 5000);
            }, 100);
            </text>
        }
    </script>
}