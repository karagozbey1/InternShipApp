@model WebUI.Models.Company.CompanyDashboardViewModel
@{
    ViewData["Title"] = "Firma Paneli";
    Layout = "_AppLayout";
}

@section Styles {
    <style>
        .dashboard-hero {
            background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 50%, #8b5cf6 100%);
            border-radius: 24px;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }
        .dashboard-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        }
        .stat-card-premium {
            background: white;
            border-radius: 20px;
            padding: 24px;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }
        .stat-card-premium::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
        }
        .stat-card-premium.yellow::before { background: linear-gradient(90deg, #f59e0b, #ea580c); }
        .stat-card-premium.blue::before { background: linear-gradient(90deg, #3b82f6, #0ea5e9); }
        .stat-card-premium.green::before { background: linear-gradient(90deg, #10b981, #059669); }
        .stat-card-premium.purple::before { background: linear-gradient(90deg, #8b5cf6, #6366f1); }
        .dark .stat-card-premium { background: rgba(30, 41, 59, 0.95); border-color: rgba(71, 85, 105, 0.3); }
        .stat-card-premium:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(99, 102, 241, 0.15); }
        
        .activity-card-premium {
            background: white;
            border-radius: 20px;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .dark .activity-card-premium { background: rgba(30, 41, 59, 0.95); border-color: rgba(71, 85, 105, 0.3); }
        
        .activity-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
        }
        .dark .activity-header { background: rgba(51, 65, 85, 0.3); border-color: rgba(71, 85, 105, 0.3); }
        
        .activity-item-premium {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.25rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
            position: relative;
        }
        .activity-item-premium:last-child { border-bottom: none; }
        .activity-item-premium:hover { background: rgba(99, 102, 241, 0.05); }
        .dark .activity-item-premium:hover { background: rgba(99, 102, 241, 0.1); }
        
        .activity-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .activity-icon.blue { background: linear-gradient(135deg, #3b82f6, #0ea5e9); }
        .activity-icon.green { background: linear-gradient(135deg, #10b981, #059669); }
        .activity-icon.red { background: linear-gradient(135deg, #ef4444, #dc2626); }
        .activity-icon.purple { background: linear-gradient(135deg, #8b5cf6, #6366f1); }
        .activity-icon.indigo { background: linear-gradient(135deg, #6366f1, #4f46e5); }
        .activity-icon.orange { background: linear-gradient(135deg, #f59e0b, #ea580c); }
        .activity-icon.yellow { background: linear-gradient(135deg, #fbbf24, #f59e0b); }
        
        .activity-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .activity-badge.new { background: linear-gradient(135deg, #10b981, #059669); color: white; }
        
        .application-card-premium {
            background: white;
            border-radius: 16px;
            padding: 1.25rem;
            border: 1px solid rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            border-left: 4px solid #6366f1;
        }
        .dark .application-card-premium { background: rgba(30, 41, 59, 0.8); border-color: rgba(71, 85, 105, 0.3); }
        .application-card-premium:hover { transform: translateX(4px); box-shadow: 0 4px 15px rgba(99, 102, 241, 0.15); }
        
        .empty-state-premium {
            text-align: center;
            padding: 4rem 2rem;
        }
        .empty-state-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .empty-state-icon i { font-size: 2rem; color: #6366f1; }
        
        .refresh-btn {
            padding: 8px 16px;
            border-radius: 10px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
            color: #6366f1;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .refresh-btn:hover { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; }
        .refresh-btn i { transition: transform 0.5s ease; }
        .refresh-btn.loading i { animation: spin 1s linear infinite; }
        @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>
}

<div class="space-y-6">
    <!-- Hero Section -->
    <div class="dashboard-hero animate-fade-in-up">
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">
                    <i class="fas fa-building mr-3"></i>Hos Geldiniz, @Model.CompanyName
                </h1>
                <p class="text-white/80">@Model.Sector</p>
            </div>
            <div class="text-right text-white/90">
                <div class="text-lg font-semibold">@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</div>
                <div class="text-white/70">@DateTime.Now.ToString("dddd", new System.Globalization.CultureInfo("tr-TR"))</div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="stat-card-premium yellow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Toplam Ilan</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white mt-1">@Model.TotalJobPostings</p>
                    <p class="text-orange-500 text-sm mt-2">Aktif ilanlar</p>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-yellow-500 to-orange-600 flex items-center justify-center">
                    <i class="fas fa-briefcase text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card-premium blue">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Toplam Basvuru</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white mt-1">@Model.TotalApplications</p>
                    <p class="text-blue-500 text-sm mt-2">Gelen basvurular</p>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center">
                    <i class="fas fa-file-alt text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card-premium green">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Aktif Stajyer</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white mt-1">@Model.ActiveInterns</p>
                    <p class="text-green-500 text-sm mt-2">Su anda calisan</p>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center">
                    <i class="fas fa-users text-white text-xl"></i>
                </div>
            </div>
        </div>
        <div class="stat-card-premium purple">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Toplam Stajyer</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white mt-1">@Model.TotalInterns</p>
                    <p class="text-purple-500 text-sm mt-2">Tum zamanlar</p>
                </div>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center">
                    <i class="fas fa-graduation-cap text-white text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Son Aktiviteler -->
        <div class="lg:col-span-2 activity-card-premium">
            <div class="activity-header flex items-center justify-between">
                <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center mr-3">
                        <i class="fas fa-bolt text-white"></i>
                    </div>
                    Son Aktiviteler
                </h2>
                <button onclick="refreshActivities()" class="refresh-btn" id="refreshBtn">
                    <i class="fas fa-sync-alt mr-2"></i>Yenile
                </button>
            </div>
            
            <div id="activitiesContainer">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    @foreach (var activity in Model.RecentActivities.Take(6))
                    {
                        var isNew = activity.CreatedAt >= DateTime.Now.AddHours(-2);
                        <div class="activity-item-premium">
                            <div class="activity-icon @activity.Color">
                                <i class="@activity.Icon text-white"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h4 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">@activity.Title</h4>
                                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">@activity.Description</p>
                                <div class="flex items-center gap-4 mt-2">
                                    <span class="text-xs text-gray-500 dark:text-gray-500">
                                        <i class="far fa-clock mr-1"></i>@activity.TimeAgo
                                    </span>
                                    @if (activity.ActivityType == "NewApplication" && activity.RelatedId.HasValue)
                                    {
                                        <a asp-controller="CompanyApplications" asp-action="Detail" asp-route-id="@activity.RelatedId"
                                           class="text-xs text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 font-medium">
                                            Goruntule <i class="fas fa-arrow-right ml-1"></i>
                                        </a>
                                    }
                                    else if (activity.ActivityType == "NewJobPosting" && activity.RelatedId.HasValue)
                                    {
                                        <a asp-controller="CompanyJobPostings" asp-action="Detail" asp-route-id="@activity.RelatedId"
                                           class="text-xs text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 font-medium">
                                            Ilani Gor <i class="fas fa-arrow-right ml-1"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                            @if (isNew)
                            {
                                <span class="activity-badge new">Yeni</span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state-premium">
                        <div class="empty-state-icon">
                            <i class="fas fa-history"></i>
                        </div>
                        <h3 class="text-lg font-semibold text-gray-600 dark:text-gray-400 mb-2">Henuz aktivite bulunmuyor</h3>
                        <p class="text-gray-500 dark:text-gray-500 mb-6">Firma aktiviteleri burada gorunecektir.</p>
                        <a asp-controller="CompanyJobPostings" asp-action="Create" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 text-white rounded-xl font-semibold hover:from-indigo-600 hover:to-purple-700 transition-all">
                            <i class="fas fa-plus"></i>Ilk Ilaninizi Olusturun
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Son Basvurular -->
        <div class="activity-card-premium">
            <div class="activity-header flex items-center justify-between">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center mr-3">
                        <i class="fas fa-file-alt text-white"></i>
                    </div>
                    Son Basvurular
                </h2>
                <a asp-controller="CompanyApplications" asp-action="List" class="text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 font-medium">
                    Tumunu Gor <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>
            
            <div class="p-4 space-y-3">
                @if (Model.RecentApplications != null && Model.RecentApplications.Any())
                {
                    @foreach (var application in Model.RecentApplications)
                    {
                        <div class="application-card-premium">
                            <div class="flex items-start justify-between mb-2">
                                <div>
                                    <h4 class="font-semibold text-gray-900 dark:text-white text-sm">@application.StudentName</h4>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">@application.JobTitle</p>
                                </div>
                                <span class="px-2 py-1 rounded-full text-xs font-medium 
                                    @(application.Status == WebUI.Models.Company.ApplicationStatus.Pending ? "bg-yellow-100 text-yellow-700" : 
                                      application.Status == WebUI.Models.Company.ApplicationStatus.Approved ? "bg-green-100 text-green-700" : 
                                      "bg-gray-100 text-gray-700")">
                                    @application.Status.GetDisplayName()
                                </span>
                            </div>
                            <div class="flex items-center justify-between text-xs text-gray-500">
                                <span><i class="far fa-calendar mr-1"></i>@application.ApplicationDate.ToString("dd MMM yyyy")</span>
                                <a asp-controller="CompanyApplications" asp-action="Detail" asp-route-id="@application.Id" 
                                   class="text-indigo-600 hover:text-indigo-800 font-medium">
                                    Detay <i class="fas fa-chevron-right ml-1"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-8">
                        <div class="w-16 h-16 mx-auto mb-4 rounded-xl bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                            <i class="fas fa-inbox text-gray-400 text-2xl"></i>
                        </div>
                        <p class="text-gray-500 dark:text-gray-500 text-sm">Henuz basvuru yok</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animate stat numbers
            document.querySelectorAll('.stat-number').forEach(function(el) {
                const finalValue = parseInt(el.textContent);
                el.textContent = '0';
                animateNumber(el, finalValue, 1500);
            });
        });

        function animateNumber(element, targetValue, duration) {
            const startValue = 0;
            const increment = targetValue / (duration / 50);
            let current = startValue;

            const timer = setInterval(function() {
                current += increment;
                if (current >= targetValue) {
                    current = targetValue;
                    clearInterval(timer);
                }
                element.textContent = Math.floor(current);
            }, 50);
        }

        function refreshActivities() {
            const btn = document.getElementById('refreshBtn');
            btn.classList.add('loading');
            
            fetch('/Company/GetRecentActivities')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateActivitiesUI(data.activities);
                    }
                    btn.classList.remove('loading');
                })
                .catch(err => {
                    console.error('Aktiviteler yuklenemedi:', err);
                    btn.classList.remove('loading');
                });
        }

        function updateActivitiesUI(activities) {
            const container = document.getElementById('activitiesContainer');
            if (!activities || activities.length === 0) {
                container.innerHTML = `
                    <div class="empty-state-premium">
                        <div class="empty-state-icon"><i class="fas fa-history"></i></div>
                        <h3 class="text-lg font-semibold text-gray-600 mb-2">Henuz aktivite bulunmuyor</h3>
                        <p class="text-gray-500">Firma aktiviteleri burada gorunecektir.</p>
                    </div>`;
                return;
            }

            let html = '';
            activities.slice(0, 6).forEach(function(a) {
                const isNew = new Date(a.createdAt) >= new Date(Date.now() - 2 * 60 * 60 * 1000);
                html += `
                    <div class="activity-item-premium">
                        <div class="activity-icon ${a.color}">
                            <i class="${a.icon} text-white"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">${a.title}</h4>
                            <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">${a.description}</p>
                            <span class="text-xs text-gray-500 mt-2 inline-block">
                                <i class="far fa-clock mr-1"></i>${a.timeAgo}
                            </span>
                        </div>
                        ${isNew ? '<span class="activity-badge new">Yeni</span>' : ''}
                    </div>`;
            });
            container.innerHTML = html;
        }

        // Auto-refresh every 2 minutes
        setInterval(refreshActivities, 120000);
    </script>
}