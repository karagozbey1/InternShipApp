@model WebUI.Models.Company.InternDetailViewModel
@{
    ViewData["Title"] = "Stajyer Detayi";
    Layout = "_AppLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdvisorCss/advisor-theme.css" asp-append-version="true" />
    <style>
        .profile-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            border-radius: 24px;
            padding: 3rem 2rem;
            position: relative;
            overflow: hidden;
        }
        .profile-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        }
        .profile-avatar-large {
            width: 120px;
            height: 120px;
            border-radius: 30px;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 3rem;
            border: 5px solid white;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        }
        .info-card-premium {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
        .info-card-premium:hover {
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.1);
        }
        .info-card-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.875rem 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        .info-row:last-child { border-bottom: none; }
        .document-card {
            background: white;
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 14px;
            padding: 1rem;
            transition: all 0.3s ease;
        }
        .document-card:hover {
            border-color: #6366f1;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.15);
            transform: translateX(4px);
        }
        .dark .info-card-premium {
            background: rgba(30, 41, 59, 0.95);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .dark .info-card-header {
            background: rgba(51, 65, 85, 0.3);
        }
        .dark .document-card {
            background: rgba(30, 41, 59, 0.8);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .rating-star {
            cursor: pointer;
            font-size: 1.5rem;
            color: #d1d5db;
            transition: all 0.2s;
        }
        .rating-star:hover, .rating-star.active {
            color: #f59e0b;
            transform: scale(1.1);
        }
        .rating-group {
            display: flex;
            gap: 0.25rem;
        }
        .rating-label {
            font-size: 0.875rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
        }
        .dark .rating-label {
            color: #e5e7eb;
        }
        .evaluation-card {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(217, 119, 6, 0.1) 100%);
            border: 2px solid #f59e0b;
            border-radius: 16px;
            padding: 1.5rem;
        }
    </style>
}

<div class="space-y-6">
    <!-- Geri Buton -->
    <div class="flex items-center justify-between animate-fade-in-up">
        <a asp-action="List" class="btn-premium btn-premium-outline">
            <i class="fas fa-arrow-left"></i>
            Stajyerlere Don
        </a>
        <div class="flex gap-3">
            <a asp-action="StartChat" asp-route-studentId="@Model.StudentId" class="btn-premium btn-premium-success">
                <i class="fas fa-comments"></i>
                Mesaj Gonder
            </a>
        </div>
    </div>

    <!-- Profil Hero -->
    <div class="profile-hero animate-fade-in-up">
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
            <div class="profile-avatar-large">
                @Model.StudentName.Substring(0, 1).ToUpper()
            </div>
            <div class="text-center md:text-left">
                <h1 class="text-3xl font-bold text-white mb-2">@Model.StudentName</h1>
                <p class="text-white/80 text-lg mb-3">@Model.Position</p>
                <div class="flex flex-wrap justify-center md:justify-start gap-3">
                    <span class="px-4 py-2 rounded-full bg-white/20 text-white text-sm font-medium backdrop-blur">
                        <i class="fas fa-university mr-2"></i>@(Model.University ?? "Universite Bilgisi Yok")
                    </span>
                    <span class="px-4 py-2 rounded-full bg-white/20 text-white text-sm font-medium backdrop-blur">
                        <i class="fas fa-graduation-cap mr-2"></i>@(Model.Department ?? "Bolum Bilgisi Yok")
                    </span>
                    <span class="px-4 py-2 rounded-full bg-green-500/80 text-white text-sm font-medium">
                        <i class="fas fa-check-circle mr-2"></i>@Model.Status
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Sol Kolon - Detay Bilgiler -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Staj Ilerlemesi -->
            <div class="info-card-premium animate-fade-in-up">
                <div class="info-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-chart-line mr-2 text-indigo-500"></i>
                        Staj Ilerlemesi
                    </h3>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-3 gap-6 mb-6">
                        <div class="text-center p-4 rounded-xl bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/30 dark:to-purple-900/30">
                            <div class="text-3xl font-bold text-indigo-600 mb-1">%@Model.Progress.ToString("F0")</div>
                            <div class="text-sm text-gray-600 dark:text-gray-400">Tamamlanan</div>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/30 dark:to-emerald-900/30">
                            <div class="text-3xl font-bold text-green-600 mb-1">@Model.RemainingTime</div>
                            <div class="text-sm text-gray-600 dark:text-gray-400">Kalan Sure</div>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/30 dark:to-pink-900/30">
                            <div class="text-3xl font-bold text-purple-600 mb-1">@Model.Status</div>
                            <div class="text-sm text-gray-600 dark:text-gray-400">Durum</div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Genel Ilerleme</span>
                            <span class="text-sm font-bold text-indigo-600">%@Model.Progress.ToString("F1")</span>
                        </div>
                        <div class="progress-premium h-3">
                            <div class="progress-premium-bar" style="width: @Model.Progress.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50">
                            <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center">
                                <i class="fas fa-calendar-alt text-indigo-600"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Baslangic</p>
                                <p class="font-semibold text-gray-900 dark:text-white">@Model.StartDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50">
                            <div class="w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center">
                                <i class="fas fa-calendar-check text-purple-600"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500">Bitis</p>
                                <p class="font-semibold text-gray-900 dark:text-white">@Model.EndDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mevcut Degerlendirme -->
            @if (Model.HasEvaluation && Model.Evaluation != null)
            {
                <div class="evaluation-card animate-fade-in-up">
                    <div class="flex items-start gap-4 mb-4">
                        <div class="w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-star text-yellow-600 text-xl"></i>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-yellow-800 dark:text-yellow-200">Degerlendirme Yapildi</h4>
                                <span class="text-2xl font-bold text-yellow-600">@Model.Evaluation.AverageRating.ToString("F1")/5</span>
                            </div>
                            <p class="text-yellow-700 dark:text-yellow-300 text-sm">@Model.Evaluation.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                        <div class="text-center p-2 rounded-lg bg-white/50">
                            <p class="text-xs text-gray-600">Teknik</p>
                            <p class="font-bold text-yellow-600">@Model.Evaluation.TechnicalSkillsRating/5</p>
                        </div>
                        <div class="text-center p-2 rounded-lg bg-white/50">
                            <p class="text-xs text-gray-600">Iletisim</p>
                            <p class="font-bold text-yellow-600">@Model.Evaluation.CommunicationRating/5</p>
                        </div>
                        <div class="text-center p-2 rounded-lg bg-white/50">
                            <p class="text-xs text-gray-600">Takim</p>
                            <p class="font-bold text-yellow-600">@Model.Evaluation.TeamworkRating/5</p>
                        </div>
                        <div class="text-center p-2 rounded-lg bg-white/50">
                            <p class="text-xs text-gray-600">Genel</p>
                            <p class="font-bold text-yellow-600">@Model.Evaluation.OverallRating/5</p>
                        </div>
                    </div>
                    <button onclick="showEvaluationModal(true)" class="w-full btn-premium btn-premium-warning py-2">
                        <i class="fas fa-edit"></i>
                        Degerlendirmeyi Duzenle
                    </button>
                </div>
            }

            <!-- Pozisyon Bilgileri -->
            <div class="info-card-premium animate-fade-in-up">
                <div class="info-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-briefcase mr-2 text-indigo-500"></i>
                        Pozisyon Bilgileri
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex items-start gap-4 p-4 rounded-xl bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20">
                            <div class="w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-building text-indigo-600 text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Ilan Basligi</p>
                                <p class="font-semibold text-gray-900 dark:text-white text-lg">@Model.JobTitle</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4 p-4 rounded-xl bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20">
                            <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-user-tie text-purple-600 text-lg"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Pozisyon</p>
                                <p class="font-semibold text-gray-900 dark:text-white text-lg">@Model.Position</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.CoverLetter))
            {
                <div class="info-card-premium animate-fade-in-up">
                    <div class="info-card-header">
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                            <i class="fas fa-file-alt mr-2 text-indigo-500"></i>
                            Basvuru Mektubu
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5 border-l-4 border-indigo-500">
                            <p class="text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line">@Model.CoverLetter</p>
                        </div>
                    </div>
                </div>
            }

            @if (Model.Documents.Any())
            {
                <div class="info-card-premium animate-fade-in-up">
                    <div class="info-card-header">
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                            <i class="fas fa-folder-open mr-2 text-indigo-500"></i>
                            Yuklenen Belgeler
                            <span class="ml-2 px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 text-xs font-semibold">@Model.Documents.Count</span>
                        </h3>
                    </div>
                    <div class="p-6">
                        <div class="space-y-3">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="document-card flex items-center justify-between">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-indigo-900/50 dark:to-purple-900/50 flex items-center justify-center">
                                            <i class="fas fa-file-pdf text-indigo-600 text-lg"></i>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-900 dark:text-white">@doc.Title</p>
                                            <div class="flex items-center gap-3 text-xs text-gray-500">
                                                <span><i class="fas fa-tag mr-1"></i>@doc.DocumentType</span>
                                                <span><i class="fas fa-calendar mr-1"></i>@doc.UploadedAt.ToString("dd MMM yyyy")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <a href="@doc.FilePath" target="_blank" class="btn-premium btn-premium-outline text-sm py-2">
                                        <i class="fas fa-download"></i>
                                        Indir
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sag Kolon -->
        <div class="space-y-6">
            <!-- Iletisim Bilgileri -->
            <div class="info-card-premium animate-fade-in-up">
                <div class="info-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-user-graduate mr-2 text-indigo-500"></i>
                        Ogrenci Bilgileri
                    </h3>
                </div>
                <div class="p-6 space-y-4">
                    <div class="info-row">
                        <span class="text-gray-600 dark:text-gray-400 text-sm">Ad Soyad</span>
                        <span class="font-semibold text-gray-900 dark:text-white text-sm">@Model.StudentName</span>
                    </div>
                    <div class="info-row">
                        <span class="text-gray-600 dark:text-gray-400 text-sm">Ogrenci No</span>
                        <span class="font-semibold text-gray-900 dark:text-white text-sm">@Model.StudentNumber</span>
                    </div>
                    <a href="mailto:@Model.StudentEmail" class="flex items-center gap-4 p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-colors group">
                        <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center group-hover:bg-indigo-200">
                            <i class="fas fa-envelope text-indigo-600"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-gray-500 mb-0.5">E-posta</p>
                            <p class="font-medium text-indigo-600 truncate">@Model.StudentEmail</p>
                        </div>
                    </a>
                    
                    @if (!string.IsNullOrEmpty(Model.StudentPhone))
                    {
                        <a href="tel:@Model.StudentPhone" class="flex items-center gap-4 p-3 rounded-xl bg-gray-50 dark:bg-gray-800/50 hover:bg-green-50 dark:hover:bg-green-900/30 transition-colors group">
                            <div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/50 flex items-center justify-center group-hover:bg-green-200">
                                <i class="fas fa-phone text-green-600"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-gray-500 mb-0.5">Telefon</p>
                                <p class="font-medium text-green-600">@Model.StudentPhone</p>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Akademik Bilgiler -->
            <div class="info-card-premium animate-fade-in-up">
                <div class="info-card-header">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-graduation-cap mr-2 text-indigo-500"></i>
                        Akademik Bilgiler
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-3">
                        <div class="info-row">
                            <span class="text-gray-600 dark:text-gray-400 text-sm">Universite</span>
                            <span class="font-semibold text-gray-900 dark:text-white text-sm">@(Model.University ?? "-")</span>
                        </div>
                        <div class="info-row">
                            <span class="text-gray-600 dark:text-gray-400 text-sm">Bolum</span>
                            <span class="font-semibold text-gray-900 dark:text-white text-sm">@(Model.Department ?? "-")</span>
                        </div>
                        <div class="info-row">
                            <span class="text-gray-600 dark:text-gray-400 text-sm">Sinif</span>
                            <span class="font-semibold text-gray-900 dark:text-white text-sm">@Model.StudentClass</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Degerlendirme Modal -->
<div id="evaluationModal" class="modal-premium-overlay">
    <div class="modal-premium max-w-2xl">
        <div class="modal-premium-header">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
                        <i class="fas fa-star text-white"></i>
                    </div>
                    <h2 class="text-xl font-bold text-white" id="modalTitle">Stajyer Degerlendirmesi</h2>
                </div>
                <button onclick="closeEvaluationModal()" class="w-10 h-10 rounded-xl bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-white"></i>
                </button>
            </div>
        </div>
        <form id="evaluationForm" onsubmit="submitEvaluation(event)" class="modal-premium-body max-h-[70vh] overflow-y-auto">
            @Html.AntiForgeryToken()
            <input type="hidden" id="applicationId" value="@Model.Id" />
            
            <div class="space-y-6">
                <!-- Puan Kriterleri -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="rating-item">
                        <label class="rating-label">Teknik Beceriler</label>
                        <div class="rating-group" data-field="technicalSkillsRating">
                            @for(int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star rating-star" data-value="@i" onclick="setRating(this)"></i>
                            }
                        </div>
                    </div>
                    <div class="rating-item">
                        <label class="rating-label">Iletisim Becerileri</label>
                        <div class="rating-group" data-field="communicationRating">
                            @for(int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star rating-star" data-value="@i" onclick="setRating(this)"></i>
                            }
                        </div>
                    </div>
                    <div class="rating-item">
                        <label class="rating-label">Takim Calismasi</label>
                        <div class="rating-group" data-field="teamworkRating">
                            @for(int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star rating-star" data-value="@i" onclick="setRating(this)"></i>
                            }
                        </div>
                    </div>
                    <div class="rating-item">
                        <label class="rating-label">Dakiklik ve Devam</label>
                        <div class="rating-group" data-field="punctualityRating">
                            @for(int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star rating-star" data-value="@i" onclick="setRating(this)"></i>
                            }
                        </div>
                    </div>
                    <div class="rating-item">
                        <label class="rating-label">Inisiyatif ve Ogrenme</label>
                        <div class="rating-group" data-field="initiativeRating">
                            @for(int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star rating-star" data-value="@i" onclick="setRating(this)"></i>
                            }
                        </div>
                    </div>
                    <div class="rating-item">
                        <label class="rating-label">Problem Cozme</label>
                        <div class="rating-group" data-field="problemSolvingRating">
                            @for(int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star rating-star" data-value="@i" onclick="setRating(this)"></i>
                            }
                        </div>
                    </div>
                </div>

                <!-- Genel Degerlendirme -->
                <div class="p-4 rounded-xl bg-gradient-to-r from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20">
                    <label class="rating-label text-center block mb-3">Genel Degerlendirme</label>
                    <div class="rating-group justify-center" data-field="overallRating">
                        @for(int i = 1; i <= 5; i++)
                        {
                            <i class="fas fa-star rating-star text-2xl" data-value="@i" onclick="setRating(this)"></i>
                        }
                    </div>
                </div>

                <!-- Yorumlar -->
                <div class="space-y-4">
                    <div>
                        <label class="rating-label">Guclu Yonleri</label>
                        <textarea id="strengthsComment" rows="2" class="filter-input-premium" placeholder="Ogrencinin guclu yonlerini yaziniz..."></textarea>
                    </div>
                    <div>
                        <label class="rating-label">Gelistirilmesi Gereken Alanlar</label>
                        <textarea id="improvementAreasComment" rows="2" class="filter-input-premium" placeholder="Gelistirilmesi gereken alanlari yaziniz..."></textarea>
                    </div>
                    <div>
                        <label class="rating-label">Genel Yorum</label>
                        <textarea id="generalComment" rows="3" class="filter-input-premium" placeholder="Genel degerlendirmenizi yaziniz..."></textarea>
                    </div>
                    <div>
                        <label class="rating-label">Ogrenciye Oneriler</label>
                        <textarea id="recommendationComment" rows="2" class="filter-input-premium" placeholder="Ogrenciye kariyer onerileri..."></textarea>
                    </div>
                </div>

                <!-- Oneri Kutulari -->
                <div class="flex flex-wrap gap-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="wouldRecommendForHire" class="w-5 h-5 rounded text-indigo-600">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Ise alim icin oneririm</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="wouldAcceptAgain" class="w-5 h-5 rounded text-indigo-600">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Tekrar stajyer olarak kabul ederim</span>
                    </label>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
                <button type="button" onclick="closeEvaluationModal()" class="btn-premium btn-premium-outline">Iptal</button>
                <button type="submit" class="btn-premium btn-premium-warning">
                    <i class="fas fa-save"></i>
                    Degerlendirmeyi Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let ratings = {
            technicalSkillsRating: 0,
            communicationRating: 0,
            teamworkRating: 0,
            punctualityRating: 0,
            initiativeRating: 0,
            problemSolvingRating: 0,
            overallRating: 0
        };

        function setRating(star) {
            const group = star.parentElement;
            const field = group.dataset.field;
            const value = parseInt(star.dataset.value);
            ratings[field] = value;
            
            const stars = group.querySelectorAll('.rating-star');
            stars.forEach((s, index) => {
                if (index < value) {
                    s.classList.add('active');
                } else {
                    s.classList.remove('active');
                }
            });
        }

        function showEvaluationModal(isEdit) {
            document.getElementById('evaluationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            document.getElementById('modalTitle').textContent = isEdit ? 'Degerlendirmeyi Duzenle' : 'Stajyer Degerlendirmesi';
            
            if (isEdit) {
                loadExistingEvaluation();
            }
        }

        function closeEvaluationModal() {
            document.getElementById('evaluationModal').classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        async function loadExistingEvaluation() {
            try {
                const applicationId = document.getElementById('applicationId').value;
                const response = await fetch(`/Company/Interns/GetEvaluation/${applicationId}`);
                const data = await response.json();
                
                if (data.success && data.exists) {
                    const e = data.evaluation;
                    
                    // Puanlari yukle
                    Object.keys(ratings).forEach(field => {
                        const value = e[field.charAt(0).toLowerCase() + field.slice(1)];
                        if (value) {
                            ratings[field] = value;
                            const group = document.querySelector(`[data-field="${field}"]`);
                            if (group) {
                                const stars = group.querySelectorAll('.rating-star');
                                stars.forEach((s, index) => {
                                    if (index < value) s.classList.add('active');
                                    else s.classList.remove('active');
                                });
                            }
                        }
                    });
                    
                    // Yorumlari yukle
                    document.getElementById('strengthsComment').value = e.strengthsComment || '';
                    document.getElementById('improvementAreasComment').value = e.improvementAreasComment || '';
                    document.getElementById('generalComment').value = e.generalComment || '';
                    document.getElementById('recommendationComment').value = e.recommendationComment || '';
                    document.getElementById('wouldRecommendForHire').checked = e.wouldRecommendForHire;
                    document.getElementById('wouldAcceptAgain').checked = e.wouldAcceptAgain;
                }
            } catch (err) {
                console.error('Degerlendirme yuklenemedi:', err);
            }
        }

        async function submitEvaluation(e) {
            e.preventDefault();
            
            // Tum puanlar doldurulmus mu kontrol et
            for (const [key, value] of Object.entries(ratings)) {
                if (value === 0) {
                    alert('Lutfen tum degerlendirme kriterlerini doldurun.');
                    return;
                }
            }
            
            const data = {
                applicationId: parseInt(document.getElementById('applicationId').value),
                ...ratings,
                strengthsComment: document.getElementById('strengthsComment').value,
                improvementAreasComment: document.getElementById('improvementAreasComment').value,
                generalComment: document.getElementById('generalComment').value,
                recommendationComment: document.getElementById('recommendationComment').value,
                wouldRecommendForHire: document.getElementById('wouldRecommendForHire').checked,
                wouldAcceptAgain: document.getElementById('wouldAcceptAgain').checked
            };
            
            try {
                const response = await fetch('/Company/Interns/Evaluate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(result.message);
                    closeEvaluationModal();
                    location.reload();
                } else {
                    alert('Hata: ' + result.message);
                }
            } catch (err) {
                alert('Hata: ' + err.message);
            }
        }

        // Modal disina tiklama
        document.getElementById('evaluationModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeEvaluationModal();
            }
        });

        // ESC tusuna basinca kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeEvaluationModal();
            }
        });

        // Progress bar animasyonu
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.progress-premium-bar').forEach(function(bar) {
                var width = bar.style.width;
                bar.style.width = '0%';
                setTimeout(function() { bar.style.width = width; }, 300);
            });
        });
    </script>
}
