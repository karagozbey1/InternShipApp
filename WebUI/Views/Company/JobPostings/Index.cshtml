@model WebUI.Models.Company.JobPostingListViewModel
@{
    ViewData["Title"] = "Ýlanlarým";
    Layout = "_AppLayout";
}

@section Styles {
<style>
    .job-page { min-height:100vh; background:linear-gradient(135deg,#f0f9ff 0%,#e0f2fe 50%,#f0f9ff 100%); }
    
    /* Hero Header */
    .hero-header { background:linear-gradient(135deg,#0ea5e9 0%,#6366f1 50%,#8b5cf6 100%); border-radius:24px; padding:32px; color:white; position:relative; overflow:hidden; box-shadow:0 20px 60px rgba(14,165,233,0.3); margin-bottom:24px; }
    .hero-header::before { content:''; position:absolute; top:-50%; right:-20%; width:400px; height:400px; background:radial-gradient(circle,rgba(255,255,255,0.1) 0%,transparent 70%); }
    .hero-content { position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; }
    .hero-icon { width:72px; height:72px; border-radius:18px; background:rgba(255,255,255,0.2); backdrop-filter:blur(10px); display:flex; align-items:center; justify-content:center; font-size:28px; }
    .hero-info h1 { font-size:1.75rem; font-weight:800; margin:0 0 4px; }
    .hero-info p { opacity:0.9; margin:0; }
    
    .btn-create { padding:16px 28px; background:white; color:#6366f1; border-radius:16px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:10px; box-shadow:0 8px 30px rgba(0,0,0,0.15); transition:all 0.3s; }
    .btn-create:hover { transform:translateY(-3px) scale(1.02); box-shadow:0 12px 40px rgba(0,0,0,0.2); color:#4f46e5; }
    
    /* Filter Card */
    .filter-card { background:white; border-radius:20px; box-shadow:0 4px 24px rgba(0,0,0,0.06); padding:24px; margin-bottom:24px; }
    .filter-grid { display:grid; grid-template-columns:1fr auto auto auto auto; gap:16px; align-items:end; }
    .filter-input { padding:12px 16px; border:2px solid #e2e8f0; border-radius:12px; font-size:0.95rem; transition:all 0.3s; background:#f8fafc; }
    .filter-input:focus { outline:none; border-color:#6366f1; box-shadow:0 0 0 4px rgba(99,102,241,0.1); background:white; }
    .filter-label { font-size:0.8rem; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
    .btn-filter { padding:12px 24px; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; border:none; border-radius:12px; font-weight:600; cursor:pointer; transition:all 0.3s; }
    .btn-filter:hover { transform:translateY(-2px); box-shadow:0 4px 20px rgba(99,102,241,0.4); }
    .btn-clear { padding:12px 20px; background:#f1f5f9; color:#64748b; border:none; border-radius:12px; font-weight:600; text-decoration:none; transition:all 0.3s; display:inline-flex; align-items:center; gap:6px; }
    .btn-clear:hover { background:#e2e8f0; color:#475569; }
    
    /* Job Cards */
    .job-grid { display:grid; gap:20px; }
    .job-card { background:white; border-radius:20px; box-shadow:0 4px 24px rgba(0,0,0,0.06); overflow:hidden; transition:all 0.3s; cursor:pointer; position:relative; }
    .job-card:hover { transform:translateY(-4px); box-shadow:0 12px 40px rgba(0,0,0,0.12); }
    .job-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg,#6366f1,#8b5cf6,#ec4899); }
    
    .job-card-header { padding:24px 24px 16px; display:flex; justify-content:space-between; align-items:flex-start; }
    .job-title { font-size:1.25rem; font-weight:700; color:#1e293b; margin:0 0 8px; }
    .job-meta { display:flex; gap:16px; flex-wrap:wrap; }
    .job-meta-item { display:flex; align-items:center; gap:6px; font-size:0.875rem; color:#64748b; }
    .job-meta-item i { color:#6366f1; }
    
    .status-badge { padding:6px 14px; border-radius:20px; font-size:0.75rem; font-weight:600; display:inline-flex; align-items:center; gap:6px; }
    .status-active { background:linear-gradient(135deg,#d1fae5,#a7f3d0); color:#065f46; }
    .status-inactive { background:linear-gradient(135deg,#fee2e2,#fecaca); color:#991b1b; }
    
    .job-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; padding:0 24px 16px; }
    .stat-box { padding:16px; border-radius:14px; text-align:center; }
    .stat-box.blue { background:linear-gradient(135deg,#eff6ff,#dbeafe); }
    .stat-box.purple { background:linear-gradient(135deg,#faf5ff,#f3e8ff); }
    .stat-box.amber { background:linear-gradient(135deg,#fffbeb,#fef3c7); }
    .stat-value { font-size:1.5rem; font-weight:800; }
    .stat-box.blue .stat-value { color:#1d4ed8; }
    .stat-box.purple .stat-value { color:#7c3aed; }
    .stat-box.amber .stat-value { color:#d97706; }
    .stat-label { font-size:0.7rem; color:#64748b; text-transform:uppercase; letter-spacing:0.5px; margin-top:4px; }
    
    .job-card-footer { padding:16px 24px; background:#f8fafc; border-top:1px solid #f1f5f9; display:flex; justify-content:space-between; align-items:center; }
    .job-date { font-size:0.8rem; color:#64748b; display:flex; align-items:center; gap:6px; }
    .job-actions { display:flex; gap:8px; }
    .action-btn { width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; transition:all 0.3s; border:none; cursor:pointer; }
    .action-btn.view { background:#eff6ff; color:#3b82f6; }
    .action-btn.edit { background:#fef3c7; color:#d97706; }
    .action-btn.delete { background:#fee2e2; color:#ef4444; }
    .action-btn:hover { transform:scale(1.1); }
    
    /* Empty State */
    .empty-state { background:white; border-radius:24px; padding:60px; text-align:center; box-shadow:0 4px 24px rgba(0,0,0,0.06); }
    .empty-icon { width:100px; height:100px; margin:0 auto 24px; background:linear-gradient(135deg,#eff6ff,#dbeafe); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:40px; color:#3b82f6; }
    .empty-title { font-size:1.5rem; font-weight:700; color:#1e293b; margin-bottom:8px; }
    .empty-desc { color:#64748b; margin-bottom:24px; }
    
    /* Modal */
    .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px); z-index:100; display:none; align-items:center; justify-content:center; padding:20px; }
    .modal-overlay.active { display:flex; }
    .modal-content { background:white; border-radius:24px; max-width:800px; width:100%; max-height:90vh; overflow:auto; box-shadow:0 25px 80px rgba(0,0,0,0.25); }
    .modal-header { padding:24px; border-bottom:1px solid #f1f5f9; display:flex; justify-content:space-between; align-items:center; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; border-radius:24px 24px 0 0; }
    .modal-header h3 { font-size:1.25rem; font-weight:700; margin:0; }
    .modal-close { width:40px; height:40px; border-radius:12px; background:rgba(255,255,255,0.2); border:none; color:white; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.3s; }
    .modal-close:hover { background:rgba(255,255,255,0.3); transform:rotate(90deg); }
    .modal-body { padding:24px; }
    
    @@media (max-width:1024px) { .filter-grid { grid-template-columns:1fr 1fr; } }
    @@media (max-width:640px) { .filter-grid { grid-template-columns:1fr; } .hero-content { flex-direction:column; text-align:center; } .job-stats { grid-template-columns:1fr; } }
</style>
}

<div class="job-page p-6">
    @Html.AntiForgeryToken()
    
    <!-- Hero Header -->
    <div class="hero-header">
        <div class="hero-content">
            <div class="flex items-center gap-5">
                <div class="hero-icon"><i class="fas fa-briefcase"></i></div>
                <div class="hero-info">
                    <h1>Ýlanlarým</h1>
                    <p>Yayýnladýðýnýz staj ve iþ ilanlarýný yönetin</p>
                </div>
            </div>
            <a asp-controller="CompanyJobPostings" asp-action="Create" class="btn-create">
                <i class="fas fa-plus-circle"></i>
                Yeni Ýlan Oluþtur
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="filter-card">
        <form method="get" class="filter-grid">
            <div>
                <label class="filter-label"><i class="fas fa-search"></i> Arama</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="filter-input w-full" placeholder="Ýlan baþlýðý, pozisyon veya þehir ara..." />
            </div>
            <div>
                <label class="filter-label"><i class="fas fa-layer-group"></i> Tür</label>
                <select name="typeFilter" class="filter-input">
                    <option value="">Tüm Türler</option>
                    @foreach (var type in Enum.GetValues<WebUI.Models.Company.JobPostingType>())
                    {
                        <option value="@type" selected="@(Model.TypeFilter == type)">@type.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div>
                <label class="filter-label"><i class="fas fa-toggle-on"></i> Durum</label>
                <select name="isActiveFilter" class="filter-input">
                    <option value="">Tüm Durumlar</option>
                    <option value="true" selected="@(Model.IsActiveFilter == true)">Aktif</option>
                    <option value="false" selected="@(Model.IsActiveFilter == false)">Pasif</option>
                </select>
            </div>
            <div>
                <button type="submit" class="btn-filter"><i class="fas fa-search mr-2"></i>Filtrele</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.TypeFilter.HasValue || Model.IsActiveFilter.HasValue)
            {
                <div>
                    <a asp-controller="CompanyJobPostings" asp-action="List" class="btn-clear"><i class="fas fa-times"></i>Temizle</a>
                </div>
            }
        </form>
    </div>

    <!-- Results Summary -->
    <div class="mb-6 flex items-center gap-3">
        <span class="px-4 py-2 bg-white rounded-full shadow-sm font-semibold text-gray-700">
            <i class="fas fa-list-ul mr-2 text-indigo-500"></i>@Model.JobPostings.Count ilan bulundu
        </span>
    </div>

    <!-- Job Cards Grid -->
    @if (Model.JobPostings.Any())
    {
        <div class="job-grid">
            @foreach (var job in Model.JobPostings)
            {
                <div class="job-card" onclick="viewJobDetail(@job.Id)">
                    <div class="job-card-header">
                        <div>
                            <h3 class="job-title">@job.Title</h3>
                            <div class="job-meta">
                                <span class="job-meta-item"><i class="fas fa-map-marker-alt"></i> @job.Location</span>
                                <span class="job-meta-item"><i class="fas fa-user-tie"></i> @job.Position</span>
                                <span class="job-meta-item"><i class="fas fa-clock"></i> Son: @job.ApplicationDeadline.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        @if (job.IsActive)
                        {
                            <span class="status-badge status-active"><i class="fas fa-check-circle"></i> Aktif</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive"><i class="fas fa-pause-circle"></i> Pasif</span>
                        }
                    </div>
                    
                    <div class="job-stats">
                        <div class="stat-box blue">
                            <div class="stat-value">@job.ApplicationCount</div>
                            <div class="stat-label">Baþvuru</div>
                        </div>
                        <div class="stat-box purple">
                            <div class="stat-value">@job.Quota</div>
                            <div class="stat-label">Kontenjan</div>
                        </div>
                        <div class="stat-box amber">
                            <div class="stat-value">@(job.Salary.HasValue ? string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N0}", job.Salary) : "-")</div>
                            <div class="stat-label">? Ücret</div>
                        </div>
                    </div>
                    
                    <div class="job-card-footer">
                        <span class="job-date"><i class="fas fa-calendar-alt"></i> @job.CreatedDate.ToString("dd MMM yyyy")</span>
                        <div class="job-actions">
                            <button class="action-btn view" onclick="viewJobDetail(@job.Id); event.stopPropagation();" title="Detay"><i class="fas fa-eye"></i></button>
                            <a asp-controller="CompanyJobPostings" asp-action="Create" asp-route-id="@job.Id" class="action-btn edit" onclick="event.stopPropagation();" title="Düzenle"><i class="fas fa-edit"></i></a>
                            <button class="action-btn delete" onclick="deleteJobPosting(@job.Id); event.stopPropagation();" title="Sil"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-briefcase"></i></div>
            <h3 class="empty-title">Henüz ilan bulunmuyor</h3>
            <p class="empty-desc">
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.TypeFilter.HasValue || Model.IsActiveFilter.HasValue)
                {
                    <span>Arama kriterlerinize uygun ilan bulunamadý.</span>
                }
                else
                {
                    <span>Ýlk ilanýnýzý oluþturarak öðrencilere fýrsat sunmaya baþlayýn.</span>
                }
            </p>
            <div class="flex justify-center gap-4">
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.TypeFilter.HasValue || Model.IsActiveFilter.HasValue)
                {
                    <a asp-controller="CompanyJobPostings" asp-action="List" class="btn-clear"><i class="fas fa-times mr-2"></i>Filtreleri Temizle</a>
                }
                <a asp-controller="CompanyJobPostings" asp-action="Create" class="btn-create" style="color:#6366f1;"><i class="fas fa-plus mr-2"></i>Ýlk Ýlanýmý Oluþtur</a>
            </div>
        </div>
    }
</div>

<!-- Detail Modal -->
<div id="jobDetailModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fas fa-file-alt mr-2"></i>Ýlan Detayý</h3>
            <button class="modal-close" onclick="closeJobDetailModal()"><i class="fas fa-times"></i></button>
        </div>
        <div id="jobDetailContent" class="modal-body">
            <div class="text-center py-8 text-gray-500"><i class="fas fa-spinner fa-spin text-2xl"></i><p class="mt-2">Yükleniyor...</p></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const deleteJobUrl = '@Url.Action("DeleteJobPosting","CompanyJobPostings")';
    const detailJobUrl = '@Url.Action("JobPostingDetail","CompanyJobPostings")';

    function deleteJobPosting(jobId) {
        if (confirm('Bu ilaný silmek istediðinizden emin misiniz? Bu iþlem geri alýnamaz.')) {
            $.ajax({
                url: deleteJobUrl,
                type: 'POST',
                data: { 
                    jobId: jobId, 
                    __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val() 
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message || 'Ýlan silinemedi.');
                    }
                },
                error: function() {
                    alert('Ýþlem sýrasýnda bir hata oluþtu.');
                }
            });
        }
    }

    function viewJobDetail(jobId) {
        $('#jobDetailContent').html('<div class="text-center py-8 text-gray-500"><i class="fas fa-spinner fa-spin text-2xl"></i><p class="mt-2">Yükleniyor...</p></div>');
        $('#jobDetailModal').addClass('active');
        $.get(detailJobUrl, { id: jobId })
            .done(function(html) { $('#jobDetailContent').html(html); })
            .fail(function() { $('#jobDetailContent').html('<div class="text-center py-8 text-red-500"><i class="fas fa-exclamation-circle text-2xl"></i><p class="mt-2">Detaylar yüklenemedi.</p></div>'); });
    }

    function closeJobDetailModal() {
        $('#jobDetailModal').removeClass('active');
    }

    $('#jobDetailModal').on('click', function(e) {
        if (e.target.id === 'jobDetailModal') closeJobDetailModal();
    });

    $(document).keydown(function(e) { if (e.key === 'Escape') closeJobDetailModal(); });
</script>
}