@model WebUI.Models.Company.JobPostingCreateViewModel
@using Core.Entity
@{
    ViewData["Title"] = Model.Id > 0 ? "Ýlaný Düzenle" : "Yeni Ýlan Oluþtur";
    Layout = "_AppLayout";
}

@section Styles {
<style>
    .create-page { min-height:100vh; background:linear-gradient(135deg,#f0f9ff 0%,#e0f2fe 50%,#f0f9ff 100%); padding:24px; }
    .page-header { background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%); border-radius:24px; padding:32px; color:white; position:relative; overflow:hidden; margin-bottom:32px; box-shadow:0 20px 60px rgba(99,102,241,0.3); }
    .page-header::before { content:''; position:absolute; top:-50%; right:-20%; width:400px; height:400px; background:radial-gradient(circle,rgba(255,255,255,0.1) 0%,transparent 70%); }
    .page-header-content { position:relative; z-index:1; display:flex; align-items:center; gap:20px; }
    .page-icon { width:64px; height:64px; border-radius:16px; background:rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center; font-size:24px; }
    .page-title { font-size:1.75rem; font-weight:800; margin:0 0 4px; }
    .page-subtitle { opacity:0.9; margin:0; }
    .form-card { background:white; border-radius:24px; box-shadow:0 4px 24px rgba(0,0,0,0.06); overflow:hidden; }
    .form-section { padding:32px; border-bottom:1px solid #f1f5f9; }
    .form-section:last-child { border-bottom:none; }
    .section-header { display:flex; align-items:center; gap:12px; margin-bottom:24px; }
    .section-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:18px; color:white; }
    .section-title { font-size:1.1rem; font-weight:700; color:#1e293b; margin:0; }
    .section-subtitle { font-size:0.85rem; color:#64748b; margin:4px 0 0; }
    .form-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
    .form-group { margin-bottom:0; }
    .form-group.full-width { grid-column:span 2; }
    .form-label { display:block; font-size:0.85rem; font-weight:600; color:#374151; margin-bottom:8px; }
    .form-label .required { color:#ef4444; margin-left:2px; }
    .form-input { width:100%; padding:14px 16px; border:2px solid #e2e8f0; border-radius:12px; font-size:0.95rem; transition:all 0.3s; background:#fafbfc; }
    .form-input:focus { outline:none; border-color:#6366f1; box-shadow:0 0 0 4px rgba(99,102,241,0.1); background:white; }
    textarea.form-input { min-height:120px; resize:vertical; }
    .radio-group { display:flex; gap:16px; flex-wrap:wrap; }
    .radio-option { display:flex; align-items:center; gap:8px; padding:12px 20px; background:#f8fafc; border:2px solid #e2e8f0; border-radius:12px; cursor:pointer; transition:all 0.3s; }
    .radio-option:hover { border-color:#c7d2fe; background:#f5f3ff; }
    .radio-option.selected { border-color:#6366f1; background:#f5f3ff; }
    .radio-option input { display:none; }
    .radio-option .radio-circle { width:20px; height:20px; border:2px solid #d1d5db; border-radius:50%; display:flex; align-items:center; justify-content:center; transition:all 0.3s; }
    .radio-option.selected .radio-circle { border-color:#6366f1; background:#6366f1; }
    .radio-option.selected .radio-circle::after { content:''; width:8px; height:8px; background:white; border-radius:50%; }
    .period-add-form { margin-top:16px; padding:20px; background:#f8fafc; border-radius:16px; border:2px dashed #e2e8f0; }
    .period-add-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px; }
    .checkbox-wrapper { display:flex; align-items:center; gap:12px; padding:16px 20px; background:linear-gradient(135deg,#f0fdf4,#dcfce7); border-radius:14px; }
    .checkbox-wrapper input[type="checkbox"] { width:22px; height:22px; accent-color:#10b981; }
    .checkbox-label { font-weight:600; color:#166534; }
    .form-actions { padding:32px; background:#f8fafc; display:flex; justify-content:flex-end; gap:16px; }
    .btn-cancel { padding:14px 28px; background:white; color:#64748b; border:2px solid #e2e8f0; border-radius:14px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:8px; transition:all 0.3s; }
    .btn-cancel:hover { border-color:#cbd5e1; color:#475569; }
    .btn-submit { padding:14px 32px; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; border:none; border-radius:14px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:10px; transition:all 0.3s; box-shadow:0 4px 20px rgba(99,102,241,0.3); }
    .btn-submit:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(99,102,241,0.4); }
    .btn-submit:disabled { opacity:0.7; cursor:not-allowed; }
    .alert-box { padding:16px 20px; border-radius:12px; margin-bottom:24px; display:flex; align-items:center; gap:12px; }
    .alert-success { background:#d1fae5; color:#065f46; }
    .alert-error { background:#fee2e2; color:#991b1b; }
    .btn-add-period { padding:10px 20px; background:linear-gradient(135deg,#10b981,#059669); color:white; border:none; border-radius:10px; font-weight:600; cursor:pointer; }
    @@media (max-width:768px) { .form-grid { grid-template-columns:1fr; } .form-group.full-width { grid-column:span 1; } .period-add-grid { grid-template-columns:1fr; } }
</style>
}

<div class="create-page">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-icon"><i class="fas @(Model.Id > 0 ? "fa-edit" : "fa-plus-circle")"></i></div>
            <div>
                <h1 class="page-title">@(Model.Id > 0 ? "Ýlaný Düzenle" : "Yeni Ýlan Oluþtur")</h1>
                <p class="page-subtitle">Stajyer adaylarý için detaylý bir ilan hazýrlayýn</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-box alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <form asp-controller="CompanyJobPostings" asp-action="Create" method="post" id="jobPostingForm" class="form-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background:linear-gradient(135deg,#3b82f6,#6366f1);"><i class="fas fa-info-circle"></i></div>
                <div><h3 class="section-title">Temel Bilgiler</h3><p class="section-subtitle">Ýlanýn baþlýk, pozisyon ve lokasyon bilgileri</p></div>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Title" class="form-label">Ýlan Baþlýðý <span class="required">*</span></label>
                    <input asp-for="Title" class="form-input" placeholder="Örn: Frontend Developer Stajyeri" />
                    <span asp-validation-for="Title" class="text-red-500 text-sm"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Position" class="form-label">Pozisyon <span class="required">*</span></label>
                    <input asp-for="Position" class="form-input" placeholder="Örn: Frontend Developer" />
                    <span asp-validation-for="Position" class="text-red-500 text-sm"></span>
                </div>
                <div class="form-group">
                    <label asp-for="JobType" class="form-label">Ýlan Türü <span class="required">*</span></label>
                    <select asp-for="JobType" asp-items="Html.GetEnumSelectListWithDisplay<WebUI.Models.Company.JobPostingType>()" class="form-input"></select>
                </div>
                <div class="form-group">
                    <label asp-for="LocationId" class="form-label">Lokasyon (Ýl) <span class="required">*</span></label>
                    <select asp-for="LocationId" class="form-input">
                        <option value="0">Þehir seçiniz</option>
                        @foreach (var loc in Model.AvailableLocations)
                        {
                            <option value="@loc.Id" selected="@(loc.Id == Model.LocationId)">@loc.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);"><i class="fas fa-calendar-alt"></i></div>
                <div><h3 class="section-title">Tarih ve Dönem</h3><p class="section-subtitle">Staj dönemi ve baþvuru tarihi ayarlarý</p></div>
            </div>
            
            <div class="form-group" style="margin-bottom:20px;">
                <label class="form-label">Tarih Seçim Modu</label>
                <div class="radio-group">
                    <label class="radio-option @(Model.DateMode == DateSelectionMode.Period ? "selected" : "")" onclick="updateRadio(this, 1)">
                        <input type="radio" name="DateMode" value="1" @(Model.DateMode == DateSelectionMode.Period ? "checked" : "") />
                        <span class="radio-circle"></span><span>Dönem Seç</span>
                    </label>
                    <label class="radio-option @(Model.DateMode == DateSelectionMode.FixedRange ? "selected" : "")" onclick="updateRadio(this, 2)">
                        <input type="radio" name="DateMode" value="2" @(Model.DateMode == DateSelectionMode.FixedRange ? "checked" : "") />
                        <span class="radio-circle"></span><span>Sabit Tarih Aralýðý</span>
                    </label>
                    <label class="radio-option @(Model.DateMode == DateSelectionMode.Open ? "selected" : "")" onclick="updateRadio(this, 3)">
                        <input type="radio" name="DateMode" value="3" @(Model.DateMode == DateSelectionMode.Open ? "checked" : "") />
                        <span class="radio-circle"></span><span>Açýk</span>
                    </label>
                </div>
            </div>

            <div id="periodSection" style="display:@(Model.DateMode == DateSelectionMode.Period ? "block" : "none");">
                <div class="form-group">
                    <label class="form-label">Dönem</label>
                    <div style="display:flex;gap:12px;align-items:center;">
                        <select asp-for="PeriodId" id="periodSelect" class="form-input" style="flex:1;">
                            <option value="0">Dönem seçiniz</option>
                            @foreach (var p in Model.AvailablePeriods)
                            {
                                <option value="@p.PeriodId" selected="@(p.PeriodId == Model.PeriodId)">@p.PeriodName (@p.StartDate.ToString("dd.MM.yyyy") - @p.EndDate.ToString("dd.MM.yyyy"))</option>
                            }
                        </select>
                        <button type="button" id="showAddPeriodBtn" class="btn-add-period"><i class="fas fa-plus"></i> Yeni</button>
                    </div>
                </div>
                <div id="addPeriodForm" class="period-add-form" style="display:none;">
                    <div class="period-add-grid">
                        <input type="text" id="newPeriodName" class="form-input" placeholder="Dönem adý" />
                        <input type="date" id="newPeriodStart" class="form-input" />
                        <input type="date" id="newPeriodEnd" class="form-input" />
                    </div>
                    <div id="addPeriodMessage" class="text-sm mb-2"></div>
                    <div style="display:flex;gap:8px;justify-content:flex-end;">
                        <button type="button" id="cancelAddPeriod" class="btn-cancel" style="padding:8px 16px;">Ýptal</button>
                        <button type="button" id="saveAddPeriod" class="btn-submit" style="padding:8px 20px;">Kaydet</button>
                    </div>
                </div>
            </div>

            <div id="fixedRangeSection" style="display:@(Model.DateMode == DateSelectionMode.FixedRange ? "block" : "none");">
                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="StartDate" class="form-label">Baþlangýç Tarihi</label>
                        <input asp-for="StartDate" type="date" class="form-input" />
                    </div>
                    <div class="form-group">
                        <label asp-for="EndDate" class="form-label">Bitiþ Tarihi</label>
                        <input asp-for="EndDate" type="date" class="form-input" />
                    </div>
                </div>
            </div>

            <div id="openModeSection" style="display:@(Model.DateMode == DateSelectionMode.Open ? "block" : "none");padding:16px;background:#fef3c7;border-radius:12px;margin-top:16px;">
                <p style="color:#92400e;margin:0;"><i class="fas fa-info-circle mr-2"></i>Açýk modda öðrenci tarihleri belirler.</p>
            </div>

            <div class="form-grid" style="margin-top:20px;">
                <div class="form-group">
                    <label asp-for="ApplicationDeadline" class="form-label">Son Baþvuru Tarihi <span class="required">*</span></label>
                    <input asp-for="ApplicationDeadline" type="date" class="form-input" />
                </div>
                <div class="form-group">
                    <label asp-for="Quota" class="form-label">Pozisyon Sayýsý <span class="required">*</span></label>
                    <input asp-for="Quota" type="number" min="1" max="100" class="form-input" />
                </div>
                <div class="form-group">
                    <label asp-for="MonthlySalary" class="form-label">Aylýk Ücret (?)</label>
                    <input asp-for="MonthlySalary" type="number" step="0.01" min="0" class="form-input" placeholder="Örn: 15000" />
                </div>
                <div class="form-group">
                    <label asp-for="Duration" class="form-label">Süre <span class="required">*</span></label>
                    <select asp-for="Duration" asp-items="Html.GetEnumSelectListWithDisplay<OfferDurationType>()" class="form-input">
                        <option value="">Seçiniz</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background:linear-gradient(135deg,#10b981,#059669);"><i class="fas fa-align-left"></i></div>
                <div><h3 class="section-title">Ýlan Açýklamasý</h3></div>
            </div>
            <textarea asp-for="Description" class="form-input" rows="5" placeholder="Staj pozisyonu hakkýnda detaylý bilgi..."></textarea>
        </div>

        <div class="form-section">
            <div class="section-header">
                <div class="section-icon" style="background:linear-gradient(135deg,#ec4899,#db2777);"><i class="fas fa-list-check"></i></div>
                <div><h3 class="section-title">Gereksinimler</h3></div>
            </div>
            <textarea asp-for="Requirements" class="form-input" rows="4" placeholder="Örn: ReactJS bilgisi, takým çalýþmasý..."></textarea>
        </div>

        <div class="form-section">
            <div class="checkbox-wrapper">
                <input asp-for="IsActive" type="checkbox" id="IsActive" />
                <label for="IsActive" class="checkbox-label"><i class="fas fa-rocket mr-2"></i>Ýlaný hemen yayýnla</label>
            </div>
        </div>

        <div class="form-actions">
            <a asp-controller="CompanyJobPostings" asp-action="List" class="btn-cancel"><i class="fas fa-times"></i> Ýptal</a>
            <button type="submit" class="btn-submit" id="submitBtn"><i class="fas fa-save"></i> @(Model.Id > 0 ? "Güncelle" : "Ýlaný Yayýnla")</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function updateRadio(label, value) {
        document.querySelectorAll('.radio-option').forEach(l => l.classList.remove('selected'));
        label.classList.add('selected');
        label.querySelector('input').checked = true;
        document.getElementById('periodSection').style.display = value === 1 ? 'block' : 'none';
        document.getElementById('fixedRangeSection').style.display = value === 2 ? 'block' : 'none';
        document.getElementById('openModeSection').style.display = value === 3 ? 'block' : 'none';
    }

    var showBtn = document.getElementById('showAddPeriodBtn');
    var addForm = document.getElementById('addPeriodForm');
    var cancelBtn = document.getElementById('cancelAddPeriod');
    var saveBtn = document.getElementById('saveAddPeriod');
    var msg = document.getElementById('addPeriodMessage');
    var periodSelect = document.getElementById('periodSelect');

    showBtn.addEventListener('click', function() { addForm.style.display = 'block'; showBtn.disabled = true; });
    cancelBtn.addEventListener('click', function() { addForm.style.display = 'none'; showBtn.disabled = false; msg.innerText = ''; });

    saveBtn.addEventListener('click', async function() {
        var name = document.getElementById('newPeriodName').value.trim();
        var start = document.getElementById('newPeriodStart').value;
        var end = document.getElementById('newPeriodEnd').value;
        if (!name || !start || !end) { msg.innerText = 'Tüm alanlarý doldurun.'; msg.style.color = '#ef4444'; return; }
        if (new Date(end) <= new Date(start)) { msg.innerText = 'Bitiþ tarihi baþlangýçtan sonra olmalý.'; msg.style.color = '#ef4444'; return; }

        saveBtn.disabled = true; msg.innerText = 'Kaydediliyor...'; msg.style.color = '#6366f1';
        try {
            var anti = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var res = await fetch('@Url.Action("AddPeriodAjax","CompanyJobPostings")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': anti },
                body: JSON.stringify({ PeriodName: name, StartDate: start, EndDate: end })
            });
            var data = await res.json();
            if (data.success) {
                var opt = document.createElement('option');
                opt.value = data.periodId;
                opt.text = data.periodName + ' (' + data.start + ' - ' + data.end + ')';
                opt.selected = true;
                periodSelect.appendChild(opt);
                addForm.style.display = 'none'; showBtn.disabled = false; msg.innerText = '';
                document.getElementById('newPeriodName').value = '';
                document.getElementById('newPeriodStart').value = '';
                document.getElementById('newPeriodEnd').value = '';
            } else { msg.innerText = data.message || 'Hata'; msg.style.color = '#ef4444'; }
        } catch (err) { msg.innerText = 'Hata: ' + err.message; msg.style.color = '#ef4444'; } finally { saveBtn.disabled = false; }
    });

    document.getElementById('jobPostingForm').addEventListener('submit', function(e) {
        var submitBtn = document.getElementById('submitBtn');
        if (submitBtn.disabled) { e.preventDefault(); return false; }
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';
    });
</script>
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
