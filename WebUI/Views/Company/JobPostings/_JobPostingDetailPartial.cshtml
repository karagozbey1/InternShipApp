@model WebUI.Models.Company.JobPostingDetailViewModel

<div class="job-detail-premium">
    <style>
        .job-detail-premium { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
        .detail-hero { background:linear-gradient(135deg,#f8fafc,#f1f5f9); border-radius:16px; padding:24px; margin-bottom:24px; }
        .detail-title { font-size:1.5rem; font-weight:800; color:#1e293b; margin:0 0 8px; }
        .detail-subtitle { font-size:1rem; color:#6366f1; font-weight:600; margin-bottom:16px; }
        .detail-badges { display:flex; gap:12px; flex-wrap:wrap; }
        .detail-badge { padding:8px 16px; border-radius:20px; font-size:0.8rem; font-weight:600; display:inline-flex; align-items:center; gap:6px; }
        .badge-active { background:linear-gradient(135deg,#d1fae5,#a7f3d0); color:#065f46; }
        .badge-inactive { background:linear-gradient(135deg,#fee2e2,#fecaca); color:#991b1b; }
        .badge-type { background:linear-gradient(135deg,#eff6ff,#dbeafe); color:#1d4ed8; }
        
        .stat-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; }
        .stat-item { background:white; border-radius:14px; padding:20px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,0.04); border:1px solid #f1f5f9; }
        .stat-item i { font-size:24px; margin-bottom:8px; }
        .stat-item.blue i { color:#3b82f6; }
        .stat-item.green i { color:#10b981; }
        .stat-item.purple i { color:#8b5cf6; }
        .stat-item.amber i { color:#f59e0b; }
        .stat-item .value { font-size:1.25rem; font-weight:800; color:#1e293b; }
        .stat-item .label { font-size:0.7rem; color:#64748b; text-transform:uppercase; letter-spacing:0.5px; margin-top:4px; }
        
        .detail-section { margin-bottom:24px; }
        .section-title { font-size:1rem; font-weight:700; color:#1e293b; margin-bottom:12px; display:flex; align-items:center; gap:8px; }
        .section-title i { color:#6366f1; }
        .section-content { background:#f8fafc; border-radius:12px; padding:16px; color:#475569; line-height:1.7; }
        
        .date-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; }
        .date-item { background:#f8fafc; border-radius:12px; padding:16px; }
        .date-item .label { font-size:0.75rem; color:#64748b; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px; }
        .date-item .value { font-size:1rem; font-weight:600; color:#1e293b; }
        
        .detail-actions { display:flex; gap:12px; justify-content:flex-end; padding-top:16px; border-top:1px solid #f1f5f9; }
        .btn-detail { padding:12px 24px; border-radius:12px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:8px; transition:all 0.3s; cursor:pointer; border:none; }
        .btn-primary-detail { background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; }
        .btn-primary-detail:hover { transform:translateY(-2px); box-shadow:0 4px 20px rgba(99,102,241,0.4); color:white; }
        .btn-outline-detail { background:white; color:#6366f1; border:2px solid #e2e8f0; }
        .btn-outline-detail:hover { border-color:#6366f1; background:#f5f3ff; }
        
        @@media (max-width:640px) { .stat-grid { grid-template-columns:repeat(2,1fr); } .date-grid { grid-template-columns:1fr; } }
    </style>

    <!-- Hero -->
    <div class="detail-hero">
        <h2 class="detail-title">@Model.Title</h2>
        <div class="detail-subtitle">@Model.Position</div>
        <div class="detail-badges">
            @if (Model.IsActive)
            {
                <span class="detail-badge badge-active"><i class="fas fa-check-circle"></i> Aktif Ýlan</span>
            }
            else
            {
                <span class="detail-badge badge-inactive"><i class="fas fa-pause-circle"></i> Pasif</span>
            }
            <span class="detail-badge badge-type"><i class="fas fa-briefcase"></i> @Model.JobType.GetDisplayName()</span>
            @if (!string.IsNullOrEmpty(Model.Location))
            {
                <span class="detail-badge" style="background:#fef3c7;color:#92400e;"><i class="fas fa-map-marker-alt"></i> @Model.Location</span>
            }
        </div>
    </div>

    <!-- Stats -->
    <div class="stat-grid">
        <div class="stat-item blue">
            <i class="fas fa-users"></i>
            <div class="value">@Model.ApplicationCount</div>
            <div class="label">Baþvuru</div>
        </div>
        <div class="stat-item green">
            <i class="fas fa-user-check"></i>
            <div class="value">@Model.Quota</div>
            <div class="label">Kontenjan</div>
        </div>
        <div class="stat-item purple">
            <i class="fas fa-money-bill-wave"></i>
            <div class="value">@(Model.Salary.HasValue ? string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N0}", Model.Salary) + " ?" : "-")</div>
            <div class="label">Aylýk Ücret</div>
        </div>
        <div class="stat-item amber">
            <i class="fas fa-calendar-check"></i>
            <div class="value">@Model.CreatedDate.ToString("dd MMM")</div>
            <div class="label">Oluþturulma</div>
        </div>
    </div>

    <!-- Dates -->
    <div class="detail-section">
        <h4 class="section-title"><i class="fas fa-calendar-alt"></i> Tarih Bilgileri</h4>
        <div class="date-grid">
            <div class="date-item">
                <div class="label">Baþlangýç Tarihi</div>
                <div class="value">@(Model.StartDate != default ? Model.StartDate.ToString("dd MMMM yyyy") : "Belirtilmemiþ")</div>
            </div>
            <div class="date-item">
                <div class="label">Bitiþ Tarihi</div>
                <div class="value">@(Model.EndDate != default ? Model.EndDate.ToString("dd MMMM yyyy") : "Belirtilmemiþ")</div>
            </div>
            <div class="date-item">
                <div class="label">Son Baþvuru</div>
                <div class="value" style="color:#ef4444;">@(Model.ApplicationDeadline != default ? Model.ApplicationDeadline.ToString("dd MMMM yyyy") : "Belirtilmemiþ")</div>
            </div>
            <div class="date-item">
                <div class="label">Oluþturulma</div>
                <div class="value">@Model.CreatedDate.ToString("dd MMMM yyyy")</div>
            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="detail-section">
        <h4 class="section-title"><i class="fas fa-align-left"></i> Ýlan Açýklamasý</h4>
        <div class="section-content">
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                @Model.Description
            }
            else
            {
                <span style="color:#94a3b8;font-style:italic;">Açýklama eklenmemiþ.</span>
            }
        </div>
    </div>

    <!-- Requirements -->
    <div class="detail-section">
        <h4 class="section-title"><i class="fas fa-list-check"></i> Gereksinimler</h4>
        <div class="section-content">
            @if (!string.IsNullOrWhiteSpace(Model.Requirements))
            {
                @Model.Requirements
            }
            else
            {
                <span style="color:#94a3b8;font-style:italic;">Gereksinim belirtilmemiþ.</span>
            }
        </div>
    </div>

    <!-- Actions -->
    <div class="detail-actions">
        <a asp-controller="CompanyJobPostings" asp-action="Create" asp-route-id="@Model.Id" class="btn-detail btn-outline-detail">
            <i class="fas fa-edit"></i> Düzenle
        </a>
        <a asp-controller="CompanyApplications" asp-action="List" asp-route-jobPostingIdFilter="@Model.Id" class="btn-detail btn-primary-detail">
            <i class="fas fa-users"></i> Baþvurularý Gör (@Model.ApplicationCount)
        </a>
    </div>
</div>