@model WebUI.Models.Company.ApplicationListViewModel
@{
    ViewData["Title"] = "Baþvurular";
    Layout = "_AppLayout";
}

@section Styles {
<style>
    .applications-page { min-height:100vh; background:linear-gradient(135deg,#f0f9ff 0%,#e0f2fe 50%,#f5f0ff 100%); padding:24px; }
    .hero-header { background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%); border-radius:24px; padding:32px; color:white; position:relative; overflow:hidden; box-shadow:0 20px 60px rgba(99,102,241,0.3); margin-bottom:24px; }
    .hero-header::before { content:''; position:absolute; top:-50%; right:-20%; width:400px; height:400px; background:radial-gradient(circle,rgba(255,255,255,0.1) 0%,transparent 70%); }
    .hero-content { position:relative; z-index:1; display:flex; align-items:center; gap:20px; }
    .hero-icon { width:72px; height:72px; border-radius:18px; background:rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center; font-size:28px; }
    .hero-info h1 { font-size:1.75rem; font-weight:800; margin:0 0 4px; }
    .hero-info p { opacity:0.9; margin:0; }
    .filter-card { background:white; border-radius:20px; box-shadow:0 4px 24px rgba(0,0,0,0.06); padding:24px; margin-bottom:24px; }
    .filter-grid { display:grid; grid-template-columns:1fr auto auto auto auto; gap:16px; align-items:end; }
    .filter-input { padding:12px 16px; border:2px solid #e2e8f0; border-radius:12px; font-size:0.95rem; transition:all 0.3s; background:#f8fafc; width:100%; }
    .filter-input:focus { outline:none; border-color:#6366f1; }
    .filter-label { font-size:0.8rem; font-weight:600; color:#64748b; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
    .btn-filter { padding:12px 24px; background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; border:none; border-radius:12px; font-weight:600; cursor:pointer; }
    .btn-filter:hover { transform:translateY(-2px); }
    .btn-clear { padding:12px 20px; background:#f1f5f9; color:#64748b; border:none; border-radius:12px; font-weight:600; text-decoration:none; }
    .results-count { padding:10px 20px; background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); font-weight:600; color:#374151; margin-bottom:24px; display:inline-block; }
    .results-count i { color:#6366f1; margin-right:8px; }
    .applications-grid { display:grid; gap:20px; }
    .app-card { background:white; border-radius:20px; box-shadow:0 4px 24px rgba(0,0,0,0.06); overflow:hidden; transition:all 0.3s; cursor:pointer; position:relative; }
    .app-card:hover { transform:translateY(-4px); box-shadow:0 12px 40px rgba(0,0,0,0.12); }
    .app-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; }
    .app-card.pending::before { background:linear-gradient(90deg,#f59e0b,#fbbf24); }
    .app-card.approved::before { background:linear-gradient(90deg,#10b981,#34d399); }
    .app-card.rejected::before { background:linear-gradient(90deg,#ef4444,#f87171); }
    .app-card-body { padding:24px; display:flex; gap:20px; }
    .app-avatar { width:60px; height:60px; border-radius:16px; background:linear-gradient(135deg,#6366f1,#8b5cf6); display:flex; align-items:center; justify-content:center; color:white; font-size:24px; flex-shrink:0; }
    .app-main { flex:1; min-width:0; }
    .app-header { display:flex; align-items:center; gap:12px; margin-bottom:12px; flex-wrap:wrap; }
    .app-name { font-size:1.1rem; font-weight:700; color:#1e293b; }
    .status-badge { padding:6px 14px; border-radius:20px; font-size:0.75rem; font-weight:600; }
    .status-badge.pending { background:linear-gradient(135deg,#fef3c7,#fde68a); color:#92400e; }
    .status-badge.approved { background:linear-gradient(135deg,#d1fae5,#a7f3d0); color:#065f46; }
    .status-badge.rejected { background:linear-gradient(135deg,#fee2e2,#fecaca); color:#991b1b; }
    .app-meta { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-bottom:12px; }
    .app-meta-item { display:flex; align-items:center; gap:8px; font-size:0.875rem; color:#64748b; }
    .app-meta-item i { color:#6366f1; width:16px; }
    .app-job { padding:12px 16px; background:linear-gradient(135deg,#eff6ff,#dbeafe); border-radius:12px; margin-bottom:12px; }
    .app-job-title { font-weight:600; color:#1d4ed8; display:flex; align-items:center; gap:8px; }
    .app-cover { padding:12px 16px; background:#f8fafc; border-radius:12px; font-size:0.875rem; color:#475569; line-height:1.6; }
    .app-actions { display:flex; flex-direction:column; gap:8px; padding-left:20px; border-left:1px solid #f1f5f9; }
    .action-btn { padding:10px 16px; border-radius:10px; font-weight:600; font-size:0.85rem; text-decoration:none; text-align:center; transition:all 0.3s; display:flex; align-items:center; justify-content:center; gap:6px; cursor:pointer; border:none; }
    .action-btn.primary { background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; }
    .action-btn.primary:hover { color:white; }
    .action-btn.outline { background:white; color:#6366f1; border:2px solid #e2e8f0; }
    .action-btn.success { background:#d1fae5; color:#065f46; }
    .action-btn.danger { background:#fee2e2; color:#991b1b; }
    .empty-state { background:white; border-radius:24px; padding:60px; text-align:center; box-shadow:0 4px 24px rgba(0,0,0,0.06); }
    .empty-icon { width:100px; height:100px; margin:0 auto 24px; background:linear-gradient(135deg,#eff6ff,#dbeafe); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:40px; color:#3b82f6; }
    .empty-title { font-size:1.5rem; font-weight:700; color:#1e293b; margin-bottom:8px; }
    .empty-desc { color:#64748b; margin-bottom:24px; }
    @@media (max-width:1024px) { .filter-grid { grid-template-columns:1fr 1fr; } .app-card-body { flex-direction:column; } .app-actions { flex-direction:row; border-left:none; border-top:1px solid #f1f5f9; padding-left:0; padding-top:16px; } }
    @@media (max-width:640px) { .filter-grid { grid-template-columns:1fr; } .app-meta { grid-template-columns:1fr; } }
</style>
}

<div class="applications-page">
    @Html.AntiForgeryToken()
    
    <div class="hero-header">
        <div class="hero-content">
            <div class="hero-icon"><i class="fas fa-users"></i></div>
            <div class="hero-info">
                <h1>Baþvurular</h1>
                <p>Ýlanlarýnýza gelen baþvurularý inceleyin ve deðerlendirin</p>
            </div>
        </div>
    </div>

    <div class="filter-card">
        <form method="get" class="filter-grid">
            <div>
                <label class="filter-label"><i class="fas fa-search"></i> Arama</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="filter-input" placeholder="Öðrenci adý, email, üniversite ara..." />
            </div>
            <div>
                <label class="filter-label"><i class="fas fa-filter"></i> Durum</label>
                <select name="statusFilter" class="filter-input">
                    <option value="">Tüm Durumlar</option>
                    @foreach (var status in Enum.GetValues<WebUI.Models.Company.ApplicationStatus>())
                    {
                        <option value="@status" selected="@(Model.StatusFilter == status)">@status.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div>
                <label class="filter-label"><i class="fas fa-briefcase"></i> Ýlan</label>
                <select name="jobPostingIdFilter" class="filter-input">
                    <option value="">Tüm Ýlanlar</option>
                    @foreach (var job in Model.AvailableJobPostings)
                    {
                        <option value="@job.Id" selected="@(Model.JobPostingIdFilter == job.Id)">@job.Title</option>
                    }
                </select>
            </div>
            <div>
                <button type="submit" class="btn-filter"><i class="fas fa-search mr-2"></i>Filtrele</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.JobPostingIdFilter.HasValue)
            {
                <div>
                    <a asp-controller="CompanyApplications" asp-action="List" class="btn-clear"><i class="fas fa-times mr-2"></i>Temizle</a>
                </div>
            }
        </form>
    </div>

    <span class="results-count"><i class="fas fa-list-ul"></i>@Model.Applications.Count baþvuru bulundu</span>

    @if (Model.Applications.Any())
    {
        <div class="applications-grid">
            @foreach (var app in Model.Applications)
            {
                var statusClass = app.Status.ToString().ToLower();
                <div class="app-card @statusClass" onclick="viewApplicationDetail(@app.Id)">
                    <div class="app-card-body">
                        <div class="app-avatar"><i class="fas fa-user-graduate"></i></div>
                        <div class="app-main">
                            <div class="app-header">
                                <span class="app-name">@app.StudentName</span>
                                <span class="status-badge @statusClass">@app.Status.GetDisplayName()</span>
                            </div>
                            <div class="app-meta">
                                <div class="app-meta-item"><i class="fas fa-envelope"></i> @app.StudentEmail</div>
                                <div class="app-meta-item"><i class="fas fa-university"></i> @app.University</div>
                                <div class="app-meta-item"><i class="fas fa-graduation-cap"></i> @app.Department</div>
                                <div class="app-meta-item"><i class="fas fa-calendar"></i> @app.ApplicationDate.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="app-job">
                                <span class="app-job-title"><i class="fas fa-briefcase"></i> @app.JobTitle</span>
                            </div>
                            @if (!string.IsNullOrEmpty(app.CoverLetter))
                            {
                                <div class="app-cover">
                                    <i class="fas fa-quote-left"></i>
                                    @(app.CoverLetter.Length > 150 ? app.CoverLetter.Substring(0, 150) + "..." : app.CoverLetter)
                                </div>
                            }
                        </div>
                        <div class="app-actions">
                            <a asp-action="Detail" asp-route-id="@app.Id" class="action-btn primary" onclick="event.stopPropagation();"><i class="fas fa-eye"></i> Detay</a>
                            @if (!string.IsNullOrEmpty(app.CvPath))
                            {
                                <a href="@app.CvPath" target="_blank" class="action-btn outline" onclick="event.stopPropagation();"><i class="fas fa-file-pdf"></i> CV</a>
                            }
                            @if (app.Status == WebUI.Models.Company.ApplicationStatus.Pending)
                            {
                                <button class="action-btn success" onclick="updateApplicationStatus(@app.Id, 'Approved'); event.stopPropagation();"><i class="fas fa-check"></i></button>
                                <button class="action-btn danger" onclick="updateApplicationStatus(@app.Id, 'Rejected'); event.stopPropagation();"><i class="fas fa-times"></i></button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-inbox"></i></div>
            <h3 class="empty-title">Baþvuru bulunmuyor</h3>
            <p class="empty-desc">
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.JobPostingIdFilter.HasValue)
                {
                    <span>Arama kriterlerinize uygun baþvuru bulunamadý.</span>
                }
                else
                {
                    <span>Henüz hiç baþvuru almamýþsýnýz.</span>
                }
            </p>
            <div style="display:flex;gap:16px;justify-content:center;">
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.JobPostingIdFilter.HasValue)
                {
                    <a asp-controller="CompanyApplications" asp-action="List" class="btn-clear"><i class="fas fa-times mr-2"></i>Filtreleri Temizle</a>
                }
                <a asp-controller="CompanyJobPostings" asp-action="Create" class="btn-filter"><i class="fas fa-plus mr-2"></i>Yeni Ýlan Oluþtur</a>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    const applicationDetailBase = '@Url.Action("Detail","CompanyApplications", new { id = 0 })'.replace('/0', '');
    const updateStatusUrl = '@Url.Action("UpdateApplicationStatus","CompanyApplications")';

    function viewApplicationDetail(id) {
        window.location.href = applicationDetailBase + '/' + id;
    }

    function updateApplicationStatus(id, status) {
        var statusText = status === 'Approved' ? 'onaylamak' : 'reddetmek';
        if (confirm('Bu baþvuruyu ' + statusText + ' istediðinizden emin misiniz?')) {
            $.post(updateStatusUrl, {
                id: id,
                status: status,
                __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val()
            })
            .done(function() { location.reload(); })
            .fail(function() { alert('Ýþlem sýrasýnda bir hata oluþtu.'); });
        }
    }
</script>
}
