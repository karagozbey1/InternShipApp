@model CalendarViewModel
@{
    ViewData["Title"] = "Takvim";
    Layout = "_AppLayout";

    var culture = new System.Globalization.CultureInfo("tr-TR");
    var month = Model.CurrentDate;
    var firstOfMonth = new DateTime(month.Year, month.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
    var startOffset = ((int)firstOfMonth.DayOfWeek + 6) % 7; // Monday first
    string[] weekDays = new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" };
    var prev = month.AddMonths(-1);
    var next = month.AddMonths(1);
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-gray-800 dark:text-gray-100">Takvim</h1>
        <div class="flex items-center gap-2">
            <a asp-area="Student" asp-controller="Calendar" asp-action="Index" asp-route-year="@prev.Year" asp-route-month="@prev.Month" class="px-3 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700"><i class="fas fa-chevron-left"></i></a>
            <span class="px-4 py-2 text-gray-600 dark:text-gray-300">@Model.MonthTitle</span>
            <a asp-area="Student" asp-controller="Calendar" asp-action="Index" asp-route-year="@next.Year" asp-route-month="@next.Month" class="px-3 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700"><i class="fas fa-chevron-right"></i></a>
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 rounded-2xl shadow-sm bg-white/80 dark:bg-gray-800 border border-gray-200/70 dark:border-gray-700">
            <div class="px-6 py-4 border-b border-gray-200/70 dark:border-gray-700 flex items-center justify-between">
                <div class="text-lg font-semibold text-gray-700 dark:text-gray-200">Staj Takvimi</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">@month.ToString("MMMM yyyy", culture)</div>
            </div>

            <div class="p-6">
                <div class="grid grid-cols-7 gap-y-2 text-center text-sm font-medium text-gray-500 dark:text-gray-400 mb-4">
                    @foreach (var wd in weekDays) { <div>@wd</div> }
                </div>

                <div class="grid grid-cols-7 gap-2 text-center select-none">
                    @for (var i = 0; i < startOffset; i++) { <div class="py-3"></div> }
                    @for (var day = 1; day <= daysInMonth; day++)
                    {
                        var isToday = day == DateTime.Today.Day && month.Month == DateTime.Today.Month && month.Year == DateTime.Today.Year;
                        var hasPeriod = Model.PeriodDays.Contains(day);
                        var hasApp = Model.ApplicationDays.Contains(day);
                        var hasDiary = Model.DiaryDays.Contains(day);
                        <button type="button" data-day="@day" class="calendar-day w-full py-3 rounded-xl transition-all duration-150 relative focus:outline-none focus:ring-2 focus:ring-blue-400
                                @(isToday ? "bg-blue-600 text-white shadow" : "text-gray-700 dark:text-gray-200 hover:bg-blue-50 dark:hover:bg-gray-700/50")">
                            <span>@day</span>
                            <div class="absolute left-1/2 -translate-x-1/2 -bottom-1.5 flex gap-1">
                                @if (hasPeriod) { <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 inline-block"></span> }
                                @if (hasApp) { <span class="w-1.5 h-1.5 rounded-full bg-blue-500 inline-block"></span> }
                                @if (hasDiary) { <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span> }
                            </div>
                        </button>
                    }
                </div>

                <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                    <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-indigo-500"></span> Dönem</div>
                    <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500"></span> Baþvuru</div>
                    <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-emerald-500"></span> Günlük</div>
                </div>
            </div>
        </div>

        <!-- Side Panel -->
        <div class="rounded-2xl shadow-sm bg-white/80 dark:bg-gray-800 border border-gray-200/70 dark:border-gray-700 flex flex-col" id="eventPanel">
            <div class="px-6 py-4 border-b border-gray-200/70 dark:border-gray-700 flex items-center justify-between">
                <div class="text-lg font-semibold text-gray-700 dark:text-gray-200">
                    <span id="panelDateLabel">Gün Seçin</span>
                </div>
                <button type="button" id="clearSelection" class="text-xs px-3 py-1 rounded bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 hidden">Temizle</button>
            </div>
            <div class="p-6 overflow-y-auto" style="max-height:500px;" id="eventList">
                <div class="text-sm text-gray-500 dark:text-gray-400">Soldan bir gün seçerek etkinlikleri görüntüleyin.</div>
            </div>
            <div class="px-6 py-3 border-t border-gray-200/70 dark:border-gray-700 text-xs text-gray-500 flex gap-4">
                <div><i class="fas fa-circle text-indigo-500 text-[8px] mr-1"></i>Dönem</div>
                <div><i class="fas fa-circle text-blue-500 text-[8px] mr-1"></i>Staj</div>
                <div><i class="fas fa-circle text-emerald-500 text-[8px] mr-1"></i>Günlük</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
    const days = document.querySelectorAll('.calendar-day');
    const list = document.getElementById('eventList');
    const label = document.getElementById('panelDateLabel');
    const clearBtn = document.getElementById('clearSelection');
    const year = @Model.CurrentDate.Year; const month = @Model.CurrentDate.Month;
    const dayEventsUrl = '@Url.Action("DayEvents","Calendar")'; // correct route (no /Student prefix)

    function resetSelection(){
        days.forEach(d=>d.classList.remove('ring-2','ring-blue-400'));    
    }

    function renderLoading(){
        list.innerHTML = `<div class='flex items-center gap-2 text-sm text-gray-500'><i class="fas fa-spinner fa-spin"></i> Yükleniyor...</div>`;
    }

    function renderEmpty(){
        list.innerHTML = `<div class='text-sm text-gray-500'>Bu gün için kayýtlý etkinlik yok.</div>`;
    }

    function renderEvents(evts){
        if(!evts.length){ renderEmpty(); return; }
        list.innerHTML = evts.map(e=>`<div class='mb-4 p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm'>
            <div class='flex items-center justify-between mb-2'>
                <h4 class='font-semibold text-sm text-gray-800 dark:text-gray-200'>${escapeHtml(e.title)}</h4>
                <span class='px-2 py-0.5 text-[10px] rounded-full font-medium ${badgeColor(e.type)}'>${typeLabel(e.type)}</span>
            </div>
            <div class='text-xs text-gray-500 dark:text-gray-400 mb-1'><i class='far fa-clock mr-1'></i>${formatDate(e.startDate, e.endDate)}</div>
            ${e.description ? `<div class='text-xs text-gray-600 dark:text-gray-300 leading-snug'>${escapeHtml(e.description)}</div>` : ''}
        </div>`).join('');
    }

    function badgeColor(t){
        switch(t){
            case 'period': return 'bg-indigo-100 text-indigo-700';
            case 'application': return 'bg-blue-100 text-blue-700';
            case 'diary': return 'bg-emerald-100 text-emerald-700';
            default: return 'bg-gray-100 text-gray-600';
        }
    }
    function typeLabel(t){
        if(t==='period') return 'Dönem';
        if(t==='application') return 'Staj';
        if(t==='diary') return 'Günlük';
        return t;
    }
    function formatDate(s,e){
        try { const sd=new Date(s); const ed=new Date(e); if(sd.toDateString()===ed.toDateString()) return sd.toLocaleDateString('tr-TR'); return sd.toLocaleDateString('tr-TR')+' - '+ed.toLocaleDateString('tr-TR'); } catch{ return ''; }
    }
    function escapeHtml(str){
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
        return String(str).replace(/[&<>"']/g, ch => map[ch] );
    }

    days.forEach(btn=>{
        btn.addEventListener('click', ()=>{
            const day = btn.getAttribute('data-day');
            console.log('[Calendar] Day clicked:', day);
            resetSelection();
            btn.classList.add('ring-2','ring-blue-400');
            label.textContent = day + ' ' + new Date(year, month-1, day).toLocaleDateString('tr-TR', { month: 'long', year:'numeric' });
            clearBtn.classList.remove('hidden');
            fetchDayEvents(day);
        });
    });

    clearBtn.addEventListener('click', ()=>{
        resetSelection();
        list.innerHTML = `<div class='text-sm text-gray-500 dark:text-gray-400'>Soldan bir gün seçerek etkinlikleri görüntüleyin.</div>`;
        label.textContent = 'Gün Seçin';
        clearBtn.classList.add('hidden');
    });

    function fetchDayEvents(day){
        renderLoading();
        const url = `${dayEventsUrl}?year=${year}&month=${month}&day=${day}&t=${Date.now()}`; // cache buster
        console.log('[Calendar] Fetching:', url);
        fetch(url, { headers: { 'Accept':'application/json' }, cache:'no-store' })
            .then(async r => {
                const text = await r.text();
                console.log('[Calendar] Raw response length:', text.length);
                if(!text){ throw new Error('Boþ cevap'); }
                let data; try { data = JSON.parse(text); } catch (e){ console.error('Parse error text=', text); throw new Error('Sunucudan geçersiz JSON geldi'); }
                if(!data.success){ throw new Error(data.message || 'Ýþlem baþarýsýz'); }
                return data;
            })
            .then(d => { console.log('[Calendar] Event count:', (d.events||[]).length); renderEvents(d.events || []); })
            .catch(err => {
                console.error('[Calendar] Fetch error:', err);
                list.innerHTML = `<div class='text-sm text-red-600'>Hata: ${escapeHtml(err.message)}</div>`;
            });
    }
})();
</script>
}
