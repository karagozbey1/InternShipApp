@model DiaryNotebookListViewModel
@{
    ViewData["Title"] = "Staj Defterlerim";
    Layout = "_AppLayout";
}

<div class="p-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
                    <i class="fas fa-book text-blue-500 mr-3"></i>Staj Defterlerim
                </h1>
                <p class="text-gray-600 dark:text-gray-400">
                    Staj süreçleriniz için oluþturduðunuz defterlerinizi buradan yönetebilirsiniz.
                </p>
            </div>
            <div>
                <button onclick="showCreateDiaryModal()" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg transition-colors shadow-lg">
                    <i class="fas fa-plus mr-2"></i>Yeni Defter Oluþtur
                </button>
            </div>
        </div>
    </div>

    @if (Model.HasAnyDiaries)
    {
        <!-- Defter Kartlarý -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var diary in Model.Diaries)
            {
                <div class="diary-notebook-card bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 rounded-xl border border-gray-200 dark:border-gray-700 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
                    
                    <!-- Card Header -->
                    <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex-1">
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 line-clamp-2">
                                    @diary.Title
                                </h3>
                                @if (!string.IsNullOrEmpty(diary.Description))
                                {
                                    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2">@diary.Description</p>
                                }
                            </div>
                            <div class="ml-4">
                                <span class="bg-@(diary.StatusColor)-100 text-@(diary.StatusColor)-800 dark:bg-@(diary.StatusColor)-900 dark:text-@(diary.StatusColor)-200 px-3 py-1 rounded-full text-xs font-medium">
                                    @diary.StatusText
                                </span>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(diary.CompanyName))
                        {
                            <div class="flex items-center text-sm text-gray-600 dark:text-gray-400 mb-2">
                                <i class="fas fa-building mr-2"></i>
                                <span>@diary.CompanyName</span>
                                @if (!string.IsNullOrEmpty(diary.Department))
                                {
                                    <span class="mx-2">•</span>
                                    <span>@diary.Department</span>
                                }
                            </div>
                        }
                        
                        <div class="flex items-center text-sm text-gray-500 dark:text-gray-500">
                            <i class="fas fa-calendar mr-2"></i>
                            <span>@diary.DurationText</span>
                        </div>
                    </div>

                    <!-- Card Body - Ýstatistikler -->
                    <div class="p-6">
                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div class="text-center">
                                <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">@diary.TotalEntries</div>
                                <div class="text-xs text-gray-600 dark:text-gray-400">Toplam Girdi</div>
                            </div>
                            <div class="text-center">
                                <div class="text-2xl font-bold text-green-600 dark:text-green-400">@diary.CompletedDays</div>
                                <div class="text-xs text-gray-600 dark:text-gray-400">Tamamlanan Gün</div>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        @if (diary.TotalDays.HasValue && diary.TotalDays > 0)
                        {
                            <div class="mb-4">
                                <div class="flex justify-between text-sm text-gray-600 dark:text-gray-400 mb-1">
                                    <span>Ýlerleme</span>
                                    <span>%@diary.CompletionPercentage.ToString("F1")</span>
                                </div>
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-blue-500 to-green-500 h-2 rounded-full transition-all duration-300" 
                                         style="width: @diary.CompletionPercentage.ToString("F1")%"></div>
                                </div>
                            </div>
                        }

                        <!-- Badges -->
                        <div class="flex flex-wrap gap-2 mb-4">
                            <span class="bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300 px-2 py-1 rounded-full text-xs">
                                @diary.RequiredText
                            </span>
                            @if (diary.LastEntryDate.HasValue)
                            {
                                <span class="bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300 px-2 py-1 rounded-full text-xs">
                                    Son: @diary.LastEntryDate.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Card Footer -->
                    <div class="p-6 pt-0">
                        <div class="flex gap-2">
                            <a asp-action="Detail" asp-route-id="@diary.Id" 
                               class="flex-1 bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded-lg text-sm font-medium text-center transition-colors">
                                <i class="fas fa-eye mr-2"></i>Defteri Aç
                            </a>
                            <div class="dropdown relative">
                                <button onclick="toggleDropdown(@diary.Id)" 
                                        class="bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 py-2 px-3 rounded-lg text-sm transition-colors">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div id="dropdown-@diary.Id" class="hidden absolute right-0 bottom-full mb-2 w-48 bg-white dark:bg-gray-700 rounded-lg shadow-lg border border-gray-200 dark:border-gray-600 z-10">
                                    <form asp-action="ToggleCompletion" asp-route-id="@diary.Id" method="post" class="inline w-full">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600">
                                            <i class="fas fa-@(diary.IsCompleted ? "play" : "check") mr-2"></i>@(diary.IsCompleted ? "Tekrar Aktifleþtir" : "Tamamlandý Olarak Ýþaretle")
                                        </button>
                                    </form>
                                    <form method="post" onsubmit="event.preventDefault(); setMainDiary(@diary.Id);" class="inline w-full">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-indigo-600 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-indigo-900/40">
                                            <i class="fas fa-star mr-2"></i>Ana Staj Yap
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@diary.Id" method="post" class="inline w-full">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:hover:bg-red-900"
                                                onclick="return confirm('Bu defteri silmek istediðinizden emin misiniz? Tüm girdi verileriniz kaybolacak!')">
                                            <i class="fas fa-trash mr-2"></i>Defteri Sil
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Boþ Durum -->
        <div class="text-center py-16">
            <div class="max-w-md mx-auto">
                <i class="fas fa-book text-8xl text-gray-300 dark:text-gray-600 mb-6"></i>
                <h3 class="text-2xl font-semibold text-gray-600 dark:text-gray-400 mb-4">Henüz Staj Defteriniz Yok</h3>
                <p class="text-gray-500 dark:text-gray-500 mb-8">
                    Staj süreçlerinizi takip etmek için ilk defterinizi oluþturun. 
                    Her staj için ayrý defter tutabilir, günlük ilerlemenizi kaydedebilirsiniz.
                </p>
                <button onclick="showCreateDiaryModal()" class="bg-blue-500 hover:bg-blue-600 text-white px-8 py-3 rounded-lg transition-colors shadow-lg">
                    <i class="fas fa-plus mr-2"></i>Ýlk Defterimi Oluþtur
                </button>
            </div>
        </div>
    }
</div>

<!-- Yeni Defter Oluþturma Modal -->
<div id="createDiaryModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="p-6">
                <div class="flex justify-between items-start mb-6">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                        <i class="fas fa-plus text-blue-500 mr-2"></i>Yeni Staj Defteri Oluþtur
                    </h2>
                    <button onclick="closeCreateDiaryModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                
                <form asp-action="Create" method="post" class="space-y-6">
                    @Html.AntiForgeryToken()
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-heading mr-1"></i>Defter Baþlýðý *
                        </label>
                        <input name="Title" type="text" required
                               class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200" 
                               placeholder="Örn: ABC Teknoloji Yazýlým Stajým" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-align-left mr-1"></i>Açýklama
                        </label>
                        <textarea name="Description" rows="3"
                                  class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200"
                                  placeholder="Bu defter hakkýnda kýsa bir açýklama..."></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-building mr-1"></i>Þirket Adý
                            </label>
                            <input name="CompanyName" type="text"
                                   class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200" 
                                   placeholder="Þirket adýný girin" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-sitemap mr-1"></i>Departman
                            </label>
                            <input name="Department" type="text"
                                   class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200" 
                                   placeholder="Çalýþacaðýnýz departman" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-calendar-alt mr-1"></i>Baþlangýç Tarihi
                            </label>
                            <input name="InternshipStartDate" type="date"
                                   class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-calendar-check mr-1"></i>Bitiþ Tarihi
                            </label>
                            <input name="InternshipEndDate" type="date"
                                   class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-calendar-day mr-1"></i>Toplam Gün
                            </label>
                            <input name="TotalDays" type="number" min="1" max="365"
                                   class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-200" 
                                   placeholder="20" />
                        </div>
                    </div>

                    <div>
                        <label class="flex items-center">
                            <input name="IsRequired" type="checkbox" checked class="mr-3 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Bu defter zorunlu staj için kullanýlacak</span>
                        </label>
                    </div>

                    <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg transition-colors">
                            <i class="fas fa-save mr-2"></i>Defteri Oluþtur
                        </button>
                        <button type="button" onclick="closeCreateDiaryModal()" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition-colors">
                            <i class="fas fa-times mr-2"></i>Ýptal
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal açma/kapatma fonksiyonlarý
        function showCreateDiaryModal() {
            document.getElementById('createDiaryModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeCreateDiaryModal() {
            document.getElementById('createDiaryModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function toggleDropdown(diaryId) {
            const dropdown = document.getElementById(`dropdown-${diaryId}`);
            document.querySelectorAll('[id^="dropdown-"]').forEach(d => { if (d !== dropdown) d.classList.add('hidden'); });
            dropdown.classList.toggle('hidden');
        }

        async function setMainDiary(id) {
            try {
                const formData = new FormData();
                formData.append('id', id);
                const token = document.querySelector(`#dropdown-${id} input[name='__RequestVerificationToken']`).value;
                // Doðru route genellikle /DiaryNotebook/SetMain (Student segmenti yok). Önce onu dene.
                let url = '/DiaryNotebook/SetMain';
                let response = await fetch(url, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });
                if (response.status === 404) {
                    // Fallback eski tahmin edilen yol
                    url = '/Student/DiaryNotebook/SetMain';
                    response = await fetch(url, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: formData
                    });
                }
                const data = await response.json();
                if (data.success) {
                    showToast('Ana staj defteri seçildi', 'success');
                    setTimeout(()=> window.location = '/Dashboard', 800);
                } else {
                    showToast(data.message || 'Ýþlem baþarýsýz', 'error');
                }
            } catch (e) {
                showToast('Sunucu hatasý: ' + e.message, 'error');
            }
        }

        function showToast(msg, type) {
            const el = document.createElement('div');
            el.className = `fixed top-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg text-sm font-medium text-white ${type==='success'?'bg-green-600':'bg-red-600'}`;
            el.textContent = msg;
            document.body.appendChild(el);
            setTimeout(()=>{ el.style.opacity='0'; setTimeout(()=> el.remove(),300); }, 2500);
        }

        // Sayfa dýþýna týklanýnca dropdown'larý kapat
        document.addEventListener('click', function(event) {
            if (!event.target.closest('.dropdown')) {
                document.querySelectorAll('[id^="dropdown-"]').forEach(d => {
                    d.classList.add('hidden');
                });
            }
        });

        // Modal dýþýna týklanýnca kapat
        document.getElementById('createDiaryModal').addEventListener('click', function(e) {
            if (e.target === this) closeCreateDiaryModal();
        });

        // Escape tuþu ile modal kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeCreateDiaryModal();
            }
        });

        // Card hover animasyonlarý
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.diary-notebook-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
                card.classList.add('fade-in-up');
            });
        });
    </script>

    <style>
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .fade-in-up {
            animation: fadeInUp 0.6s ease-out forwards;
            opacity: 0;
            transform: translateY(30px);
        }

        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .diary-notebook-card {
            transition: all 0.3s ease;
        }

        .diary-notebook-card:hover {
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }
    </style>
}