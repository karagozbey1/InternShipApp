@using Core.Entity
@using WebUI.Models.ViewModels.Student
@model ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Baþvuru Detayý";
    Layout = "_AppLayout";

    string statusText = Model.Status switch
    {
        InternshipApplicationStatus.Pending => "Beklemede",
        InternshipApplicationStatus.Approved => "Onaylandý",
        InternshipApplicationStatus.Rejected => "Reddedildi",
        _ => Model.Status.ToString()
    };

    string startDateText = Model.StartDate != DateTime.MinValue ? Model.StartDate.ToString("dd MMMM yyyy") : "-";
    string endDateText = Model.EndDate != DateTime.MinValue ? Model.EndDate.ToString("dd MMMM yyyy") : "-";
}

@section Styles {
    <link rel="stylesheet" href="~/css/approval-details.css" />
    <style>
        /* Compact hero and centered status */
        .hero { border-radius:14px; padding:18px 24px; color:#fff; display:flex; align-items:center; justify-content:space-between; min-height:110px; }
        .hero-left { display:flex; align-items:center; gap:16px; }
        .avatar { width:64px; height:64px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:24px; color:#fff; }
        .hero-meta h2 { margin:0; font-size:18px; font-weight:700; }
        .hero-meta .meta { color:rgba(255,255,255,0.9); font-size:13px; }
        .status-pill { background:rgba(255,255,255,0.08); padding:12px 18px; border-radius:10px; text-align:center; }

        /* Layout */
        .grid { display:flex; gap:20px; align-items:flex-start; }
        .main { flex:1; }
        #right-sidebar { width:320px; }
        .card { border-radius:12px; box-shadow: 0 6px 20px rgba(12, 16, 26, 0.06); background:#fff; margin-bottom:18px; }
        .section-title { font-weight:700; margin-bottom:12px; }

        /* Timeline steps */
        .timeline-steps { display:flex; gap:12px; align-items:center; flex-wrap:wrap; }
        .step { display:flex; align-items:center; gap:10px; padding:12px; background:#fbfbfb; border-radius:10px; min-width:180px; }
        .step .icon { width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:16px; color:white; }
        .step.pending .icon { background:#f59e0b; }
        .step.completed .icon { background:#10b981; }
        .step.rejected .icon { background:#ef4444; }
        .step .label { font-weight:700; }
        .arrow { font-size:20px; color:#cbd5e1; }

        /* Basic responsive: stack columns on small screens using flex-wrap */
        @@media screen and (max-width: 991px) {
            .grid { flex-direction:column; }
            #right-sidebar { width:100%; }
        }
    </style>
}

<div class="container-fluid approval-page">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h5 mb-1">Baþvuru Detayý</h1>
            <div class="text-muted">@Model.CompanyName baþvurusunun detaylarý</div>
        </div>
        <a asp-action="Index" asp-controller="Application" class="btn btn-ghost"><i class="fas fa-arrow-left me-1"></i> Baþvurulara Dön</a>
    </div>

    <div class="hero" style="background:linear-gradient(90deg,#5b21b6,#6d28d9);">
        <div class="hero-left">
            <div class="avatar" style="background:linear-gradient(135deg,#7c3aed,#06b6d4);">@(!string.IsNullOrEmpty(Model.CompanyName) ? Model.CompanyName.Substring(0,1).ToUpper() : "F")</div>
            <div class="hero-meta">
                <h2>@Model.CompanyName @if(Model.IsCompulsory){<span class="badge bg-warning text-dark ms-2" style="font-size:11px;vertical-align:middle;">Zorunlu</span>}</h2>
                <div class="meta">@(!string.IsNullOrEmpty(Model.OfferDetails?.Title) ? Model.OfferDetails.Title : Model.Position)</div>
                <div class="meta small-muted">@statusText • @Model.AppliedDate.ToString("dd MMMM yyyy")</div>
            </div>
        </div>

        <div class="hero-right">
            <div class="status-pill">
                <div style="font-weight:700;">@statusText</div>
                <div class="small-muted" style="color:rgba(255,255,255,0.9);">Durum</div>
            </div>
        </div>
    </div>

    <div class="grid">
        <div class="main">
            <div class="card p-4" aria-labelledby="info-heading">
                <div id="info-heading" class="section-title"><i class="fas fa-info-circle me-2"></i> Ýlan Bilgileri</div>
                <p class="text-muted mb-0">@(!string.IsNullOrEmpty(Model.OfferDetails?.Description) ? Model.OfferDetails.Description : Model.Description)</p>
            </div>

            <div class="card p-4">
                <div class="section-title"><i class="fas fa-user-graduate me-2"></i> Baþvuru Bilgileri</div>
                <div class="row">
                    <div class="col-md-6">
                        <dl>
                            <dt class="small-muted">Pozisyon</dt>
                            <dd>@Model.Position</dd>

                            <dt class="small-muted">Ücret</dt>
                            <dd>
                                @if (Model.OfferDetails?.Salary.HasValue ?? false)
                                {
                                    var cur = Model.OfferDetails.SalaryCurrency;
                                    var symbol = cur == Core.Entity.CurrencyType.TRY ? "?" : cur == Core.Entity.CurrencyType.USD ? "$" : "€";
                                    @($"{Model.OfferDetails.Salary.Value:N0} {symbol}")
                                }
                                else
                                {
                                    @:Belirtilmemiþ
                                }
                            </dd>

                            @if(!string.IsNullOrEmpty(Model.StudentNote))
                            {
                                <dt class="small-muted">Ön Yazý</dt>
                                <dd>@Model.StudentNote</dd>
                            }
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl>
                            <dt class="small-muted">Baþlangýç</dt>
                            <dd>@startDateText</dd>

                            <dt class="small-muted">Bitiþ</dt>
                            <dd>@endDateText</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Timeline steps -->
            <div class="card p-4">
                <div class="section-title"><i class="fas fa-history me-2"></i> Zaman Çizelgesi</div>
                <div class="timeline-steps">
                    <div class="step completed">
                        <div class="icon"><i class="fas fa-paper-plane"></i></div>
                        <div>
                            <div class="label">Baþvuru Gönderildi</div>
                            <div class="text-muted small">@Model.AppliedDate.ToString("dd MMMM yyyy HH:mm")</div>
                        </div>
                    </div>

                    <div class="arrow"><i class="fas fa-chevron-right"></i></div>

                    @if (Model.Status == InternshipApplicationStatus.Pending)
                    {
                        <div class="step pending">
                            <div class="icon"><i class="fas fa-hourglass-half"></i></div>
                            <div>
                                <div class="label">Onay Bekleniyor</div>
                                <div class="text-muted small">Þu anda danýþman onayý bekleniyor</div>
                            </div>
                        </div>
                    }
                    else if (Model.Status == InternshipApplicationStatus.Approved)
                    {
                        <div class="step completed">
                            <div class="icon"><i class="fas fa-check-circle"></i></div>
                            <div>
                                <div class="label">Baþvuru Onaylandý</div>
                                <div class="text-muted small">@Model.ApprovedDate?.ToString("dd MMMM yyyy HH:mm")</div>
                            </div>
                        </div>
                    }
                    else if (Model.Status == InternshipApplicationStatus.Rejected)
                    {
                        <div class="step rejected">
                            <div class="icon"><i class="fas fa-times-circle"></i></div>
                            <div>
                                <div class="label">Baþvuru Reddedildi</div>
                                <div class="text-muted small">@Model.RejectedDate?.ToString("dd MMMM yyyy HH:mm")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div id="right-sidebar">
            <div class="card p-3">
                <div class="section-title"><i class="fas fa-tasks me-2"></i> Durum Yönetimi</div>
                <div class="p-3" style="background:linear-gradient(180deg,#f0f9f4,#ffffff);border-radius:8px;">
                    <div class="small-muted">@statusText</div>
                    <div class="mt-3 d-grid gap-2">
                        @if (Model.Status == InternshipApplicationStatus.Pending)
                        {
                            <form asp-action="Withdraw" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu baþvuruyu geri çekmek istediðinize emin misiniz?')">
                                <button type="submit" class="btn btn-danger">Geri Çek</button>
                            </form>
                        }

                        @* Diary actions *@
                        @if (Model.HasDiary && Model.DiaryId.HasValue)
                        {
                            <a asp-controller="DiaryNotebook" asp-action="Detail" asp-route-id="@Model.DiaryId" class="btn btn-primary">Defteri Aç</a>
                        }
                        @* No create-diary action here anymore. Diary creation moved to Defterlerim (DiaryCards) cart. *@
                     </div>
                 </div>

            <div class="card p-3">
                <div class="section-title"><i class="fas fa-folder me-2"></i> Belgeler</div>
                @if (Model.Documents != null && Model.Documents.Any())
                {
                    foreach (var d in Model.Documents)
                    {
                        var title = !string.IsNullOrEmpty(d.Title) ? d.Title : d.FileName;
                        <div class="d-flex align-items-center justify-content-between mb-2 p-2 rounded" style="background:#fbfbfb;">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-file-pdf text-danger"></i>
                                <div>
                                    <div class="font-weight-bold small mb-0">@title</div>
                                    <div class="text-muted small">@((d.FileSize/1024.0/1024.0)>=1 ? (d.FileSize/1024.0/1024.0).ToString("0.0") + " MB" : (d.FileSize/1024.0).ToString("0") + " KB")</div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="@d.FilePath" target="_blank" class="btn btn-sm btn-outline-secondary">Gör</a>
                                <a href="@d.FilePath" download class="btn btn-sm btn-primary">Ýndir</a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="small-muted">Henüz belge yüklenmemiþ.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // small enhancement: if button is disabled add tooltip
        document.addEventListener('DOMContentLoaded', function() {
            var withdrawBtn = document.querySelector('form[action*="Withdraw"] button');
            if (withdrawBtn && withdrawBtn.disabled) {
                withdrawBtn.title = 'Onaylandýktan sonra baþvuru geri çekilemez.';
            }
        });
    </script>
}