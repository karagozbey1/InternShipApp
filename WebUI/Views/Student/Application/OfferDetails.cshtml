@model WebUI.Models.ViewModels.Student.OfferDetailsViewModel
@{
    ViewData["Title"] = "Ýlan Detaylarý";
    Layout = "_AppLayout";
}

<div class="container-fluid px-4 py-4">
    <div class="grid gap-4"
         style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:minmax(120px,auto);">
        <!-- Baþlýk + aksiyonlar: tam geniþlik, mor kart -->
        <div class="col-span-12 rounded-3 shadow-sm text-white"
             style="grid-column: span 12 / span 12;background:linear-gradient(120deg,#6d28d9 0%,#5631d8 45%,#7c3aed 90%);position:relative;overflow:hidden;">

            <!-- En sað üst CTA butonlarý -->
            <div class="header-cta">
                @{
                    var offerActive = Model.IsActive && (Model.ApplicationDeadline == default(DateTime) || Model.ApplicationDeadline >= DateTime.UtcNow);
                }
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
                {
                    if (Model.HasApplied)
                    {
                        <span class="cta-btn cta-secondary cta-lg disabled"><i class="fas fa-check me-2"></i>Baþvuru Yapýlmýþ</span>
                    }
                    else if (offerActive)
                    {
                        <a asp-controller="Application" asp-action="Create" asp-route-offerId="@Model.Id" class="cta-btn cta-primary cta-lg"><i class="fas fa-paper-plane me-2"></i>Baþvur</a>
                    }
                    else
                    {
                        <span class="cta-btn cta-secondary cta-lg disabled">Süresi Geçmiþ</span>
                    }
                }
                else
                {
                    if (offerActive)
                    {
                        var returnUrl = Url.Action("Create", "Application", new { offerId = Model.Id });
                        <a href="@Url.Action("Login", "Account", new { returnUrl = returnUrl })" class="cta-btn cta-primary cta-lg"><i class="fas fa-paper-plane me-2"></i>Giriþ Yap ve Baþvur</a>
                    }
                    else
                    {
                        <span class="cta-btn cta-secondary cta-lg disabled">Süresi Geçmiþ</span>
                    }
                }
                <button class="cta-btn cta-secondary cta-lg" id="btnSaveOffer" data-offer-id="@Model.Id">
                    <i class="fas fa-bookmark me-2"></i>@(Model.IsFavorite?"Kaydedildi":"Kaydet")
                </button>
            </div>

            <div class="p-4 d-flex align-items-start justify-content-between flex-wrap gap-3"
                 style="padding-right:300px;">
                <div class="d-flex align-items-start gap-3">
                    <div class="offer-avatar d-flex align-items-center justify-content-center rounded-2 fw-bold">
                        @(string.IsNullOrWhiteSpace(Model?.CompanyName) ? "" : Model.CompanyName.Substring(0,1).ToUpper())
                    </div>
                    <div>
                        <h1 class="h5 mb-1">@Model.Title</h1>
                        <div class="opacity-90 small">@Model.CompanyName • @Model.Location</div>
                        <div class="mt-1 d-flex flex-wrap gap-3 small opacity-90">
                            <span><i class="fas fa-briefcase me-1"></i>@Model.Position</span>
                            <span><i class="fas fa-users me-1"></i>@Model.Quota pozisyon</span>
                            <span><i class="fas fa-calendar me-1"></i>Ýlan: @Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sol ana içerik: 8 kolon -->
        <div class="col-span-12 col-lg-8" style="grid-column: span 12 / span 12;">
            <div class="row g-4">
                <div class="col-12">
                    <div class="p-4 bg-white rounded-3 shadow-sm h-100">
                        <h5 class="mb-3">Genel Nitelikler ve Ýþ Tanýmý</h5>
                        <div class="text-muted">@Html.Raw(string.IsNullOrEmpty(Model.Description) ? "Açýklama bulunmuyor." : Model.Description)</div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="p-4 bg-white rounded-3 shadow-sm h-100">
                        <h5 class="mb-3">Aranan Nitelikler</h5>
                        @{
                            var rawReq = Model.Requirements ?? string.Empty;
                            var norm = rawReq.Replace("\r", string.Empty);
                            var items = norm.Split(new[] { '\n', ';' }, StringSplitOptions.RemoveEmptyEntries)
                                            .Select(s => s.Trim().Trim('-', '•'))
                                            .Where(s => !string.IsNullOrWhiteSpace(s))
                                            .ToList();
                            if (!items.Any() && !string.IsNullOrWhiteSpace(rawReq))
                            {
                                items = rawReq.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                              .Select(s => s.Trim().Trim('-', '•'))
                                              .Where(s => !string.IsNullOrWhiteSpace(s))
                                              .ToList();
                            }
                        }
                        @if (items.Any())
                        {
                            <ul class="list-unstyled m-0">
                                @foreach (var it in items)
                                {
                                    <li class="d-flex align-items-start gap-2 mb-2">
                                        <i class="fas fa-check text-success mt-1"></i>
                                        <span class="text-muted">@it</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted">Belirtilmemiþ.</div>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="p-4 bg-white rounded-3 shadow-sm h-100">
                        <h5 class="mb-3">Diðer Bilgiler</h5>
                        <div class="info-grid">
                            <div class="info-box">
                                <div class="info-label">Maaþ</div>
                                <div class="info-value">@(Model.Salary.HasValue ? (string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N0}", Model.Salary) + " " + Model.SalaryCurrency.ToString()) : "-")</div>
                            </div>
                            <div class="info-box">
                                <div class="info-label">Çalýþma Süresi</div>
                                <div class="info-value">@Model.WorkingHours</div>
                            </div>
                            <div class="info-box">
                                <div class="info-label">Pozisyon</div>
                                <div class="info-value">@Model.Position</div>
                            </div>
                            <div class="info-box">
                                <div class="info-label">Kontenjan</div>
                                <div class="info-value">@Model.Quota</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Diðer þirketlerin ilanlarý: Sol sütunda *@
                @if (!User.IsInRole("Company") && Model.OtherCompanyOffers != null && Model.OtherCompanyOffers.Any())
                {
                    <div class="col-12">
                        <div class="p-4 bg-white rounded-3 shadow-sm h-100">
                            <h5 class="mb-3">Diðer Þirketlerden Benzer Ýlanlar</h5>
                            <div class="row g-3">
                                @foreach (var o in Model.OtherCompanyOffers)
                                {
                                    <div class="col-12 col-md-6 col-xxl-4">
                                        <div class="p-3 border rounded-2 h-100 d-flex flex-column">
                                            <div class="d-flex align-items-start justify-content-between gap-2">
                                                <div>
                                                    <div class="fw-semibold">@o.Title</div>
                                                    <div class="text-muted small">@o.CompanyName • @o.City</div>
                                                </div>
                                                <div class="text-muted small">@((o.ApplicationDeadline.HasValue) ? o.ApplicationDeadline.Value.ToString("dd.MM.yyyy") : "-")</div>
                                            </div>
                                            <div class="mt-3 d-flex gap-2 mt-auto">
                                                <a asp-action="OfferDetails" asp-route-id="@o.OfferId" asp-route-source="student" class="btn btn-sm btn-link p-0">Ýlaný Gör</a>
                                                <a asp-controller="Application" asp-action="Create" asp-route-offerId="@o.OfferId" class="btn btn-sm btn-success">Baþvur</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Sað yan içerik: 4 kolon -->
        <div class="col-span-12 col-lg-4" style="grid-column: span 12 / span 12;">
            <div class="row g-4">
                <div class="col-12">
                    <div class="p-4 bg-white rounded-3 shadow-sm h-100">
                        <div class="d-flex gap-3">
                            <div class="company-avatar d-flex align-items-center justify-content-center rounded-2 fw-bold">
                                @(string.IsNullOrWhiteSpace(Model?.CompanyName) ? "" : Model.CompanyName.Substring(0,1).ToUpper())
                            </div>
                            <div class="flex-1">
                                <div class="fw-semibold">@Model.CompanyName</div>
                                <div class="text-muted small">@Model.Location</div>
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                                {
                                    <div class="small mt-2"><i class="fas fa-phone me-2 text-primary"></i><a href="tel:@Model.CompanyPhone">@Model.CompanyPhone</a></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail))
                                {
                                    <div class="small mt-1"><i class="fas fa-envelope me-2 text-primary"></i><a href="mailto:@Model.CompanyEmail">@Model.CompanyEmail</a></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyWebsite))
                                {
                                    <div class="small mt-2"><a href="@Model.CompanyWebsite" target="_blank" rel="noopener" class="link-primary">@Model.CompanyWebsite</a></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="p-4 bg-white rounded-3 shadow-sm h-100">
                        <h6 class="fw-semibold mb-2">Hakkýmýzda</h6>
                        @if(!string.IsNullOrWhiteSpace(Model.CompanyDescription))
                        {
                            <p class="text-muted small mb-0">@Model.CompanyDescription</p>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Þirket hakkýnda bilgi bulunmamaktadýr.</p>
                        }
                    </div>
                </div>

                @* Ayný þirketten diðer ilanlar *@
                @if (!User.IsInRole("Company") && Model.RelatedOffers != null && Model.RelatedOffers.Any())
                {
                    <div class="col-12">
                        <div class="p-4 bg-white rounded-3 shadow-sm h-100">
                            <h6 class="fw-semibold mb-3">Ayný Þirketten Diðer Ýlanlar</h6>
                            <div class="row g-3">
                                @foreach (var o in Model.RelatedOffers)
                                {
                                    <div class="col-12">
                                        <div class="p-3 border rounded-2 d-flex align-items-start justify-content-between gap-2">
                                            <div>
                                                <div class="fw-semibold">@o.Title</div>
                                                <div class="text-muted small">@o.CompanyName • @o.City</div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a asp-action="OfferDetails" asp-route-id="@o.OfferId" asp-route-source="student" class="btn btn-sm btn-link p-0">Ýlaný Gör</a>
                                                <a asp-controller="Application" asp-action="Create" asp-route-offerId="@o.OfferId" class="btn btn-sm btn-outline-primary">Baþvur</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .offer-avatar{width:64px;height:64px;background:linear-gradient(135deg,#7c3aed,#06b6d4);font-size:1.5rem;color:#fff;text-align:center}
    .company-avatar{width:56px;height:56px;background:linear-gradient(135deg,#7c3aed,#06b6d4);font-size:1.25rem;color:#fff;text-align:center}

    /* CTA büyük lacivert butonlar */
    .header-cta{position:absolute;top:16px;right:16px;display:flex;gap:12px;z-index:2}
    .cta-btn{display:inline-flex;align-items:center;justify-content:center;border:none;border-radius:12px;padding:.85rem 1.4rem;font-size:1.06rem;font-weight:700;line-height:1;color:#fff;cursor:pointer;transition:all .15s ease-in-out;box-shadow:0 10px 22px rgba(10,42,106,.25)}
    .cta-btn i{font-size:1rem}
    .cta-primary{background:linear-gradient(135deg,#0b3d91,#0a2a6a)}
    .cta-primary:hover{filter:brightness(1.05);transform:translateY(-1px)}
    .cta-secondary{background:#0a2a6a}
    .cta-secondary:hover{background:#09255d;transform:translateY(-1px)}
    .cta-lg{min-width:140px}
    .cta-btn.disabled,.cta-btn:disabled{opacity:.6;pointer-events:none}

    /* Diðer Bilgiler: yan yana kutucuklar */
    .info-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .info-box{background:#f8f9fa;border:1px solid #e9ecef;border-radius:12px;padding:14px}
    .info-label{font-size:11px;color:#6c757d;text-transform:uppercase;letter-spacing:.03em;margin-bottom:4px}
    .info-value{font-weight:600;color:#1f2937}

    /* Responsive */
    @@media (max-width: 1199.98px){.info-grid{grid-template-columns:repeat(3,1fr)}}
    @@media (max-width: 991.98px){.info-grid{grid-template-columns:repeat(2,1fr)}}
    @@media (max-width: 575.98px){.info-grid{grid-template-columns:1fr}}

    @@media (min-width: 992px) {
        .col-lg-8 { grid-column: span 8 / span 8 !important; }
        .col-lg-4 { grid-column: span 4 / span 4 !important; }
    }
</style>

@section Scripts {
    <script>
        (function(){
            const btn = document.getElementById('btnSaveOffer');
            if(!btn) return;
            const offerId = btn.getAttribute('data-offer-id');
            const isAuth = '@(User.Identity?.IsAuthenticated == true ? "true" : "false")' === 'true';
            const isStudent = '@(User.IsInRole("Student") ? "true" : "false")' === 'true';
            const userId = '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0")';
            const storageKey = `favOffers:${userId}`;

            function getFavSet(){
                try{ const raw = localStorage.getItem(storageKey) || ''; return new Set(raw.split(',').filter(x=>x)); }catch{ return new Set(); }
            }
            function saveFavSet(set){ try{ localStorage.setItem(storageKey, Array.from(set).join(',')); }catch{} }
            function setBtn(saved){ btn.innerHTML = saved? '<i class="fas fa-bookmark me-2"></i>Kaydedildi' : '<i class="fas fa-bookmark me-2"></i>Kaydet'; }

            // Initial sync from localStorage (override server if needed)
            const s = getFavSet();
            setBtn(s.has(offerId));

            btn.addEventListener('click', function(){
                if(!isAuth || !isStudent){
                    const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.href = '/Account/Login?returnUrl=' + returnUrl;
                    return;
                }
                const set = getFavSet();
                let willBeFavorite;
                if(set.has(offerId)){ set.delete(offerId); willBeFavorite = false; } else { set.add(offerId); willBeFavorite = true; }
                saveFavSet(set);
                setBtn(willBeFavorite);
                // Best-effort server sync
                fetch(`/api/public/offers/${offerId}/favorite`, { method:'POST' }).catch(()=>{});
            });
        })();
    </script>
}