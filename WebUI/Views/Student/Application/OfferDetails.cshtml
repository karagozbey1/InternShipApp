@model WebUI.Models.ViewModels.Student.OfferDetailsViewModel
@{
    ViewData["Title"] = "Ýlan Detaylarý";
    Layout = "_AppLayout";
}

@if (Model.ShowEcommerceMode)
{
    <!-- E-commerce style layout (for Home/Student source) -->
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="p-6 bg-white rounded-2xl shadow-lg">
                <div class="flex items-start justify-between">
                    <div class="flex items-start gap-4">
                        <div class="w-20 h-20 bg-gradient-to-r from-purple-600 to-pink-500 rounded-lg flex items-center justify-center text-white font-bold text-2xl">
                            @(string.IsNullOrWhiteSpace(Model?.CompanyName) ? "" : Model.CompanyName.Substring(0,1).ToUpper())
                        </div>
                        <div>
                            <h1 class="text-2xl font-semibold">@Model.Title</h1>
                            <p class="text-sm text-gray-600 mt-1">@Model.CompanyName • @Model.Location</p>
                            <div class="mt-3 flex items-center gap-3 text-sm text-gray-500">
                                <span><i class="fas fa-briefcase mr-1"></i> @Model.Position</span>
                                <span><i class="fas fa-users mr-1"></i> @Model.Quota pozisyon</span>
                                <span><i class="fas fa-calendar mr-1"></i> Ýlan: @Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        @{
                            var offerActive = Model.IsActive && (Model.ApplicationDeadline == default(DateTime) || Model.ApplicationDeadline >= DateTime.UtcNow);
                        }
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
                        {
                            if (offerActive)
                            {
                                <a asp-controller="Application" asp-action="Create" asp-route-offerId="@Model.Id" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:shadow-lg">Baþvur</a>
                            }
                            else
                            {
                                <span class="px-4 py-2 bg-gray-100 text-gray-600 rounded-lg">Ýlanýn süresi geçmiþ</span>
                            }
                        }
                        else
                        {
                            if (offerActive)
                            {
                                // In ecommerce mode we show login link so students can login then apply
                                var returnUrl = Url.Action("Create", "Application", new { offerId = Model.Id });
                                <a href="@Url.Action("Login", "Account", new { returnUrl = returnUrl })" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:shadow-lg">Giriþ Yap ve Baþvur</a>
                            }
                            else
                            {
                                <span class="px-4 py-2 bg-gray-100 text-gray-600 rounded-lg">Ýlanýn süresi geçmiþ</span>
                            }
                        }

                        <button class="px-4 py-2 border rounded-lg">Kaydet</button>
                    </div>
                </div>

                <div class="mt-6 space-y-4">
                    <h3 class="font-semibold text-gray-800">Genel Nitelikler ve Ýþ Tanýmý</h3>
                    <p class="text-gray-700">
                        @Html.Raw(string.IsNullOrEmpty(Model.Description) ? "Açýklama bulunmuyor." : Model.Description)
                    </p>

                    <h4 class="font-semibold text-gray-800">Aranan Nitelikler</h4>
                    <p class="text-gray-700">@Html.Raw(string.IsNullOrEmpty(Model.Requirements) ? "Belirtilmemiþ." : Model.Requirements)</p>
                </div>
            </div>

            <div class="p-6 bg-white rounded-2xl shadow-lg">
                <h3 class="text-lg font-semibold mb-4">Diðer Bilgiler</h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="p-3 bg-gray-50 rounded-lg">
                        <div class="text-xs text-gray-500">Maaþ</div>
                        <div class="font-semibold text-gray-800">@(Model.Salary.HasValue ? (string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N0}", Model.Salary) + " " + Model.SalaryCurrency.ToString()) : "—")</div>
                    </div>
                    <div class="p-3 bg-gray-50 rounded-lg">
                        <div class="text-xs text-gray-500">Çalýþma Süresi</div>
                        <div class="font-semibold text-gray-800">@Model.WorkingHours</div>
                    </div>
                    <div class="p-3 bg-gray-50 rounded-lg">
                        <div class="text-xs text-gray-500">Pozisyon</div>
                        <div class="font-semibold text-gray-800">@Model.Position</div>
                    </div>
                    <div class="p-3 bg-gray-50 rounded-lg">
                        <div class="text-xs text-gray-500">Kontenjan</div>
                        <div class="font-semibold text-gray-800">@Model.Quota</div>
                    </div>
                </div>
            </div>

            @* Main column now only contains core details; related cards moved to aside *@
        </div>

        <aside class="space-y-6">
            <!-- Top-right company info card: show company name, phone and email dynamically and make link open website -->
            <div class="p-6 bg-white rounded-2xl shadow-lg">
                <div class="flex items-start gap-4">
                    <div class="w-16 h-16 bg-gradient-to-r from-purple-600 to-pink-500 rounded-lg flex items-center justify-center text-white font-bold text-xl">@(string.IsNullOrWhiteSpace(Model?.CompanyName) ? "" : Model.CompanyName.Substring(0,1).ToUpper())</div>
                    <div class="flex-1">
                        <div class="font-semibold text-lg">@Model.CompanyName</div>
                        <div class="text-sm text-gray-500">@Model.Location</div>

                        <div class="mt-3 space-y-1 text-sm text-gray-700">
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                            {
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-phone text-blue-600"></i>
                                    <a href="tel:@Model.CompanyPhone" class="hover:underline">@Model.CompanyPhone</a>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail))
                            {
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-envelope text-blue-600"></i>
                                    <a href="mailto:@Model.CompanyEmail" class="hover:underline">@Model.CompanyEmail</a>
                                </div>
                            }
                        </div>

                        @* Prominent action link under contact info that opens the company's website in a new tab *@
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyWebsite))
                        {
                            <div class="mt-4">
                                <a href="@Model.CompanyWebsite" target="_blank" rel="noopener" class="inline-block text-sm text-blue-600 hover:underline">Þirket Sayfasýna Git</a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Detailed Hakkýmýzda card -->
            <div class="p-6 bg-white rounded-2xl shadow-lg">
                <h4 class="font-semibold mb-3">Hakkýmýzda</h4>
                @if(!string.IsNullOrWhiteSpace(Model.CompanyDescription))
                {
                    <p class="text-sm text-gray-700">@Model.CompanyDescription</p>
                }
                else
                {
                    <p class="text-sm text-gray-500">Þirket hakkýnda bilgi bulunmamaktadýr.</p>
                }
            </div>

            @* Show Benzer Ýlanlar only to non-company users *@
            @if (!User.IsInRole("Company"))
            {
                @if (Model.RelatedOffers != null && Model.RelatedOffers.Any())
                {
                    <div class="p-6 rounded-2xl bg-white shadow-lg w-full">
                        <h3 class="text-lg font-semibold mb-4">Benzer Ýlanlar</h3>
                        <div class="space-y-3">
                            @foreach (var o in Model.RelatedOffers)
                            {
                                <div class="w-full p-4 border rounded-lg flex items-center gap-4 hover:shadow-lg transition">
                                    <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-gradient-to-r from-blue-500 to-purple-600 text-white font-bold">@(!string.IsNullOrWhiteSpace(o.CompanyName) ? o.CompanyName.Substring(0,1).ToUpper() : "?")</div>
                                    <div class="flex-1">
                                        <div class="flex items-start justify-between">
                                            <div>
                                                <h4 class="font-semibold text-gray-800">@o.Title</h4>
                                                <p class="text-sm text-gray-500">@o.CompanyName • @o.City</p>
                                            </div>
                                            <div class="text-xs text-gray-500 ml-4">@((o.ApplicationDeadline.HasValue) ? o.ApplicationDeadline.Value.ToString("dd.MM.yyyy") : "—")</div>
                                        </div>
                                        <div class="mt-3 flex items-center gap-2">
                                            <a asp-action="OfferDetails" asp-route-id="@o.OfferId" asp-route-source="student" class="text-blue-600 hover:underline">Ýlaný Gör</a>
                                            <a asp-controller="Application" asp-action="Create" asp-route-offerId="@o.OfferId" class="px-3 py-1 bg-green-500 text-white rounded text-sm">Baþvur</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </aside>
    </div>
}

@section Scripts {
    <script>
        // preserved scripts (if needed)
    </script>
}