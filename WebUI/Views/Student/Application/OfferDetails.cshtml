@model WebUI.Models.ViewModels.Student.OfferDetailsViewModel
@{
    ViewData["Title"] = "Ilan Detaylari";
    Layout = "_AppLayout";
    var offerActive = Model.IsActive && (Model.ApplicationDeadline == default(DateTime) || Model.ApplicationDeadline >= DateTime.UtcNow);
}

@section Styles {
<style>
    .offer-detail-hero {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        border-radius: 24px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
    }
    .offer-detail-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 80%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
    }
    .company-avatar-lg {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 800;
        color: white;
        flex-shrink: 0;
    }
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background: rgba(255,255,255,0.15);
        border-radius: 20px;
        font-size: 14px;
        backdrop-filter: blur(10px);
    }
    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .btn-apply-lg {
        padding: 14px 28px;
        border-radius: 14px;
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }
    .btn-apply-lg:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(16, 185, 129, 0.5);
        color: white;
    }
    .btn-apply-lg.disabled {
        opacity: 0.6;
        cursor: not-allowed;
        pointer-events: none;
    }
    .btn-save-lg {
        padding: 14px 24px;
        border-radius: 14px;
        background: rgba(255,255,255,0.2);
        color: white;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        backdrop-filter: blur(10px);
    }
    .btn-save-lg:hover {
        background: rgba(255,255,255,0.3);
    }
    .btn-save-lg.saved {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }
    
    .premium-card {
        background: white;
        border-radius: 20px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .dark .premium-card {
        background: rgba(30, 41, 59, 0.95);
        border-color: rgba(71, 85, 105, 0.3);
    }
    .card-header-premium {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .dark .card-header-premium {
        background: rgba(51, 65, 85, 0.3);
        border-color: rgba(71, 85, 105, 0.3);
    }
    .header-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }
    .card-body-premium {
        padding: 1.5rem;
    }
    
    .description-box {
        padding: 1.5rem;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(139, 92, 246, 0.05));
        border-radius: 16px;
        border-left: 4px solid #8b5cf6;
        line-height: 1.8;
        color: #374151;
    }
    .dark .description-box {
        color: #d1d5db;
    }
    
    .requirement-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    .requirement-item:last-child {
        border-bottom: none;
    }
    .requirement-icon {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: linear-gradient(135deg, #10b981, #059669);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .requirement-icon i {
        font-size: 10px;
        color: white;
    }
    
    .info-grid-premium {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }
    .info-card {
        padding: 1.25rem;
        border-radius: 14px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        text-align: center;
    }
    .dark .info-card {
        background: rgba(51, 65, 85, 0.3);
    }
    .info-card-label {
        font-size: 11px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        margin-bottom: 8px;
    }
    .info-card-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1e293b;
    }
    .dark .info-card-value {
        color: #e5e7eb;
    }
    
    .company-card {
        background: white;
        border-radius: 20px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .dark .company-card {
        background: rgba(30, 41, 59, 0.95);
        border-color: rgba(71, 85, 105, 0.3);
    }
    .company-avatar-sm {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        flex-shrink: 0;
    }
    .contact-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    .contact-item:last-child {
        border-bottom: none;
    }
    .contact-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1));
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .contact-icon i {
        color: #6366f1;
        font-size: 12px;
    }
    
    .related-offer-card {
        padding: 1rem;
        border-radius: 14px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        margin-bottom: 0.75rem;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }
    .dark .related-offer-card {
        background: rgba(51, 65, 85, 0.3);
    }
    .related-offer-card:hover {
        border-color: #6366f1;
        transform: translateX(4px);
    }
    
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: white;
        border-radius: 14px;
        color: #6366f1;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.1);
        transition: all 0.3s ease;
        margin-bottom: 1.5rem;
    }
    .back-link:hover {
        transform: translateX(-4px);
        box-shadow: 0 4px 16px rgba(99, 102, 241, 0.2);
        color: #4f46e5;
    }
    .dark .back-link {
        background: rgba(30, 41, 59, 0.95);
        color: #a5b4fc;
    }
    
    .btn-outline-premium {
        padding: 8px 16px;
        border-radius: 10px;
        background: transparent;
        border: 2px solid #6366f1;
        color: #6366f1;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .btn-outline-premium:hover {
        background: #6366f1;
        color: white;
    }
    .btn-success-premium {
        padding: 8px 16px;
        border-radius: 10px;
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-success-premium:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        color: white;
    }
    
    @@media (max-width: 1024px) {
        .info-grid-premium {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @@media (max-width: 640px) {
        .info-grid-premium {
            grid-template-columns: 1fr;
        }
        .hero-actions {
            width: 100%;
        }
        .hero-actions > * {
            flex: 1;
            justify-content: center;
        }
    }
</style>
}

<div class="space-y-6">
    <a asp-action="Browse" class="back-link">
        <i class="fas fa-arrow-left"></i>Ilanlara Don
    </a>

    <!-- Hero Section -->
    <div class="offer-detail-hero animate-fade-in-up">
        <div class="relative z-10">
            <div class="flex flex-col lg:flex-row items-start justify-between gap-6">
                <div class="flex items-start gap-5">
                    <div class="company-avatar-lg">
                        @(string.IsNullOrWhiteSpace(Model?.CompanyName) ? "?" : Model.CompanyName.Substring(0,1).ToUpper())
                    </div>
                    <div>
                        <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">@Model.Title</h1>
                        <p class="text-white/80 text-lg mb-4">@Model.CompanyName • @Model.Location</p>
                        <div class="flex flex-wrap gap-3">
                            <span class="hero-badge text-white">
                                <i class="fas fa-briefcase"></i>@Model.Position
                            </span>
                            <span class="hero-badge text-white">
                                <i class="fas fa-users"></i>@Model.Quota pozisyon
                            </span>
                            <span class="hero-badge text-white">
                                <i class="fas fa-calendar"></i>@Model.CreatedAt.ToString("dd.MM.yyyy")
                            </span>
                            @if (Model.ApplicationDeadline != default(DateTime))
                            {
                                <span class="hero-badge text-white" style="background: rgba(239, 68, 68, 0.3);">
                                    <i class="fas fa-clock"></i>Son: @Model.ApplicationDeadline.ToString("dd.MM.yyyy")
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="hero-actions">
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
                    {
                        if (Model.HasApplied)
                        {
                            <span class="btn-apply-lg disabled"><i class="fas fa-check"></i>Basvuru Yapilmis</span>
                        }
                        else if (offerActive)
                        {
                            <a asp-controller="Application" asp-action="Create" asp-route-offerId="@Model.Id" class="btn-apply-lg">
                                <i class="fas fa-paper-plane"></i>Basvur
                            </a>
                        }
                        else
                        {
                            <span class="btn-apply-lg disabled">Suresi Gecmis</span>
                        }
                    }
                    else
                    {
                        if (offerActive)
                        {
                            var returnUrl = Url.Action("Create", "Application", new { offerId = Model.Id });
                            <a href="@Url.Action("Login", "Account", new { returnUrl = returnUrl })" class="btn-apply-lg">
                                <i class="fas fa-sign-in-alt"></i>Giris Yap ve Basvur
                            </a>
                        }
                        else
                        {
                            <span class="btn-apply-lg disabled">Suresi Gecmis</span>
                        }
                    }
                    <button class="btn-save-lg @(Model.IsFavorite ? "saved" : "")" id="btnSaveOffer" data-offer-id="@Model.Id">
                        <i class="fas fa-bookmark"></i>@(Model.IsFavorite ? "Kaydedildi" : "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Description -->
            <div class="premium-card animate-fade-in-up">
                <div class="card-header-premium">
                    <div class="header-icon" style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Genel Nitelikler ve Is Tanimi</h3>
                </div>
                <div class="card-body-premium">
                    <div class="description-box">
                        @Html.Raw(string.IsNullOrEmpty(Model.Description) ? "Aciklama bulunmuyor." : Model.Description)
                    </div>
                </div>
            </div>

            <!-- Requirements -->
            <div class="premium-card animate-fade-in-up">
                <div class="card-header-premium">
                    <div class="header-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="fas fa-list-check"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Aranan Nitelikler</h3>
                </div>
                <div class="card-body-premium">
                    @{
                        var rawReq = Model.Requirements ?? string.Empty;
                        var norm = rawReq.Replace("\r", string.Empty);
                        var items = norm.Split(new[] { '\n', ';' }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(s => s.Trim().Trim('-', '•'))
                                        .Where(s => !string.IsNullOrWhiteSpace(s))
                                        .ToList();
                        if (!items.Any() && !string.IsNullOrWhiteSpace(rawReq))
                        {
                            items = rawReq.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                          .Select(s => s.Trim().Trim('-', '•'))
                                          .Where(s => !string.IsNullOrWhiteSpace(s))
                                          .ToList();
                        }
                    }
                    @if (items.Any())
                    {
                        <div class="space-y-0">
                            @foreach (var it in items)
                            {
                                <div class="requirement-item">
                                    <div class="requirement-icon">
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <span class="text-gray-700 dark:text-gray-300">@it</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500">Belirtilmemis.</p>
                    }
                </div>
            </div>

            <!-- Other Info -->
            <div class="premium-card animate-fade-in-up">
                <div class="card-header-premium">
                    <div class="header-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">Diger Bilgiler</h3>
                </div>
                <div class="card-body-premium">
                    <div class="info-grid-premium">
                        <div class="info-card">
                            <div class="info-card-label">Maas</div>
                            <div class="info-card-value">
                                @(Model.Salary.HasValue ? (string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N0}", Model.Salary) + " " + Model.SalaryCurrency.ToString()) : "-")
                            </div>
                        </div>
                        <div class="info-card">
                            <div class="info-card-label">Calisma Suresi</div>
                            <div class="info-card-value">@(Model.WorkingHours ?? "-")</div>
                        </div>
                        <div class="info-card">
                            <div class="info-card-label">Pozisyon</div>
                            <div class="info-card-value">@Model.Position</div>
                        </div>
                        <div class="info-card">
                            <div class="info-card-label">Kontenjan</div>
                            <div class="info-card-value">@Model.Quota</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Other Companies Offers -->
            @if (!User.IsInRole("Company") && Model.OtherCompanyOffers != null && Model.OtherCompanyOffers.Any())
            {
                <div class="premium-card animate-fade-in-up">
                    <div class="card-header-premium">
                        <div class="header-icon" style="background: linear-gradient(135deg, #ec4899, #be185d);">
                            <i class="fas fa-building"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Diger Sirketlerden Benzer Ilanlar</h3>
                    </div>
                    <div class="card-body-premium">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var o in Model.OtherCompanyOffers)
                            {
                                <div class="related-offer-card">
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div>
                                            <h4 class="font-semibold text-gray-900 dark:text-white">@o.Title</h4>
                                            <p class="text-sm text-gray-500">@o.CompanyName • @o.City</p>
                                        </div>
                                        <span class="text-xs text-gray-400">
                                            @((o.ApplicationDeadline.HasValue) ? o.ApplicationDeadline.Value.ToString("dd.MM") : "-")
                                        </span>
                                    </div>
                                    <div class="flex gap-2">
                                        <a asp-action="OfferDetails" asp-route-id="@o.OfferId" asp-route-source="student" class="btn-outline-premium">
                                            <i class="fas fa-eye mr-1"></i>Gor
                                        </a>
                                        <a asp-controller="Application" asp-action="Create" asp-route-offerId="@o.OfferId" class="btn-success-premium">
                                            <i class="fas fa-paper-plane mr-1"></i>Basvur
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Company Info -->
            <div class="company-card animate-fade-in-up">
                <div class="flex items-start gap-4 mb-4">
                    <div class="company-avatar-sm">
                        @(string.IsNullOrWhiteSpace(Model?.CompanyName) ? "?" : Model.CompanyName.Substring(0,1).ToUpper())
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">@Model.CompanyName</h4>
                        <p class="text-sm text-gray-500">@Model.Location</p>
                    </div>
                </div>
                
                <div class="space-y-0 mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                    {
                        <div class="contact-item">
                            <div class="contact-icon"><i class="fas fa-phone"></i></div>
                            <a href="tel:@Model.CompanyPhone" class="text-sm text-gray-700 dark:text-gray-300 hover:text-indigo-600">@Model.CompanyPhone</a>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail))
                    {
                        <div class="contact-item">
                            <div class="contact-icon"><i class="fas fa-envelope"></i></div>
                            <a href="mailto:@Model.CompanyEmail" class="text-sm text-gray-700 dark:text-gray-300 hover:text-indigo-600">@Model.CompanyEmail</a>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CompanyWebsite))
                    {
                        <div class="contact-item">
                            <div class="contact-icon"><i class="fas fa-globe"></i></div>
                            <a href="@Model.CompanyWebsite" target="_blank" class="text-sm text-indigo-600 hover:text-indigo-800">Web Sitesi</a>
                        </div>
                    }
                </div>
            </div>

            <!-- About Company -->
            <div class="company-card animate-fade-in-up">
                <h4 class="font-bold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
                    <i class="fas fa-info-circle text-indigo-500"></i>Hakkimizda
                </h4>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyDescription))
                {
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">@Model.CompanyDescription</p>
                }
                else
                {
                    <p class="text-sm text-gray-500">Sirket hakkinda bilgi bulunmamaktadir.</p>
                }
            </div>

            <!-- Same Company Offers -->
            @if (!User.IsInRole("Company") && Model.RelatedOffers != null && Model.RelatedOffers.Any())
            {
                <div class="company-card animate-fade-in-up">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                        <i class="fas fa-briefcase text-indigo-500"></i>Ayni Sirketten Diger Ilanlar
                    </h4>
                    <div class="space-y-3">
                        @foreach (var o in Model.RelatedOffers)
                        {
                            <div class="related-offer-card">
                                <h5 class="font-semibold text-gray-900 dark:text-white text-sm mb-1">@o.Title</h5>
                                <p class="text-xs text-gray-500 mb-3">@o.City</p>
                                <div class="flex gap-2">
                                    <a asp-action="OfferDetails" asp-route-id="@o.OfferId" asp-route-source="student" class="btn-outline-premium text-xs py-1 px-3">Gor</a>
                                    <a asp-controller="Application" asp-action="Create" asp-route-offerId="@o.OfferId" class="btn-success-premium text-xs py-1 px-3">Basvur</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            const btn = document.getElementById('btnSaveOffer');
            if(!btn) return;
            const offerId = btn.getAttribute('data-offer-id');
            const isAuth = '@(User.Identity?.IsAuthenticated == true ? "true" : "false")' === 'true';
            const isStudent = '@(User.IsInRole("Student") ? "true" : "false")' === 'true';
            const userId = '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0")';
            const storageKey = `favOffers:${userId}`;

            function getFavSet(){
                try{ 
                    const raw = localStorage.getItem(storageKey) || ''; 
                    return new Set(raw.split(',').filter(x=>x)); 
                } catch { 
                    return new Set(); 
                }
            }
            
            function saveFavSet(set){ 
                try{ 
                    localStorage.setItem(storageKey, Array.from(set).join(',')); 
                    window.dispatchEvent(new CustomEvent('favoriteUpdated', {
                        detail: { userId, favoriteCount: set.size }
                    }));
                } catch {} 
            }
            
            function setBtn(saved){ 
                btn.innerHTML = saved ? '<i class="fas fa-bookmark"></i>Kaydedildi' : '<i class="fas fa-bookmark"></i>Kaydet'; 
                btn.className = saved ? 'btn-save-lg saved' : 'btn-save-lg';
            }

            const s = getFavSet();
            setBtn(s.has(offerId));

            btn.addEventListener('click', function(){
                if(!isAuth || !isStudent){
                    const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.href = '/Account/Login?returnUrl=' + returnUrl;
                    return;
                }
                
                const set = getFavSet();
                let willBeFavorite;
                
                if(set.has(offerId)){ 
                    set.delete(offerId); 
                    willBeFavorite = false; 
                } else { 
                    set.add(offerId); 
                    willBeFavorite = true; 
                }
                
                saveFavSet(set);
                setBtn(willBeFavorite);
                
                fetch(`/api/public/offers/${offerId}/favorite`, { method:'POST' })
                    .then(r => r.json())
                    .catch(e => console.error('Sync error:', e));
            });
        })();
    </script>
}