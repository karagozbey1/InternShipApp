@using WebUI.Models.ViewModels.Student
@model WebUI.Models.ViewModels.Student.ApplicationListViewModel
@{
    ViewData["Title"] = "Basvurularim";
    Layout = "_AppLayout";
}

@section Styles {
    <style>
        .applications-hero {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
            border-radius: 24px;
            padding: 2rem;
            position: relative;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }
        .applications-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        }
        .filter-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
        }
        .dark .filter-card {
            background: rgba(30, 41, 59, 0.95);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .filter-input {
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            background: #f8fafc;
            transition: all 0.3s ease;
            font-size: 14px;
        }
        .filter-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            background: white;
        }
        .dark .filter-input {
            background: rgba(51, 65, 85, 0.5);
            border-color: rgba(71, 85, 105, 0.3);
            color: #e5e7eb;
        }
        .filter-btn {
            padding: 12px 24px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .filter-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
        }
        .application-card {
            background: white;
            border-radius: 24px;
            padding: 0;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            margin-bottom: 1.25rem;
        }
        .dark .application-card {
            background: rgba(30, 41, 59, 0.95);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .application-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.15);
        }
        .card-header-gradient {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
            padding: 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        .dark .card-header-gradient {
            background: rgba(51, 65, 85, 0.3);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .company-avatar {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-pending {
            background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(245, 158, 11, 0.15));
            color: #d97706;
        }
        .status-approved {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.15));
            color: #059669;
        }
        .status-rejected {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.15));
            color: #dc2626;
        }
        .info-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 500;
            background: rgba(0, 0, 0, 0.03);
        }
        .dark .info-badge {
            background: rgba(255, 255, 255, 0.05);
        }
        .card-body-content {
            padding: 1.5rem;
        }
        .date-card {
            padding: 1rem;
            border-radius: 14px;
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            text-align: center;
        }
        .dark .date-card {
            background: rgba(51, 65, 85, 0.3);
        }
        .card-footer-actions {
            padding: 1rem 1.5rem;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            background: rgba(0, 0, 0, 0.01);
        }
        .dark .card-footer-actions {
            background: rgba(0, 0, 0, 0.1);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .btn-action {
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }
        .btn-primary-action {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
        }
        .btn-primary-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
            color: white;
        }
        .btn-outline-action {
            background: transparent;
            border: 2px solid #6366f1;
            color: #6366f1;
        }
        .btn-outline-action:hover {
            background: #6366f1;
            color: white;
        }
        .btn-success-action {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }
        .btn-success-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
            color: white;
        }
        .btn-danger-action {
            background: transparent;
            border: 2px solid #ef4444;
            color: #ef4444;
        }
        .btn-danger-action:hover {
            background: #ef4444;
            color: white;
        }
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
        }
        .empty-state-icon {
            width: 100px;
            height: 100px;
            margin: 0 auto 1.5rem;
            border-radius: 24px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .empty-state-icon i { font-size: 2.5rem; color: #6366f1; }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-xl flex items-center gap-3">
        <i class="fas fa-check-circle text-xl"></i>
        @TempData["SuccessMessage"]
    </div>
}

<!-- CSRF Token -->
@Html.AntiForgeryToken()

<div class="space-y-6">
    <!-- Hero Section -->
    <div class="applications-hero animate-fade-in-up">
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">
                    <i class="fas fa-file-alt mr-3"></i>Basvurularim
                </h1>
                <p class="text-white/80">Tum staj basvurularinizi buradan takip edebilirsiniz</p>
            </div>
            <div class="flex items-center gap-3">
                <a asp-action="Favorites" class="px-5 py-3 bg-white/20 hover:bg-white/30 text-white rounded-xl font-semibold backdrop-blur transition-all flex items-center gap-2">
                    <i class="fas fa-bookmark"></i>Favorilerim
                </a>
                <a asp-action="Browse" class="px-5 py-3 bg-white text-indigo-600 rounded-xl font-semibold hover:bg-white/90 transition-all flex items-center gap-2">
                    <i class="fas fa-plus"></i>Yeni Basvuru
                </a>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="filter-card">
        <form method="get" class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Ara</label>
                <div class="relative">
                    <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Basvuru ara..." class="filter-input w-full pl-11" />
                </div>
            </div>
            <div class="w-48">
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Durum</label>
                <select name="statusFilter" class="filter-input w-full">
                    <option value="">Tum Durumlar</option>
                    <option value="Pending" selected="@(Model.StatusFilter?.ToString() == "Pending")">Beklemede</option>
                    <option value="Approved" selected="@(Model.StatusFilter?.ToString() == "Approved")">Onaylandi</option>
                    <option value="Rejected" selected="@(Model.StatusFilter?.ToString() == "Rejected")">Reddedildi</option>
                </select>
            </div>
            <button type="submit" class="filter-btn flex items-center gap-2">
                <i class="fas fa-filter"></i>Filtrele
            </button>
        </form>
    </div>

    <!-- Applications List -->
    <div class="space-y-5">
        @foreach (var application in Model.Applications)
        {
            var avatarLetter = !string.IsNullOrWhiteSpace(application.CompanyName) && application.CompanyName.Length >= 1
                ? application.CompanyName.Substring(0, 1).ToUpper()
                : "?";
            var statusClass = application.Status.ToString() == "Approved" ? "status-approved" : 
                              application.Status.ToString() == "Pending" ? "status-pending" : "status-rejected";
            var statusText = application.Status.ToString() == "Approved" ? "Onaylandi" : 
                             application.Status.ToString() == "Pending" ? "Beklemede" : "Reddedildi";
                             
            <div class="application-card animate-fade-in-up">
                <div class="card-header-gradient">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="company-avatar">@avatarLetter</div>
                            <div>
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                                    @(!string.IsNullOrWhiteSpace(application.CompanyName) ? application.CompanyName : "Bilinmeyen")
                                </h3>
                                <p class="text-gray-600 dark:text-gray-400 mt-1">@application.Position</p>
                                <div class="flex flex-wrap items-center gap-2 mt-3">
                                    <span class="info-badge">
                                        <i class="fas fa-file-alt text-indigo-500"></i>
                                        @($"{application.DocumentCount} belge")
                                    </span>
                                    <span class="info-badge">
                                        <i class="fas fa-user text-purple-500"></i>
                                        @(!string.IsNullOrEmpty(application.AdvisorName) ? application.AdvisorName : "Danisman yok")
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="status-badge @statusClass">@statusText</span>
                            <p class="text-sm text-gray-500 dark:text-gray-400 mt-3">Basvuru Tarihi</p>
                            <p class="font-semibold text-gray-900 dark:text-white">@application.AppliedDate.ToString("dd.MM.yyyy")</p>
                        </div>
                    </div>
                </div>

                <div class="card-body-content">
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div class="date-card">
                            <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Baslangic</p>
                            <p class="font-bold text-gray-900 dark:text-white">@application.StartDate.ToString("dd.MM.yyyy")</p>
                        </div>
                        <div class="date-card">
                            <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Bitis</p>
                            <p class="font-bold text-gray-900 dark:text-white">@application.EndDate.ToString("dd.MM.yyyy")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(application.Description))
                    {
                        <div class="p-4 rounded-xl bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 border-l-4 border-indigo-500">
                            <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">@application.Description</p>
                        </div>
                    }
                </div>

                <div class="card-footer-actions">
                    <div class="flex items-center justify-between">
                        <p class="text-sm text-gray-500 dark:text-gray-400">
                            <i class="far fa-clock mr-1"></i>@application.AppliedDate.ToString("dd.MM.yyyy HH:mm")
                        </p>
                        <div class="flex items-center gap-3">
                            <a asp-action="Details" asp-route-id="@application.Id" class="btn-action btn-outline-action">
                                <i class="fas fa-eye"></i>Detaylar
                            </a>
                            @if (application.Status.ToString() == "Approved")
                            {
                                @if (application.CanCreateApprovalForm)
                                {
                                    <a asp-controller="Approval" asp-action="Create" asp-route-applicationId="@application.Id" class="btn-action btn-success-action">
                                        <i class="fas fa-clipboard-check"></i>Onay Formu
                                    </a>
                                }
                                else
                                {
                                    <span class="btn-action bg-gray-100 text-gray-500 cursor-default">
                                        <i class="fas fa-check-circle"></i>Form Mevcut
                                    </span>
                                }
                            }
                            @if (application.Status.ToString() == "Pending")
                            {
                                <form asp-action="Withdraw" asp-route-id="@application.Id" method="post" class="inline" 
                                      onsubmit="return confirm('Bu basvuruyu geri cekmek istediginizden emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-action btn-danger-action">
                                        <i class="fas fa-undo"></i>Geri Cek
                                    </button>
                                </form>
                            }
                            @if (application.Status.ToString() == "Rejected")
                            {
                                <form asp-action="Delete" asp-route-id="@application.Id" method="post" class="inline" 
                                      onsubmit="return confirm('Bu basvuruyu kalici olarak silmek istediginize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-action bg-gray-100 text-gray-600 hover:bg-gray-200">
                                        <i class="fas fa-trash"></i>Sil
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Applications.Any())
        {
            <div class="application-card">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">Henuz basvuru bulunmuyor</h3>
                    <p class="text-gray-500 dark:text-gray-400 mb-6">Ilk staj basvurunuzu olusturmak icin asagidaki butona tiklayin.</p>
                    <a asp-action="Browse" class="btn-action btn-primary-action inline-flex">
                        <i class="fas fa-plus"></i>Yeni Basvuru Olustur
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Belge Seçim Modal -->
<div id="documentModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-2xl w-full max-h-[80vh] overflow-hidden">
            <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200">Belge Seç</h3>
                <button onclick="closeDocumentModal()" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto max-h-96">
                <div id="modalDocumentsList" class="space-y-3">
                    <!-- Belgeler buraya yüklenecek -->
                </div>
            </div>
            <div class="flex items-center justify-end gap-3 p-6 border-t border-gray-200 dark:border-gray-700">
                <button onclick="closeDocumentModal()" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50">
                    İptal
                </button>
                <button onclick="addSelectedDocuments()" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">
                    Seçilenleri Ekle
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentApplicationId = null;
        let selectedDocuments = [];

        // Modal açma
        async function openDocumentModal(applicationId) {
            currentApplicationId = applicationId;
            selectedDocuments = [];
            
            try {
                // Belgelerim listesini getir
                const response = await fetch('@Url.Action("GetStudentDocuments", "Document")');
                const documents = await response.json();
                
                const modalDocumentsList = document.getElementById('modalDocumentsList');
                
                if (documents.length === 0) {
                    modalDocumentsList.innerHTML = `
                        <div class="text-center py-8">
                            <i class="fas fa-folder-open text-gray-400 text-4xl mb-4"></i>
                            <p class="text-gray-500">Henüz belge yüklenmemiş.</p>
                            <a href="/Document" class="text-blue-500 hover:text-blue-600 text-sm">
                                Belge yüklemek için tıklayın.
                            </a>
                        </div>
                    `;
                } else {
                    modalDocumentsList.innerHTML = documents.map(doc => `
                        <div class="flex items-center justify-between p-3 border rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" id="modal_doc_${doc.id}" value="${doc.id}" 
                                       onchange="toggleModalDocument(${doc.id})" 
                                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <div>
                                    <p class="font-medium text-sm">${doc.title || doc.fileName}</p>
                                    <p class="text-xs text-gray-500">${doc.type} • ${doc.fileSize} • ${doc.uploadDate}</p>
                                </div>
                            </div>
                            <i class="fas fa-file-alt text-blue-500"></i>
                        </div>
                    `).join('');
                }
                
                document.getElementById('documentModal').classList.remove('hidden');
                
            } catch (error) {
                console.error('Belgeler yüklenirken hata:', error);
                alert('Belgeler yüklenirken bir hata oluştu.');
            }
        }

        // Modal kapatma
        function closeDocumentModal() {
            document.getElementById('documentModal').classList.add('hidden');
            currentApplicationId = null;
            selectedDocuments = [];
        }

        // Belge seçimi
        function toggleModalDocument(documentId) {
            const checkbox = document.getElementById(`modal_doc_${documentId}`);
            
            if (checkbox.checked) {
                if (!selectedDocuments.includes(documentId)) {
                    selectedDocuments.push(documentId);
                }
            } else {
                const index = selectedDocuments.indexOf(documentId);
                if (index > -1) {
                    selectedDocuments.splice(index, 1);
                }
            }
        }

        // Seçilen belgeleri başvuruya ekleme
        async function addSelectedDocuments() {
            if (selectedDocuments.length === 0) {
                alert('Lütfen en az bir belge seçin.');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                const response = await fetch('@Url.Action("AddDocumentsToApplication", "Application")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        applicationId: currentApplicationId,
                        documentIds: selectedDocuments
                    })
                });

                if (response.ok) {
                    // Başarılı - başvuru belgelerini güncelle
                    await loadApplicationDocuments(currentApplicationId);
                    closeDocumentModal();
                    
                    // Success message göster
                    const successDiv = document.createElement('div');
                    successDiv.className = 'mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg';
                    successDiv.textContent = 'Belgeler başarıyla eklendi.';
                    document.body.insertBefore(successDiv, document.body.firstChild);
                    
                    // 3 saniye sonra mesajı kaldır
                    setTimeout(() => {
                        if (successDiv.parentNode) {
                            successDiv.parentNode.removeChild(successDiv);
                        }
                    }, 3000);
                } else {
                    alert('Belgeler eklenirken bir hata oluştu.');
                }
                
            } catch (error) {
                console.error('Belge ekleme hatası:', error);
                alert('Belgeler eklenirken bir hata oluştu.');
            }
        }

        // Başvuruya ait belgeleri yükleme
        async function loadApplicationDocuments(applicationId) {
            try {
                const response = await fetch(`@Url.Action("GetApplicationDocuments", "Application")?applicationId=${applicationId}`);
                const documents = await response.json();
                
                const container = document.getElementById(`applicationDocuments_${applicationId}`);
                
                if (documents.length === 0) {
                    container.innerHTML = '<p class="text-xs text-gray-500">Henüz belge eklenmemiş</p>';
                } else {
                    container.innerHTML = documents.map(doc => `
                        <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-700 rounded">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-file-alt text-blue-500 text-sm"></i>
                                <span class="text-sm">${doc.title || doc.fileName}</span>
                            </div>
                            <a href="${doc.filePath}" target="_blank" class="text-blue-500 hover:text-blue-600 text-xs">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </div>
                    `).join('');
                }
                
            } catch (error) {
                console.error('Başvuru belgeleri yüklenirken hata:', error);
            }
        }

        // Sayfa yüklendiğinde başvuru belgelerini yükle
        document.addEventListener('DOMContentLoaded', function() {
            @foreach (var application in Model.Applications)
            {
                @:loadApplicationDocuments(@application.Id);
            }
        });
    </script>
}