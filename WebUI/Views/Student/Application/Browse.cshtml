@using WebUI.Models.ViewModels.Student.ViewModels
@model OfferBrowseViewModel
@{
    ViewData["Title"] = "Aktif Staj Ilanlari";
    Layout = "_AppLayout";
}

@section Styles {
    <style>
        .browse-hero {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
            border-radius: 24px;
            padding: 2rem;
            position: relative;
            overflow: hidden;
            margin-bottom: 1.5rem;
        }
        .browse-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        }
        .filter-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
        }
        .dark .filter-card {
            background: rgba(30, 41, 59, 0.95);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .filter-input {
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            background: #f8fafc;
            transition: all 0.3s ease;
            font-size: 14px;
        }
        .filter-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            background: white;
            outline: none;
        }
        .dark .filter-input {
            background: rgba(51, 65, 85, 0.5);
            border-color: rgba(71, 85, 105, 0.3);
            color: #e5e7eb;
        }
        .filter-btn {
            padding: 12px 24px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .filter-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
        }
        
        .offer-card {
            background: white;
            border-radius: 24px;
            padding: 0;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            margin-bottom: 1.25rem;
        }
        .dark .offer-card {
            background: rgba(30, 41, 59, 0.95);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .offer-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.15);
        }
        .offer-card-header {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
            padding: 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        .dark .offer-card-header {
            background: rgba(51, 65, 85, 0.3);
            border-color: rgba(71, 85, 105, 0.3);
        }
        .company-avatar {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-active {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.15));
            color: #059669;
        }
        .status-urgent {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.15));
            color: #dc2626;
        }
        .offer-card-body {
            padding: 1.5rem;
        }
        .offer-description {
            padding: 1rem;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(139, 92, 246, 0.05));
            border-left: 3px solid #8b5cf6;
        }
        .offer-card-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            background: rgba(0, 0, 0, 0.01);
        }
        .dark .offer-card-footer {
            background: rgba(0, 0, 0, 0.1);
            border-color: rgba(71, 85, 105, 0.3);
        }
        
        .btn-action {
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }
        .btn-outline-action {
            background: transparent;
            border: 2px solid #6366f1;
            color: #6366f1;
        }
        .btn-outline-action:hover {
            background: #6366f1;
            color: white;
        }
        .btn-success-action {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }
        .btn-success-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
            color: white;
        }
        .btn-disabled {
            background: #e5e7eb;
            color: #9ca3af;
            cursor: not-allowed;
        }
        
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
        }
        .empty-state-icon {
            width: 100px;
            height: 100px;
            margin: 0 auto 1.5rem;
            border-radius: 24px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .empty-state-icon i { font-size: 2.5rem; color: #6366f1; }
        
        .info-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 500;
            background: rgba(0, 0, 0, 0.03);
        }
        .dark .info-badge {
            background: rgba(255, 255, 255, 0.05);
        }
    </style>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-xl flex items-center gap-3">
        <i class="fas fa-check-circle text-xl"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-xl flex items-center gap-3">
        <i class="fas fa-exclamation-circle text-xl"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="space-y-6">
    <!-- Hero Section -->
    <div class="browse-hero animate-fade-in-up">
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">
                    <i class="fas fa-briefcase mr-3"></i>Aktif Staj Ilanlari
                </h1>
                <p class="text-white/80">Kariyer yolculugunuza baslamak icin firsatlari kesfedin</p>
            </div>
            <a asp-controller="Application" asp-action="Index" class="px-5 py-3 bg-white/20 hover:bg-white/30 text-white rounded-xl font-semibold backdrop-blur transition-all flex items-center gap-2">
                <i class="fas fa-arrow-left"></i>Basvurularim
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="filter-card">
        <form method="get" class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Ara</label>
                <div class="relative">
                    <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Sirket adi veya pozisyon ara..." class="filter-input w-full pl-11" />
                </div>
            </div>
            <div class="w-48">
                <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Sehir</label>
                <input type="text" name="locationFilter" value="@Model.LocationFilter" placeholder="Sehir..." class="filter-input w-full" />
            </div>
            <button type="submit" class="filter-btn flex items-center gap-2">
                <i class="fas fa-filter"></i>Filtrele
            </button>
        </form>
    </div>

    <!-- Offers List -->
    <div class="space-y-5">
        @foreach (var offer in Model.Offers)
        {
            var avatarLetter = offer.Company?.CompanyName?.Substring(0, 1).ToUpper() ?? "?";
            var isUrgent = offer.ApplicationDeadline.HasValue && offer.ApplicationDeadline.Value < DateTime.Now.AddDays(7);
            var isExpired = offer.ApplicationDeadline.HasValue && offer.ApplicationDeadline.Value < DateTime.Now;
            
            <div class="offer-card animate-fade-in-up">
                <div class="offer-card-header">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="company-avatar">@avatarLetter</div>
                            <div>
                                <div class="flex items-center gap-3 mb-1">
                                    <h3 class="text-xl font-bold text-gray-900 dark:text-white">@offer.Title</h3>
                                    @if (offer.IsActive && !isExpired)
                                    {
                                        <span class="status-badge status-active">Aktif</span>
                                    }
                                    @if (isUrgent && !isExpired)
                                    {
                                        <span class="status-badge status-urgent">
                                            <i class="fas fa-fire mr-1"></i>Son Gunler
                                        </span>
                                    }
                                </div>
                                <p class="text-gray-600 dark:text-gray-400 font-medium">@offer.Company?.CompanyName</p>
                                <div class="flex flex-wrap items-center gap-2 mt-2">
                                    @if (!string.IsNullOrEmpty(offer.City))
                                    {
                                        <span class="info-badge">
                                            <i class="fas fa-map-marker-alt text-indigo-500"></i>@offer.City
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(offer.Field))
                                    {
                                        <span class="info-badge">
                                            <i class="fas fa-briefcase text-purple-500"></i>@offer.Field
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            @if (offer.ApplicationDeadline.HasValue)
                            {
                                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Son Basvuru</p>
                                <p class="font-bold text-gray-900 dark:text-white">@offer.ApplicationDeadline.Value.ToString("dd.MM.yyyy")</p>
                            }
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
                                <i class="far fa-calendar mr-1"></i>Ilan: @offer.CreatedAt.ToString("dd.MM.yyyy")
                            </p>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(offer.Description))
                {
                    <div class="offer-card-body">
                        <div class="offer-description">
                            <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed line-clamp-3">@offer.Description</p>
                        </div>
                    </div>
                }

                <div class="offer-card-footer">
                    <div class="flex items-center justify-end">
                        <div class="flex items-center gap-3">
                            <a asp-action="OfferDetails" asp-route-id="@offer.Id" asp-route-source="student" class="btn-action btn-outline-action">
                                <i class="fas fa-eye"></i>Detaylar
                            </a>
                            @if (offer.IsActive && !isExpired)
                            {
                                <a asp-action="Create" asp-route-offerId="@offer.Id" class="btn-action btn-success-action">
                                    <i class="fas fa-paper-plane"></i>Basvur
                                </a>
                            }
                            else
                            {
                                <span class="btn-action btn-disabled">
                                    <i class="fas fa-times"></i>Suresi Dolmus
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @if (!Model.Offers.Any())
        {
            <div class="offer-card">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-search"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-700 dark:text-gray-300 mb-2">Aktif staj ilani bulunmuyor</h3>
                    <p class="text-gray-500 dark:text-gray-400 mb-6">Su anda basvuru yapabileceginiz aktif bir staj ilani bulunmamaktadir.</p>
                    <a asp-controller="Application" asp-action="Index" class="btn-action btn-outline-action inline-flex">
                        <i class="fas fa-arrow-left"></i>Basvurularima Don
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Modal preview removed - details open as full page
    </script>
}