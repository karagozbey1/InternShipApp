@using WebUI.Models.ViewModels.Student.ViewModels
@model OfferBrowseViewModel
@{
    ViewData["Title"] = "Aktif Staj Ýlanlarý";
    Layout = "_AppLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
        @TempData["ErrorMessage"]
    </div>
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-gray-800 dark:text-gray-100">Aktif Staj Ýlanlarý</h1>
        <a asp-controller="Application" asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>Baþvurularým
        </a>
    </div>

    <!-- Search and Filter -->
    <div class="p-4 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
        <form method="get" class="flex gap-4">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Þirket adý veya pozisyon ara..." 
                       class="pl-10 pr-4 py-2 w-full border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-800 dark:border-gray-700 dark:text-gray-200" />
            </div>
            <div class="relative">
                <input type="text" name="locationFilter" value="@Model.LocationFilter" placeholder="Þehir..." 
                       class="px-4 py-2 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-800 dark:border-gray-700 dark:text-gray-200" />
            </div>
            <button type="submit" class="flex items-center gap-2 px-4 py-2 bg-blue-500 text-white rounded-xl hover:bg-blue-600 transition-colors duration-200">
                <i class="fas fa-filter"></i>
                Filtrele
            </button>
        </form>
    </div>

    <!-- Offers List -->
    <div class="grid gap-6">
        @foreach (var offer in Model.Offers)
        {
            <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700 hover:shadow-xl transition-all duration-200">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-start gap-4 flex-1">
                        <div class="w-16 h-16 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xl">
                            @offer.Company?.CompanyName?.Substring(0, 1).ToUpper()
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-2">
                                <h3 class="text-xl font-semibold text-gray-800 dark:text-gray-200">@offer.Title</h3>
                                @if (offer.IsActive)
                                {
                                    <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-medium rounded-full">Aktif</span>
                                }
                            </div>
                            <p class="text-gray-600 dark:text-gray-400 font-medium">@offer.Company?.CompanyName</p>
                            @if (!string.IsNullOrEmpty(offer.City))
                            {
                                <p class="text-sm text-gray-500 dark:text-gray-500 flex items-center gap-1 mt-1">
                                    <i class="fas fa-map-marker-alt"></i>
                                    @offer.City
                                </p>
                            }
                        </div>
                    </div>
                    <div class="text-right">
                        @if (offer.ApplicationDeadline.HasValue)
                        {
                            <p class="text-sm text-gray-500 dark:text-gray-400">Son Baþvuru:</p>
                            <p class="font-medium text-gray-800 dark:text-gray-200">@offer.ApplicationDeadline.Value.ToString("dd.MM.yyyy")</p>
                            @if (offer.ApplicationDeadline.Value < DateTime.Now.AddDays(7))
                            {
                                <span class="inline-block mt-1 px-2 py-1 bg-red-100 text-red-800 text-xs font-medium rounded-full">
                                    <i class="fas fa-exclamation-triangle mr-1"></i>Son Günler
                                </span>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(offer.Description))
                {
                    <div class="mb-4">
                        <p class="text-gray-700 dark:text-gray-300 line-clamp-3">@offer.Description</p>
                    </div>
                }

                <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-gray-600">
                    <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                        <span>
                            <i class="fas fa-calendar mr-1"></i>
                            Ýlan Tarihi: @offer.CreatedAt.ToString("dd.MM.yyyy")
                        </span>
                    </div>
                    <div class="flex gap-2">
                        <a asp-action="OfferDetails" asp-route-id="@offer.Id" asp-route-source="student" class="px-4 py-2 text-blue-600 border border-blue-600 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors">
                            <i class="fas fa-info-circle mr-1"></i>
                            Detaylar
                        </a>
                        @if (offer.IsActive && (!offer.ApplicationDeadline.HasValue || offer.ApplicationDeadline.Value >= DateTime.Now))
                        {
                            <a asp-action="Create" asp-route-offerId="@offer.Id" 
                               class="px-4 py-2 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg hover:shadow-lg transition-all duration-200 transform hover:scale-105">
                                <i class="fas fa-paper-plane mr-1"></i>
                                Baþvuru Yap
                            </a>
                        }
                        else
                        {
                            <button disabled 
                                    class="px-4 py-2 bg-gray-300 text-gray-500 rounded-lg cursor-not-allowed">
                                <i class="fas fa-times mr-1"></i>
                                Süresi Dolmuþ
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
        
        @if (!Model.Offers.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-briefcase text-gray-400 text-6xl mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">Aktif staj ilaný bulunmuyor</h3>
                <p class="text-gray-500 dark:text-gray-500 mb-6">Þu anda baþvuru yapabileceðiniz aktif bir staj ilaný bulunmamaktadýr.</p>
                <a asp-controller="Application" asp-action="Index" class="inline-flex items-center gap-2 bg-blue-500 text-white px-6 py-3 rounded-xl hover:bg-blue-600 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                    Baþvurularýma Dön
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Modal preview removed - details open as full page
    </script>
}