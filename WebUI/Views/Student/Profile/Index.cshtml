@using WebUI.Models.ViewModels.Student.ViewModels
@model ProfileUpdateViewModel
@{
    ViewData["Title"] = "Profil";
    Layout = "_AppLayout";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-lg dark:from-blue-900/20 dark:to-indigo-900/20 dark:border-blue-700 flex items-start justify-between">
        <div>
            <h1 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-2">
                <i class="fas fa-user-graduate me-3"></i>Öðrenci Profili
            </h1>
            <p class="text-blue-600 dark:text-blue-300">Bilgilerinizi görüntüleyin ve düzenleyin</p>
        </div>
        <div>
            <button id="btnEditToggle" class="px-4 py-2 rounded-xl text-white shadow-sm hover:shadow transition-all duration-150" style="background:linear-gradient(135deg,#7C3AED,#6D28D9);">
                <i class="fas fa-pen me-2"></i>Düzenle
            </button>
        </div>
    </div>

    <!-- DISPLAY SECTION -->
    <div id="displaySection" class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
        <!-- TempData Messages - Moved to Display Section -->
        @if (TempData["SuccessMessage"] != null)
        {
        <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
        <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        </div>
        }

        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-6">
            <!-- Centered avatar + name -->
            <div class="flex flex-col items-center text-center mb-6">
                <div class="relative">
                    <img src="@Url.Action("Avatar","Profile")" alt="Avatar" class="w-24 h-24 rounded-full object-cover border" />
                    <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="absolute -bottom-2 -right-2" title="Profil resmini deðiþtir">
                        @Html.AntiForgeryToken()
                        <label class="cursor-pointer w-9 h-9 rounded-full flex items-center justify-center text-white shadow" style="background:linear-gradient(45deg,#7C3AED,#6D28D9);">
                            <i class="fas fa-camera"></i>
                            <input type="file" name="AvatarFile" accept="image/*" class="hidden" onchange="this.form.submit()" />
                        </label>
                    </form>
                </div>
                <form asp-action="RemoveAvatar" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Profil Resmini Kaldýr</button>
                </form>
                <h2 class="mt-4 text-2xl font-extrabold text-gray-900 dark:text-gray-100">@Model.FullName</h2>
                <div class="text-gray-500 dark:text-gray-400">@Model.Department</div>
            </div>

            <!-- Info grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="space-y-3">
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-envelope text-rose-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">E-posta</div>
                            <div class="font-medium">@Model.Email</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-phone text-emerald-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">Telefon</div>
                            <div class="font-medium">@(string.IsNullOrWhiteSpace(Model.Phone)?"-":Model.Phone)</div>
                        </div>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-id-card text-indigo-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">Öðrenci No</div>
                            <div class="font-medium">@(string.IsNullOrWhiteSpace(Model.StudentNumber)?"-":Model.StudentNumber)</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 info-line">
                        <i class="fas fa-layer-group text-fuchsia-600"></i>
                        <div>
                            <div class="text-xs text-gray-500">Sýnýf</div>
                            <div class="font-medium">@Model.Grade?.ToString()</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- EDIT SECTION (existing forms) -->
    <div id="editSection" class="hidden space-y-6">
        <!-- Profile Information -->
        <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-6">
                <i class="fas fa-user me-2"></i>Profil Bilgileri
            </h3>

            <form asp-action="Index" method="post" class="profile-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="FullName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-user me-1"></i>Ad Soyad
                        </label>
                        <input asp-for="FullName" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Adýnýzý ve soyadýnýzý girin" 
                               required />
                        <span asp-validation-for="FullName" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-envelope me-1"></i>E-posta
                        </label>
                        <input asp-for="Email" 
                               type="email"
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="E-posta adresinizi girin" 
                               required />
                        <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-phone me-1"></i>Telefon
                        </label>
                        <input asp-for="Phone" 
                               type="tel"
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Telefon numaranýzý girin" 
                               required />
                        <span asp-validation-for="Phone" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="StudentNumber" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-id-card me-1"></i>Öðrenci No
                        </label>
                        <input asp-for="StudentNumber" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Öðrenci numaranýzý girin" 
                               required />
                        <span asp-validation-for="StudentNumber" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Department" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-graduation-cap me-1"></i>Bölüm
                        </label>
                        <input asp-for="Department" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Bölümünüzü girin" />
                        <span asp-validation-for="Department" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Grade" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-layer-group me-1"></i>Sýnýf
                        </label>
                        <select asp-for="Grade" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200">
                            <option value="1">1. Sýnýf</option>
                            <option value="2">2. Sýnýf</option>
                            <option value="3">3. Sýnýf</option>
                            <option value="4">4. Sýnýf</option>
                        </select>
                        <span asp-validation-for="Grade" class="text-red-600 text-sm"></span>
                    </div>
                </div>

            <button type="submit" class="mt-6 bg-gradient-to-r from-blue-500 to-purple-600 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105 font-medium">
                <i class="fas fa-save me-2"></i>Bilgileri Güncelle
            </button>
            <button type="button" id="btnCancelEdit" class="ml-3 px-4 py-3 rounded-xl border">Ýptal</button>
            </form>
        </div>

        <!-- Change Password -->
        <div class="p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-6">
                <i class="fas fa-lock me-2"></i>Þifre Deðiþtir
            </h3>

            <form asp-action="ChangePassword" method="post" class="change-password-form">
                @Html.AntiForgeryToken()
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-key me-1"></i>Mevcut Þifre
                        </label>
                        <input type="password" 
                               name="CurrentPassword" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Mevcut þifrenizi girin" 
                               required />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-lock me-1"></i>Yeni Þifre
                        </label>
                        <input type="password" 
                               name="NewPassword" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Yeni þifrenizi girin (en az 6 karakter)" 
                               minlength="6"
                               required />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-check-circle me-1"></i>Yeni Þifre Tekrar
                        </label>
                        <input type="password" 
                               name="ConfirmPassword" 
                               class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white dark:bg-gray-700 dark:border-gray-600 dark:text-gray-200" 
                               placeholder="Yeni þifrenizi tekrar girin" 
                               required />
                    </div>
                </div>

                <button type="submit" class="mt-6 bg-gradient-to-r from-green-500 to-green-600 text-white px-6 py-3 rounded-xl hover:shadow-lg transition-all duration-200 transform hover:scale-105 font-medium">
                    <i class="fas fa-shield-alt me-2"></i>Þifreyi Güncelle
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const passwordForm = document.querySelector('.change-password-form');
            const newPassword = passwordForm.querySelector('input[name="NewPassword"]');
            const confirmPassword = passwordForm.querySelector('input[name="ConfirmPassword"]');
            function validatePasswords() { confirmPassword.setCustomValidity(newPassword.value !== confirmPassword.value ? 'Þifreler eþleþmiyor' : ''); }
            newPassword.addEventListener('input', validatePasswords);
            confirmPassword.addEventListener('input', validatePasswords);
            passwordForm.addEventListener('submit', function(e) { if (newPassword.value !== confirmPassword.value) { e.preventDefault(); alert('Þifreler eþleþmiyor. Lütfen kontrol edin.'); }});

            const btn = document.getElementById('btnEditToggle');
            const display = document.getElementById('displaySection');
            const edit = document.getElementById('editSection');
            const cancelBtn = document.getElementById('btnCancelEdit');
            function toEdit(){ display.classList.add('hidden'); edit.classList.remove('hidden'); window.scrollTo({top:0, behavior:'smooth'}); }
            function toDisplay(){ edit.classList.add('hidden'); display.classList.remove('hidden'); window.scrollTo({top:0, behavior:'smooth'}); }
            if(btn) btn.addEventListener('click', toEdit);
            if(cancelBtn) cancelBtn.addEventListener('click', toDisplay);

            // Auto-hide messages after 5 seconds
            const messages = document.querySelectorAll('.bg-green-100, .bg-red-100');
            messages.forEach(function(message) {
                setTimeout(function() {
                    message.style.transition = 'opacity 0.5s ease-out';
                    message.style.opacity = '0';
                    setTimeout(function() {
                        message.remove();
                    }, 500);
                }, 5000);
            });
        });
    </script>
    <style>
        .info-line{padding:.75rem 1rem;border:1px solid rgba(0,0,0,.06);border-radius:12px;background:rgba(99,102,241,.03)}
    </style>
}
