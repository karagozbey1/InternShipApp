@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "_AppLayout";
}

<link rel="stylesheet" href="~/css/dashboard-custom.css" />
<link rel="stylesheet" href="~/css/AdvisorCss/dynamic-dashboard.css" />

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 p-6 space-y-6">
    <div class="dynamic-card p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-lg dark:from-blue-900/20 dark:to-indigo-900/20 dark:border-blue-700">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-2"><i class="fas fa-user-graduate me-3"></i>Hoþ Geldiniz, @Model.FullName</h2>
                <div class="text-blue-600 dark:text-blue-300 text-sm">@(Model.User?.Department ?? "") @(Model.User?.University?.Name != null ? ("- " + Model.User.University.Name.ToUpperInvariant()) : "")</div>
                @if (Model.ActiveInternship?.InternshipOffer?.Period != null)
                {
                    <div class="text-xs text-blue-500 mt-2">@Model.ActiveInternship.InternshipOffer.Period.PeriodName</div>
                }
            </div>
            <div class="text-right text-sm text-blue-600 dark:text-blue-300">
                <div>@DateTime.Now.ToString("dd MMMM yyyy", new CultureInfo("tr-TR"))</div>
                <div class="mt-1">@CultureInfo.GetCultureInfo("tr-TR").DateTimeFormat.GetDayName(DateTime.Now.DayOfWeek)</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Staj Gün Sayýsý</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.TotalInternshipDays</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl"><i class="fas fa-calendar-day text-white text-xl"></i></div>
            </div>
            <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">Planlanan toplam çalýþma günü</div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Tamamlanan Staj Günü</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.CompletedInternshipDays</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-green-500 to-emerald-500 rounded-xl"><i class="fas fa-check-circle text-white text-xl"></i></div>
            </div>
            <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">Deftere iþlediðiniz benzersiz günler</div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Tamamlanma Oraný</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.ProgressPercentage%</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl"><i class="fas fa-chart-line text-white text-xl"></i></div>
            </div>
            <div class="mt-4 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden"><div class="h-2 bg-gradient-to-r from-purple-500 to-pink-500" style="width:@Model.ProgressPercentage%;"></div></div>
            <div class="mt-2 text-xs text-gray-500 dark:text-gray-400">Gün / Planlanan gün</div>
        </div>
        <div class="stat-card dynamic-card p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Okunmayan Bildirim</p>
                    <p class="stat-number text-3xl font-bold text-gray-900 dark:text-white">@Model.UnreadNotifications</p>
                </div>
                <div class="p-3 bg-gradient-to-r from-red-500 to-rose-500 rounded-xl"><i class="fas fa-bell text-white text-xl"></i></div>
            </div>
            <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">Yeni bildirimleri kontrol edin</div>
        </div>
    </div>

    <div class="dynamic-card p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800 dark:text-gray-200"><i class="fas fa-route mr-2"></i>Staj Süreci</h3>
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300">@Model.CurrentProcessStage</span>
        </div>
        <div class="w-full h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden"><div class="h-3 bg-green-500" style="width:@Model.ProcessProgress%;"></div></div>
        <div class="flex justify-between mt-2 text-xs text-gray-600 dark:text-gray-400"><span>@Model.ProcessDescription</span><span>%@Model.ProcessProgress</span></div>
    </div>

    <div class="dynamic-card p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
        <div class="flex items-center justify-between mb-4"><h3 class="text-lg font-bold text-gray-800 dark:text-gray-200"><i class="fas fa-bolt mr-2"></i>Son Aktiviteler</h3></div>
        <div class="space-y-4">
            @if (Model.RecentActivities.Any()){
                @foreach (var activity in Model.RecentActivities){
                    <div class="flex items-start space-x-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors">
                        <div class="flex-shrink-0"><div class="w-8 h-8 rounded-full flex items-center justify-center bg-blue-100 dark:bg-blue-900"><i class="@activity.Icon text-blue-600 dark:text-blue-300 text-sm"></i></div></div>
                        <div class="flex-1 min-w-0"><p class="text-sm text-gray-900 dark:text-gray-100 font-medium">@activity.Title</p><p class="text-xs text-gray-500 dark:text-gray-400">@activity.Time</p></div>
                    </div>
                }
            } else { <div class="text-center py-8 text-gray-500 dark:text-gray-400 text-sm">Henüz aktivite bulunmuyor</div> }
        </div>
    </div>

    <div class="dynamic-card p-6 rounded-2xl bg-white/70 backdrop-blur-sm border-white/20 border shadow-lg dark:bg-gray-800/50 dark:border-gray-700">
        <div class="flex items-center justify-between mb-4"><h3 class="text-lg font-bold text-gray-800 dark:text-gray-200"><i class="fas fa-briefcase mr-2"></i>Son Baþvurular</h3><a asp-controller="Application" asp-action="Index" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-sm font-medium">Tümünü Gör</a></div>
        <div class="space-y-3">
            @if (Model.RecentApplications.Any()){
                @foreach (var app in Model.RecentApplications){
                    <div class="flex items-center justify-between p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                        <div class="flex items-center space-x-3"><div class="w-10 h-10 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center"><i class="fas fa-building text-blue-600 dark:text-blue-400"></i></div><div><h4 class="text-sm font-medium text-gray-900 dark:text-gray-100">@app.InternshipOffer?.Company?.CompanyName</h4><p class="text-xs text-gray-500 dark:text-gray-400">@app.InternshipOffer?.Title</p><p class="text-xs text-gray-400 dark:text-gray-500">@app.CreatedAt.ToString("dd MMM yyyy")</p></div></div>
                        <span class="px-2 py-1 rounded-full text-xs font-medium @(app.Status==Core.Entity.InternshipApplicationStatus.Pending?"bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200":app.Status==Core.Entity.InternshipApplicationStatus.Approved?"bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200":app.Status==Core.Entity.InternshipApplicationStatus.Rejected?"bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200":"bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200")">@(app.Status==Core.Entity.InternshipApplicationStatus.Pending?"Beklemede":app.Status==Core.Entity.InternshipApplicationStatus.Approved?"Onaylandý":app.Status==Core.Entity.InternshipApplicationStatus.Rejected?"Reddedildi":"Bilinmiyor")</span>
                    </div>
                }
            } else { <div class="text-center py-8 text-gray-500 dark:text-gray-400 text-sm">Henüz baþvuru bulunmuyor</div> }
        </div>
    </div>
</div>

@section Scripts {<script>console.log('Student Dashboard moved view loaded');</script>}
