@model WebUI.Models.ViewModels.Student.ViewModels.HelpViewModel
@{
    ViewData["Title"] = "Yardým";
    Layout = "_AppLayout";
}

<div class="space-y-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-2">Yardým Merkezi</h1>
        <p class="text-gray-600 dark:text-gray-400 text-sm">Sýk sorulan sorular ve destek kanallarý.</p>
    </div>

    <!-- FAQ -->
    <div class="rounded-2xl shadow-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Sýk Sorulan Sorular</h2>
        </div>
        <div class="p-6 space-y-4">
            @if (Model.FaqItems.Any())
            {
                foreach (var item in Model.FaqItems)
                {
                    <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-700/40">
                        <p class="font-semibold text-gray-800 dark:text-gray-100">@item.Question</p>
                        <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">@item.Answer</p>
                    </div>
                }
            }
            else
            {
                <p class="text-sm text-gray-500">Kayýtlý SSS bulunamadý.</p>
            }
        </div>
    </div>

    <!-- Ýletiþim -->
    <div class="rounded-2xl shadow-sm bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
            <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Ýletiþim</h2>
        </div>
        <div class="p-6 grid md:grid-cols-2 gap-6 text-sm">
            <div>
                <h3 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">Koordinatör</h3>
                <p class="text-gray-700 dark:text-gray-300">@Model.CoordinatorName</p>
                <p class="text-gray-500 dark:text-gray-400">@Model.CoordinatorEmail</p>
                <p class="text-gray-500 dark:text-gray-400">@Model.OfficeHours</p>
            </div>
            <div>
                <h3 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">Destek</h3>
                <p class="text-gray-700 dark:text-gray-300">E-posta: @Model.SupportEmail</p>
                <p class="text-gray-700 dark:text-gray-300">Telefon: @Model.SupportPhone</p>
                <p class="text-gray-500 dark:text-gray-400">Yanýtlama süresi genellikle 1 iþ günüdür.</p>
            </div>
        </div>
    </div>
</div>