@using WebUI.Models.Student
@model ApprovalFormCreateViewModel
@{
    ViewData["Title"] = "Yeni Onay Formu";
    Layout = "_AppLayout";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h2 class="mb-0">
                        <i class="fas fa-clipboard-check me-2"></i>Staj Onay Formu Oluþtur
                    </h2>
                    <p class="mb-0 mt-2 opacity-75">Staj yapacaðýnýz þirketle ilgili bilgileri doldurun</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h6><i class="fas fa-exclamation-triangle me-2"></i>Formda hatalar bulundu:</h6>
                                <ul class="mb-0">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Þirket Bilgileri -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card mb-4">
                                    <div class="card-header bg-info text-white">
                                        <h6 class="mb-0">
                                            <i class="fas fa-building me-2"></i>Þirket Bilgileri
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="CompanyName" class="form-label required"></label>
                                                <input asp-for="CompanyName" class="form-control" 
                                                       placeholder="Þirket adýný tam olarak yazýn" required />
                                                <span asp-validation-for="CompanyName" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="InternshipCoordinator" class="form-label required"></label>
                                                <input asp-for="InternshipCoordinator" class="form-control" 
                                                       placeholder="Staj koordinatörünün ad soyad" required />
                                                <span asp-validation-for="InternshipCoordinator" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="CoordinatorPhone" class="form-label"></label>
                                                <input asp-for="CoordinatorPhone" class="form-control" type="tel" 
                                                       placeholder="05XX XXX XX XX" />
                                                <span asp-validation-for="CoordinatorPhone" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="CoordinatorEmail" class="form-label"></label>
                                                <input asp-for="CoordinatorEmail" class="form-control" type="email" 
                                                       placeholder="koordinator@sirket.com" />
                                                <span asp-validation-for="CoordinatorEmail" class="text-danger"></span>
                                            </div>
                                            <div class="col-12 mb-3">
                                                <label asp-for="WorkplaceAddress" class="form-label required"></label>
                                                <textarea asp-for="WorkplaceAddress" class="form-control" rows="3" 
                                                          placeholder="Þirketin tam adresi (il, ilçe, mahalle, sokak, no)" required></textarea>
                                                <span asp-validation-for="WorkplaceAddress" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Staj Detaylarý -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card mb-4">
                                    <div class="card-header bg-success text-white">
                                        <h6 class="mb-0">
                                            <i class="fas fa-calendar-alt me-2"></i>Staj Detaylarý
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4 mb-3">
                                                <label asp-for="StartDate" class="form-label required"></label>
                                                <input asp-for="StartDate" type="date" class="form-control" required />
                                                <span asp-validation-for="StartDate" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <label asp-for="EndDate" class="form-label required"></label>
                                                <input asp-for="EndDate" type="date" class="form-control" required />
                                                <span asp-validation-for="EndDate" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <label asp-for="WeeklyWorkHours" class="form-label required"></label>
                                                <input asp-for="WeeklyWorkHours" type="number" class="form-control" 
                                                       min="1" max="40" placeholder="Haftalýk saat" required />
                                                <span asp-validation-for="WeeklyWorkHours" class="text-danger"></span>
                                            </div>
                                            <div class="col-12 mb-3">
                                                <label asp-for="InternshipDescription" class="form-label required"></label>
                                                <textarea asp-for="InternshipDescription" class="form-control" rows="4" 
                                                          placeholder="Yapacaðýnýz iþlerin detaylý açýklamasý..."></textarea>
                                                <span asp-validation-for="InternshipDescription" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Öðrenci Notu -->
                        <div class="card mb-4">
                            <div class="card-header bg-warning text-dark">
                                <h6 class="mb-0">
                                    <i class="fas fa-sticky-note me-2"></i>Öðrenci Notu
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label asp-for="StudentNote" class="form-label"></label>
                                    <textarea asp-for="StudentNote" class="form-control" rows="3"
                                              placeholder="Danýþmanýnýza iletmek istediðiniz özel notlar..."></textarea>
                                    <span asp-validation-for="StudentNote" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Form Butonlarý -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <button type="submit" class="btn btn-primary btn-lg me-3">
                                            <i class="fas fa-paper-plane me-2"></i>Onaya Gönder
                                        </button>
                                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                                            <i class="fas fa-times me-2"></i>Ýptal
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/student/approval-create.js" asp-append-version="true"></script>
}