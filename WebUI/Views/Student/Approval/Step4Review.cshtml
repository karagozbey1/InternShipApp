@using WebUI.Models.Student
@model ApprovalFormReviewViewModel
@{
    ViewData["Title"] = "Baþvuru Gözden Geçir";
    Layout = "_AppLayout";
}

<div class="max-w-4xl mx-auto p-6">
    <div class="bg-white rounded-lg shadow-md p-8">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">
                <i class="fas fa-clipboard-check text-blue-500 mr-2"></i>
                Baþvuru Gözden Geçirme
            </h1>
            <p class="text-gray-600">Bilgilerinizi kontrol edin ve baþvurunuzu gönderin</p>
        </div>

        <!-- Bilgi kartlarý -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <!-- Þirket bilgileri -->
            <div class="bg-blue-50 p-4 rounded-lg">
                <h3 class="font-semibold text-blue-800 mb-3">
                    <i class="fas fa-building mr-2"></i>Þirket Bilgileri
                </h3>
                <div class="space-y-2 text-sm">
                    <div><strong>Þirket:</strong> @Model.CompanyName</div>
                    <div><strong>Pozisyon:</strong> @Model.InternshipDescription</div>
                    <div><strong>Adres:</strong> @Model.WorkplaceAddress</div>
                </div>
            </div>

            <!-- Tarih bilgileri -->
            <div class="bg-green-50 p-4 rounded-lg">
                <h3 class="font-semibold text-green-800 mb-3">
                    <i class="fas fa-calendar mr-2"></i>Staj Tarihleri
                </h3>
                <div class="space-y-2 text-sm">
                    <div><strong>Baþlangýç:</strong> @Model.StartDate.ToString("dd/MM/yyyy")</div>
                    <div><strong>Bitiþ:</strong> @Model.EndDate.ToString("dd/MM/yyyy")</div>
                    <div><strong>Haftalýk Saat:</strong> @Model.WeeklyWorkHours saat</div>
                </div>
            </div>
        </div>

        <!-- Ýrtibat bilgileri -->
        <div class="bg-yellow-50 p-4 rounded-lg mb-6">
            <h3 class="font-semibold text-yellow-800 mb-3">
                <i class="fas fa-user-tie mr-2"></i>Staj Koordinatörü
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                <div><strong>Ad Soyad:</strong> @Model.InternshipCoordinator</div>
                <div><strong>Telefon:</strong> @Model.CoordinatorPhone</div>
                <div><strong>E-posta:</strong> @Model.CoordinatorEmail</div>
            </div>
        </div>

        <!-- Öðrenci notu -->
        @if (!string.IsNullOrEmpty(Model.StudentNote))
        {
            <div class="bg-purple-50 p-4 rounded-lg mb-6">
                <h3 class="font-semibold text-purple-800 mb-3">
                    <i class="fas fa-sticky-note mr-2"></i>Öðrenci Notu
                </h3>
                <p class="text-sm text-gray-700">@Model.StudentNote</p>
            </div>
        }

        <!-- Form gönderimi -->
        <form method="post" asp-action="SubmitApproval">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            
            <div class="text-center">
                <button type="submit" id="submitBtn" 
                        class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded-lg transition-colors">
                    <i class="fas fa-paper-plane mr-2"></i>Baþvuruyu Gönder
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/student/approval-review.js" asp-append-version="true"></script>
}