@model WebUI.Models.ViewModels.Student.ApprovalFormListViewModel
@{
    ViewData["Title"] = "Baþvurularý Görüntüle";
    Layout = "_AppLayout";
}

@section Styles {
<text>
    <style>
        .approval-card { background: linear-gradient(180deg,#ffffff 0%, #fbfbff 100%); border-radius: 14px; box-shadow: 0 8px 30px rgba(18,38,63,0.06); padding: 18px; border: 1px solid rgba(15,23,42,0.04); }
        .top-info { background: linear-gradient(90deg,#eff6ff,#eef2ff); border-radius: 12px; padding: 14px 18px; display:flex; align-items:center; gap:18px; justify-content:space-between; }
        .top-left { display:flex; align-items:center; gap:14px; }
        .icon-box { width:52px; height:52px; border-radius:10px; background:linear-gradient(90deg,#2563eb,#7c3aed); display:flex; align-items:center; justify-content:center; color:white; font-size:18px; flex-shrink:0; }
        .btn-back { background: linear-gradient(90deg,#64748b,#334155); color:white; padding:10px 20px; border-radius:12px; border:none; font-weight:600; display:inline-flex; align-items:center; gap:8px; text-decoration:none; box-shadow:0 4px 12px rgba(51,65,85,.25); transition:.2s; }
        .btn-back:hover { filter:brightness(1.05); transform:translateY(-2px); }
        .sent-card { background:#fff; border-radius:12px; padding:18px; margin-bottom:22px; box-shadow:0 6px 18px rgba(2,6,23,0.04); border:1px solid rgba(15,23,42,0.03); }
        .sent-meta { display:flex; gap:18px; align-items:flex-start; }
        .avatar-circle { width:56px; height:56px; border-radius:12px; display:flex; align-items:center; justify-content:center; color:white; font-weight:700; }
        .card-body { flex:1; }
        .card-row { display:flex; gap:12px; align-items:flex-start; }
        .card-col { flex:1; }
        .status-badge { padding:6px 10px; border-radius:999px; font-weight:600; font-size:0.85rem; display:inline-flex; gap:8px; align-items:center; }
        .status-pending { background: linear-gradient(90deg,#fff7ed,#ffedd5); color:#92400e; }
        .status-approved { background: linear-gradient(90deg,#ecfdf5,#bbf7d0); color:#065f46; }
        .status-rejected { background: linear-gradient(90deg,#fff1f2,#fee2e2); color:#7f1d1d; }
        .doc-line { border-top:1px solid #f1f5f9; margin-top:12px; padding-top:12px; color:#6b7280; }
        .doc-item { display:flex; align-items:center; gap:8px; padding:6px 0; }
        .doc-item i { width:22px; text-align:center; }
        .card-actions { display:flex; gap:10px; align-items:center; justify-content:flex-end; margin-top:12px; }
        .btn-outline { padding:8px 12px; border-radius:8px; border:1px solid rgba(15,23,42,0.06); background:transparent; }
        @Html.Raw("@media (max-width: 880px){ .top-info{flex-direction:column; align-items:flex-start;} .btn-back{align-self:stretch; justify-content:center; width:100%;} .card-row{flex-direction:column;} }")
    </style>
</text>
}

<div class="container max-w-7xl mx-auto">
    <div class="approval-card top-card mb-6">
        <div class="top-info">
            <div class="top-left">
                <div class="icon-box"><i class="fas fa-clipboard-check"></i></div>
                <div>
                    <div style="font-weight:700; font-size:1rem;">Onay Formlarý</div>
                    <div style="color:#374151;">Gönderdiðiniz onay formlarýný burada görüntüleyebilir, detaylarýna bakabilirsiniz.</div>
                </div>
            </div>
            <a asp-action="Step1Documents" asp-controller="Approval" class="btn-back" title="Geri Dön">
                <i class="fas fa-arrow-left"></i> Geri Dön
            </a>
        </div>
    </div>

    @if (Model.ApprovalForms.Any())
    {
        foreach (var f in Model.ApprovalForms.OrderByDescending(x => x.CreatedAt))
        {
            var statusClass = f.Status == Core.Entity.InternshipApprovalStatus.Pending ? "status-pending" : (f.Status == Core.Entity.InternshipApprovalStatus.Approved ? "status-approved" : "status-rejected");
            var initial = !string.IsNullOrEmpty(f.AdvisorName) ? f.AdvisorName.Substring(0,1).ToUpper() : (string.IsNullOrEmpty(f.CompanyName) ? "F" : f.CompanyName.Substring(0,1).ToUpper());
            <div class="sent-card">
                <div class="sent-meta">
                    <div class="avatar-circle" style="background:linear-gradient(135deg,#7c3aed,#06b6d4);">@initial</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="card-row" style="width:100%;">
                                <div class="card-col">
                                    <h4 class="mb-1">@(!string.IsNullOrEmpty(f.AdvisorName) ? ("Danýþman: " + f.AdvisorName) : (!string.IsNullOrEmpty(f.CompanyName) ? f.CompanyName : "Bilinmeyen"))</h4>
                                    <div class="text-muted small">
                                        @if (!string.IsNullOrEmpty(f.AdvisorDepartment))
                                        {
                                            <span><i class="fas fa-chalkboard-teacher me-1 text-muted"></i> @f.AdvisorDepartment</span>
                                        }
                                        else if (!string.IsNullOrEmpty(f.OfferTitle))
                                        {
                                            <span><i class="fas fa-briefcase me-1 text-muted"></i> @f.OfferTitle</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-col text-end">
                                    <div class="text-muted small">Baþlangýç Tarihi<br /><strong>@f.StartDate.ToString("dd.MM.yyyy")</strong></div>
                                </div>
                                <div class="card-col text-end">
                                    <div class="text-muted small">Bitiþ Tarihi<br /><strong>@f.EndDate.ToString("dd.MM.yyyy")</strong></div>
                                </div>
                            </div>
                        </div>

                        <div class="doc-line">
                            <div class="d-flex justify-content-between">
                                <div style="max-width:65%;">
                                    <div class="text-sm">Açýklama<br /><strong class="text-dark">@(!string.IsNullOrEmpty(f.StudentNote) ? f.StudentNote : "-")</strong></div>
                                    <div class="mt-2 text-sm">Ekli Belgeler</div>
                                    <div class="mt-1 text-muted small">
                                        @if (f.Documents != null && f.Documents.Any())
                                        {
                                            foreach (var d in f.Documents)
                                            {
                                                <div class="doc-item"><i class="fas fa-file-alt text-blue-500"></i> <span>@d.Title</span></div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="doc-item"><i class="fas fa-info-circle text-yellow-500"></i> Henüz belge eklenmemiþ</div>
                                        }
                                    </div>
                                </div>

                                <div class="text-end" style="min-width:200px;">
                                    <div class="status-badge @statusClass">
                                        <i class="fas @(f.Status == Core.Entity.InternshipApprovalStatus.Pending ? "fa-clock" : f.Status == Core.Entity.InternshipApprovalStatus.Approved ? "fa-check-circle" : "fa-times-circle")"></i>
                                        <span>@f.Status.ToString()</span>
                                    </div>
                                    <div class="mt-3 card-actions">
                                        <a asp-controller="Approval" asp-action="Details" asp-route-id="@f.Id" class="btn-outline"> <i class="fas fa-eye me-1"></i> Detaylar</a>
                                        @if (f.Status == Core.Entity.InternshipApprovalStatus.Approved)
                                        {
                                            <span class="btn-outline ms-2"> <i class="fas fa-file-download me-1"></i>Onay Formu Mevcut</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="text-muted small mt-3">Baþvuru Tarihi: @f.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-12">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <h4 class="mb-2">Henüz gönderilmiþ baþvurunuz yok</h4>
            <p class="text-muted mb-4">Baþvuru oluþturmak için belge seçimi sayfasýna gidin ve formu tamamlayýn.</p>
            <a asp-action="Step1Documents" asp-controller="Approval" class="btn btn-primary">Baþvuru Oluþtur</a>
        </div>
    }
</div>

@section Scripts { <script></script> }
