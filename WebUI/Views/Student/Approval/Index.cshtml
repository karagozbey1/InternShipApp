@using Core.Entity
@model WebUI.Models.Student.ApprovalFormListViewModel
@{
    ViewData["Title"] = "Staj Onay Formlarý";
    Layout = "_AppLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-clipboard-check me-2"></i>Staj Onay Formlarý
                    </h6>
                    <div class="d-flex gap-2">
                        <!-- Modern Onay Formu Butonu -->
                        <a asp-action="Step1Documents" class="btn btn-success btn-sm">
                            <i class="fas fa-plus me-2"></i>Yeni Onay Formu
                        </a>
                        
                        <!-- Filtreleme ve Arama -->
                        <form asp-action="Index" method="get" class="d-flex gap-2">
                            <input type="text" name="searchTerm" value="@Model.SearchTerm" 
                                   class="form-control form-control-sm" placeholder="Þirket adý, koordinatör..." style="width: 200px;">
                            
                            <select name="statusFilter" class="form-select form-select-sm" style="width: 150px;">
                                <option value="">Tüm Durumlar</option>
                                <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Beklemede</option>
                                <option value="Approved" selected="@(Model.StatusFilter == "Approved")">Onaylandý</option>
                                <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Reddedildi</option>
                            </select>
                            
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-search"></i>
                            </button>
                            
                            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                            {
                                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-times"></i>
                                </a>
                            }
                        </form>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Yeni Onay Formu Bilgilendirme -->
                    <div class="alert alert-info d-flex align-items-center mb-4">
                        <i class="fas fa-info-circle me-3 fs-4"></i>
                        <div class="flex-fill">
                            <h6 class="alert-heading mb-1">Onay Formu Oluþturma</h6>
                            <small>
                                Onaylanmýþ baþvurularýnýz için danýþman onay formlarý oluþturabilirsiniz. 
                                Form oluþturmak için önce belgelerinizi hazýrlayýn.
                            </small>
                        </div>
                        <a asp-action="Step1Documents" class="btn btn-success">
                            <i class="fas fa-paper-plane me-2"></i>Form Oluþtur
                        </a>
                    </div>

                    <!-- Ýstatistikler -->
                    <div class="row mb-4">
                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-primary shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                                Toplam Form
                                            </div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Stats.TotalCount</div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-warning shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                                Beklemede
                                            </div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Stats.PendingCount</div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-success shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                                Onaylandý
                                            </div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Stats.ApprovedCount</div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6 mb-4">
                            <div class="card border-left-danger shadow h-100 py-2">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                                Reddedildi
                                            </div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Stats.RejectedCount</div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Onay Formlarý Listesi -->
                    @if (Model.ApprovalForms.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Þirket</th>
                                        <th>Danýþman</th>
                                        <th>Oluþturma Tarihi</th>
                                        <th>Durum</th>
                                        <th>Ýþlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var form in Model.ApprovalForms)
                                    {
                                        var statusClass = form.Status switch
                                        {
                                            "Pending" => "warning",
                                            "Approved" => "success", 
                                            "Rejected" => "danger",
                                            "Revision" => "warning",
                                            _ => "secondary"
                                        };
                                        var statusText = form.Status switch
                                        {
                                            "Pending" => "Beklemede",
                                            "Approved" => "Onaylandý",
                                            "Rejected" => "Reddedildi", 
                                            "Revision" => "Revizyonda",
                                            _ => form.Status
                                        };

                                        // Legacy revision durumunu kontrol et
                                        if (form.Status == "Rejected" && !string.IsNullOrEmpty(form.AdvisorComment) && form.AdvisorComment.StartsWith("REVISION:"))
                                        {
                                            statusClass = "warning";
                                            statusText = "Revizyonda";
                                        }

                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@form.CompanyName</div>
                                                <small class="text-muted">@form.Position</small>
                                            </td>
                                            <td>@form.AdvisorName</td>
                                            <td>@form.CreatedAt.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <span class="badge bg-@statusClass">@statusText</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@form.Id" 
                                                       class="btn btn-sm btn-outline-info" title="Detaylarý Görüntüle">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (form.Status == "Pending" || form.Status == "Revision" || (form.Status == "Rejected" && !string.IsNullOrEmpty(form.AdvisorComment) && form.AdvisorComment.StartsWith("REVISION:")))
                                                    {
                                                        <a asp-action="Edit" asp-route-id="@form.Id" 
                                                           class="btn btn-sm btn-outline-warning" title="Düzenle">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Henüz onay formu bulunmuyor</h5>
                            <p class="text-muted">Onaylanmýþ baþvurularýnýz için danýþman onay formu oluþturabilirsiniz.</p>
                            <a asp-action="Step1Documents" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Ýlk Onay Formunu Oluþtur
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Baþvuru arama
            $('[name="searchTerm"]').on('input', function() {
                var searchValue = $(this).val().toLowerCase();
                $('tbody tr').each(function() {
                    var companyName = $(this).find('td:first').text().toLowerCase();
                    if (companyName.includes(searchValue)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });
        });
    </script>
}