@model DirectApprovalFormViewModel
@{
    ViewData["Title"] = "Staj Onay Formu Oluþtur";
    Layout = "_StudentLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-primary text-white">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-file-signature me-2"></i>Staj Onay Formu Oluþtur
                    </h6>
                </div>
                <div class="card-body">
                    <!-- Bilgilendirme Mesajý -->
                    <div class="alert alert-info d-flex align-items-center mb-4">
                        <i class="fas fa-info-circle me-3 fs-4"></i>
                        <div>
                            <h6 class="alert-heading mb-1">Staj Onay Süreci</h6>
                            <small>
                                Bu form ile belgelerinizi danýþmanýnýza göndererek staj onayý alabilirsiniz. 
                                Tüm bilgileri doðru ve eksiksiz doldurunuz.
                            </small>
                        </div>
                    </div>

                    <!-- Yüklenen Belgeler -->
                    <div class="card bg-light mb-4">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0">
                                <i class="fas fa-paperclip me-2"></i>Yüklenen Belgeleriniz (@Model.StudentDocuments.Count adet)
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (Model.StudentDocuments.Any())
                            {
                                <div class="row" id="document-container">
                                    @for (int i = 0; i < Model.StudentDocuments.Count; i++)
                                    {
                                        <div class="col-md-6 col-lg-4 mb-3">
                                            <div class="card h-100 selectable-document" 
                                                 data-id="@Model.StudentDocuments[i].Id" 
                                                 onclick="toggleDocument(this, event)">
                                                <div class="card-body p-3 d-flex flex-column">
                                                    <div class="document-content">
                                                        <div class="checkbox-container">
                                                            <input type="checkbox" name="SelectedDocumentIds" 
                                                                   value="@Model.StudentDocuments[i].Id" 
                                                                   class="form-check-input document-checkbox" 
                                                                   id="doc_@Model.StudentDocuments[i].Id" 
                                                                   onclick="event.stopPropagation();">
                                                        </div>
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="fas fa-file-alt text-success me-2"></i>
                                                            <div class="flex-fill">
                                                                <h6 class="card-title mb-1 small">@Model.StudentDocuments[i].DocumentTypeDisplayName</h6>
                                                                <p class="card-text mb-1 small text-muted">@Model.StudentDocuments[i].FileName</p>
                                                            </div>
                                                        </div>
                                                        <small class="text-muted mt-auto">@Model.StudentDocuments[i].UploadedAt.ToString("dd.MM.yyyy")</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="alert alert-warning mt-3">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Devam etmek için lütfen en az bir belge seçin.
                                    <span id="selected-count" class="badge bg-primary ms-2">0</span> belge seçildi.
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted">
                                    <i class="fas fa-file-upload fs-1 mb-3"></i>
                                    <p>Henüz belge yüklenmemiþ.</p>
                                    <a href="@Url.Action("Index", "Document")" class="btn btn-outline-primary">
                                        <i class="fas fa-upload me-2"></i>Belge Yükle
                                    </a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Onay Formu -->
                    <form asp-action="CreateDirectApproval" method="post" class="needs-validation" id="approvalForm" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <!-- Sol Kolon -->
                            <div class="col-md-6">
                                <!-- Þirket Bilgileri -->
                                <div class="card mb-4">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0">
                                            <i class="fas fa-building me-2"></i>Þirket Bilgileri
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="CompanyName" class="form-label required"></label>
                                            <input asp-for="CompanyName" class="form-control" 
                                                   placeholder="Staj yapacaðýnýz þirketin adý" required />
                                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="WorkplaceAddress" class="form-label"></label>
                                            <textarea asp-for="WorkplaceAddress" class="form-control" rows="3" 
                                                      placeholder="Staj yapacaðýnýz yerin tam adresi (isteðe baðlý)"></textarea>
                                            <span asp-validation-for="WorkplaceAddress" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Koordinatör Bilgileri -->
                                <div class="card mb-4">
                                    <div class="card-header bg-info text-white">
                                        <h6 class="mb-0">
                                            <i class="fas fa-user-tie me-2"></i>Staj Koordinatörü (Ýsteðe Baðlý)
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="InternshipCoordinator" class="form-label"></label>
                                            <input asp-for="InternshipCoordinator" class="form-control" 
                                                   placeholder="Koordinatör adý soyadý" />
                                            <span asp-validation-for="InternshipCoordinator" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="CoordinatorPhone" class="form-label"></label>
                                            <input asp-for="CoordinatorPhone" class="form-control" 
                                                   placeholder="+90 (555) 123 45 67" />
                                            <span asp-validation-for="CoordinatorPhone" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="CoordinatorEmail" class="form-label"></label>
                                            <input asp-for="CoordinatorEmail" type="email" class="form-control" 
                                                   placeholder="koordinator@sirket.com" />
                                            <span asp-validation-for="CoordinatorEmail" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sað Kolon -->
                            <div class="col-md-6">
                                <!-- Staj Detaylarý -->
                                <div class="card mb-4">
                                    <div class="card-header bg-success text-white">
                                        <h6 class="mb-0">
                                            <i class="fas fa-calendar-alt me-2"></i>Staj Detaylarý
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="StartDate" class="form-label required"></label>
                                                <input asp-for="StartDate" type="date" class="form-control" required />
                                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label asp-for="EndDate" class="form-label required"></label>
                                                <input asp-for="EndDate" type="date" class="form-control" required />
                                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="WeeklyWorkHours" class="form-label required"></label>
                                            <div class="input-group">
                                                <input asp-for="WeeklyWorkHours" type="number" class="form-control" 
                                                       min="1" max="168" required />
                                                <span class="input-group-text">saat/hafta</span>
                                            </div>
                                            <div class="form-text">Önerilen: 30-40 saat/hafta</div>
                                            <span asp-validation-for="WeeklyWorkHours" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="InternshipDescription" class="form-label"></label>
                                            <textarea asp-for="InternshipDescription" class="form-control" rows="4"
                                                      placeholder="Stajda yapacaðýnýz iþlerin detaylý açýklamasý..."></textarea>
                                            <span asp-validation-for="InternshipDescription" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Danýþmana Not -->
                                <div class="card mb-4">
                                    <div class="card-header bg-warning text-dark">
                                        <h6 class="mb-0">
                                            <i class="fas fa-sticky-note me-2"></i>Danýþmanýnýza Not
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="StudentNote" class="form-label"></label>
                                            <textarea asp-for="StudentNote" class="form-control" rows="3"
                                                      placeholder="Danýþmanýnýza iletmek istediðiniz özel notlar (isteðe baðlý)"></textarea>
                                            <span asp-validation-for="StudentNote" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Butonlarý -->
                        <div class="card">
                            <div class="card-body text-center bg-light">
                                <button type="submit" class="btn btn-primary btn-lg me-3" id="submit-button" 
                                        @(Model.StudentDocuments.Count == 0 ? "disabled" : "")>
                                    <i class="fas fa-paper-plane me-2"></i>Danýþmana Gönder
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg me-3">
                                    <i class="fas fa-list me-2"></i>Formlarým
                                </a>
                                <a asp-controller="Document" asp-action="Index" class="btn btn-outline-primary btn-lg">
                                    <i class="fas fa-upload me-2"></i>Belge Yükle
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Sayfa yüklendiðinde çalýþacak fonksiyon
        document.addEventListener('DOMContentLoaded', function() {
            // Baþlangýçta seçim sayýsýný güncelle
            updateSelectedCount();
            
            // Tarih alaný ayarlarý
            setupDateFields();
            
            // Form doðrulama ayarlarý
            setupFormValidation();
        });
        
        // Belge seçim fonksiyonu
        function toggleDocument(element, event) {
            // Eðer doðrudan checkbox'a týklandýysa, kartýn týklama iþlemini engelle
            if (event.target.type === 'checkbox') {
                return;
            }
            
            // Kartýn içindeki checkbox'ý bul
            var checkbox = element.querySelector('input[type="checkbox"]');
            
            // Checkbox durumunu tersine çevir
            checkbox.checked = !checkbox.checked;
            
            // Kartýn görünümünü güncelle
            updateDocumentCardStyle(element, checkbox.checked);
            
            // Seçili belge sayýsýný güncelle
            updateSelectedCount();
        }
        
        // Belge kartý stilini güncelleme
        function updateDocumentCardStyle(card, isSelected) {
            if (isSelected) {
                card.classList.add('selected-document');
            } else {
                card.classList.remove('selected-document');
            }
        }
        
        // Seçili belge sayýsýný güncelleme
        function updateSelectedCount() {
            var checkboxes = document.querySelectorAll('.document-checkbox:checked');
            var count = checkboxes.length;
            var countElement = document.getElementById('selected-count');
            var submitButton = document.getElementById('submit-button');
            
            // Sayýyý güncelle
            if (countElement) {
                countElement.textContent = count;
            }
            
            // Submit butonunu etkinleþtir/devre dýþý býrak
            if (submitButton) {
                submitButton.disabled = (count === 0);
            }
        }
        
        // Tarih alanlarýný ayarlama
        function setupDateFields() {
            var startDateInput = document.getElementById('StartDate');
            var endDateInput = document.getElementById('EndDate');
            
            if (!startDateInput || !endDateInput) return;
            
            // Bugünün tarihini al
            var today = new Date().toISOString().split('T')[0];
            
            // Minimum tarih deðerlerini ayarla
            startDateInput.setAttribute('min', today);
            
            // Baþlangýç tarihi deðiþtiðinde bitiþ tarihini güncelle
            startDateInput.addEventListener('change', function() {
                var startDate = this.value;
                endDateInput.setAttribute('min', startDate);
                
                // Bitiþ tarihini otomatik ayarla (90 gün sonra)
                if (startDate) {
                    var start = new Date(startDate);
                    start.setDate(start.getDate() + 90);
                    var endDateString = start.toISOString().split('T')[0];
                    endDateInput.value = endDateString;
                }
            });
        }
        
        // Form doðrulama
        function setupFormValidation() {
            var form = document.getElementById('approvalForm');
            
            if (!form) return;
            
            form.addEventListener('submit', function(e) {
                var startDate = new Date(document.getElementById('StartDate').value);
                var endDate = new Date(document.getElementById('EndDate').value);
                
                // Bitiþ tarihi baþlangýçtan sonra olmalý
                if (startDate >= endDate) {
                    e.preventDefault();
                    alert('Staj bitiþ tarihi, baþlangýç tarihinden sonra olmalýdýr!');
                    return false;
                }
                
                // Minimum staj süresi kontrolü (30 gün)
                var diffTime = Math.abs(endDate - startDate);
                var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                
                if (diffDays < 30) {
                    e.preventDefault();
                    alert('Staj süresi en az 30 gün olmalýdýr!');
                    return false;
                }
                
                // En az bir belge seçilmeli
                var selectedDocuments = document.querySelectorAll('.document-checkbox:checked');
                if (selectedDocuments.length === 0) {
                    e.preventDefault();
                    alert('Lütfen onaya göndermek için en az bir belge seçin.');
                    return false;
                }
            });
        }
    </script>
}

<style>
    .required::after {
        content: " *";
        color: red;
    }
    
    .alert {
        border-left: 4px solid;
    }
    
    .alert-info {
        border-left-color: #0dcaf0;
    }
    
    /* Belge kartý stilleri */
    .selectable-document {
        cursor: pointer;
        transition: all 0.2s ease;
        border: 2px solid #e9ecef;
        position: relative;
    }
    
    .selectable-document:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        transform: translateY(-2px);
    }
    
    .selected-document {
        border-color: #0d6efd !important;
        background-color: #f0f7ff;
    }
    
    .document-checkbox {
        transform: scale(1.5);
        margin: 0.5rem;
    }
    
    .checkbox-container {
        position: absolute;
        top: 10px;
        right: 10px;
    }
    
    .document-content {
        padding-right: 30px; /* Checkbox için alan aç */
    }
    
    /* Form alaný iyileþtirmeleri */
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    #selected-count {
        font-size: 1rem;
    }
</style>