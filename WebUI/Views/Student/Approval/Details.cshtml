@using Core.Entity
@model WebUI.Models.ViewModels.Student.ApprovalFormViewModel
@{
    ViewData["Title"] = "Baþvuru Detayý";
    Layout = "_AppLayout";

    // Localized status text
    string statusText = Model.Status switch
    {
        InternshipApprovalStatus.Pending => "Beklemede",
        InternshipApprovalStatus.Approved => "Onaylandý",
        InternshipApprovalStatus.Rejected => "Reddedildi",
        _ => Model.Status.ToString()
    };

    string startDateText = Model.StartDate != DateTime.MinValue ? Model.StartDate.ToString("dd MMMM yyyy") : "-";
    string endDateText = Model.EndDate != DateTime.MinValue ? Model.EndDate.ToString("dd MMMM yyyy") : "-";
}

@section Styles {
    <link rel="stylesheet" href="~/css/approval-details.css" />
}

<div class="approval-page">
    <div class="approval-top">
        <div>
            <div class="page-title">Baþvuru Detayý</div>
            <div class="page-sub">@((!string.IsNullOrEmpty(Model.StudentName) ? Model.StudentName : "Öðrenci")) adlý öðrencinin baþvuru detaylarý</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="SentForms" asp-controller="Approval" class="btn btn-ghost" aria-label="Baþvurulara dön">
                <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Baþvurulara Dön
            </a>
        </div>
    </div>

    <div class="hero" style="background:linear-gradient(90deg,#5b21b6,#6d28d9);">
        <div class="hero-left">
            <div class="avatar" style="background:linear-gradient(135deg,#7c3aed,#06b6d4);" aria-hidden="true">@((!string.IsNullOrEmpty(Model.StudentName) ? Model.StudentName.Substring(0,1).ToUpper() : "Ö"))</div>
            <div class="hero-meta">
                <h2>@(Model.StudentName ?? "Öðrenci Adý")</h2>
                <div class="meta">@((!string.IsNullOrEmpty(Model.StudentUniversity) ? Model.StudentUniversity : "Üniversite Bilgisi")) • @((!string.IsNullOrEmpty(Model.StudentDepartment) ? Model.StudentDepartment : "Bölüm"))</div>
                <div class="meta small-muted">@statusText • @Model.CreatedAt.ToString("dd MMMM yyyy")</div>
            </div>
        </div>
        <div class="hero-right">
            <div class="card" style="min-width:220px; text-align:center; background:rgba(255,255,255,0.06); border:none;" role="status" aria-live="polite">
                <div style="font-weight:700; font-size:18px; color:#fff;">@((Model.ApprovedAt.HasValue) ? "Onaylandý" : (Model.RejectedAt.HasValue ? "Reddedildi" : "Beklemede"))</div>
                <div class="small-muted" style="color:rgba(255,255,255,0.9);">Durum</div>
            </div>
        </div>
    </div>

    <div class="grid">
        <div class="main">
            <div class="card fade-in" tabindex="0" aria-labelledby="personal-heading">
                <div id="personal-heading" class="section-title"><i class="fas fa-user-graduate" aria-hidden="true"></i> Kiþisel Bilgiler</div>
                <div class="row">
                    <div class="col-md-6">
                        <dl>
                            <dt class="small-muted">Email</dt>
                            <dd>@((!string.IsNullOrEmpty(Model.StudentEmail)) ? Model.StudentEmail : "-")</dd>

                            <dt class="small-muted">Sýnýf</dt>
                            <dd>@((Model.StudentGrade.HasValue) ? Model.StudentGrade + ". sýnýf" : "-")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl>
                            <dt class="small-muted">Üniversite</dt>
                            <dd>@((!string.IsNullOrEmpty(Model.StudentUniversity)) ? Model.StudentUniversity : "-")</dd>

                            <dt class="small-muted">Bölüm</dt>
                            <dd>@((!string.IsNullOrEmpty(Model.StudentDepartment)) ? Model.StudentDepartment : "-")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Company Card: includes Ön Yazý now -->
            <div class="card fade-in mt-3" tabindex="0" aria-labelledby="company-heading">
                <div id="company-heading" class="section-title"><i class="fas fa-building" aria-hidden="true"></i> Firma Bilgileri</div>
                <div class="position-box">
                    <h5 style="font-weight:700">@(!string.IsNullOrEmpty(Model.CompanyName) ? Model.CompanyName : "-")</h5>
                    <div class="small-muted mt-1">Baþlangýç: @startDateText • Bitiþ: @endDateText</div>
                    <div class="mt-3" style="font-weight:700; color:var(--accent-2);">@((!string.IsNullOrEmpty(Model.OfferTitle) ? Model.OfferTitle : (!string.IsNullOrEmpty(Model.Position) ? Model.Position : "-")))</div>

                    @if (!string.IsNullOrEmpty(Model.StudentNote))
                    {
                        <div class="mt-3" style="background:#f8fafc; padding:12px; border-radius:8px;">
                            <div style="font-weight:700; margin-bottom:6px;">Ön Yazý</div>
                            <div class="small-muted">@Model.StudentNote</div>
                        </div>
                    }
                </div>
            </div>

        </div>

        <div id="right-sidebar" class="right" role="complementary" aria-label="Yan menü">
            <div class="card fade-in" tabindex="0">
                <div class="section-title"><i class="fas fa-tasks" aria-hidden="true"></i> Durum Yönetimi</div>
                <div class="status-box">
                    @if (Model.Status == InternshipApprovalStatus.Approved)
                    {
                        <div class="small-muted">Bu baþvuru onaylanmýþ</div>
                    }
                    else if (Model.Status == InternshipApprovalStatus.Rejected)
                    {
                        <div class="small-muted">Bu baþvuru reddedilmiþ</div>
                    }
                    else
                    {
                        <div class="small-muted">Onay bekleniyor</div>
                    }

                    <div class="d-grid gap-2 mt-3">
                        <button class="btn btn-danger" aria-label="Onayý iptal et"><i class="fas fa-ban me-1" aria-hidden="true"></i>Onayý Ýptal Et</button>
                    </div>
                </div>
            </div>

            <!-- Advisor Card -->
            <div class="card fade-in" tabindex="0" aria-labelledby="advisor-heading">
                <div id="advisor-heading" class="section-title"><i class="fas fa-chalkboard-teacher" aria-hidden="true"></i> Danýþman</div>
                @if (!string.IsNullOrEmpty(Model.AdvisorName))
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div style="width:56px; height:56px; border-radius:12px; background:linear-gradient(135deg,var(--accent-2),var(--accent-1)); display:flex; align-items:center; justify-content:center; color:white; font-weight:700;">@Model.AdvisorName.Substring(0,1).ToUpper()</div>
                        <div>
                            <div style="font-weight:700">@Model.AdvisorName</div>
                            <div class="small-muted">@(!string.IsNullOrEmpty(Model.AdvisorDepartment) ? Model.AdvisorDepartment : "-")</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="small-muted">Danýþman ile iletiþim kurmak için uygulama içi mesajlaþma kullanýn.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-primary" aria-label="Mesajlara git"><i class="fas fa-envelope me-1" aria-hidden="true"></i>Mesaj Gönder</a>
                    </div>
                }
                else
                {
                    <div class="small-muted">Danýþman bilgisi mevcut deðil.</div>
                }
            </div>

            <!-- Documents Card -->
            <div class="card fade-in" tabindex="0" aria-labelledby="docs-heading">
                <div id="docs-heading" class="section-title"><i class="fas fa-folder" aria-hidden="true"></i> Belgeler</div>
                <div>
                    @if (Model.Documents != null && Model.Documents.Any())
                    {
                        foreach (var d in Model.Documents)
                        {
                            var title = (!string.IsNullOrEmpty(d.Title)) ? d.Title : d.FileName;
                            <div class="doc-item mb-2">
                                <div class="doc-meta">
                                    <i class="fas fa-file-pdf text-danger" aria-hidden="true"></i>
                                    <div>
                                        <div style="font-weight:700;">@title</div>
                                        <div class="small-muted">@((d.FileSize/1024.0/1024.0)>=1 ? (d.FileSize/1024.0/1024.0).ToString("0.0") + " MB" : (d.FileSize/1024.0).ToString("0") + " KB")</div>
                                    </div>
                                </div>
                                <div class="doc-actions">
                                    <a href="@d.FilePath" class="doc-view" aria-label="@($"Belgeyi görüntüle: {title}")">Gör</a>
                                    <a href="@d.FilePath" download class="btn btn-outline" aria-label="@($"Belgeyi indir: {title}")">Ýndir</a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="small-muted">Henüz yüklenmiþ belge yok.</div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/approval-details.js"></script>
}