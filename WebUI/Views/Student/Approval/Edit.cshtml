@* Staj onay düzenleme sayfasý - danýþman tarafýndan kullanýlýr *@
@model WebUI.Models.ViewModels.Student.ApprovalEditViewModel

@{
    ViewData["Title"] = "Staj Onayý Düzenle";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@* Modern CSS stilleri için link *@
<link rel="stylesheet" href="~/css/approval-edit-modern.css" asp-append-version="true" />

@* Ana container *@
<div class="approval-edit-container">
    <div class="approval-edit-header">
        <div class="header-content">
            <div class="header-text">
                <h1 class="page-title">
                    <i class="fas fa-edit" aria-hidden="true"></i>
                    Staj Onayý Düzenle
                </h1>
                <p class="page-subtitle">@Model.Student.FullName - @Model.Student.StudentNumber</p>
            </div>
            <div class="header-actions">
                <a asp-controller="Advisor" asp-action="Approval" asp-route-area="" 
                   class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Geri Dön
                </a>
            </div>
        </div>
    </div>

    @* Form baþlangýcý *@
    <form asp-controller="Advisor" asp-action="UpdateApproval" method="post" id="editForm" class="approval-form">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Student.Id" />

        <div class="form-grid">
            @* Sol kolon - form alanlarý *@
            <div class="form-column">
                <div class="form-card">
                    <h3 class="card-title">
                        <i class="fas fa-info-circle"></i>
                        Onay Bilgileri
                    </h3>
                    
                    <div class="form-group">
                        <label asp-for="StudentNote" class="form-label required">Danýþman Notu</label>
                        <textarea asp-for="StudentNote" id="studentNote" class="form-control" rows="4" 
                                  placeholder="Öðrencinin staj performansý ve deðerlendirmeniz hakkýnda notlarýnýzý yazýn..."></textarea>
                        <span asp-validation-for="StudentNote" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AdvisorApprovalStatus" class="form-label required">Onay Durumu</label>
                        <select asp-for="AdvisorApprovalStatus" class="form-control">
                            <option value="">Seçiniz</option>
                            <option value="Pending">Beklemede</option>
                            <option value="Approved">Onaylý</option>
                            <option value="Rejected">Reddedildi</option>
                            <option value="NeedsRevision">Revizyon Gerekli</option>
                        </select>
                        <span asp-validation-for="AdvisorApprovalStatus" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Ýlgili Belgeler</label>
                        <div class="documents-container" id="documentsContainer">
                            @* Mevcut belgeler burada gösterilecek *@
                            @if (Model.Documents != null && Model.Documents.Any())
                            {
                                @foreach (var document in Model.Documents)
                                {
                                    <div class="document-item" data-document-id="@document.Id">
                                        <div class="document-info">
                                            <i class="fas fa-file-pdf text-danger"></i>
                                            <span class="document-name">@document.Title</span>
                                            <small class="document-size">
                                                (@(document.FileSize / 1024)KB)
                                            </small>
                                        </div>
                                        <div class="document-actions">
                                            <label class="document-checkbox">
                                                <input type="checkbox" name="documentCheck" value="@document.Id" />
                                                <span class="checkmark"></span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="no-documents">Henüz belge yüklenmemiþ.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Sað kolon - özet ve eylemler *@
            <div class="summary-column">
                <div class="summary-card">
                    <h3 class="card-title">
                        <i class="fas fa-user"></i>
                        Öðrenci Bilgileri
                    </h3>
                    <div class="student-info">
                        <div class="info-item">
                            <strong>Ad Soyad:</strong>
                            <span>@Model.Student.FullName</span>
                        </div>
                        <div class="info-item">
                            <strong>Öðrenci No:</strong>
                            <span>@Model.Student.StudentNumber</span>
                        </div>
                        <div class="info-item">
                            <strong>E-posta:</strong>
                            <span>@Model.Student.Email</span>
                        </div>
                    </div>
                </div>

                <div class="actions-card">
                    <h3 class="card-title">
                        <i class="fas fa-cogs"></i>
                        Ýþlemler
                    </h3>
                    <div class="action-buttons">
                        <button type="submit" id="submitBtn" class="btn btn-primary btn-block">
                            <i class="fas fa-save"></i>
                            Kaydet
                        </button>
                        <button type="button" class="btn btn-secondary btn-block" onclick="previewChanges()">
                            <i class="fas fa-eye"></i>
                            Önizleme
                        </button>
                        <a asp-controller="Advisor" asp-action="Approval" 
                           class="btn btn-outline-secondary btn-block">
                            <i class="fas fa-times"></i>
                            Ýptal
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Seçili dokümanlar için hidden inputlar *@
        <div id="selectedDocumentsInputs">
            @* JavaScript ile dinamik olarak oluþturulacak *@
        </div>
    </form>
</div>

@section Scripts {
    @* Form validasyonu için partial view *@
    <partial name="_ValidationScriptsPartial" />
    
    @* Approval edit için özel JavaScript *@
    <script src="~/js/approval-edit-modern.js" asp-append-version="true"></script>
    
    <script>
        // Seçili dokümanlarý takip eden set
        let selectedDocuments = new Set();

        // Sayfa yüklendiðinde çalýþacak fonksiyonlar
        document.addEventListener('DOMContentLoaded', function() {
            // Doküman seçimi iþlevselliðini baþlat
            initializeDocumentSelection();
            
            // Form gönderimi iþlevselliðini baþlat
            setupFormSubmission();
        });

        // Doküman seçim iþlevselliðini baþlatma
        function initializeDocumentSelection() {
            // Tüm doküman checkbox'larýný seç
            const checkboxes = document.querySelectorAll('input[name="documentCheck"]');
            
            // Her checkbox için event listener ekle
            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const documentId = parseInt(this.value);
                    
                    if (this.checked) {
                        // Doküman seçildiyse set'e ekle
                        selectedDocuments.add(documentId);
                    } else {
                        // Doküman seçimi kaldýrýldýysa set'ten çýkar
                        selectedDocuments.delete(documentId);
                    }
                    
                    // Hidden inputlarý güncelle
                    updateHiddenInputs();
                    
                    // Seçim durumunu görsel olarak güncelle
                    updateDocumentSelectionUI();
                });
            });
        }

        // Hidden inputlarý güncelleme fonksiyonu
        function updateHiddenInputs() {
            const container = document.getElementById('selectedDocumentsInputs');
            // Mevcut inputlarý temizle
            container.innerHTML = '';
            
            // Seçili her doküman için hidden input oluþtur
            selectedDocuments.forEach(documentId => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'SelectedDocumentIds';
                input.value = documentId;
                container.appendChild(input);
            });
        }

        // Doküman seçimi UI güncellemesi
        function updateDocumentSelectionUI() {
            const selectedCount = selectedDocuments.size;
            
            // Seçili doküman sayýsýný güncelleyici bir element varsa güncelle
            const countElement = document.querySelector('.selected-count');
            if (countElement) {
                countElement.textContent = `${selectedCount} belge seçili`;
            }
        }

        // Form gönderimi ayarlama fonksiyonu
        function setupFormSubmission() {
            const form = document.getElementById('editForm');
            const submitBtn = document.getElementById('submitBtn');
            
            if (!form || !submitBtn) {
                return;
            }
            
            // Form gönderim eventi
            form.addEventListener('submit', function(e) {
                // Öðrenci notu validasyonu
                const studentNote = document.getElementById('studentNote');
                if (!studentNote) {
                    e.preventDefault();
                    alert('Öðrenci notu alaný bulunamadý!');
                    return false;
                }
                
                const noteValue = studentNote.value.trim();
                
                if (noteValue.length === 0) {
                    e.preventDefault();
                    alert('Lütfen danýþman notunu doldurun.');
                    return false;
                }
                
                // Hidden inputlarý son kez güncelle
                updateHiddenInputs();
                
                // Yükleniyor durumu göster
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';
            });
        }

        // Deðiþiklikleri önizleme fonksiyonu
        function previewChanges() {
            const studentNote = document.getElementById('studentNote').value;
            const approvalStatus = document.querySelector('select[name="AdvisorApprovalStatus"]').value;
            const selectedDocCount = selectedDocuments.size;
            
            // Önizleme modal'ý veya alert'i göster
            alert(`Önizleme:\n\nDanýþman Notu: ${studentNote}\nOnay Durumu: ${approvalStatus}\nSeçili Belgeler: ${selectedDocCount}`);
        }

        // Hata mesajlarý için Toast notification
        function showToast(message, type = 'info') {
            // Toast notification gösterici (gelecekte geniþletilebilir)
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.textContent = message;
            
            // Toast'u sayfaya ekle
            document.body.appendChild(toast);
            
            // 3 saniye sonra kaldýr
            setTimeout(() => {
                document.body.removeChild(toast);
            }, 3000);
        }
    </script>
}